[
  {
    "number": 5287,
    "text": "سَنَسِمُهُۥ عَلَى ٱلۡخُرۡطُومِ",
    "numberInSurah": 16,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 498,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "سنسمه على الخرطوم"
  },
  {
    "number": 5288,
    "text": "إِنَّا بَلَوۡنَٰهُمۡ كَمَا بَلَوۡنَآ أَصۡحَٰبَ ٱلۡجَنَّةِ إِذۡ أَقۡسَمُواْ لَيَصۡرِمُنَّهَا مُصۡبِحِينَ",
    "numberInSurah": 17,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 498,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "إنا بلوناهم كما بلونا أصحاب الجنة إذ أقسموا ليصرمنها مصبحين"
  },
  {
    "number": 5289,
    "text": "وَلَا يَسۡتَثۡنُونَ",
    "numberInSurah": 18,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 498,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "ولا يستثنون"
  },
  {
    "number": 5290,
    "text": "فَطَافَ عَلَيۡهَا طَآئِفٞ مِّن رَّبِّكَ وَهُمۡ نَآئِمُونَ",
    "numberInSurah": 19,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 498,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "فطاف عليها طائف من ربك وهم نائمون"
  },
  {
    "number": 5291,
    "text": "فَأَصۡبَحَتۡ كَٱلصَّرِيمِ",
    "numberInSurah": 20,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 498,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "فأصبحت كالصريم"
  },
  {
    "number": 5292,
    "text": "فَتَنَادَوۡاْ مُصۡبِحِينَ",
    "numberInSurah": 21,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 498,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "فتنادوا مصبحين"
  },
  {
    "number": 5293,
    "text": "أَنِ ٱغۡدُواْ عَلَىٰ حَرۡثِكُمۡ إِن كُنتُمۡ صَٰرِمِينَ",
    "numberInSurah": 22,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 498,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "أن اغدوا على حرثكم إن كنتم صارمين"
  },
  {
    "number": 5294,
    "text": "فَٱنطَلَقُواْ وَهُمۡ يَتَخَٰفَتُونَ",
    "numberInSurah": 23,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 498,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "فانطلقوا وهم يتخافتون"
  },
  {
    "number": 5295,
    "text": "أَن لَّا يَدۡخُلَنَّهَا ٱلۡيَوۡمَ عَلَيۡكُم مِّسۡكِينٞ",
    "numberInSurah": 24,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 498,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "أن لا يدخلنها اليوم عليكم مسكين"
  },
  {
    "number": 5296,
    "text": "وَغَدَوۡاْ عَلَىٰ حَرۡدٖ قَٰدِرِينَ",
    "numberInSurah": 25,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 498,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "وغدوا على حرد قادرين"
  },
  {
    "number": 5297,
    "text": "فَلَمَّا رَأَوۡهَا قَالُوٓاْ إِنَّا لَضَآلُّونَ",
    "numberInSurah": 26,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 498,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "فلما رأوها قالوا إنا لضالون"
  },
  {
    "number": 5298,
    "text": "بَلۡ نَحۡنُ مَحۡرُومُونَ",
    "numberInSurah": 27,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 498,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "بل نحن محرومون"
  },
  {
    "number": 5299,
    "text": "قَالَ أَوۡسَطُهُمۡ أَلَمۡ أَقُل لَّكُمۡ لَوۡلَا تُسَبِّحُونَ",
    "numberInSurah": 28,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 498,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "قال أوسطهم ألم أقل لكم لولا تسبحون"
  },
  {
    "number": 5300,
    "text": "قَالُواْ سُبۡحَٰنَ رَبِّنَآ إِنَّا كُنَّا ظَٰلِمِينَ",
    "numberInSurah": 29,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 498,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "قالوا سبحان ربنا إنا كنا ظالمين"
  },
  {
    "number": 5301,
    "text": "فَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَلَٰوَمُونَ",
    "numberInSurah": 30,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 498,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "فأقبل بعضهم على بعض يتلاومون"
  },
  {
    "number": 5302,
    "text": "قَالُواْ يَٰوَيۡلَنَآ إِنَّا كُنَّا طَٰغِينَ",
    "numberInSurah": 31,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 498,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "قالوا يا ويلنا إنا كنا طاغين"
  },
  {
    "number": 5303,
    "text": "عَسَىٰ رَبُّنَآ أَن يُبۡدِلَنَا خَيۡرٗا مِّنۡهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَ",
    "numberInSurah": 32,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 498,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "عسى ربنا أن يبدلنا خيرا منها إنا إلى ربنا راغبون"
  },
  {
    "number": 5304,
    "text": "كَذَٰلِكَ ٱلۡعَذَابُۖ وَلَعَذَابُ ٱلۡأٓخِرَةِ أَكۡبَرُۚ لَوۡ كَانُواْ يَعۡلَمُونَ",
    "numberInSurah": 33,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 498,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "كذلك العذاب ولعذاب الآخرة أكبر لو كانوا يعلمون"
  },
  {
    "number": 5305,
    "text": "إِنَّ لِلۡمُتَّقِينَ عِندَ رَبِّهِمۡ جَنَّـٰتِ ٱلنَّعِيمِ",
    "numberInSurah": 34,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 499,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "إن للمتقين عند ربهم جنات النعيم"
  },
  {
    "number": 5306,
    "text": "أَفَنَجۡعَلُ ٱلۡمُسۡلِمِينَ كَٱلۡمُجۡرِمِينَ",
    "numberInSurah": 35,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 499,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "أفنجعل المسلمين كالمجرمين"
  },
  {
    "number": 5307,
    "text": "مَا لَكُمۡ كَيۡفَ تَحۡكُمُونَ",
    "numberInSurah": 36,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 499,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "ما لكم كيف تحكمون"
  },
  {
    "number": 5308,
    "text": "أَمۡ لَكُمۡ كِتَٰبٞ فِيهِ تَدۡرُسُونَ",
    "numberInSurah": 37,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 499,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "أم لكم كتاب فيه تدرسون"
  },
  {
    "number": 5309,
    "text": "إِنَّ لَكُمۡ فِيهِ لَمَا تَخَيَّرُونَ",
    "numberInSurah": 38,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 499,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "إن لكم فيه لما تخيرون"
  },
  {
    "number": 5310,
    "text": "أَمۡ لَكُمۡ أَيۡمَٰنٌ عَلَيۡنَا بَٰلِغَةٌ إِلَىٰ يَوۡمِ ٱلۡقِيَٰمَةِ إِنَّ لَكُمۡ لَمَا تَحۡكُمُونَ",
    "numberInSurah": 39,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 499,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "أم لكم أيمان علينا بالغة إلى يوم القيامة إن لكم لما تحكمون"
  },
  {
    "number": 5311,
    "text": "سَلۡهُمۡ أَيُّهُم بِذَٰلِكَ زَعِيمٌ",
    "numberInSurah": 40,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 499,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "سلهم أيهم بذلك زعيم"
  },
  {
    "number": 5312,
    "text": "أَمۡ لَهُمۡ شُرَكَآءُ فَلۡيَأۡتُواْ بِشُرَكَآئِهِمۡ إِن كَانُواْ صَٰدِقِينَ",
    "numberInSurah": 41,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 499,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "أم لهم شركاء فليأتوا بشركائهم إن كانوا صادقين"
  },
  {
    "number": 5313,
    "text": "يَوۡمَ يُكۡشَفُ عَن سَاقٖ وَيُدۡعَوۡنَ إِلَى ٱلسُّجُودِ فَلَا يَسۡتَطِيعُونَ",
    "numberInSurah": 42,
    "juz": 29,
    "manzil": 7,
    "page": 565,
    "ruku": 499,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "يوم يكشف عن ساق ويدعون إلى السجود فلا يستطيعون"
  }
]