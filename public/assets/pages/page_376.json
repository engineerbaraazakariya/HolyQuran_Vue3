[
  {
    "number": 3139,
    "text": "مَآ أَغۡنَىٰ عَنۡهُم مَّا كَانُواْ يُمَتَّعُونَ",
    "numberInSurah": 207,
    "juz": 19,
    "manzil": 5,
    "page": 376,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "ما أغنى عنهم ما كانوا يمتعون"
  },
  {
    "number": 3140,
    "text": "وَمَآ أَهۡلَكۡنَا مِن قَرۡيَةٍ إِلَّا لَهَا مُنذِرُونَ",
    "numberInSurah": 208,
    "juz": 19,
    "manzil": 5,
    "page": 376,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "وما أهلكنا من قرية إلا لها منذرون"
  },
  {
    "number": 3141,
    "text": "ذِكۡرَىٰ وَمَا كُنَّا ظَٰلِمِينَ",
    "numberInSurah": 209,
    "juz": 19,
    "manzil": 5,
    "page": 376,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "ذكرى وما كنا ظالمين"
  },
  {
    "number": 3142,
    "text": "وَمَا تَنَزَّلَتۡ بِهِ ٱلشَّيَٰطِينُ",
    "numberInSurah": 210,
    "juz": 19,
    "manzil": 5,
    "page": 376,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "وما تنزلت به الشياطين"
  },
  {
    "number": 3143,
    "text": "وَمَا يَنۢبَغِي لَهُمۡ وَمَا يَسۡتَطِيعُونَ",
    "numberInSurah": 211,
    "juz": 19,
    "manzil": 5,
    "page": 376,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "وما ينبغي لهم وما يستطيعون"
  },
  {
    "number": 3144,
    "text": "إِنَّهُمۡ عَنِ ٱلسَّمۡعِ لَمَعۡزُولُونَ",
    "numberInSurah": 212,
    "juz": 19,
    "manzil": 5,
    "page": 376,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "إنهم عن السمع لمعزولون"
  },
  {
    "number": 3145,
    "text": "فَلَا تَدۡعُ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَ فَتَكُونَ مِنَ ٱلۡمُعَذَّبِينَ",
    "numberInSurah": 213,
    "juz": 19,
    "manzil": 5,
    "page": 376,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "فلا تدع مع الله إلها آخر فتكون من المعذبين"
  },
  {
    "number": 3146,
    "text": "وَأَنذِرۡ عَشِيرَتَكَ ٱلۡأَقۡرَبِينَ",
    "numberInSurah": 214,
    "juz": 19,
    "manzil": 5,
    "page": 376,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "وأنذر عشيرتك الأقربين"
  },
  {
    "number": 3147,
    "text": "وَٱخۡفِضۡ جَنَاحَكَ لِمَنِ ٱتَّبَعَكَ مِنَ ٱلۡمُؤۡمِنِينَ",
    "numberInSurah": 215,
    "juz": 19,
    "manzil": 5,
    "page": 376,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "واخفض جناحك لمن اتبعك من المؤمنين"
  },
  {
    "number": 3148,
    "text": "فَإِنۡ عَصَوۡكَ فَقُلۡ إِنِّي بَرِيٓءٞ مِّمَّا تَعۡمَلُونَ",
    "numberInSurah": 216,
    "juz": 19,
    "manzil": 5,
    "page": 376,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "فإن عصوك فقل إني بريء مما تعملون"
  },
  {
    "number": 3149,
    "text": "وَتَوَكَّلۡ عَلَى ٱلۡعَزِيزِ ٱلرَّحِيمِ",
    "numberInSurah": 217,
    "juz": 19,
    "manzil": 5,
    "page": 376,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "وتوكل على العزيز الرحيم"
  },
  {
    "number": 3150,
    "text": "ٱلَّذِي يَرَىٰكَ حِينَ تَقُومُ",
    "numberInSurah": 218,
    "juz": 19,
    "manzil": 5,
    "page": 376,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "الذي يراك حين تقوم"
  },
  {
    "number": 3151,
    "text": "وَتَقَلُّبَكَ فِي ٱلسَّـٰجِدِينَ",
    "numberInSurah": 219,
    "juz": 19,
    "manzil": 5,
    "page": 376,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "وتقلبك في الساجدين"
  },
  {
    "number": 3152,
    "text": "إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلۡعَلِيمُ",
    "numberInSurah": 220,
    "juz": 19,
    "manzil": 5,
    "page": 376,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "إنه هو السميع العليم"
  },
  {
    "number": 3153,
    "text": "هَلۡ أُنَبِّئُكُمۡ عَلَىٰ مَن تَنَزَّلُ ٱلشَّيَٰطِينُ",
    "numberInSurah": 221,
    "juz": 19,
    "manzil": 5,
    "page": 376,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "هل أنبئكم على من تنزل الشياطين"
  },
  {
    "number": 3154,
    "text": "تَنَزَّلُ عَلَىٰ كُلِّ أَفَّاكٍ أَثِيمٖ",
    "numberInSurah": 222,
    "juz": 19,
    "manzil": 5,
    "page": 376,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "تنزل على كل أفاك أثيم"
  },
  {
    "number": 3155,
    "text": "يُلۡقُونَ ٱلسَّمۡعَ وَأَكۡثَرُهُمۡ كَٰذِبُونَ",
    "numberInSurah": 223,
    "juz": 19,
    "manzil": 5,
    "page": 376,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "يلقون السمع وأكثرهم كاذبون"
  },
  {
    "number": 3156,
    "text": "وَٱلشُّعَرَآءُ يَتَّبِعُهُمُ ٱلۡغَاوُۥنَ",
    "numberInSurah": 224,
    "juz": 19,
    "manzil": 5,
    "page": 376,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "والشعراء يتبعهم الغاوون"
  },
  {
    "number": 3157,
    "text": "أَلَمۡ تَرَ أَنَّهُمۡ فِي كُلِّ وَادٖ يَهِيمُونَ",
    "numberInSurah": 225,
    "juz": 19,
    "manzil": 5,
    "page": 376,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "ألم تر أنهم في كل واد يهيمون"
  },
  {
    "number": 3158,
    "text": "وَأَنَّهُمۡ يَقُولُونَ مَا لَا يَفۡعَلُونَ",
    "numberInSurah": 226,
    "juz": 19,
    "manzil": 5,
    "page": 376,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "وأنهم يقولون ما لا يفعلون"
  },
  {
    "number": 3159,
    "text": "إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ وَذَكَرُواْ ٱللَّهَ كَثِيرٗا وَٱنتَصَرُواْ مِنۢ بَعۡدِ مَا ظُلِمُواْۗ وَسَيَعۡلَمُ ٱلَّذِينَ ظَلَمُوٓاْ أَيَّ مُنقَلَبٖ يَنقَلِبُونَ",
    "numberInSurah": 227,
    "juz": 19,
    "manzil": 5,
    "page": 376,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "إلا الذين آمنوا وعملوا الصالحات وذكروا الله كثيرا وانتصروا من بعد ما ظلموا وسيعلم الذين ظلموا أي منقلب ينقلبون"
  }
