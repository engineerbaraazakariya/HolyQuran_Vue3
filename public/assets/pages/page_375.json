[
  {
    "number": 3116,
    "text": "وَٱتَّقُواْ ٱلَّذِي خَلَقَكُمۡ وَٱلۡجِبِلَّةَ ٱلۡأَوَّلِينَ",
    "numberInSurah": 184,
    "juz": 19,
    "manzil": 5,
    "page": 375,
    "ruku": 325,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "واتقوا الذي خلقكم والجبلة الأولين"
  },
  {
    "number": 3117,
    "text": "قَالُوٓاْ إِنَّمَآ أَنتَ مِنَ ٱلۡمُسَحَّرِينَ",
    "numberInSurah": 185,
    "juz": 19,
    "manzil": 5,
    "page": 375,
    "ruku": 325,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "قالوا إنما أنت من المسحرين"
  },
  {
    "number": 3118,
    "text": "وَمَآ أَنتَ إِلَّا بَشَرٞ مِّثۡلُنَا وَإِن نَّظُنُّكَ لَمِنَ ٱلۡكَٰذِبِينَ",
    "numberInSurah": 186,
    "juz": 19,
    "manzil": 5,
    "page": 375,
    "ruku": 325,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "وما أنت إلا بشر مثلنا وإن نظنك لمن الكاذبين"
  },
  {
    "number": 3119,
    "text": "فَأَسۡقِطۡ عَلَيۡنَا كِسَفٗا مِّنَ ٱلسَّمَآءِ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ",
    "numberInSurah": 187,
    "juz": 19,
    "manzil": 5,
    "page": 375,
    "ruku": 325,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "فأسقط علينا كسفا من السماء إن كنت من الصادقين"
  },
  {
    "number": 3120,
    "text": "قَالَ رَبِّيٓ أَعۡلَمُ بِمَا تَعۡمَلُونَ",
    "numberInSurah": 188,
    "juz": 19,
    "manzil": 5,
    "page": 375,
    "ruku": 325,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "قال ربي أعلم بما تعملون"
  },
  {
    "number": 3121,
    "text": "فَكَذَّبُوهُ فَأَخَذَهُمۡ عَذَابُ يَوۡمِ ٱلظُّلَّةِۚ إِنَّهُۥ كَانَ عَذَابَ يَوۡمٍ عَظِيمٍ",
    "numberInSurah": 189,
    "juz": 19,
    "manzil": 5,
    "page": 375,
    "ruku": 325,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "فكذبوه فأخذهم عذاب يوم الظلة إنه كان عذاب يوم عظيم"
  },
  {
    "number": 3122,
    "text": "إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ",
    "numberInSurah": 190,
    "juz": 19,
    "manzil": 5,
    "page": 375,
    "ruku": 325,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "إن في ذلك لآية وما كان أكثرهم مؤمنين"
  },
  {
    "number": 3123,
    "text": "وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ",
    "numberInSurah": 191,
    "juz": 19,
    "manzil": 5,
    "page": 375,
    "ruku": 325,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "وإن ربك لهو العزيز الرحيم"
  },
  {
    "number": 3124,
    "text": "وَإِنَّهُۥ لَتَنزِيلُ رَبِّ ٱلۡعَٰلَمِينَ",
    "numberInSurah": 192,
    "juz": 19,
    "manzil": 5,
    "page": 375,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "وإنه لتنزيل رب العالمين"
  },
  {
    "number": 3125,
    "text": "نَزَلَ بِهِ ٱلرُّوحُ ٱلۡأَمِينُ",
    "numberInSurah": 193,
    "juz": 19,
    "manzil": 5,
    "page": 375,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "نزل به الروح الأمين"
  },
  {
    "number": 3126,
    "text": "عَلَىٰ قَلۡبِكَ لِتَكُونَ مِنَ ٱلۡمُنذِرِينَ",
    "numberInSurah": 194,
    "juz": 19,
    "manzil": 5,
    "page": 375,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "على قلبك لتكون من المنذرين"
  },
  {
    "number": 3127,
    "text": "بِلِسَانٍ عَرَبِيّٖ مُّبِينٖ",
    "numberInSurah": 195,
    "juz": 19,
    "manzil": 5,
    "page": 375,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "بلسان عربي مبين"
  },
  {
    "number": 3128,
    "text": "وَإِنَّهُۥ لَفِي زُبُرِ ٱلۡأَوَّلِينَ",
    "numberInSurah": 196,
    "juz": 19,
    "manzil": 5,
    "page": 375,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "وإنه لفي زبر الأولين"
  },
  {
    "number": 3129,
    "text": "أَوَلَمۡ يَكُن لَّهُمۡ ءَايَةً أَن يَعۡلَمَهُۥ عُلَمَـٰٓؤُاْ بَنِيٓ إِسۡرَـٰٓءِيلَ",
    "numberInSurah": 197,
    "juz": 19,
    "manzil": 5,
    "page": 375,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "أولم يكن لهم آية أن يعلمه علماء بني إسرائيل"
  },
  {
    "number": 3130,
    "text": "وَلَوۡ نَزَّلۡنَٰهُ عَلَىٰ بَعۡضِ ٱلۡأَعۡجَمِينَ",
    "numberInSurah": 198,
    "juz": 19,
    "manzil": 5,
    "page": 375,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "ولو نزلناه على بعض الأعجمين"
  },
  {
    "number": 3131,
    "text": "فَقَرَأَهُۥ عَلَيۡهِم مَّا كَانُواْ بِهِۦ مُؤۡمِنِينَ",
    "numberInSurah": 199,
    "juz": 19,
    "manzil": 5,
    "page": 375,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "فقرأه عليهم ما كانوا به مؤمنين"
  },
  {
    "number": 3132,
    "text": "كَذَٰلِكَ سَلَكۡنَٰهُ فِي قُلُوبِ ٱلۡمُجۡرِمِينَ",
    "numberInSurah": 200,
    "juz": 19,
    "manzil": 5,
    "page": 375,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "كذلك سلكناه في قلوب المجرمين"
  },
  {
    "number": 3133,
    "text": "لَا يُؤۡمِنُونَ بِهِۦ حَتَّىٰ يَرَوُاْ ٱلۡعَذَابَ ٱلۡأَلِيمَ",
    "numberInSurah": 201,
    "juz": 19,
    "manzil": 5,
    "page": 375,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "لا يؤمنون به حتى يروا العذاب الأليم"
  },
  {
    "number": 3134,
    "text": "فَيَأۡتِيَهُم بَغۡتَةٗ وَهُمۡ لَا يَشۡعُرُونَ",
    "numberInSurah": 202,
    "juz": 19,
    "manzil": 5,
    "page": 375,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "فيأتيهم بغتة وهم لا يشعرون"
  },
  {
    "number": 3135,
    "text": "فَيَقُولُواْ هَلۡ نَحۡنُ مُنظَرُونَ",
    "numberInSurah": 203,
    "juz": 19,
    "manzil": 5,
    "page": 375,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "فيقولوا هل نحن منظرون"
  },
  {
    "number": 3136,
    "text": "أَفَبِعَذَابِنَا يَسۡتَعۡجِلُونَ",
    "numberInSurah": 204,
    "juz": 19,
    "manzil": 5,
    "page": 375,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "أفبعذابنا يستعجلون"
  },
  {
    "number": 3137,
    "text": "أَفَرَءَيۡتَ إِن مَّتَّعۡنَٰهُمۡ سِنِينَ",
    "numberInSurah": 205,
    "juz": 19,
    "manzil": 5,
    "page": 375,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "أفرأيت إن متعناهم سنين"
  },
  {
    "number": 3138,
    "text": "ثُمَّ جَآءَهُم مَّا كَانُواْ يُوعَدُونَ",
    "numberInSurah": 206,
    "juz": 19,
    "manzil": 5,
    "page": 375,
    "ruku": 326,
    "hizbQuarter": 150,
    "sajda": false,
    "no_Tashkeel_text": "ثم جاءهم ما كانوا يوعدون"
  }
