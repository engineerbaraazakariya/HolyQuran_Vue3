[
  {
    "number": 5386,
    "text": "يُبَصَّرُونَهُمۡۚ يَوَدُّ ٱلۡمُجۡرِمُ لَوۡ يَفۡتَدِي مِنۡ عَذَابِ يَوۡمِئِذِۭ بِبَنِيهِ",
    "numberInSurah": 11,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 227,
    "sajda": false,
    "no_Tashkeel_text": "يبصرونهم يود المجرم لو يفتدي من عذاب يومئذ ببنيه"
  },
  {
    "number": 5387,
    "text": "وَصَٰحِبَتِهِۦ وَأَخِيهِ",
    "numberInSurah": 12,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 227,
    "sajda": false,
    "no_Tashkeel_text": "وصاحبته وأخيه"
  },
  {
    "number": 5388,
    "text": "وَفَصِيلَتِهِ ٱلَّتِي تُـٔۡوِيهِ",
    "numberInSurah": 13,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 227,
    "sajda": false,
    "no_Tashkeel_text": "وفصيلته التي تؤويه"
  },
  {
    "number": 5389,
    "text": "وَمَن فِي ٱلۡأَرۡضِ جَمِيعٗا ثُمَّ يُنجِيهِ",
    "numberInSurah": 14,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 227,
    "sajda": false,
    "no_Tashkeel_text": "ومن في الأرض جميعا ثم ينجيه"
  },
  {
    "number": 5390,
    "text": "كَلَّآۖ إِنَّهَا لَظَىٰ",
    "numberInSurah": 15,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 227,
    "sajda": false,
    "no_Tashkeel_text": "كلا إنها لظى"
  },
  {
    "number": 5391,
    "text": "نَزَّاعَةٗ لِّلشَّوَىٰ",
    "numberInSurah": 16,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 227,
    "sajda": false,
    "no_Tashkeel_text": "نزاعة للشوى"
  },
  {
    "number": 5392,
    "text": "تَدۡعُواْ مَنۡ أَدۡبَرَ وَتَوَلَّىٰ",
    "numberInSurah": 17,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 227,
    "sajda": false,
    "no_Tashkeel_text": "تدعو من أدبر وتولى"
  },
  {
    "number": 5393,
    "text": "وَجَمَعَ فَأَوۡعَىٰٓ",
    "numberInSurah": 18,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 227,
    "sajda": false,
    "no_Tashkeel_text": "وجمع فأوعى"
  },
  {
    "number": 5394,
    "text": "۞إِنَّ ٱلۡإِنسَٰنَ خُلِقَ هَلُوعًا",
    "numberInSurah": 19,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 228,
    "sajda": false,
    "no_Tashkeel_text": "إن الإنسان خلق هلوعا"
  },
  {
    "number": 5395,
    "text": "إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعٗا",
    "numberInSurah": 20,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 228,
    "sajda": false,
    "no_Tashkeel_text": "إذا مسه الشر جزوعا"
  },
  {
    "number": 5396,
    "text": "وَإِذَا مَسَّهُ ٱلۡخَيۡرُ مَنُوعًا",
    "numberInSurah": 21,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 228,
    "sajda": false,
    "no_Tashkeel_text": "وإذا مسه الخير منوعا"
  },
  {
    "number": 5397,
    "text": "إِلَّا ٱلۡمُصَلِّينَ",
    "numberInSurah": 22,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 228,
    "sajda": false,
    "no_Tashkeel_text": "إلا المصلين"
  },
  {
    "number": 5398,
    "text": "ٱلَّذِينَ هُمۡ عَلَىٰ صَلَاتِهِمۡ دَآئِمُونَ",
    "numberInSurah": 23,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 228,
    "sajda": false,
    "no_Tashkeel_text": "الذين هم على صلاتهم دائمون"
  },
  {
    "number": 5399,
    "text": "وَٱلَّذِينَ فِيٓ أَمۡوَٰلِهِمۡ حَقّٞ مَّعۡلُومٞ",
    "numberInSurah": 24,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 228,
    "sajda": false,
    "no_Tashkeel_text": "والذين في أموالهم حق معلوم"
  },
  {
    "number": 5400,
    "text": "لِّلسَّآئِلِ وَٱلۡمَحۡرُومِ",
    "numberInSurah": 25,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 228,
    "sajda": false,
    "no_Tashkeel_text": "للسائل والمحروم"
  },
  {
    "number": 5401,
    "text": "وَٱلَّذِينَ يُصَدِّقُونَ بِيَوۡمِ ٱلدِّينِ",
    "numberInSurah": 26,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 228,
    "sajda": false,
    "no_Tashkeel_text": "والذين يصدقون بيوم الدين"
  },
  {
    "number": 5402,
    "text": "وَٱلَّذِينَ هُم مِّنۡ عَذَابِ رَبِّهِم مُّشۡفِقُونَ",
    "numberInSurah": 27,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 228,
    "sajda": false,
    "no_Tashkeel_text": "والذين هم من عذاب ربهم مشفقون"
  },
  {
    "number": 5403,
    "text": "إِنَّ عَذَابَ رَبِّهِمۡ غَيۡرُ مَأۡمُونٖ",
    "numberInSurah": 28,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 228,
    "sajda": false,
    "no_Tashkeel_text": "إن عذاب ربهم غير مأمون"
  },
  {
    "number": 5404,
    "text": "وَٱلَّذِينَ هُمۡ لِفُرُوجِهِمۡ حَٰفِظُونَ",
    "numberInSurah": 29,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 228,
    "sajda": false,
    "no_Tashkeel_text": "والذين هم لفروجهم حافظون"
  },
  {
    "number": 5405,
    "text": "إِلَّا عَلَىٰٓ أَزۡوَٰجِهِمۡ أَوۡ مَا مَلَكَتۡ أَيۡمَٰنُهُمۡ فَإِنَّهُمۡ غَيۡرُ مَلُومِينَ",
    "numberInSurah": 30,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 228,
    "sajda": false,
    "no_Tashkeel_text": "إلا على أزواجهم أو ما ملكت أيمانهم فإنهم غير ملومين"
  },
  {
    "number": 5406,
    "text": "فَمَنِ ٱبۡتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُوْلَـٰٓئِكَ هُمُ ٱلۡعَادُونَ",
    "numberInSurah": 31,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 228,
    "sajda": false,
    "no_Tashkeel_text": "فمن ابتغى وراء ذلك فأولئك هم العادون"
  },
  {
    "number": 5407,
    "text": "وَٱلَّذِينَ هُمۡ لِأَمَٰنَٰتِهِمۡ وَعَهۡدِهِمۡ رَٰعُونَ",
    "numberInSurah": 32,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 228,
    "sajda": false,
    "no_Tashkeel_text": "والذين هم لأماناتهم وعهدهم راعون"
  },
  {
    "number": 5408,
    "text": "وَٱلَّذِينَ هُم بِشَهَٰدَٰتِهِمۡ قَآئِمُونَ",
    "numberInSurah": 33,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 228,
    "sajda": false,
    "no_Tashkeel_text": "والذين هم بشهاداتهم قائمون"
  },
  {
    "number": 5409,
    "text": "وَٱلَّذِينَ هُمۡ عَلَىٰ صَلَاتِهِمۡ يُحَافِظُونَ",
    "numberInSurah": 34,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 228,
    "sajda": false,
    "no_Tashkeel_text": "والذين هم على صلاتهم يحافظون"
  },
  {
    "number": 5410,
    "text": "أُوْلَـٰٓئِكَ فِي جَنَّـٰتٖ مُّكۡرَمُونَ",
    "numberInSurah": 35,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 502,
    "hizbQuarter": 228,
    "sajda": false,
    "no_Tashkeel_text": "أولئك في جنات مكرمون"
  },
  {
    "number": 5411,
    "text": "فَمَالِ ٱلَّذِينَ كَفَرُواْ قِبَلَكَ مُهۡطِعِينَ",
    "numberInSurah": 36,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 503,
    "hizbQuarter": 228,
    "sajda": false,
    "no_Tashkeel_text": "فمال الذين كفروا قبلك مهطعين"
  },
  {
    "number": 5412,
    "text": "عَنِ ٱلۡيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ",
    "numberInSurah": 37,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 503,
    "hizbQuarter": 228,
    "sajda": false,
    "no_Tashkeel_text": "عن اليمين وعن الشمال عزين"
  },
  {
    "number": 5413,
    "text": "أَيَطۡمَعُ كُلُّ ٱمۡرِيٕٖ مِّنۡهُمۡ أَن يُدۡخَلَ جَنَّةَ نَعِيمٖ",
    "numberInSurah": 38,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 503,
    "hizbQuarter": 228,
    "sajda": false,
    "no_Tashkeel_text": "أيطمع كل امرئ منهم أن يدخل جنة نعيم"
  },
  {
    "number": 5414,
    "text": "كَلَّآۖ إِنَّا خَلَقۡنَٰهُم مِّمَّا يَعۡلَمُونَ",
    "numberInSurah": 39,
    "juz": 29,
    "manzil": 7,
    "page": 569,
    "ruku": 503,
    "hizbQuarter": 228,
    "sajda": false,
    "no_Tashkeel_text": "كلا إنا خلقناهم مما يعلمون"
  }
]