[
  {
    "number": 5543,
    "text": "فَمَا تَنفَعُهُمۡ شَفَٰعَةُ ٱلشَّـٰفِعِينَ",
    "numberInSurah": 48,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 511,
    "hizbQuarter": 230,
    "sajda": false,
    "no_Tashkeel_text": "فما تنفعهم شفاعة الشافعين"
  },
  {
    "number": 5544,
    "text": "فَمَا لَهُمۡ عَنِ ٱلتَّذۡكِرَةِ مُعۡرِضِينَ",
    "numberInSurah": 49,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 511,
    "hizbQuarter": 230,
    "sajda": false,
    "no_Tashkeel_text": "فما لهم عن التذكرة معرضين"
  },
  {
    "number": 5545,
    "text": "كَأَنَّهُمۡ حُمُرٞ مُّسۡتَنفِرَةٞ",
    "numberInSurah": 50,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 511,
    "hizbQuarter": 230,
    "sajda": false,
    "no_Tashkeel_text": "كأنهم حمر مستنفرة"
  },
  {
    "number": 5546,
    "text": "فَرَّتۡ مِن قَسۡوَرَةِۭ",
    "numberInSurah": 51,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 511,
    "hizbQuarter": 230,
    "sajda": false,
    "no_Tashkeel_text": "فرت من قسورة"
  },
  {
    "number": 5547,
    "text": "بَلۡ يُرِيدُ كُلُّ ٱمۡرِيٕٖ مِّنۡهُمۡ أَن يُؤۡتَىٰ صُحُفٗا مُّنَشَّرَةٗ",
    "numberInSurah": 52,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 511,
    "hizbQuarter": 230,
    "sajda": false,
    "no_Tashkeel_text": "بل يريد كل امرئ منهم أن يؤتى صحفا منشرة"
  },
  {
    "number": 5548,
    "text": "كَلَّاۖ بَل لَّا يَخَافُونَ ٱلۡأٓخِرَةَ",
    "numberInSurah": 53,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 511,
    "hizbQuarter": 230,
    "sajda": false,
    "no_Tashkeel_text": "كلا بل لا يخافون الآخرة"
  },
  {
    "number": 5549,
    "text": "كَلَّآ إِنَّهُۥ تَذۡكِرَةٞ",
    "numberInSurah": 54,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 511,
    "hizbQuarter": 230,
    "sajda": false,
    "no_Tashkeel_text": "كلا إنه تذكرة"
  },
  {
    "number": 5550,
    "text": "فَمَن شَآءَ ذَكَرَهُۥ",
    "numberInSurah": 55,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 511,
    "hizbQuarter": 230,
    "sajda": false,
    "no_Tashkeel_text": "فمن شاء ذكره"
  },
  {
    "number": 5551,
    "text": "وَمَا يَذۡكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ هُوَ أَهۡلُ ٱلتَّقۡوَىٰ وَأَهۡلُ ٱلۡمَغۡفِرَةِ",
    "numberInSurah": 56,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 511,
    "hizbQuarter": 230,
    "sajda": false,
    "no_Tashkeel_text": "وما يذكرون إلا أن يشاء الله هو أهل التقوى وأهل المغفرة"
  },
  {
    "number": 5552,
    "text": "لَآ أُقۡسِمُ بِيَوۡمِ ٱلۡقِيَٰمَةِ",
    "numberInSurah": 1,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم لا أقسم بيوم القيامة"
  },
  {
    "number": 5553,
    "text": "وَلَآ أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ",
    "numberInSurah": 2,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "ولا أقسم بالنفس اللوامة"
  },
  {
    "number": 5554,
    "text": "أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ",
    "numberInSurah": 3,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "أيحسب الإنسان ألن نجمع عظامه"
  },
  {
    "number": 5555,
    "text": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّيَ بَنَانَهُۥ",
    "numberInSurah": 4,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "بلى قادرين على أن نسوي بنانه"
  },
  {
    "number": 5556,
    "text": "بَلۡ يُرِيدُ ٱلۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ",
    "numberInSurah": 5,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "بل يريد الإنسان ليفجر أمامه"
  },
  {
    "number": 5557,
    "text": "يَسۡـَٔلُ أَيَّانَ يَوۡمُ ٱلۡقِيَٰمَةِ",
    "numberInSurah": 6,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "يسأل أيان يوم القيامة"
  },
  {
    "number": 5558,
    "text": "فَإِذَا بَرِقَ ٱلۡبَصَرُ",
    "numberInSurah": 7,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "فإذا برق البصر"
  },
  {
    "number": 5559,
    "text": "وَخَسَفَ ٱلۡقَمَرُ",
    "numberInSurah": 8,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "وخسف القمر"
  },
  {
    "number": 5560,
    "text": "وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ",
    "numberInSurah": 9,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "وجمع الشمس والقمر"
  },
  {
    "number": 5561,
    "text": "يَقُولُ ٱلۡإِنسَٰنُ يَوۡمَئِذٍ أَيۡنَ ٱلۡمَفَرُّ",
    "numberInSurah": 10,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "يقول الإنسان يومئذ أين المفر"
  },
  {
    "number": 5562,
    "text": "كَلَّا لَا وَزَرَ",
    "numberInSurah": 11,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "كلا لا وزر"
  },
  {
    "number": 5563,
    "text": "إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمُسۡتَقَرُّ",
    "numberInSurah": 12,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "إلى ربك يومئذ المستقر"
  },
  {
    "number": 5564,
    "text": "يُنَبَّؤُاْ ٱلۡإِنسَٰنُ يَوۡمَئِذِۭ بِمَا قَدَّمَ وَأَخَّرَ",
    "numberInSurah": 13,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "ينبأ الإنسان يومئذ بما قدم وأخر"
  },
  {
    "number": 5565,
    "text": "بَلِ ٱلۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةٞ",
    "numberInSurah": 14,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "بل الإنسان على نفسه بصيرة"
  },
  {
    "number": 5566,
    "text": "وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ",
    "numberInSurah": 15,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "ولو ألقى معاذيره"
  },
  {
    "number": 5567,
    "text": "لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦٓ",
    "numberInSurah": 16,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "لا تحرك به لسانك لتعجل به"
  },
  {
    "number": 5568,
    "text": "إِنَّ عَلَيۡنَا جَمۡعَهُۥ وَقُرۡءَانَهُۥ",
    "numberInSurah": 17,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "إن علينا جمعه وقرآنه"
  },
  {
    "number": 5569,
    "text": "فَإِذَا قَرَأۡنَٰهُ فَٱتَّبِعۡ قُرۡءَانَهُۥ",
    "numberInSurah": 18,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "فإذا قرأناه فاتبع قرآنه"
  },
  {
    "number": 5570,
    "text": "ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ",
    "numberInSurah": 19,
    "juz": 29,
    "manzil": 7,
    "page": 577,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "ثم إن علينا بيانه"
  }
]