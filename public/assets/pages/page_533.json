    "page": 533,
    "ruku": 467,
    "hizbQuarter": 213,
    "sajda": false,
    "no_Tashkeel_text": "هذه جهنم التي يكذب بها المجرمون"
  },
  {
    "number": 4945,
    "text": "يَطُوفُونَ بَيۡنَهَا وَبَيۡنَ حَمِيمٍ ءَانٖ",
