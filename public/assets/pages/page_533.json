[
  {
    "number": 4942,
    "text": "يُعۡرَفُ ٱلۡمُجۡرِمُونَ بِسِيمَٰهُمۡ فَيُؤۡخَذُ بِٱلنَّوَٰصِي وَٱلۡأَقۡدَامِ",
    "numberInSurah": 41,
    "juz": 27,
    "manzil": 7,
    "page": 533,
    "ruku": 467,
    "hizbQuarter": 213,
    "sajda": false,
    "no_Tashkeel_text": "يعرف المجرمون بسيماهم فيؤخذ بالنواصي والأقدام"
  },
  {
    "number": 4943,
    "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
