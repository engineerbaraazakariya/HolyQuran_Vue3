    "ruku": 467,
    "hizbQuarter": 213,
    "sajda": false,
    "no_Tashkeel_text": "فبأي آلاء ربكما تكذبان"
  },
  {
    "number": 4944,
    "text": "هَٰذِهِۦ جَهَنَّمُ ٱلَّتِي يُكَذِّبُ بِهَا ٱلۡمُجۡرِمُونَ",
