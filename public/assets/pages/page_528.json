[
  {
    "number": 4829,
    "text": "وَأَنَّهُۥ خَلَقَ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰ",
    "numberInSurah": 45,
    "juz": 27,
    "manzil": 7,
    "page": 528,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "وأنه خلق الزوجين الذكر والأنثى"
  },
  {
    "number": 4830,
    "text": "مِن نُّطۡفَةٍ إِذَا تُمۡنَىٰ",
    "numberInSurah": 46,
    "juz": 27,
    "manzil": 7,
    "page": 528,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "من نطفة إذا تمنى"
  },
  {
    "number": 4831,
    "text": "وَأَنَّ عَلَيۡهِ ٱلنَّشۡأَةَ ٱلۡأُخۡرَىٰ",
    "numberInSurah": 47,
    "juz": 27,
    "manzil": 7,
    "page": 528,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "وأن عليه النشأة الأخرى"
  },
  {
    "number": 4832,
    "text": "وَأَنَّهُۥ هُوَ أَغۡنَىٰ وَأَقۡنَىٰ",
    "numberInSurah": 48,
    "juz": 27,
    "manzil": 7,
    "page": 528,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "وأنه هو أغنى وأقنى"
  },
  {
    "number": 4833,
    "text": "وَأَنَّهُۥ هُوَ رَبُّ ٱلشِّعۡرَىٰ",
    "numberInSurah": 49,
    "juz": 27,
    "manzil": 7,
    "page": 528,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "وأنه هو رب الشعرى"
  },
  {
    "number": 4834,
    "text": "وَأَنَّهُۥٓ أَهۡلَكَ عَادًا ٱلۡأُولَىٰ",
    "numberInSurah": 50,
    "juz": 27,
    "manzil": 7,
    "page": 528,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "وأنه أهلك عادا الأولى"
  },
  {
    "number": 4835,
    "text": "وَثَمُودَاْ فَمَآ أَبۡقَىٰ",
    "numberInSurah": 51,
    "juz": 27,
    "manzil": 7,
    "page": 528,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "وثمود فما أبقى"
  },
  {
    "number": 4836,
    "text": "وَقَوۡمَ نُوحٖ مِّن قَبۡلُۖ إِنَّهُمۡ كَانُواْ هُمۡ أَظۡلَمَ وَأَطۡغَىٰ",
    "numberInSurah": 52,
    "juz": 27,
    "manzil": 7,
    "page": 528,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "وقوم نوح من قبل إنهم كانوا هم أظلم وأطغى"
  },
  {
    "number": 4837,
    "text": "وَٱلۡمُؤۡتَفِكَةَ أَهۡوَىٰ",
    "numberInSurah": 53,
    "juz": 27,
    "manzil": 7,
    "page": 528,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "والمؤتفكة أهوى"
  },
  {
    "number": 4838,
    "text": "فَغَشَّىٰهَا مَا غَشَّىٰ",
    "numberInSurah": 54,
    "juz": 27,
    "manzil": 7,
    "page": 528,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "فغشاها ما غشى"
  },
  {
    "number": 4839,
    "text": "فَبِأَيِّ ءَالَآءِ رَبِّكَ تَتَمَارَىٰ",
    "numberInSurah": 55,
    "juz": 27,
    "manzil": 7,
    "page": 528,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "فبأي آلاء ربك تتمارى"
  },
  {
    "number": 4840,
    "text": "هَٰذَا نَذِيرٞ مِّنَ ٱلنُّذُرِ ٱلۡأُولَىٰٓ",
    "numberInSurah": 56,
    "juz": 27,
    "manzil": 7,
    "page": 528,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "هذا نذير من النذر الأولى"
  },
  {
    "number": 4841,
    "text": "أَزِفَتِ ٱلۡأٓزِفَةُ",
    "numberInSurah": 57,
    "juz": 27,
    "manzil": 7,
    "page": 528,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "أزفت الآزفة"
  },
  {
    "number": 4842,
    "text": "لَيۡسَ لَهَا مِن دُونِ ٱللَّهِ كَاشِفَةٌ",
    "numberInSurah": 58,
    "juz": 27,
    "manzil": 7,
    "page": 528,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "ليس لها من دون الله كاشفة"
  },
  {
    "number": 4843,
    "text": "أَفَمِنۡ هَٰذَا ٱلۡحَدِيثِ تَعۡجَبُونَ",
    "numberInSurah": 59,
    "juz": 27,
    "manzil": 7,
    "page": 528,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "أفمن هذا الحديث تعجبون"
  },
  {
    "number": 4844,
    "text": "وَتَضۡحَكُونَ وَلَا تَبۡكُونَ",
    "numberInSurah": 60,
    "juz": 27,
    "manzil": 7,
    "page": 528,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "وتضحكون ولا تبكون"
  },
  {
    "number": 4845,
    "text": "وَأَنتُمۡ سَٰمِدُونَ",
    "numberInSurah": 61,
    "juz": 27,
    "manzil": 7,
    "page": 528,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "وأنتم سامدون"
  },
  {
    "number": 4846,
    "text": "فَٱسۡجُدُواْۤ لِلَّهِۤ وَٱعۡبُدُواْ۩",
    "numberInSurah": 62,
    "juz": 27,
    "manzil": 7,
    "page": 528,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": {
      "id": 13,
      "recommended": false,
      "obligatory": true
    },
    "no_Tashkeel_text": "فاسجدوا لله واعبدوا"
  },
  {
    "number": 4847,
    "text": "ٱقۡتَرَبَتِ ٱلسَّاعَةُ وَٱنشَقَّ ٱلۡقَمَرُ",
    "numberInSurah": 1,
    "juz": 27,
    "manzil": 7,
    "page": 528,
    "ruku": 463,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم اقتربت الساعة وانشق القمر"
  },
  {
    "number": 4848,
    "text": "وَإِن يَرَوۡاْ ءَايَةٗ يُعۡرِضُواْ وَيَقُولُواْ سِحۡرٞ مُّسۡتَمِرّٞ",
    "numberInSurah": 2,
    "juz": 27,
    "manzil": 7,
    "page": 528,
    "ruku": 463,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "وإن يروا آية يعرضوا ويقولوا سحر مستمر"
  },
  {
    "number": 4849,
    "text": "وَكَذَّبُواْ وَٱتَّبَعُوٓاْ أَهۡوَآءَهُمۡۚ وَكُلُّ أَمۡرٖ مُّسۡتَقِرّٞ",
    "numberInSurah": 3,
    "juz": 27,
    "manzil": 7,
    "page": 528,
    "ruku": 463,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "وكذبوا واتبعوا أهواءهم وكل أمر مستقر"
  },
  {
    "number": 4850,
    "text": "وَلَقَدۡ جَآءَهُم مِّنَ ٱلۡأَنۢبَآءِ مَا فِيهِ مُزۡدَجَرٌ",
    "numberInSurah": 4,
    "juz": 27,
    "manzil": 7,
    "page": 528,
    "ruku": 463,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "ولقد جاءهم من الأنباء ما فيه مزدجر"
  },
  {
    "number": 4851,
    "text": "حِكۡمَةُۢ بَٰلِغَةٞۖ فَمَا تُغۡنِ ٱلنُّذُرُ",
    "numberInSurah": 5,
    "juz": 27,
    "manzil": 7,
    "page": 528,
    "ruku": 463,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "حكمة بالغة فما تغن النذر"
  },
  {
    "number": 4852,
    "text": "فَتَوَلَّ عَنۡهُمۡۘ يَوۡمَ يَدۡعُ ٱلدَّاعِ إِلَىٰ شَيۡءٖ نُّكُرٍ",
    "numberInSurah": 6,
    "juz": 27,
    "manzil": 7,
    "page": 528,
    "ruku": 463,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "فتول عنهم يوم يدع الداع إلى شيء نكر"
  }
]