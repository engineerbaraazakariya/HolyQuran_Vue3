    "juz": 23,
    "manzil": 6,
    "page": 450,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "وباركنا عليه وعلى إسحاق ومن ذريتهما محسن وظالم لنفسه مبين"
  },
  {
    "number": 3902,
    "text": "وَلَقَدۡ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَٰرُونَ",
