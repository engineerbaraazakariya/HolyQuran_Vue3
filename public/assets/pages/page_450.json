[
  {
    "number": 3891,
    "text": "فَلَمَّآ أَسۡلَمَا وَتَلَّهُۥ لِلۡجَبِينِ",
    "numberInSurah": 103,
    "juz": 23,
    "manzil": 6,
    "page": 450,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "فلما أسلما وتله للجبين"
  },
  {
    "number": 3892,
    "text": "وَنَٰدَيۡنَٰهُ أَن يَـٰٓإِبۡرَٰهِيمُ",
    "numberInSurah": 104,
    "juz": 23,
    "manzil": 6,
    "page": 450,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "وناديناه أن يا إبراهيم"
  },
  {
    "number": 3893,
    "text": "قَدۡ صَدَّقۡتَ ٱلرُّءۡيَآۚ إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ",
    "numberInSurah": 105,
    "juz": 23,
    "manzil": 6,
    "page": 450,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "قد صدقت الرؤيا إنا كذلك نجزي المحسنين"
  },
  {
    "number": 3894,
    "text": "إِنَّ هَٰذَا لَهُوَ ٱلۡبَلَـٰٓؤُاْ ٱلۡمُبِينُ",
    "numberInSurah": 106,
    "juz": 23,
    "manzil": 6,
    "page": 450,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
