  },
  {
    "number": 3895,
    "text": "وَفَدَيۡنَٰهُ بِذِبۡحٍ عَظِيمٖ",
    "numberInSurah": 107,
    "juz": 23,
    "manzil": 6,
    "page": 450,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "وفديناه بذبح عظيم"
  },
  {
    "number": 3896,
    "text": "وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ",
