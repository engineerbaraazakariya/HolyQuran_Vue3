    "ruku": 389,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "ولقد مننا على موسى وهارون"
  },
  {
    "number": 3903,
    "text": "وَنَجَّيۡنَٰهُمَا وَقَوۡمَهُمَا مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ",
