[
  {
    "number": 3044,
    "text": "قَالَ وَمَا عِلۡمِي بِمَا كَانُواْ يَعۡمَلُونَ",
    "numberInSurah": 112,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 321,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "قال وما علمي بما كانوا يعملون"
  },
  {
    "number": 3045,
    "text": "إِنۡ حِسَابُهُمۡ إِلَّا عَلَىٰ رَبِّيۖ لَوۡ تَشۡعُرُونَ",
    "numberInSurah": 113,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 321,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "إن حسابهم إلا على ربي لو تشعرون"
  },
  {
    "number": 3046,
    "text": "وَمَآ أَنَا۠ بِطَارِدِ ٱلۡمُؤۡمِنِينَ",
    "numberInSurah": 114,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 321,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "وما أنا بطارد المؤمنين"
  },
  {
    "number": 3047,
    "text": "إِنۡ أَنَا۠ إِلَّا نَذِيرٞ مُّبِينٞ",
    "numberInSurah": 115,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 321,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "إن أنا إلا نذير مبين"
  },
  {
    "number": 3048,
    "text": "قَالُواْ لَئِن لَّمۡ تَنتَهِ يَٰنُوحُ لَتَكُونَنَّ مِنَ ٱلۡمَرۡجُومِينَ",
    "numberInSurah": 116,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 321,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "قالوا لئن لم تنته يا نوح لتكونن من المرجومين"
  },
  {
    "number": 3049,
    "text": "قَالَ رَبِّ إِنَّ قَوۡمِي كَذَّبُونِ",
    "numberInSurah": 117,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 321,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "قال رب إن قومي كذبون"
  },
  {
    "number": 3050,
    "text": "فَٱفۡتَحۡ بَيۡنِي وَبَيۡنَهُمۡ فَتۡحٗا وَنَجِّنِي وَمَن مَّعِيَ مِنَ ٱلۡمُؤۡمِنِينَ",
    "numberInSurah": 118,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 321,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "فافتح بيني وبينهم فتحا ونجني ومن معي من المؤمنين"
  },
  {
    "number": 3051,
    "text": "فَأَنجَيۡنَٰهُ وَمَن مَّعَهُۥ فِي ٱلۡفُلۡكِ ٱلۡمَشۡحُونِ",
    "numberInSurah": 119,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 321,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "فأنجيناه ومن معه في الفلك المشحون"
  },
  {
    "number": 3052,
    "text": "ثُمَّ أَغۡرَقۡنَا بَعۡدُ ٱلۡبَاقِينَ",
    "numberInSurah": 120,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 321,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "ثم أغرقنا بعد الباقين"
  },
  {
    "number": 3053,
    "text": "إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ",
    "numberInSurah": 121,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 321,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "إن في ذلك لآية وما كان أكثرهم مؤمنين"
  },
  {
    "number": 3054,
    "text": "وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ",
    "numberInSurah": 122,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 321,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "وإن ربك لهو العزيز الرحيم"
  },
  {
    "number": 3055,
    "text": "كَذَّبَتۡ عَادٌ ٱلۡمُرۡسَلِينَ",
    "numberInSurah": 123,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 322,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "كذبت عاد المرسلين"
  },
  {
    "number": 3056,
    "text": "إِذۡ قَالَ لَهُمۡ أَخُوهُمۡ هُودٌ أَلَا تَتَّقُونَ",
    "numberInSurah": 124,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 322,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "إذ قال لهم أخوهم هود ألا تتقون"
  },
  {
    "number": 3057,
    "text": "إِنِّي لَكُمۡ رَسُولٌ أَمِينٞ",
    "numberInSurah": 125,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 322,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "إني لكم رسول أمين"
  },
  {
    "number": 3058,
    "text": "فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ",
    "numberInSurah": 126,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 322,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "فاتقوا الله وأطيعون"
  },
  {
    "number": 3059,
    "text": "وَمَآ أَسۡـَٔلُكُمۡ عَلَيۡهِ مِنۡ أَجۡرٍۖ إِنۡ أَجۡرِيَ إِلَّا عَلَىٰ رَبِّ ٱلۡعَٰلَمِينَ",
    "numberInSurah": 127,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 322,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "وما أسألكم عليه من أجر إن أجري إلا على رب العالمين"
  },
  {
    "number": 3060,
    "text": "أَتَبۡنُونَ بِكُلِّ رِيعٍ ءَايَةٗ تَعۡبَثُونَ",
    "numberInSurah": 128,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 322,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "أتبنون بكل ريع آية تعبثون"
  },
  {
    "number": 3061,
    "text": "وَتَتَّخِذُونَ مَصَانِعَ لَعَلَّكُمۡ تَخۡلُدُونَ",
    "numberInSurah": 129,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 322,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "وتتخذون مصانع لعلكم تخلدون"
  },
  {
    "number": 3062,
    "text": "وَإِذَا بَطَشۡتُم بَطَشۡتُمۡ جَبَّارِينَ",
    "numberInSurah": 130,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 322,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "وإذا بطشتم بطشتم جبارين"
  },
  {
    "number": 3063,
    "text": "فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ",
    "numberInSurah": 131,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 322,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "فاتقوا الله وأطيعون"
  },
  {
    "number": 3064,
    "text": "وَٱتَّقُواْ ٱلَّذِيٓ أَمَدَّكُم بِمَا تَعۡلَمُونَ",
    "numberInSurah": 132,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 322,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "واتقوا الذي أمدكم بما تعلمون"
  },
  {
    "number": 3065,
    "text": "أَمَدَّكُم بِأَنۡعَٰمٖ وَبَنِينَ",
    "numberInSurah": 133,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 322,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "أمدكم بأنعام وبنين"
  },
  {
    "number": 3066,
    "text": "وَجَنَّـٰتٖ وَعُيُونٍ",
    "numberInSurah": 134,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 322,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "وجنات وعيون"
  },
  {
    "number": 3067,
    "text": "إِنِّيٓ أَخَافُ عَلَيۡكُمۡ عَذَابَ يَوۡمٍ عَظِيمٖ",
    "numberInSurah": 135,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 322,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "إني أخاف عليكم عذاب يوم عظيم"
  },
  {
    "number": 3068,
    "text": "قَالُواْ سَوَآءٌ عَلَيۡنَآ أَوَعَظۡتَ أَمۡ لَمۡ تَكُن مِّنَ ٱلۡوَٰعِظِينَ",
    "numberInSurah": 136,
    "juz": 19,
    "manzil": 5,
    "page": 372,
    "ruku": 322,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "قالوا سواء علينا أوعظت أم لم تكن من الواعظين"
  }
]