    "ruku": 501,
    "hizbQuarter": 227,
    "sajda": false,
    "no_Tashkeel_text": "إنه لقول رسول كريم"
  },
  {
    "number": 5364,
    "text": "وَمَا هُوَ بِقَوۡلِ شَاعِرٖۚ قَلِيلٗا مَّا تُؤۡمِنُونَ",
