[
  {
    "number": 5358,
    "text": "فَلَيۡسَ لَهُ ٱلۡيَوۡمَ هَٰهُنَا حَمِيمٞ",
    "numberInSurah": 35,
    "juz": 29,
    "manzil": 7,
    "page": 568,
    "ruku": 500,
    "hizbQuarter": 227,
    "sajda": false,
    "no_Tashkeel_text": "فليس له اليوم هاهنا حميم"
  },
  {
    "number": 5359,
    "text": "وَلَا طَعَامٌ إِلَّا مِنۡ غِسۡلِينٖ",
