    "manzil": 7,
    "page": 568,
    "ruku": 502,
    "hizbQuarter": 227,
    "sajda": false,
    "no_Tashkeel_text": "فاصبر صبرا جميلا"
  },
  {
    "number": 5381,
    "text": "إِنَّهُمۡ يَرَوۡنَهُۥ بَعِيدٗا",
