    "manzil": 7,
    "page": 568,
    "ruku": 501,
    "hizbQuarter": 227,
    "sajda": false,
    "no_Tashkeel_text": "وإنه لتذكرة للمتقين"
  },
  {
    "number": 5372,
    "text": "وَإِنَّا لَنَعۡلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ",
