    "juz": 29,
    "manzil": 7,
    "page": 568,
    "ruku": 500,
    "hizbQuarter": 227,
    "sajda": false,
    "no_Tashkeel_text": "ولا طعام إلا من غسلين"
  },
  {
    "number": 5360,
    "text": "لَّا يَأۡكُلُهُۥٓ إِلَّا ٱلۡخَٰطِـُٔونَ",
