    "juz": 29,
    "manzil": 7,
    "page": 568,
    "ruku": 501,
    "hizbQuarter": 227,
    "sajda": false,
    "no_Tashkeel_text": "وما لا تبصرون"
  },
  {
    "number": 5363,
    "text": "إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ",
