    "manzil": 7,
    "page": 568,
    "ruku": 501,
    "hizbQuarter": 227,
    "sajda": false,
    "no_Tashkeel_text": "وما هو بقول شاعر قليلا ما تؤمنون"
  },
  {
    "number": 5365,
    "text": "وَلَا بِقَوۡلِ كَاهِنٖۚ قَلِيلٗا مَّا تَذَكَّرُونَ",
    "numberInSurah": 42,
