[
  {
    "number": 4682,
    "text": "وَٱلسَّمَآءِ ذَاتِ ٱلۡحُبُكِ",
    "numberInSurah": 7,
    "juz": 26,
    "manzil": 7,
    "page": 521,
    "ruku": 455,
    "hizbQuarter": 208,
    "sajda": false,
    "no_Tashkeel_text": "والسماء ذات الحبك"
  },
  {
    "number": 4683,
    "text": "إِنَّكُمۡ لَفِي قَوۡلٖ مُّخۡتَلِفٖ",
    "numberInSurah": 8,
    "juz": 26,
    "manzil": 7,
    "page": 521,
    "ruku": 455,
    "hizbQuarter": 208,
    "sajda": false,
    "no_Tashkeel_text": "إنكم لفي قول مختلف"
  },
  {
    "number": 4684,
    "text": "يُؤۡفَكُ عَنۡهُ مَنۡ أُفِكَ",
    "numberInSurah": 9,
    "juz": 26,
    "manzil": 7,
    "page": 521,
    "ruku": 455,
    "hizbQuarter": 208,
    "sajda": false,
    "no_Tashkeel_text": "يؤفك عنه من أفك"
  },
  {
    "number": 4685,
    "text": "قُتِلَ ٱلۡخَرَّـٰصُونَ",
    "numberInSurah": 10,
    "juz": 26,
    "manzil": 7,
    "page": 521,
    "ruku": 455,
    "hizbQuarter": 208,
    "sajda": false,
    "no_Tashkeel_text": "قتل الخراصون"
  },
  {
    "number": 4686,
    "text": "ٱلَّذِينَ هُمۡ فِي غَمۡرَةٖ سَاهُونَ",
    "numberInSurah": 11,
    "juz": 26,
    "manzil": 7,
    "page": 521,
    "ruku": 455,
    "hizbQuarter": 208,
    "sajda": false,
    "no_Tashkeel_text": "الذين هم في غمرة ساهون"
  },
  {
    "number": 4687,
    "text": "يَسۡـَٔلُونَ أَيَّانَ يَوۡمُ ٱلدِّينِ",
    "numberInSurah": 12,
    "juz": 26,
    "manzil": 7,
    "page": 521,
    "ruku": 455,
    "hizbQuarter": 208,
    "sajda": false,
    "no_Tashkeel_text": "يسألون أيان يوم الدين"
  },
  {
    "number": 4688,
    "text": "يَوۡمَ هُمۡ عَلَى ٱلنَّارِ يُفۡتَنُونَ",
    "numberInSurah": 13,
    "juz": 26,
    "manzil": 7,
    "page": 521,
    "ruku": 455,
    "hizbQuarter": 208,
    "sajda": false,
    "no_Tashkeel_text": "يوم هم على النار يفتنون"
  },
  {
    "number": 4689,
    "text": "ذُوقُواْ فِتۡنَتَكُمۡ هَٰذَا ٱلَّذِي كُنتُم بِهِۦ تَسۡتَعۡجِلُونَ",
    "numberInSurah": 14,
    "juz": 26,
    "manzil": 7,
    "page": 521,
    "ruku": 455,
    "hizbQuarter": 208,
    "sajda": false,
    "no_Tashkeel_text": "ذوقوا فتنتكم هذا الذي كنتم به تستعجلون"
  },
  {
    "number": 4690,
    "text": "إِنَّ ٱلۡمُتَّقِينَ فِي جَنَّـٰتٖ وَعُيُونٍ",
    "numberInSurah": 15,
    "juz": 26,
    "manzil": 7,
    "page": 521,
    "ruku": 455,
    "hizbQuarter": 208,
    "sajda": false,
    "no_Tashkeel_text": "إن المتقين في جنات وعيون"
  },
  {
    "number": 4691,
    "text": "ءَاخِذِينَ مَآ ءَاتَىٰهُمۡ رَبُّهُمۡۚ إِنَّهُمۡ كَانُواْ قَبۡلَ ذَٰلِكَ مُحۡسِنِينَ",
    "numberInSurah": 16,
    "juz": 26,
    "manzil": 7,
    "page": 521,
    "ruku": 455,
    "hizbQuarter": 208,
    "sajda": false,
    "no_Tashkeel_text": "آخذين ما آتاهم ربهم إنهم كانوا قبل ذلك محسنين"
  },
  {
    "number": 4692,
    "text": "كَانُواْ قَلِيلٗا مِّنَ ٱلَّيۡلِ مَا يَهۡجَعُونَ",
    "numberInSurah": 17,
    "juz": 26,
    "manzil": 7,
    "page": 521,
    "ruku": 455,
    "hizbQuarter": 208,
    "sajda": false,
    "no_Tashkeel_text": "كانوا قليلا من الليل ما يهجعون"
  },
  {
    "number": 4693,
    "text": "وَبِٱلۡأَسۡحَارِ هُمۡ يَسۡتَغۡفِرُونَ",
    "numberInSurah": 18,
    "juz": 26,
    "manzil": 7,
    "page": 521,
    "ruku": 455,
    "hizbQuarter": 208,
    "sajda": false,
    "no_Tashkeel_text": "وبالأسحار هم يستغفرون"
  },
  {
    "number": 4694,
    "text": "وَفِيٓ أَمۡوَٰلِهِمۡ حَقّٞ لِّلسَّآئِلِ وَٱلۡمَحۡرُومِ",
    "numberInSurah": 19,
    "juz": 26,
    "manzil": 7,
    "page": 521,
    "ruku": 455,
    "hizbQuarter": 208,
    "sajda": false,
    "no_Tashkeel_text": "وفي أموالهم حق للسائل والمحروم"
  },
  {
    "number": 4695,
    "text": "وَفِي ٱلۡأَرۡضِ ءَايَٰتٞ لِّلۡمُوقِنِينَ",
    "numberInSurah": 20,
    "juz": 26,
    "manzil": 7,
    "page": 521,
    "ruku": 455,
    "hizbQuarter": 208,
    "sajda": false,
    "no_Tashkeel_text": "وفي الأرض آيات للموقنين"
  },
  {
    "number": 4696,
    "text": "وَفِيٓ أَنفُسِكُمۡۚ أَفَلَا تُبۡصِرُونَ",
    "numberInSurah": 21,
    "juz": 26,
    "manzil": 7,
    "page": 521,
    "ruku": 455,
    "hizbQuarter": 208,
    "sajda": false,
    "no_Tashkeel_text": "وفي أنفسكم أفلا تبصرون"
  },
  {
    "number": 4697,
    "text": "وَفِي ٱلسَّمَآءِ رِزۡقُكُمۡ وَمَا تُوعَدُونَ",
    "numberInSurah": 22,
    "juz": 26,
    "manzil": 7,
    "page": 521,
    "ruku": 455,
    "hizbQuarter": 208,
    "sajda": false,
    "no_Tashkeel_text": "وفي السماء رزقكم وما توعدون"
  },
  {
    "number": 4698,
    "text": "فَوَرَبِّ ٱلسَّمَآءِ وَٱلۡأَرۡضِ إِنَّهُۥ لَحَقّٞ مِّثۡلَ مَآ أَنَّكُمۡ تَنطِقُونَ",
    "numberInSurah": 23,
    "juz": 26,
    "manzil": 7,
    "page": 521,
    "ruku": 455,
    "hizbQuarter": 208,
    "sajda": false,
    "no_Tashkeel_text": "فورب السماء والأرض إنه لحق مثل ما أنكم تنطقون"
  },
  {
    "number": 4699,
    "text": "هَلۡ أَتَىٰكَ حَدِيثُ ضَيۡفِ إِبۡرَٰهِيمَ ٱلۡمُكۡرَمِينَ",
    "numberInSurah": 24,
    "juz": 26,
    "manzil": 7,
    "page": 521,
    "ruku": 456,
    "hizbQuarter": 208,
    "sajda": false,
    "no_Tashkeel_text": "هل أتاك حديث ضيف إبراهيم المكرمين"
  },
  {
    "number": 4700,
    "text": "إِذۡ دَخَلُواْ عَلَيۡهِ فَقَالُواْ سَلَٰمٗاۖ قَالَ سَلَٰمٞ قَوۡمٞ مُّنكَرُونَ",
    "numberInSurah": 25,
    "juz": 26,
    "manzil": 7,
    "page": 521,
    "ruku": 456,
    "hizbQuarter": 208,
    "sajda": false,
    "no_Tashkeel_text": "إذ دخلوا عليه فقالوا سلاما قال سلام قوم منكرون"
  },
  {
    "number": 4701,
    "text": "فَرَاغَ إِلَىٰٓ أَهۡلِهِۦ فَجَآءَ بِعِجۡلٖ سَمِينٖ",
    "numberInSurah": 26,
    "juz": 26,
    "manzil": 7,
    "page": 521,
    "ruku": 456,
    "hizbQuarter": 208,
    "sajda": false,
    "no_Tashkeel_text": "فراغ إلى أهله فجاء بعجل سمين"
  },
  {
    "number": 4702,
    "text": "فَقَرَّبَهُۥٓ إِلَيۡهِمۡ قَالَ أَلَا تَأۡكُلُونَ",
    "numberInSurah": 27,
    "juz": 26,
    "manzil": 7,
    "page": 521,
    "ruku": 456,
    "hizbQuarter": 208,
    "sajda": false,
    "no_Tashkeel_text": "فقربه إليهم قال ألا تأكلون"
  },
  {
    "number": 4703,
    "text": "فَأَوۡجَسَ مِنۡهُمۡ خِيفَةٗۖ قَالُواْ لَا تَخَفۡۖ وَبَشَّرُوهُ بِغُلَٰمٍ عَلِيمٖ",
    "numberInSurah": 28,
    "juz": 26,
    "manzil": 7,
    "page": 521,
    "ruku": 456,
    "hizbQuarter": 208,
    "sajda": false,
    "no_Tashkeel_text": "فأوجس منهم خيفة قالوا لا تخف وبشروه بغلام عليم"
  },
  {
    "number": 4704,
    "text": "فَأَقۡبَلَتِ ٱمۡرَأَتُهُۥ فِي صَرَّةٖ فَصَكَّتۡ وَجۡهَهَا وَقَالَتۡ عَجُوزٌ عَقِيمٞ",
    "numberInSurah": 29,
    "juz": 26,
    "manzil": 7,
    "page": 521,
    "ruku": 456,
    "hizbQuarter": 208,
    "sajda": false,
    "no_Tashkeel_text": "فأقبلت امرأته في صرة فصكت وجهها وقالت عجوز عقيم"
  },
  {
    "number": 4705,
    "text": "قَالُواْ كَذَٰلِكِ قَالَ رَبُّكِۖ إِنَّهُۥ هُوَ ٱلۡحَكِيمُ ٱلۡعَلِيمُ",
    "numberInSurah": 30,
    "juz": 26,
    "manzil": 7,
    "page": 521,
    "ruku": 456,
    "hizbQuarter": 208,
    "sajda": false,
    "no_Tashkeel_text": "قالوا كذلك قال ربك إنه هو الحكيم العليم"
  }
]