[
  {
    "number": 6073,
    "text": "لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى",
    "numberInSurah": 15,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 534,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "لا يصلاها إلا الأشقى"
  },
  {
    "number": 6074,
    "text": "ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ",
    "numberInSurah": 16,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 534,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "الذي كذب وتولى"
  },
  {
    "number": 6075,
    "text": "وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى",
    "numberInSurah": 17,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 534,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "وسيجنبها الأتقى"
  },
  {
    "number": 6076,
    "text": "ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ",
    "numberInSurah": 18,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 534,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "الذي يؤتي ماله يتزكى"
  },
  {
    "number": 6077,
    "text": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزَىٰٓ",
    "numberInSurah": 19,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 534,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "وما لأحد عنده من نعمة تجزى"
  },
  {
    "number": 6078,
    "text": "إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ",
    "numberInSurah": 20,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 534,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "إلا ابتغاء وجه ربه الأعلى"
  },
  {
    "number": 6079,
    "text": "وَلَسَوۡفَ يَرۡضَىٰ",
    "numberInSurah": 21,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 534,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "ولسوف يرضى"
  },
  {
    "number": 6080,
    "text": "وَٱلضُّحَىٰ",
    "numberInSurah": 1,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 535,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم والضحى"
  },
  {
    "number": 6081,
    "text": "وَٱلَّيۡلِ إِذَا سَجَىٰ",
    "numberInSurah": 2,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 535,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "والليل إذا سجى"
  },
  {
    "number": 6082,
    "text": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ",
    "numberInSurah": 3,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 535,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "ما ودعك ربك وما قلى"
  },
  {
    "number": 6083,
    "text": "وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ ٱلۡأُولَىٰ",
    "numberInSurah": 4,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 535,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "وللآخرة خير لك من الأولى"
  },
  {
    "number": 6084,
    "text": "وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ",
    "numberInSurah": 5,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 535,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "ولسوف يعطيك ربك فترضى"
  },
  {
    "number": 6085,
    "text": "أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوَىٰ",
    "numberInSurah": 6,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 535,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "ألم يجدك يتيما فآوى"
  },
  {
    "number": 6086,
    "text": "وَوَجَدَكَ ضَآلّٗا فَهَدَىٰ",
    "numberInSurah": 7,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 535,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "ووجدك ضالا فهدى"
  },
  {
    "number": 6087,
    "text": "وَوَجَدَكَ عَآئِلٗا فَأَغۡنَىٰ",
    "numberInSurah": 8,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 535,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "ووجدك عائلا فأغنى"
  },
  {
    "number": 6088,
    "text": "فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ",
    "numberInSurah": 9,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 535,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "فأما اليتيم فلا تقهر"
  },
  {
    "number": 6089,
    "text": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ",
    "numberInSurah": 10,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 535,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "وأما السائل فلا تنهر"
  },
  {
    "number": 6090,
    "text": "وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ",
    "numberInSurah": 11,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 535,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "وأما بنعمة ربك فحدث"
  },
  {
    "number": 6091,
    "text": "أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ",
    "numberInSurah": 1,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 536,
    "hizbQuarter": 239,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم ألم نشرح لك صدرك"
  },
  {
    "number": 6092,
    "text": "وَوَضَعۡنَا عَنكَ وِزۡرَكَ",
    "numberInSurah": 2,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 536,
    "hizbQuarter": 239,
    "sajda": false,
    "no_Tashkeel_text": "ووضعنا عنك وزرك"
  },
  {
    "number": 6093,
    "text": "ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ",
    "numberInSurah": 3,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 536,
    "hizbQuarter": 239,
    "sajda": false,
    "no_Tashkeel_text": "الذي أنقض ظهرك"
  },
  {
    "number": 6094,
    "text": "وَرَفَعۡنَا لَكَ ذِكۡرَكَ",
    "numberInSurah": 4,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 536,
    "hizbQuarter": 239,
    "sajda": false,
    "no_Tashkeel_text": "ورفعنا لك ذكرك"
  },
  {
    "number": 6095,
    "text": "فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا",
    "numberInSurah": 5,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 536,
    "hizbQuarter": 239,
    "sajda": false,
    "no_Tashkeel_text": "فإن مع العسر يسرا"
  },
  {
    "number": 6096,
    "text": "إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرٗا",
    "numberInSurah": 6,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 536,
    "hizbQuarter": 239,
    "sajda": false,
    "no_Tashkeel_text": "إن مع العسر يسرا"
  },
  {
    "number": 6097,
    "text": "فَإِذَا فَرَغۡتَ فَٱنصَبۡ",
    "numberInSurah": 7,
    "juz": 30,
    "manzil": 7,
    "page": 596,
    "ruku": 536,
    "hizbQuarter": 239,
    "sajda": false,
    "no_Tashkeel_text": "فإذا فرغت فانصب"
  },
  {
