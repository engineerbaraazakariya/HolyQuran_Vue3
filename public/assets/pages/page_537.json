[
  {
    "number": 5056,
    "text": "إِنَّهُۥ لَقُرۡءَانٞ كَرِيمٞ",
    "numberInSurah": 77,
    "juz": 27,
    "manzil": 7,
    "page": 537,
    "ruku": 471,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "إنه لقرآن كريم"
  },
  {
    "number": 5057,
    "text": "فِي كِتَٰبٖ مَّكۡنُونٖ",
    "numberInSurah": 78,
    "juz": 27,
    "manzil": 7,
    "page": 537,
    "ruku": 471,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "في كتاب مكنون"
  },
  {
    "number": 5058,
    "text": "لَّا يَمَسُّهُۥٓ إِلَّا ٱلۡمُطَهَّرُونَ",
    "numberInSurah": 79,
    "juz": 27,
    "manzil": 7,
    "page": 537,
    "ruku": 471,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "لا يمسه إلا المطهرون"
  },
  {
    "number": 5059,
    "text": "تَنزِيلٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ",
    "numberInSurah": 80,
    "juz": 27,
    "manzil": 7,
    "page": 537,
    "ruku": 471,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "تنزيل من رب العالمين"
  },
  {
    "number": 5060,
    "text": "أَفَبِهَٰذَا ٱلۡحَدِيثِ أَنتُم مُّدۡهِنُونَ",
    "numberInSurah": 81,
    "juz": 27,
    "manzil": 7,
    "page": 537,
    "ruku": 471,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "أفبهذا الحديث أنتم مدهنون"
  },
  {
    "number": 5061,
    "text": "وَتَجۡعَلُونَ رِزۡقَكُمۡ أَنَّكُمۡ تُكَذِّبُونَ",
    "numberInSurah": 82,
    "juz": 27,
    "manzil": 7,
    "page": 537,
    "ruku": 471,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "وتجعلون رزقكم أنكم تكذبون"
  },
  {
    "number": 5062,
    "text": "فَلَوۡلَآ إِذَا بَلَغَتِ ٱلۡحُلۡقُومَ",
    "numberInSurah": 83,
    "juz": 27,
    "manzil": 7,
    "page": 537,
    "ruku": 471,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "فلولا إذا بلغت الحلقوم"
  },
  {
    "number": 5063,
    "text": "وَأَنتُمۡ حِينَئِذٖ تَنظُرُونَ",
    "numberInSurah": 84,
    "juz": 27,
    "manzil": 7,
    "page": 537,
    "ruku": 471,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "وأنتم حينئذ تنظرون"
  },
  {
    "number": 5064,
    "text": "وَنَحۡنُ أَقۡرَبُ إِلَيۡهِ مِنكُمۡ وَلَٰكِن لَّا تُبۡصِرُونَ",
    "numberInSurah": 85,
    "juz": 27,
    "manzil": 7,
    "page": 537,
    "ruku": 471,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "ونحن أقرب إليه منكم ولكن لا تبصرون"
  },
  {
    "number": 5065,
    "text": "فَلَوۡلَآ إِن كُنتُمۡ غَيۡرَ مَدِينِينَ",
    "numberInSurah": 86,
    "juz": 27,
    "manzil": 7,
    "page": 537,
    "ruku": 471,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "فلولا إن كنتم غير مدينين"
  },
  {
    "number": 5066,
    "text": "تَرۡجِعُونَهَآ إِن كُنتُمۡ صَٰدِقِينَ",
    "numberInSurah": 87,
    "juz": 27,
    "manzil": 7,
    "page": 537,
    "ruku": 471,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "ترجعونها إن كنتم صادقين"
  },
  {
    "number": 5067,
    "text": "فَأَمَّآ إِن كَانَ مِنَ ٱلۡمُقَرَّبِينَ",
    "numberInSurah": 88,
    "juz": 27,
    "manzil": 7,
    "page": 537,
    "ruku": 471,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "فأما إن كان من المقربين"
  },
  {
    "number": 5068,
    "text": "فَرَوۡحٞ وَرَيۡحَانٞ وَجَنَّتُ نَعِيمٖ",
    "numberInSurah": 89,
    "juz": 27,
    "manzil": 7,
    "page": 537,
    "ruku": 471,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "فروح وريحان وجنت نعيم"
  },
  {
    "number": 5069,
    "text": "وَأَمَّآ إِن كَانَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ",
    "numberInSurah": 90,
    "juz": 27,
    "manzil": 7,
    "page": 537,
    "ruku": 471,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "وأما إن كان من أصحاب اليمين"
  },
  {
    "number": 5070,
    "text": "فَسَلَٰمٞ لَّكَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ",
    "numberInSurah": 91,
    "juz": 27,
    "manzil": 7,
    "page": 537,
    "ruku": 471,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "فسلام لك من أصحاب اليمين"
  },
  {
    "number": 5071,
    "text": "وَأَمَّآ إِن كَانَ مِنَ ٱلۡمُكَذِّبِينَ ٱلضَّآلِّينَ",
    "numberInSurah": 92,
    "juz": 27,
    "manzil": 7,
    "page": 537,
    "ruku": 471,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "وأما إن كان من المكذبين الضالين"
  },
  {
    "number": 5072,
    "text": "فَنُزُلٞ مِّنۡ حَمِيمٖ",
    "numberInSurah": 93,
    "juz": 27,
    "manzil": 7,
    "page": 537,
    "ruku": 471,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "فنزل من حميم"
  },
  {
    "number": 5073,
    "text": "وَتَصۡلِيَةُ جَحِيمٍ",
    "numberInSurah": 94,
    "juz": 27,
    "manzil": 7,
    "page": 537,
    "ruku": 471,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "وتصلية جحيم"
  },
  {
    "number": 5074,
    "text": "إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلۡيَقِينِ",
    "numberInSurah": 95,
    "juz": 27,
    "manzil": 7,
    "page": 537,
    "ruku": 471,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "إن هذا لهو حق اليقين"
  },
  {
    "number": 5075,
    "text": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ",
    "numberInSurah": 96,
    "juz": 27,
    "manzil": 7,
    "page": 537,
    "ruku": 471,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "فسبح باسم ربك العظيم"
  },
  {
    "number": 5076,
    "text": "سَبَّحَ لِلَّهِ مَا فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ وَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ",
    "numberInSurah": 1,
    "juz": 27,
    "manzil": 7,
    "page": 537,
    "ruku": 472,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم سبح لله ما في السماوات والأرض وهو العزيز الحكيم"
  },
  {
    "number": 5077,
    "text": "لَهُۥ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ يُحۡيِۦ وَيُمِيتُۖ وَهُوَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٌ",
    "numberInSurah": 2,
    "juz": 27,
    "manzil": 7,
    "page": 537,
    "ruku": 472,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "له ملك السماوات والأرض يحيي ويميت وهو على كل شيء قدير"
  },
  {
    "number": 5078,
    "text": "هُوَ ٱلۡأَوَّلُ وَٱلۡأٓخِرُ وَٱلظَّـٰهِرُ وَٱلۡبَاطِنُۖ وَهُوَ بِكُلِّ شَيۡءٍ عَلِيمٌ",
    "numberInSurah": 3,
    "juz": 27,
    "manzil": 7,
    "page": 537,
    "ruku": 472,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "هو الأول والآخر والظاهر والباطن وهو بكل شيء عليم"
  }
]