[
  {
    "number": 2361,
    "text": "وَأَنَا ٱخۡتَرۡتُكَ فَٱسۡتَمِعۡ لِمَا يُوحَىٰٓ",
    "numberInSurah": 13,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 270,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "وأنا اخترتك فاستمع لما يوحى"
  },
  {
    "number": 2362,
    "text": "إِنَّنِيٓ أَنَا ٱللَّهُ لَآ إِلَٰهَ إِلَّآ أَنَا۠ فَٱعۡبُدۡنِي وَأَقِمِ ٱلصَّلَوٰةَ لِذِكۡرِيٓ",
    "numberInSurah": 14,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 270,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "إنني أنا الله لا إله إلا أنا فاعبدني وأقم الصلاة لذكري"
  },
  {
    "number": 2363,
    "text": "إِنَّ ٱلسَّاعَةَ ءَاتِيَةٌ أَكَادُ أُخۡفِيهَا لِتُجۡزَىٰ كُلُّ نَفۡسِۭ بِمَا تَسۡعَىٰ",
    "numberInSurah": 15,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 270,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "إن الساعة آتية أكاد أخفيها لتجزى كل نفس بما تسعى"
  },
  {
    "number": 2364,
    "text": "فَلَا يَصُدَّنَّكَ عَنۡهَا مَن لَّا يُؤۡمِنُ بِهَا وَٱتَّبَعَ هَوَىٰهُ فَتَرۡدَىٰ",
    "numberInSurah": 16,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 270,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "فلا يصدنك عنها من لا يؤمن بها واتبع هواه فتردى"
  },
  {
    "number": 2365,
    "text": "وَمَا تِلۡكَ بِيَمِينِكَ يَٰمُوسَىٰ",
    "numberInSurah": 17,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 270,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "وما تلك بيمينك يا موسى"
  },
  {
    "number": 2366,
    "text": "قَالَ هِيَ عَصَايَ أَتَوَكَّؤُاْ عَلَيۡهَا وَأَهُشُّ بِهَا عَلَىٰ غَنَمِي وَلِيَ فِيهَا مَـَٔارِبُ أُخۡرَىٰ",
    "numberInSurah": 18,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 270,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "قال هي عصاي أتوكأ عليها وأهش بها على غنمي ولي فيها مآرب أخرى"
  },
  {
    "number": 2367,
    "text": "قَالَ أَلۡقِهَا يَٰمُوسَىٰ",
    "numberInSurah": 19,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 270,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "قال ألقها يا موسى"
  },
  {
    "number": 2368,
    "text": "فَأَلۡقَىٰهَا فَإِذَا هِيَ حَيَّةٞ تَسۡعَىٰ",
    "numberInSurah": 20,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 270,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "فألقاها فإذا هي حية تسعى"
  },
  {
    "number": 2369,
    "text": "قَالَ خُذۡهَا وَلَا تَخَفۡۖ سَنُعِيدُهَا سِيرَتَهَا ٱلۡأُولَىٰ",
    "numberInSurah": 21,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 270,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "قال خذها ولا تخف سنعيدها سيرتها الأولى"
  },
  {
    "number": 2370,
    "text": "وَٱضۡمُمۡ يَدَكَ إِلَىٰ جَنَاحِكَ تَخۡرُجۡ بَيۡضَآءَ مِنۡ غَيۡرِ سُوٓءٍ ءَايَةً أُخۡرَىٰ",
    "numberInSurah": 22,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 270,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "واضمم يدك إلى جناحك تخرج بيضاء من غير سوء آية أخرى"
  },
  {
    "number": 2371,
    "text": "لِنُرِيَكَ مِنۡ ءَايَٰتِنَا ٱلۡكُبۡرَى",
    "numberInSurah": 23,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 270,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "لنريك من آياتنا الكبرى"
  },
  {
    "number": 2372,
    "text": "ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ",
    "numberInSurah": 24,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 270,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "اذهب إلى فرعون إنه طغى"
  },
  {
    "number": 2373,
    "text": "قَالَ رَبِّ ٱشۡرَحۡ لِي صَدۡرِي",
    "numberInSurah": 25,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 271,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "قال رب اشرح لي صدري"
  },
  {
    "number": 2374,
    "text": "وَيَسِّرۡ لِيٓ أَمۡرِي",
    "numberInSurah": 26,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 271,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "ويسر لي أمري"
  },
  {
    "number": 2375,
    "text": "وَٱحۡلُلۡ عُقۡدَةٗ مِّن لِّسَانِي",
    "numberInSurah": 27,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 271,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "واحلل عقدة من لساني"
  },
  {
    "number": 2376,
    "text": "يَفۡقَهُواْ قَوۡلِي",
    "numberInSurah": 28,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 271,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "يفقهوا قولي"
  },
  {
    "number": 2377,
    "text": "وَٱجۡعَل لِّي وَزِيرٗا مِّنۡ أَهۡلِي",
    "numberInSurah": 29,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 271,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "واجعل لي وزيرا من أهلي"
  },
  {
    "number": 2378,
    "text": "هَٰرُونَ أَخِي",
    "numberInSurah": 30,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 271,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "هارون أخي"
  },
  {
    "number": 2379,
    "text": "ٱشۡدُدۡ بِهِۦٓ أَزۡرِي",
    "numberInSurah": 31,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 271,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "اشدد به أزري"
  },
  {
    "number": 2380,
    "text": "وَأَشۡرِكۡهُ فِيٓ أَمۡرِي",
    "numberInSurah": 32,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 271,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "وأشركه في أمري"
  },
  {
    "number": 2381,
    "text": "كَيۡ نُسَبِّحَكَ كَثِيرٗا",
    "numberInSurah": 33,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 271,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "كي نسبحك كثيرا"
  },
  {
    "number": 2382,
    "text": "وَنَذۡكُرَكَ كَثِيرًا",
    "numberInSurah": 34,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 271,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "ونذكرك كثيرا"
  },
  {
    "number": 2383,
    "text": "إِنَّكَ كُنتَ بِنَا بَصِيرٗا",
    "numberInSurah": 35,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 271,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "إنك كنت بنا بصيرا"
  },
  {
    "number": 2384,
    "text": "قَالَ قَدۡ أُوتِيتَ سُؤۡلَكَ يَٰمُوسَىٰ",
    "numberInSurah": 36,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 271,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "قال قد أوتيت سؤلك يا موسى"
  },
  {
    "number": 2385,
    "text": "وَلَقَدۡ مَنَنَّا عَلَيۡكَ مَرَّةً أُخۡرَىٰٓ",
    "numberInSurah": 37,
    "juz": 16,
    "manzil": 4,
    "page": 313,
    "ruku": 271,
    "hizbQuarter": 125,
    "sajda": false,
    "no_Tashkeel_text": "ولقد مننا عليك مرة أخرى"
  }
]