[
  {
    "number": 2972,
    "text": "لَعَلَّنَا نَتَّبِعُ ٱلسَّحَرَةَ إِن كَانُواْ هُمُ ٱلۡغَٰلِبِينَ",
    "numberInSurah": 40,
    "juz": 19,
    "manzil": 5,
    "page": 369,
    "ruku": 318,
    "hizbQuarter": 147,
    "sajda": false,
    "no_Tashkeel_text": "لعلنا نتبع السحرة إن كانوا هم الغالبين"
  },
  {
    "number": 2973,
    "text": "فَلَمَّا جَآءَ ٱلسَّحَرَةُ قَالُواْ لِفِرۡعَوۡنَ أَئِنَّ لَنَا لَأَجۡرًا إِن كُنَّا نَحۡنُ ٱلۡغَٰلِبِينَ",
    "numberInSurah": 41,
    "juz": 19,
    "manzil": 5,
    "page": 369,
    "ruku": 318,
    "hizbQuarter": 147,
    "sajda": false,
    "no_Tashkeel_text": "فلما جاء السحرة قالوا لفرعون أئن لنا لأجرا إن كنا نحن الغالبين"
  },
  {
    "number": 2974,
    "text": "قَالَ نَعَمۡ وَإِنَّكُمۡ إِذٗا لَّمِنَ ٱلۡمُقَرَّبِينَ",
    "numberInSurah": 42,
    "juz": 19,
    "manzil": 5,
    "page": 369,
    "ruku": 318,
    "hizbQuarter": 147,
    "sajda": false,
    "no_Tashkeel_text": "قال نعم وإنكم إذا لمن المقربين"
  },
  {
    "number": 2975,
    "text": "قَالَ لَهُم مُّوسَىٰٓ أَلۡقُواْ مَآ أَنتُم مُّلۡقُونَ",
    "numberInSurah": 43,
    "juz": 19,
    "manzil": 5,
    "page": 369,
    "ruku": 318,
    "hizbQuarter": 147,
    "sajda": false,
    "no_Tashkeel_text": "قال لهم موسى ألقوا ما أنتم ملقون"
  },
  {
    "number": 2976,
    "text": "فَأَلۡقَوۡاْ حِبَالَهُمۡ وَعِصِيَّهُمۡ وَقَالُواْ بِعِزَّةِ فِرۡعَوۡنَ إِنَّا لَنَحۡنُ ٱلۡغَٰلِبُونَ",
    "numberInSurah": 44,
    "juz": 19,
    "manzil": 5,
    "page": 369,
    "ruku": 318,
    "hizbQuarter": 147,
    "sajda": false,
    "no_Tashkeel_text": "فألقوا حبالهم وعصيهم وقالوا بعزة فرعون إنا لنحن الغالبون"
  },
  {
    "number": 2977,
    "text": "فَأَلۡقَىٰ مُوسَىٰ عَصَاهُ فَإِذَا هِيَ تَلۡقَفُ مَا يَأۡفِكُونَ",
    "numberInSurah": 45,
    "juz": 19,
    "manzil": 5,
    "page": 369,
    "ruku": 318,
    "hizbQuarter": 147,
    "sajda": false,
    "no_Tashkeel_text": "فألقى موسى عصاه فإذا هي تلقف ما يأفكون"
  },
  {
    "number": 2978,
    "text": "فَأُلۡقِيَ ٱلسَّحَرَةُ سَٰجِدِينَ",
    "numberInSurah": 46,
    "juz": 19,
    "manzil": 5,
    "page": 369,
    "ruku": 318,
    "hizbQuarter": 147,
    "sajda": false,
    "no_Tashkeel_text": "فألقي السحرة ساجدين"
  },
  {
    "number": 2979,
    "text": "قَالُوٓاْ ءَامَنَّا بِرَبِّ ٱلۡعَٰلَمِينَ",
    "numberInSurah": 47,
    "juz": 19,
    "manzil": 5,
    "page": 369,
    "ruku": 318,
    "hizbQuarter": 147,
    "sajda": false,
    "no_Tashkeel_text": "قالوا آمنا برب العالمين"
  },
  {
    "number": 2980,
    "text": "رَبِّ مُوسَىٰ وَهَٰرُونَ",
    "numberInSurah": 48,
    "juz": 19,
    "manzil": 5,
    "page": 369,
    "ruku": 318,
    "hizbQuarter": 147,
    "sajda": false,
    "no_Tashkeel_text": "رب موسى وهارون"
  },
  {
    "number": 2981,
    "text": "قَالَ ءَامَنتُمۡ لَهُۥ قَبۡلَ أَنۡ ءَاذَنَ لَكُمۡۖ إِنَّهُۥ لَكَبِيرُكُمُ ٱلَّذِي عَلَّمَكُمُ ٱلسِّحۡرَ فَلَسَوۡفَ تَعۡلَمُونَۚ لَأُقَطِّعَنَّ أَيۡدِيَكُمۡ وَأَرۡجُلَكُم مِّنۡ خِلَٰفٖ وَلَأُصَلِّبَنَّكُمۡ أَجۡمَعِينَ",
    "numberInSurah": 49,
    "juz": 19,
    "manzil": 5,
    "page": 369,
    "ruku": 318,
    "hizbQuarter": 147,
    "sajda": false,
    "no_Tashkeel_text": "قال آمنتم له قبل أن آذن لكم إنه لكبيركم الذي علمكم السحر فلسوف تعلمون لأقطعن أيديكم وأرجلكم من خلاف ولأصلبنكم أجمعين"
  },
  {
    "number": 2982,
    "text": "قَالُواْ لَا ضَيۡرَۖ إِنَّآ إِلَىٰ رَبِّنَا مُنقَلِبُونَ",
    "numberInSurah": 50,
    "juz": 19,
    "manzil": 5,
    "page": 369,
    "ruku": 318,
    "hizbQuarter": 147,
    "sajda": false,
    "no_Tashkeel_text": "قالوا لا ضير إنا إلى ربنا منقلبون"
  },
  {
    "number": 2983,
    "text": "إِنَّا نَطۡمَعُ أَن يَغۡفِرَ لَنَا رَبُّنَا خَطَٰيَٰنَآ أَن كُنَّآ أَوَّلَ ٱلۡمُؤۡمِنِينَ",
    "numberInSurah": 51,
    "juz": 19,
    "manzil": 5,
    "page": 369,
    "ruku": 318,
    "hizbQuarter": 147,
    "sajda": false,
    "no_Tashkeel_text": "إنا نطمع أن يغفر لنا ربنا خطايانا أن كنا أول المؤمنين"
  },
  {
    "number": 2984,
    "text": "۞وَأَوۡحَيۡنَآ إِلَىٰ مُوسَىٰٓ أَنۡ أَسۡرِ بِعِبَادِيٓ إِنَّكُم مُّتَّبَعُونَ",
    "numberInSurah": 52,
    "juz": 19,
    "manzil": 5,
    "page": 369,
    "ruku": 318,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "وأوحينا إلى موسى أن أسر بعبادي إنكم متبعون"
  },
  {
    "number": 2985,
    "text": "فَأَرۡسَلَ فِرۡعَوۡنُ فِي ٱلۡمَدَآئِنِ حَٰشِرِينَ",
    "numberInSurah": 53,
    "juz": 19,
    "manzil": 5,
    "page": 369,
    "ruku": 319,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "فأرسل فرعون في المدائن حاشرين"
  },
  {
    "number": 2986,
    "text": "إِنَّ هَـٰٓؤُلَآءِ لَشِرۡذِمَةٞ قَلِيلُونَ",
    "numberInSurah": 54,
    "juz": 19,
    "manzil": 5,
    "page": 369,
    "ruku": 319,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "إن هؤلاء لشرذمة قليلون"
  },
  {
    "number": 2987,
    "text": "وَإِنَّهُمۡ لَنَا لَغَآئِظُونَ",
    "numberInSurah": 55,
    "juz": 19,
    "manzil": 5,
    "page": 369,
    "ruku": 319,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "وإنهم لنا لغائظون"
  },
  {
    "number": 2988,
    "text": "وَإِنَّا لَجَمِيعٌ حَٰذِرُونَ",
    "numberInSurah": 56,
    "juz": 19,
    "manzil": 5,
    "page": 369,
    "ruku": 319,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "وإنا لجميع حاذرون"
  },
  {
    "number": 2989,
    "text": "فَأَخۡرَجۡنَٰهُم مِّن جَنَّـٰتٖ وَعُيُونٖ",
    "numberInSurah": 57,
    "juz": 19,
    "manzil": 5,
    "page": 369,
    "ruku": 319,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "فأخرجناهم من جنات وعيون"
  },
  {
    "number": 2990,
    "text": "وَكُنُوزٖ وَمَقَامٖ كَرِيمٖ",
    "numberInSurah": 58,
    "juz": 19,
    "manzil": 5,
    "page": 369,
    "ruku": 319,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "وكنوز ومقام كريم"
  },
  {
    "number": 2991,
    "text": "كَذَٰلِكَۖ وَأَوۡرَثۡنَٰهَا بَنِيٓ إِسۡرَـٰٓءِيلَ",
    "numberInSurah": 59,
    "juz": 19,
    "manzil": 5,
    "page": 369,
    "ruku": 319,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "كذلك وأورثناها بني إسرائيل"
  },
  {
    "number": 2992,
    "text": "فَأَتۡبَعُوهُم مُّشۡرِقِينَ",
    "numberInSurah": 60,
    "juz": 19,
    "manzil": 5,
    "page": 369,
    "ruku": 319,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "فأتبعوهم مشرقين"
  }
]