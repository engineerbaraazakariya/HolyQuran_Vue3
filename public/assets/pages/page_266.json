[
  {
    "number": 1873,
    "text": "قَالَ هَـٰٓؤُلَآءِ بَنَاتِيٓ إِن كُنتُمۡ فَٰعِلِينَ",
    "numberInSurah": 71,
    "juz": 14,
    "manzil": 3,
    "page": 266,
    "ruku": 222,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "قال هؤلاء بناتي إن كنتم فاعلين"
  },
  {
    "number": 1874,
    "text": "لَعَمۡرُكَ إِنَّهُمۡ لَفِي سَكۡرَتِهِمۡ يَعۡمَهُونَ",
    "numberInSurah": 72,
    "juz": 14,
    "manzil": 3,
    "page": 266,
    "ruku": 222,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "لعمرك إنهم لفي سكرتهم يعمهون"
  },
  {
    "number": 1875,
    "text": "فَأَخَذَتۡهُمُ ٱلصَّيۡحَةُ مُشۡرِقِينَ",
    "numberInSurah": 73,
    "juz": 14,
    "manzil": 3,
    "page": 266,
    "ruku": 222,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "فأخذتهم الصيحة مشرقين"
  },
  {
    "number": 1876,
    "text": "فَجَعَلۡنَا عَٰلِيَهَا سَافِلَهَا وَأَمۡطَرۡنَا عَلَيۡهِمۡ حِجَارَةٗ مِّن سِجِّيلٍ",
    "numberInSurah": 74,
    "juz": 14,
    "manzil": 3,
    "page": 266,
    "ruku": 222,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "فجعلنا عاليها سافلها وأمطرنا عليهم حجارة من سجيل"
  },
  {
    "number": 1877,
    "text": "إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّلۡمُتَوَسِّمِينَ",
    "numberInSurah": 75,
    "juz": 14,
    "manzil": 3,
    "page": 266,
    "ruku": 222,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "إن في ذلك لآيات للمتوسمين"
  },
  {
    "number": 1878,
    "text": "وَإِنَّهَا لَبِسَبِيلٖ مُّقِيمٍ",
    "numberInSurah": 76,
    "juz": 14,
    "manzil": 3,
    "page": 266,
    "ruku": 222,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "وإنها لبسبيل مقيم"
  },
  {
    "number": 1879,
    "text": "إِنَّ فِي ذَٰلِكَ لَأٓيَةٗ لِّلۡمُؤۡمِنِينَ",
    "numberInSurah": 77,
    "juz": 14,
    "manzil": 3,
    "page": 266,
    "ruku": 222,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "إن في ذلك لآية للمؤمنين"
  },
  {
    "number": 1880,
    "text": "وَإِن كَانَ أَصۡحَٰبُ ٱلۡأَيۡكَةِ لَظَٰلِمِينَ",
    "numberInSurah": 78,
    "juz": 14,
    "manzil": 3,
    "page": 266,
    "ruku": 222,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "وإن كان أصحاب الأيكة لظالمين"
  },
  {
    "number": 1881,
    "text": "فَٱنتَقَمۡنَا مِنۡهُمۡ وَإِنَّهُمَا لَبِإِمَامٖ مُّبِينٖ",
    "numberInSurah": 79,
    "juz": 14,
    "manzil": 3,
    "page": 266,
    "ruku": 222,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "فانتقمنا منهم وإنهما لبإمام مبين"
  },
  {
    "number": 1882,
    "text": "وَلَقَدۡ كَذَّبَ أَصۡحَٰبُ ٱلۡحِجۡرِ ٱلۡمُرۡسَلِينَ",
    "numberInSurah": 80,
    "juz": 14,
    "manzil": 3,
    "page": 266,
    "ruku": 223,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "ولقد كذب أصحاب الحجر المرسلين"
  },
  {
    "number": 1883,
    "text": "وَءَاتَيۡنَٰهُمۡ ءَايَٰتِنَا فَكَانُواْ عَنۡهَا مُعۡرِضِينَ",
    "numberInSurah": 81,
    "juz": 14,
    "manzil": 3,
    "page": 266,
    "ruku": 223,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "وآتيناهم آياتنا فكانوا عنها معرضين"
  },
  {
    "number": 1884,
    "text": "وَكَانُواْ يَنۡحِتُونَ مِنَ ٱلۡجِبَالِ بُيُوتًا ءَامِنِينَ",
    "numberInSurah": 82,
    "juz": 14,
    "manzil": 3,
    "page": 266,
    "ruku": 223,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "وكانوا ينحتون من الجبال بيوتا آمنين"
  },
  {
    "number": 1885,
    "text": "فَأَخَذَتۡهُمُ ٱلصَّيۡحَةُ مُصۡبِحِينَ",
    "numberInSurah": 83,
    "juz": 14,
    "manzil": 3,
    "page": 266,
    "ruku": 223,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "فأخذتهم الصيحة مصبحين"
  },
  {
    "number": 1886,
    "text": "فَمَآ أَغۡنَىٰ عَنۡهُم مَّا كَانُواْ يَكۡسِبُونَ",
    "numberInSurah": 84,
    "juz": 14,
    "manzil": 3,
    "page": 266,
    "ruku": 223,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "فما أغنى عنهم ما كانوا يكسبون"
  },
  {
    "number": 1887,
    "text": "وَمَا خَلَقۡنَا ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ وَمَا بَيۡنَهُمَآ إِلَّا بِٱلۡحَقِّۗ وَإِنَّ ٱلسَّاعَةَ لَأٓتِيَةٞۖ فَٱصۡفَحِ ٱلصَّفۡحَ ٱلۡجَمِيلَ",
    "numberInSurah": 85,
    "juz": 14,
    "manzil": 3,
    "page": 266,
    "ruku": 223,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "وما خلقنا السماوات والأرض وما بينهما إلا بالحق وإن الساعة لآتية فاصفح الصفح الجميل"
  },
  {
    "number": 1888,
    "text": "إِنَّ رَبَّكَ هُوَ ٱلۡخَلَّـٰقُ ٱلۡعَلِيمُ",
    "numberInSurah": 86,
    "juz": 14,
    "manzil": 3,
    "page": 266,
    "ruku": 223,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "إن ربك هو الخلاق العليم"
  },
  {
    "number": 1889,
    "text": "وَلَقَدۡ ءَاتَيۡنَٰكَ سَبۡعٗا مِّنَ ٱلۡمَثَانِي وَٱلۡقُرۡءَانَ ٱلۡعَظِيمَ",
    "numberInSurah": 87,
    "juz": 14,
    "manzil": 3,
    "page": 266,
    "ruku": 223,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "ولقد آتيناك سبعا من المثاني والقرآن العظيم"
  },
  {
    "number": 1890,
    "text": "لَا تَمُدَّنَّ عَيۡنَيۡكَ إِلَىٰ مَا مَتَّعۡنَا بِهِۦٓ أَزۡوَٰجٗا مِّنۡهُمۡ وَلَا تَحۡزَنۡ عَلَيۡهِمۡ وَٱخۡفِضۡ جَنَاحَكَ لِلۡمُؤۡمِنِينَ",
    "numberInSurah": 88,
    "juz": 14,
    "manzil": 3,
    "page": 266,
    "ruku": 223,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "لا تمدن عينيك إلى ما متعنا به أزواجا منهم ولا تحزن عليهم واخفض جناحك للمؤمنين"
  },
  {
    "number": 1891,
    "text": "وَقُلۡ إِنِّيٓ أَنَا ٱلنَّذِيرُ ٱلۡمُبِينُ",
    "numberInSurah": 89,
    "juz": 14,
    "manzil": 3,
    "page": 266,
    "ruku": 223,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "وقل إني أنا النذير المبين"
  },
  {
    "number": 1892,
    "text": "كَمَآ أَنزَلۡنَا عَلَى ٱلۡمُقۡتَسِمِينَ",
    "numberInSurah": 90,
    "juz": 14,
    "manzil": 3,
    "page": 266,
    "ruku": 223,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "كما أنزلنا على المقتسمين"
  }
]