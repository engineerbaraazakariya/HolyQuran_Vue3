    "ruku": 325,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "كذب أصحاب الأيكة المرسلين"
  },
  {
    "number": 3109,
    "text": "إِذۡ قَالَ لَهُمۡ شُعَيۡبٌ أَلَا تَتَّقُونَ",
