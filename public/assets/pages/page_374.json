[
  {
    "number": 3092,
    "text": "كَذَّبَتۡ قَوۡمُ لُوطٍ ٱلۡمُرۡسَلِينَ",
    "numberInSurah": 160,
    "juz": 19,
    "manzil": 5,
    "page": 374,
    "ruku": 324,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "كذبت قوم لوط المرسلين"
  },
  {
    "number": 3093,
    "text": "إِذۡ قَالَ لَهُمۡ أَخُوهُمۡ لُوطٌ أَلَا تَتَّقُونَ",
    "numberInSurah": 161,
    "juz": 19,
    "manzil": 5,
    "page": 374,
    "ruku": 324,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "إذ قال لهم أخوهم لوط ألا تتقون"
  },
  {
    "number": 3094,
    "text": "إِنِّي لَكُمۡ رَسُولٌ أَمِينٞ",
    "numberInSurah": 162,
    "juz": 19,
    "manzil": 5,
    "page": 374,
    "ruku": 324,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "إني لكم رسول أمين"
  },
  {
    "number": 3095,
    "text": "فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ",
    "numberInSurah": 163,
    "juz": 19,
    "manzil": 5,
    "page": 374,
    "ruku": 324,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "فاتقوا الله وأطيعون"
  },
  {
    "number": 3096,
    "text": "وَمَآ أَسۡـَٔلُكُمۡ عَلَيۡهِ مِنۡ أَجۡرٍۖ إِنۡ أَجۡرِيَ إِلَّا عَلَىٰ رَبِّ ٱلۡعَٰلَمِينَ",
    "numberInSurah": 164,
    "juz": 19,
    "manzil": 5,
    "page": 374,
    "ruku": 324,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "وما أسألكم عليه من أجر إن أجري إلا على رب العالمين"
  },
  {
    "number": 3097,
    "text": "أَتَأۡتُونَ ٱلذُّكۡرَانَ مِنَ ٱلۡعَٰلَمِينَ",
    "numberInSurah": 165,
    "juz": 19,
    "manzil": 5,
    "page": 374,
    "ruku": 324,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "أتأتون الذكران من العالمين"
  },
  {
    "number": 3098,
    "text": "وَتَذَرُونَ مَا خَلَقَ لَكُمۡ رَبُّكُم مِّنۡ أَزۡوَٰجِكُمۚ بَلۡ أَنتُمۡ قَوۡمٌ عَادُونَ",
    "numberInSurah": 166,
    "juz": 19,
    "manzil": 5,
    "page": 374,
    "ruku": 324,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "وتذرون ما خلق لكم ربكم من أزواجكم بل أنتم قوم عادون"
  },
  {
    "number": 3099,
    "text": "قَالُواْ لَئِن لَّمۡ تَنتَهِ يَٰلُوطُ لَتَكُونَنَّ مِنَ ٱلۡمُخۡرَجِينَ",
    "numberInSurah": 167,
    "juz": 19,
    "manzil": 5,
    "page": 374,
    "ruku": 324,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "قالوا لئن لم تنته يا لوط لتكونن من المخرجين"
  },
  {
    "number": 3100,
    "text": "قَالَ إِنِّي لِعَمَلِكُم مِّنَ ٱلۡقَالِينَ",
    "numberInSurah": 168,
    "juz": 19,
    "manzil": 5,
    "page": 374,
    "ruku": 324,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "قال إني لعملكم من القالين"
  },
  {
    "number": 3101,
    "text": "رَبِّ نَجِّنِي وَأَهۡلِي مِمَّا يَعۡمَلُونَ",
    "numberInSurah": 169,
    "juz": 19,
    "manzil": 5,
    "page": 374,
    "ruku": 324,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "رب نجني وأهلي مما يعملون"
  },
  {
    "number": 3102,
    "text": "فَنَجَّيۡنَٰهُ وَأَهۡلَهُۥٓ أَجۡمَعِينَ",
    "numberInSurah": 170,
    "juz": 19,
    "manzil": 5,
    "page": 374,
    "ruku": 324,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "فنجيناه وأهله أجمعين"
  },
  {
    "number": 3103,
    "text": "إِلَّا عَجُوزٗا فِي ٱلۡغَٰبِرِينَ",
    "numberInSurah": 171,
    "juz": 19,
    "manzil": 5,
    "page": 374,
    "ruku": 324,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "إلا عجوزا في الغابرين"
  },
  {
    "number": 3104,
    "text": "ثُمَّ دَمَّرۡنَا ٱلۡأٓخَرِينَ",
    "numberInSurah": 172,
    "juz": 19,
    "manzil": 5,
    "page": 374,
    "ruku": 324,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "ثم دمرنا الآخرين"
  },
  {
    "number": 3105,
    "text": "وَأَمۡطَرۡنَا عَلَيۡهِم مَّطَرٗاۖ فَسَآءَ مَطَرُ ٱلۡمُنذَرِينَ",
    "numberInSurah": 173,
    "juz": 19,
    "manzil": 5,
    "page": 374,
    "ruku": 324,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "وأمطرنا عليهم مطرا فساء مطر المنذرين"
  },
  {
    "number": 3106,
    "text": "إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ",
    "numberInSurah": 174,
    "juz": 19,
    "manzil": 5,
    "page": 374,
    "ruku": 324,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "إن في ذلك لآية وما كان أكثرهم مؤمنين"
  },
  {
    "number": 3107,
    "text": "وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ",
    "numberInSurah": 175,
    "juz": 19,
    "manzil": 5,
    "page": 374,
    "ruku": 324,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "وإن ربك لهو العزيز الرحيم"
  },
  {
    "number": 3108,
    "text": "كَذَّبَ أَصۡحَٰبُ لۡـَٔيۡكَةِ ٱلۡمُرۡسَلِينَ",
    "numberInSurah": 176,
