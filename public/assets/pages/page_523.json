[
  {
    "number": 4727,
    "text": "كَذَٰلِكَ مَآ أَتَى ٱلَّذِينَ مِن قَبۡلِهِم مِّن رَّسُولٍ إِلَّا قَالُواْ سَاحِرٌ أَوۡ مَجۡنُونٌ",
    "numberInSurah": 52,
    "juz": 27,
    "manzil": 7,
    "page": 523,
    "ruku": 457,
    "hizbQuarter": 209,
    "sajda": false,
    "no_Tashkeel_text": "كذلك ما أتى الذين من قبلهم من رسول إلا قالوا ساحر أو مجنون"
  },
  {
    "number": 4728,
    "text": "أَتَوَاصَوۡاْ بِهِۦۚ بَلۡ هُمۡ قَوۡمٞ طَاغُونَ",
    "numberInSurah": 53,
    "juz": 27,
    "manzil": 7,
    "page": 523,
    "ruku": 457,
    "hizbQuarter": 209,
    "sajda": false,
    "no_Tashkeel_text": "أتواصوا به بل هم قوم طاغون"
  },
  {
    "number": 4729,
    "text": "فَتَوَلَّ عَنۡهُمۡ فَمَآ أَنتَ بِمَلُومٖ",
    "numberInSurah": 54,
    "juz": 27,
    "manzil": 7,
    "page": 523,
    "ruku": 457,
    "hizbQuarter": 209,
    "sajda": false,
    "no_Tashkeel_text": "فتول عنهم فما أنت بملوم"
  },
  {
    "number": 4730,
    "text": "وَذَكِّرۡ فَإِنَّ ٱلذِّكۡرَىٰ تَنفَعُ ٱلۡمُؤۡمِنِينَ",
    "numberInSurah": 55,
    "juz": 27,
    "manzil": 7,
    "page": 523,
    "ruku": 457,
    "hizbQuarter": 209,
    "sajda": false,
    "no_Tashkeel_text": "وذكر فإن الذكرى تنفع المؤمنين"
  },
  {
    "number": 4731,
    "text": "وَمَا خَلَقۡتُ ٱلۡجِنَّ وَٱلۡإِنسَ إِلَّا لِيَعۡبُدُونِ",
    "numberInSurah": 56,
    "juz": 27,
    "manzil": 7,
    "page": 523,
    "ruku": 457,
    "hizbQuarter": 209,
    "sajda": false,
    "no_Tashkeel_text": "وما خلقت الجن والإنس إلا ليعبدون"
  },
  {
    "number": 4732,
    "text": "مَآ أُرِيدُ مِنۡهُم مِّن رِّزۡقٖ وَمَآ أُرِيدُ أَن يُطۡعِمُونِ",
    "numberInSurah": 57,
    "juz": 27,
    "manzil": 7,
    "page": 523,
    "ruku": 457,
    "hizbQuarter": 209,
    "sajda": false,
    "no_Tashkeel_text": "ما أريد منهم من رزق وما أريد أن يطعمون"
  },
  {
    "number": 4733,
    "text": "إِنَّ ٱللَّهَ هُوَ ٱلرَّزَّاقُ ذُو ٱلۡقُوَّةِ ٱلۡمَتِينُ",
    "numberInSurah": 58,
    "juz": 27,
    "manzil": 7,
    "page": 523,
    "ruku": 457,
    "hizbQuarter": 209,
    "sajda": false,
    "no_Tashkeel_text": "إن الله هو الرزاق ذو القوة المتين"
  },
  {
    "number": 4734,
    "text": "فَإِنَّ لِلَّذِينَ ظَلَمُواْ ذَنُوبٗا مِّثۡلَ ذَنُوبِ أَصۡحَٰبِهِمۡ فَلَا يَسۡتَعۡجِلُونِ",
    "numberInSurah": 59,
    "juz": 27,
    "manzil": 7,
    "page": 523,
    "ruku": 457,
    "hizbQuarter": 209,
    "sajda": false,
    "no_Tashkeel_text": "فإن للذين ظلموا ذنوبا مثل ذنوب أصحابهم فلا يستعجلون"
  },
  {
    "number": 4735,
    "text": "فَوَيۡلٞ لِّلَّذِينَ كَفَرُواْ مِن يَوۡمِهِمُ ٱلَّذِي يُوعَدُونَ",
    "numberInSurah": 60,
    "juz": 27,
    "manzil": 7,
    "page": 523,
    "ruku": 457,
    "hizbQuarter": 209,
    "sajda": false,
    "no_Tashkeel_text": "فويل للذين كفروا من يومهم الذي يوعدون"
  },
  {
    "number": 4736,
    "text": "وَٱلطُّورِ",
    "numberInSurah": 1,
    "juz": 27,
    "manzil": 7,
    "page": 523,
    "ruku": 458,
    "hizbQuarter": 209,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم والطور"
  },
  {
    "number": 4737,
    "text": "وَكِتَٰبٖ مَّسۡطُورٖ",
    "numberInSurah": 2,
    "juz": 27,
    "manzil": 7,
    "page": 523,
    "ruku": 458,
    "hizbQuarter": 209,
    "sajda": false,
    "no_Tashkeel_text": "وكتاب مسطور"
  },
  {
    "number": 4738,
    "text": "فِي رَقّٖ مَّنشُورٖ",
    "numberInSurah": 3,
    "juz": 27,
    "manzil": 7,
    "page": 523,
    "ruku": 458,
    "hizbQuarter": 209,
    "sajda": false,
    "no_Tashkeel_text": "في رق منشور"
  },
  {
    "number": 4739,
    "text": "وَٱلۡبَيۡتِ ٱلۡمَعۡمُورِ",
    "numberInSurah": 4,
    "juz": 27,
    "manzil": 7,
    "page": 523,
    "ruku": 458,
    "hizbQuarter": 209,
    "sajda": false,
    "no_Tashkeel_text": "والبيت المعمور"
  },
  {
    "number": 4740,
    "text": "وَٱلسَّقۡفِ ٱلۡمَرۡفُوعِ",
    "numberInSurah": 5,
    "juz": 27,
    "manzil": 7,
    "page": 523,
    "ruku": 458,
    "hizbQuarter": 209,
    "sajda": false,
    "no_Tashkeel_text": "والسقف المرفوع"
  },
  {
    "number": 4741,
    "text": "وَٱلۡبَحۡرِ ٱلۡمَسۡجُورِ",
    "numberInSurah": 6,
    "juz": 27,
    "manzil": 7,
    "page": 523,
    "ruku": 458,
    "hizbQuarter": 209,
    "sajda": false,
    "no_Tashkeel_text": "والبحر المسجور"
  },
  {
    "number": 4742,
    "text": "إِنَّ عَذَابَ رَبِّكَ لَوَٰقِعٞ",
    "numberInSurah": 7,
    "juz": 27,
    "manzil": 7,
    "page": 523,
    "ruku": 458,
    "hizbQuarter": 209,
    "sajda": false,
    "no_Tashkeel_text": "إن عذاب ربك لواقع"
  },
  {
    "number": 4743,
    "text": "مَّا لَهُۥ مِن دَافِعٖ",
    "numberInSurah": 8,
    "juz": 27,
    "manzil": 7,
    "page": 523,
    "ruku": 458,
    "hizbQuarter": 209,
    "sajda": false,
    "no_Tashkeel_text": "ما له من دافع"
  },
  {
    "number": 4744,
    "text": "يَوۡمَ تَمُورُ ٱلسَّمَآءُ مَوۡرٗا",
    "numberInSurah": 9,
    "juz": 27,
    "manzil": 7,
    "page": 523,
    "ruku": 458,
    "hizbQuarter": 209,
    "sajda": false,
    "no_Tashkeel_text": "يوم تمور السماء مورا"
  },
  {
    "number": 4745,
    "text": "وَتَسِيرُ ٱلۡجِبَالُ سَيۡرٗا",
    "numberInSurah": 10,
    "juz": 27,
    "manzil": 7,
    "page": 523,
    "ruku": 458,
    "hizbQuarter": 209,
    "sajda": false,
    "no_Tashkeel_text": "وتسير الجبال سيرا"
  },
  {
    "number": 4746,
    "text": "فَوَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
    "numberInSurah": 11,
    "juz": 27,
    "manzil": 7,
    "page": 523,
    "ruku": 458,
    "hizbQuarter": 209,
    "sajda": false,
    "no_Tashkeel_text": "فويل يومئذ للمكذبين"
  },
  {
    "number": 4747,
    "text": "ٱلَّذِينَ هُمۡ فِي خَوۡضٖ يَلۡعَبُونَ",
    "numberInSurah": 12,
    "juz": 27,
    "manzil": 7,
    "page": 523,
    "ruku": 458,
    "hizbQuarter": 209,
    "sajda": false,
    "no_Tashkeel_text": "الذين هم في خوض يلعبون"
  },
  {
    "number": 4748,
    "text": "يَوۡمَ يُدَعُّونَ إِلَىٰ نَارِ جَهَنَّمَ دَعًّا",
    "numberInSurah": 13,
    "juz": 27,
    "manzil": 7,
    "page": 523,
    "ruku": 458,
    "hizbQuarter": 209,
    "sajda": false,
    "no_Tashkeel_text": "يوم يدعون إلى نار جهنم دعا"
  },
  {
    "number": 4749,
    "text": "هَٰذِهِ ٱلنَّارُ ٱلَّتِي كُنتُم بِهَا تُكَذِّبُونَ",
    "numberInSurah": 14,
    "juz": 27,
    "manzil": 7,
    "page": 523,
    "ruku": 458,
    "hizbQuarter": 209,
    "sajda": false,
    "no_Tashkeel_text": "هذه النار التي كنتم بها تكذبون"
  }
]