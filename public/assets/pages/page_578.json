[
  {
    "number": 5571,
    "text": "كَلَّا بَلۡ تُحِبُّونَ ٱلۡعَاجِلَةَ",
    "numberInSurah": 20,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "كلا بل تحبون العاجلة"
  },
  {
    "number": 5572,
    "text": "وَتَذَرُونَ ٱلۡأٓخِرَةَ",
    "numberInSurah": 21,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "وتذرون الآخرة"
  },
  {
    "number": 5573,
    "text": "وُجُوهٞ يَوۡمَئِذٖ نَّاضِرَةٌ",
    "numberInSurah": 22,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "وجوه يومئذ ناضرة"
  },
  {
    "number": 5574,
    "text": "إِلَىٰ رَبِّهَا نَاظِرَةٞ",
    "numberInSurah": 23,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "إلى ربها ناظرة"
  },
  {
    "number": 5575,
    "text": "وَوُجُوهٞ يَوۡمَئِذِۭ بَاسِرَةٞ",
    "numberInSurah": 24,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "ووجوه يومئذ باسرة"
  },
  {
    "number": 5576,
    "text": "تَظُنُّ أَن يُفۡعَلَ بِهَا فَاقِرَةٞ",
    "numberInSurah": 25,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "تظن أن يفعل بها فاقرة"
  },
  {
    "number": 5577,
    "text": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِيَ",
    "numberInSurah": 26,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "كلا إذا بلغت التراقي"
  },
  {
    "number": 5578,
    "text": "وَقِيلَ مَنۡۜ رَاقٖ",
    "numberInSurah": 27,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "وقيل من راق"
  },
  {
    "number": 5579,
    "text": "وَظَنَّ أَنَّهُ ٱلۡفِرَاقُ",
    "numberInSurah": 28,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "وظن أنه الفراق"
  },
  {
    "number": 5580,
    "text": "وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ",
    "numberInSurah": 29,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "والتفت الساق بالساق"
  },
  {
    "number": 5581,
    "text": "إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمَسَاقُ",
    "numberInSurah": 30,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 512,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "إلى ربك يومئذ المساق"
  },
  {
    "number": 5582,
    "text": "فَلَا صَدَّقَ وَلَا صَلَّىٰ",
    "numberInSurah": 31,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 513,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "فلا صدق ولا صلى"
  },
  {
    "number": 5583,
    "text": "وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ",
    "numberInSurah": 32,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 513,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "ولكن كذب وتولى"
  },
  {
    "number": 5584,
    "text": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهۡلِهِۦ يَتَمَطَّىٰٓ",
    "numberInSurah": 33,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 513,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "ثم ذهب إلى أهله يتمطى"
  },
  {
    "number": 5585,
    "text": "أَوۡلَىٰ لَكَ فَأَوۡلَىٰ",
    "numberInSurah": 34,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 513,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "أولى لك فأولى"
  },
  {
    "number": 5586,
    "text": "ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلَىٰٓ",
    "numberInSurah": 35,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 513,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "ثم أولى لك فأولى"
  },
  {
    "number": 5587,
    "text": "أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَن يُتۡرَكَ سُدًى",
    "numberInSurah": 36,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 513,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "أيحسب الإنسان أن يترك سدى"
  },
  {
    "number": 5588,
    "text": "أَلَمۡ يَكُ نُطۡفَةٗ مِّن مَّنِيّٖ يُمۡنَىٰ",
    "numberInSurah": 37,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 513,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "ألم يك نطفة من مني يمنى"
  },
  {
    "number": 5589,
    "text": "ثُمَّ كَانَ عَلَقَةٗ فَخَلَقَ فَسَوَّىٰ",
    "numberInSurah": 38,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 513,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "ثم كان علقة فخلق فسوى"
  },
  {
    "number": 5590,
    "text": "فَجَعَلَ مِنۡهُ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ",
    "numberInSurah": 39,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 513,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "فجعل منه الزوجين الذكر والأنثى"
  },
  {
    "number": 5591,
    "text": "أَلَيۡسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحۡـِۧيَ ٱلۡمَوۡتَىٰ",
    "numberInSurah": 40,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 513,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "أليس ذلك بقادر على أن يحيي الموتى"
  },
  {
    "number": 5592,
    "text": "هَلۡ أَتَىٰ عَلَى ٱلۡإِنسَٰنِ حِينٞ مِّنَ ٱلدَّهۡرِ لَمۡ يَكُن شَيۡـٔٗا مَّذۡكُورًا",
    "numberInSurah": 1,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 514,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم هل أتى على الإنسان حين من الدهر لم يكن شيئا مذكورا"
  },
  {
    "number": 5593,
    "text": "إِنَّا خَلَقۡنَا ٱلۡإِنسَٰنَ مِن نُّطۡفَةٍ أَمۡشَاجٖ نَّبۡتَلِيهِ فَجَعَلۡنَٰهُ سَمِيعَۢا بَصِيرًا",
    "numberInSurah": 2,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 514,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "إنا خلقنا الإنسان من نطفة أمشاج نبتليه فجعلناه سميعا بصيرا"
  },
  {
    "number": 5594,
    "text": "إِنَّا هَدَيۡنَٰهُ ٱلسَّبِيلَ إِمَّا شَاكِرٗا وَإِمَّا كَفُورًا",
    "numberInSurah": 3,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 514,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "إنا هديناه السبيل إما شاكرا وإما كفورا"
  },
  {
    "number": 5595,
    "text": "إِنَّآ أَعۡتَدۡنَا لِلۡكَٰفِرِينَ سَلَٰسِلَاْ وَأَغۡلَٰلٗا وَسَعِيرًا",
    "numberInSurah": 4,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 514,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "إنا أعتدنا للكافرين سلاسل وأغلالا وسعيرا"
  },
  {
    "number": 5596,
    "text": "إِنَّ ٱلۡأَبۡرَارَ يَشۡرَبُونَ مِن كَأۡسٖ كَانَ مِزَاجُهَا كَافُورًا",
    "numberInSurah": 5,
    "juz": 29,
    "manzil": 7,
    "page": 578,
    "ruku": 514,
    "hizbQuarter": 231,
    "sajda": false,
    "no_Tashkeel_text": "إن الأبرار يشربون من كأس كان مزاجها كافورا"
  }
]