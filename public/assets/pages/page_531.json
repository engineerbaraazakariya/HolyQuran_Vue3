[
  {
    "number": 4896,
    "text": "وَمَآ أَمۡرُنَآ إِلَّا وَٰحِدَةٞ كَلَمۡحِۭ بِٱلۡبَصَرِ",
    "numberInSurah": 50,
    "juz": 27,
    "manzil": 7,
    "page": 531,
    "ruku": 465,
    "hizbQuarter": 212,
    "sajda": false,
    "no_Tashkeel_text": "وما أمرنا إلا واحدة كلمح بالبصر"
  },
  {
    "number": 4897,
    "text": "وَلَقَدۡ أَهۡلَكۡنَآ أَشۡيَاعَكُمۡ فَهَلۡ مِن مُّدَّكِرٖ",
    "numberInSurah": 51,
    "juz": 27,
    "manzil": 7,
    "page": 531,
    "ruku": 465,
    "hizbQuarter": 212,
    "sajda": false,
    "no_Tashkeel_text": "ولقد أهلكنا أشياعكم فهل من مدكر"
  },
  {
    "number": 4898,
    "text": "وَكُلُّ شَيۡءٖ فَعَلُوهُ فِي ٱلزُّبُرِ",
    "numberInSurah": 52,
    "juz": 27,
    "manzil": 7,
    "page": 531,
    "ruku": 465,
    "hizbQuarter": 212,
    "sajda": false,
    "no_Tashkeel_text": "وكل شيء فعلوه في الزبر"
  },
  {
    "number": 4899,
    "text": "وَكُلُّ صَغِيرٖ وَكَبِيرٖ مُّسۡتَطَرٌ",
    "numberInSurah": 53,
    "juz": 27,
    "manzil": 7,
    "page": 531,
    "ruku": 465,
    "hizbQuarter": 212,
    "sajda": false,
    "no_Tashkeel_text": "وكل صغير وكبير مستطر"
  },
  {
    "number": 4900,
    "text": "إِنَّ ٱلۡمُتَّقِينَ فِي جَنَّـٰتٖ وَنَهَرٖ",
    "numberInSurah": 54,
    "juz": 27,
    "manzil": 7,
    "page": 531,
    "ruku": 465,
    "hizbQuarter": 212,
    "sajda": false,
    "no_Tashkeel_text": "إن المتقين في جنات ونهر"
  },
  {
    "number": 4901,
    "text": "فِي مَقۡعَدِ صِدۡقٍ عِندَ مَلِيكٖ مُّقۡتَدِرِۭ",
    "numberInSurah": 55,
    "juz": 27,
    "manzil": 7,
    "page": 531,
    "ruku": 465,
    "hizbQuarter": 212,
    "sajda": false,
    "no_Tashkeel_text": "في مقعد صدق عند مليك مقتدر"
  },
  {
    "number": 4902,
    "text": "ٱلرَّحۡمَٰنُ",
    "numberInSurah": 1,
    "juz": 27,
    "manzil": 7,
    "page": 531,
    "ruku": 466,
    "hizbQuarter": 213,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم الرحمن"
  },
  {
    "number": 4903,
    "text": "عَلَّمَ ٱلۡقُرۡءَانَ",
    "numberInSurah": 2,
    "juz": 27,
    "manzil": 7,
    "page": 531,
    "ruku": 466,
    "hizbQuarter": 213,
    "sajda": false,
    "no_Tashkeel_text": "علم القرآن"
  },
  {
    "number": 4904,
    "text": "خَلَقَ ٱلۡإِنسَٰنَ",
    "numberInSurah": 3,
    "juz": 27,
    "manzil": 7,
    "page": 531,
    "ruku": 466,
    "hizbQuarter": 213,
    "sajda": false,
    "no_Tashkeel_text": "خلق الإنسان"
  },
  {
    "number": 4905,
    "text": "عَلَّمَهُ ٱلۡبَيَانَ",
    "numberInSurah": 4,
    "juz": 27,
    "manzil": 7,
    "page": 531,
    "ruku": 466,
    "hizbQuarter": 213,
    "sajda": false,
    "no_Tashkeel_text": "علمه البيان"
  },
  {
    "number": 4906,
    "text": "ٱلشَّمۡسُ وَٱلۡقَمَرُ بِحُسۡبَانٖ",
    "numberInSurah": 5,
    "juz": 27,
    "manzil": 7,
    "page": 531,
    "ruku": 466,
    "hizbQuarter": 213,
    "sajda": false,
    "no_Tashkeel_text": "الشمس والقمر بحسبان"
  },
  {
    "number": 4907,
    "text": "وَٱلنَّجۡمُ وَٱلشَّجَرُ يَسۡجُدَانِ",
    "numberInSurah": 6,
    "juz": 27,
    "manzil": 7,
    "page": 531,
    "ruku": 466,
    "hizbQuarter": 213,
    "sajda": false,
    "no_Tashkeel_text": "والنجم والشجر يسجدان"
  },
  {
    "number": 4908,
    "text": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلۡمِيزَانَ",
    "numberInSurah": 7,
    "juz": 27,
    "manzil": 7,
    "page": 531,
    "ruku": 466,
    "hizbQuarter": 213,
    "sajda": false,
    "no_Tashkeel_text": "والسماء رفعها ووضع الميزان"
  },
  {
    "number": 4909,
    "text": "أَلَّا تَطۡغَوۡاْ فِي ٱلۡمِيزَانِ",
    "numberInSurah": 8,
    "juz": 27,
    "manzil": 7,
    "page": 531,
    "ruku": 466,
    "hizbQuarter": 213,
    "sajda": false,
    "no_Tashkeel_text": "ألا تطغوا في الميزان"
  },
  {
    "number": 4910,
    "text": "وَأَقِيمُواْ ٱلۡوَزۡنَ بِٱلۡقِسۡطِ وَلَا تُخۡسِرُواْ ٱلۡمِيزَانَ",
    "numberInSurah": 9,
    "juz": 27,
    "manzil": 7,
    "page": 531,
    "ruku": 466,
    "hizbQuarter": 213,
    "sajda": false,
    "no_Tashkeel_text": "وأقيموا الوزن بالقسط ولا تخسروا الميزان"
  },
  {
    "number": 4911,
    "text": "وَٱلۡأَرۡضَ وَضَعَهَا لِلۡأَنَامِ",
    "numberInSurah": 10,
    "juz": 27,
    "manzil": 7,
    "page": 531,
    "ruku": 466,
    "hizbQuarter": 213,
    "sajda": false,
    "no_Tashkeel_text": "والأرض وضعها للأنام"
  },
  {
    "number": 4912,
    "text": "فِيهَا فَٰكِهَةٞ وَٱلنَّخۡلُ ذَاتُ ٱلۡأَكۡمَامِ",
    "numberInSurah": 11,
    "juz": 27,
    "manzil": 7,
    "page": 531,
    "ruku": 466,
    "hizbQuarter": 213,
    "sajda": false,
    "no_Tashkeel_text": "فيها فاكهة والنخل ذات الأكمام"
  },
  {
    "number": 4913,
    "text": "وَٱلۡحَبُّ ذُو ٱلۡعَصۡفِ وَٱلرَّيۡحَانُ",
    "numberInSurah": 12,
    "juz": 27,
    "manzil": 7,
    "page": 531,
    "ruku": 466,
    "hizbQuarter": 213,
    "sajda": false,
    "no_Tashkeel_text": "والحب ذو العصف والريحان"
  },
  {
    "number": 4914,
    "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
    "numberInSurah": 13,
    "juz": 27,
    "manzil": 7,
    "page": 531,
    "ruku": 466,
    "hizbQuarter": 213,
    "sajda": false,
    "no_Tashkeel_text": "فبأي آلاء ربكما تكذبان"
  },
  {
    "number": 4915,
    "text": "خَلَقَ ٱلۡإِنسَٰنَ مِن صَلۡصَٰلٖ كَٱلۡفَخَّارِ",
    "numberInSurah": 14,
    "juz": 27,
    "manzil": 7,
    "page": 531,
    "ruku": 466,
    "hizbQuarter": 213,
    "sajda": false,
    "no_Tashkeel_text": "خلق الإنسان من صلصال كالفخار"
  },
  {
    "number": 4916,
    "text": "وَخَلَقَ ٱلۡجَآنَّ مِن مَّارِجٖ مِّن نَّارٖ",
    "numberInSurah": 15,
    "juz": 27,
    "manzil": 7,
    "page": 531,
    "ruku": 466,
    "hizbQuarter": 213,
    "sajda": false,
    "no_Tashkeel_text": "وخلق الجان من مارج من نار"
  },
  {
