[
  {
    "number": 3865,
    "text": "وَجَعَلۡنَا ذُرِّيَّتَهُۥ هُمُ ٱلۡبَاقِينَ",
    "numberInSurah": 77,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "وجعلنا ذريته هم الباقين"
  },
  {
    "number": 3866,
    "text": "وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ",
    "numberInSurah": 78,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "وتركنا عليه في الآخرين"
  },
  {
    "number": 3867,
    "text": "سَلَٰمٌ عَلَىٰ نُوحٖ فِي ٱلۡعَٰلَمِينَ",
    "numberInSurah": 79,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "سلام على نوح في العالمين"
  },
  {
    "number": 3868,
    "text": "إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ",
    "numberInSurah": 80,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "إنا كذلك نجزي المحسنين"
  },
  {
    "number": 3869,
    "text": "إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ",
    "numberInSurah": 81,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "إنه من عبادنا المؤمنين"
  },
  {
    "number": 3870,
    "text": "ثُمَّ أَغۡرَقۡنَا ٱلۡأٓخَرِينَ",
    "numberInSurah": 82,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "ثم أغرقنا الآخرين"
  },
  {
    "number": 3871,
    "text": "۞وَإِنَّ مِن شِيعَتِهِۦ لَإِبۡرَٰهِيمَ",
    "numberInSurah": 83,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "وإن من شيعته لإبراهيم"
  },
  {
    "number": 3872,
    "text": "إِذۡ جَآءَ رَبَّهُۥ بِقَلۡبٖ سَلِيمٍ",
    "numberInSurah": 84,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "إذ جاء ربه بقلب سليم"
  },
  {
    "number": 3873,
    "text": "إِذۡ قَالَ لِأَبِيهِ وَقَوۡمِهِۦ مَاذَا تَعۡبُدُونَ",
    "numberInSurah": 85,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "إذ قال لأبيه وقومه ماذا تعبدون"
  },
  {
    "number": 3874,
    "text": "أَئِفۡكًا ءَالِهَةٗ دُونَ ٱللَّهِ تُرِيدُونَ",
    "numberInSurah": 86,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "أئفكا آلهة دون الله تريدون"
  },
  {
    "number": 3875,
    "text": "فَمَا ظَنُّكُم بِرَبِّ ٱلۡعَٰلَمِينَ",
    "numberInSurah": 87,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "فما ظنكم برب العالمين"
  },
  {
    "number": 3876,
    "text": "فَنَظَرَ نَظۡرَةٗ فِي ٱلنُّجُومِ",
    "numberInSurah": 88,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "فنظر نظرة في النجوم"
  },
  {
    "number": 3877,
    "text": "فَقَالَ إِنِّي سَقِيمٞ",
    "numberInSurah": 89,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "فقال إني سقيم"
  },
  {
    "number": 3878,
    "text": "فَتَوَلَّوۡاْ عَنۡهُ مُدۡبِرِينَ",
    "numberInSurah": 90,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "فتولوا عنه مدبرين"
  },
  {
    "number": 3879,
    "text": "فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمۡ فَقَالَ أَلَا تَأۡكُلُونَ",
    "numberInSurah": 91,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "فراغ إلى آلهتهم فقال ألا تأكلون"
  },
  {
    "number": 3880,
    "text": "مَا لَكُمۡ لَا تَنطِقُونَ",
    "numberInSurah": 92,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "ما لكم لا تنطقون"
  },
  {
    "number": 3881,
    "text": "فَرَاغَ عَلَيۡهِمۡ ضَرۡبَۢا بِٱلۡيَمِينِ",
    "numberInSurah": 93,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "فراغ عليهم ضربا باليمين"
  },
  {
    "number": 3882,
    "text": "فَأَقۡبَلُوٓاْ إِلَيۡهِ يَزِفُّونَ",
    "numberInSurah": 94,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "فأقبلوا إليه يزفون"
  },
  {
    "number": 3883,
    "text": "قَالَ أَتَعۡبُدُونَ مَا تَنۡحِتُونَ",
    "numberInSurah": 95,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "قال أتعبدون ما تنحتون"
  },
  {
    "number": 3884,
    "text": "وَٱللَّهُ خَلَقَكُمۡ وَمَا تَعۡمَلُونَ",
    "numberInSurah": 96,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "والله خلقكم وما تعملون"
  },
  {
    "number": 3885,
    "text": "قَالُواْ ٱبۡنُواْ لَهُۥ بُنۡيَٰنٗا فَأَلۡقُوهُ فِي ٱلۡجَحِيمِ",
    "numberInSurah": 97,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "قالوا ابنوا له بنيانا فألقوه في الجحيم"
  },
  {
    "number": 3886,
    "text": "فَأَرَادُواْ بِهِۦ كَيۡدٗا فَجَعَلۡنَٰهُمُ ٱلۡأَسۡفَلِينَ",
    "numberInSurah": 98,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "فأرادوا به كيدا فجعلناهم الأسفلين"
  },
  {
    "number": 3887,
    "text": "وَقَالَ إِنِّي ذَاهِبٌ إِلَىٰ رَبِّي سَيَهۡدِينِ",
    "numberInSurah": 99,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "وقال إني ذاهب إلى ربي سيهدين"
  },
  {
    "number": 3888,
    "text": "رَبِّ هَبۡ لِي مِنَ ٱلصَّـٰلِحِينَ",
    "numberInSurah": 100,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "رب هب لي من الصالحين"
  },
  {
    "number": 3889,
    "text": "فَبَشَّرۡنَٰهُ بِغُلَٰمٍ حَلِيمٖ",
    "numberInSurah": 101,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "فبشرناه بغلام حليم"
  },
  {
    "number": 3890,
    "text": "فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعۡيَ قَالَ يَٰبُنَيَّ إِنِّيٓ أَرَىٰ فِي ٱلۡمَنَامِ أَنِّيٓ أَذۡبَحُكَ فَٱنظُرۡ مَاذَا تَرَىٰۚ قَالَ يَـٰٓأَبَتِ ٱفۡعَلۡ مَا تُؤۡمَرُۖ سَتَجِدُنِيٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّـٰبِرِينَ",
    "numberInSurah": 102,
    "juz": 23,
    "manzil": 6,
    "page": 449,
    "ruku": 388,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "فلما بلغ معه السعي قال يا بني إني أرى في المنام أني أذبحك فانظر ماذا ترى قال يا أبت افعل ما تؤمر ستجدني إن شاء الله من الصابرين"
  }
]