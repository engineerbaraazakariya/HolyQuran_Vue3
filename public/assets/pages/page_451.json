[
  {
    "number": 3915,
    "text": "فَكَذَّبُوهُ فَإِنَّهُمۡ لَمُحۡضَرُونَ",
    "numberInSurah": 127,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 389,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "فكذبوه فإنهم لمحضرون"
  },
  {
    "number": 3916,
    "text": "إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ",
    "numberInSurah": 128,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 389,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "إلا عباد الله المخلصين"
  },
  {
    "number": 3917,
    "text": "وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ",
    "numberInSurah": 129,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 389,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "وتركنا عليه في الآخرين"
  },
  {
    "number": 3918,
    "text": "سَلَٰمٌ عَلَىٰٓ إِلۡ يَاسِينَ",
    "numberInSurah": 130,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 389,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "سلام على إل ياسين"
  },
  {
    "number": 3919,
    "text": "إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ",
    "numberInSurah": 131,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 389,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "إنا كذلك نجزي المحسنين"
  },
  {
    "number": 3920,
    "text": "إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ",
    "numberInSurah": 132,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 389,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "إنه من عبادنا المؤمنين"
  },
  {
    "number": 3921,
    "text": "وَإِنَّ لُوطٗا لَّمِنَ ٱلۡمُرۡسَلِينَ",
    "numberInSurah": 133,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 389,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "وإن لوطا لمن المرسلين"
  },
  {
    "number": 3922,
    "text": "إِذۡ نَجَّيۡنَٰهُ وَأَهۡلَهُۥٓ أَجۡمَعِينَ",
    "numberInSurah": 134,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 389,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "إذ نجيناه وأهله أجمعين"
  },
  {
    "number": 3923,
    "text": "إِلَّا عَجُوزٗا فِي ٱلۡغَٰبِرِينَ",
    "numberInSurah": 135,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 389,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "إلا عجوزا في الغابرين"
  },
  {
    "number": 3924,
    "text": "ثُمَّ دَمَّرۡنَا ٱلۡأٓخَرِينَ",
    "numberInSurah": 136,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 389,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "ثم دمرنا الآخرين"
  },
  {
    "number": 3925,
    "text": "وَإِنَّكُمۡ لَتَمُرُّونَ عَلَيۡهِم مُّصۡبِحِينَ",
    "numberInSurah": 137,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 389,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "وإنكم لتمرون عليهم مصبحين"
  },
  {
    "number": 3926,
    "text": "وَبِٱلَّيۡلِۚ أَفَلَا تَعۡقِلُونَ",
    "numberInSurah": 138,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 389,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "وبالليل أفلا تعقلون"
  },
  {
    "number": 3927,
    "text": "وَإِنَّ يُونُسَ لَمِنَ ٱلۡمُرۡسَلِينَ",
    "numberInSurah": 139,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 390,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "وإن يونس لمن المرسلين"
  },
  {
    "number": 3928,
    "text": "إِذۡ أَبَقَ إِلَى ٱلۡفُلۡكِ ٱلۡمَشۡحُونِ",
    "numberInSurah": 140,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 390,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "إذ أبق إلى الفلك المشحون"
  },
  {
    "number": 3929,
    "text": "فَسَاهَمَ فَكَانَ مِنَ ٱلۡمُدۡحَضِينَ",
    "numberInSurah": 141,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 390,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "فساهم فكان من المدحضين"
  },
  {
    "number": 3930,
    "text": "فَٱلۡتَقَمَهُ ٱلۡحُوتُ وَهُوَ مُلِيمٞ",
    "numberInSurah": 142,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 390,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "فالتقمه الحوت وهو مليم"
  },
  {
    "number": 3931,
    "text": "فَلَوۡلَآ أَنَّهُۥ كَانَ مِنَ ٱلۡمُسَبِّحِينَ",
    "numberInSurah": 143,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 390,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "فلولا أنه كان من المسبحين"
  },
  {
    "number": 3932,
    "text": "لَلَبِثَ فِي بَطۡنِهِۦٓ إِلَىٰ يَوۡمِ يُبۡعَثُونَ",
    "numberInSurah": 144,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 390,
    "hizbQuarter": 180,
    "sajda": false,
    "no_Tashkeel_text": "للبث في بطنه إلى يوم يبعثون"
  },
  {
    "number": 3933,
    "text": "۞فَنَبَذۡنَٰهُ بِٱلۡعَرَآءِ وَهُوَ سَقِيمٞ",
    "numberInSurah": 145,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "فنبذناه بالعراء وهو سقيم"
  },
  {
    "number": 3934,
    "text": "وَأَنۢبَتۡنَا عَلَيۡهِ شَجَرَةٗ مِّن يَقۡطِينٖ",
    "numberInSurah": 146,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "وأنبتنا عليه شجرة من يقطين"
  },
  {
    "number": 3935,
    "text": "وَأَرۡسَلۡنَٰهُ إِلَىٰ مِاْئَةِ أَلۡفٍ أَوۡ يَزِيدُونَ",
    "numberInSurah": 147,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "وأرسلناه إلى مائة ألف أو يزيدون"
  },
  {
    "number": 3936,
    "text": "فَـَٔامَنُواْ فَمَتَّعۡنَٰهُمۡ إِلَىٰ حِينٖ",
    "numberInSurah": 148,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "فآمنوا فمتعناهم إلى حين"
  },
  {
    "number": 3937,
    "text": "فَٱسۡتَفۡتِهِمۡ أَلِرَبِّكَ ٱلۡبَنَاتُ وَلَهُمُ ٱلۡبَنُونَ",
    "numberInSurah": 149,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "فاستفتهم ألربك البنات ولهم البنون"
  },
  {
    "number": 3938,
    "text": "أَمۡ خَلَقۡنَا ٱلۡمَلَـٰٓئِكَةَ إِنَٰثٗا وَهُمۡ شَٰهِدُونَ",
    "numberInSurah": 150,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "أم خلقنا الملائكة إناثا وهم شاهدون"
  },
  {
    "number": 3939,
    "text": "أَلَآ إِنَّهُم مِّنۡ إِفۡكِهِمۡ لَيَقُولُونَ",
    "numberInSurah": 151,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "ألا إنهم من إفكهم ليقولون"
  },
  {
    "number": 3940,
    "text": "وَلَدَ ٱللَّهُ وَإِنَّهُمۡ لَكَٰذِبُونَ",
    "numberInSurah": 152,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "ولد الله وإنهم لكاذبون"
  },
  {
    "number": 3941,
    "text": "أَصۡطَفَى ٱلۡبَنَاتِ عَلَى ٱلۡبَنِينَ",
    "numberInSurah": 153,
    "juz": 23,
    "manzil": 6,
    "page": 451,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "أصطفى البنات على البنين"
  }
]