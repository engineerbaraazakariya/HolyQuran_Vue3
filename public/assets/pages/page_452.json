[
  {
    "number": 3942,
    "text": "مَا لَكُمۡ كَيۡفَ تَحۡكُمُونَ",
    "numberInSurah": 154,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "ما لكم كيف تحكمون"
  },
  {
    "number": 3943,
    "text": "أَفَلَا تَذَكَّرُونَ",
    "numberInSurah": 155,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "أفلا تذكرون"
  },
  {
    "number": 3944,
    "text": "أَمۡ لَكُمۡ سُلۡطَٰنٞ مُّبِينٞ",
    "numberInSurah": 156,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "أم لكم سلطان مبين"
  },
  {
    "number": 3945,
    "text": "فَأۡتُواْ بِكِتَٰبِكُمۡ إِن كُنتُمۡ صَٰدِقِينَ",
    "numberInSurah": 157,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "فأتوا بكتابكم إن كنتم صادقين"
  },
  {
    "number": 3946,
    "text": "وَجَعَلُواْ بَيۡنَهُۥ وَبَيۡنَ ٱلۡجِنَّةِ نَسَبٗاۚ وَلَقَدۡ عَلِمَتِ ٱلۡجِنَّةُ إِنَّهُمۡ لَمُحۡضَرُونَ",
    "numberInSurah": 158,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "وجعلوا بينه وبين الجنة نسبا ولقد علمت الجنة إنهم لمحضرون"
  },
  {
    "number": 3947,
    "text": "سُبۡحَٰنَ ٱللَّهِ عَمَّا يَصِفُونَ",
    "numberInSurah": 159,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "سبحان الله عما يصفون"
  },
  {
    "number": 3948,
    "text": "إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ",
    "numberInSurah": 160,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "إلا عباد الله المخلصين"
  },
  {
    "number": 3949,
    "text": "فَإِنَّكُمۡ وَمَا تَعۡبُدُونَ",
    "numberInSurah": 161,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "فإنكم وما تعبدون"
  },
  {
    "number": 3950,
    "text": "مَآ أَنتُمۡ عَلَيۡهِ بِفَٰتِنِينَ",
    "numberInSurah": 162,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "ما أنتم عليه بفاتنين"
  },
  {
    "number": 3951,
    "text": "إِلَّا مَنۡ هُوَ صَالِ ٱلۡجَحِيمِ",
    "numberInSurah": 163,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "إلا من هو صال الجحيم"
  },
  {
    "number": 3952,
    "text": "وَمَامِنَّآ إِلَّا لَهُۥ مَقَامٞ مَّعۡلُومٞ",
    "numberInSurah": 164,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "وما منا إلا له مقام معلوم"
  },
  {
    "number": 3953,
    "text": "وَإِنَّا لَنَحۡنُ ٱلصَّآفُّونَ",
    "numberInSurah": 165,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "وإنا لنحن الصافون"
  },
  {
    "number": 3954,
    "text": "وَإِنَّا لَنَحۡنُ ٱلۡمُسَبِّحُونَ",
    "numberInSurah": 166,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "وإنا لنحن المسبحون"
  },
  {
    "number": 3955,
    "text": "وَإِن كَانُواْ لَيَقُولُونَ",
    "numberInSurah": 167,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "وإن كانوا ليقولون"
  },
  {
    "number": 3956,
    "text": "لَوۡ أَنَّ عِندَنَا ذِكۡرٗا مِّنَ ٱلۡأَوَّلِينَ",
    "numberInSurah": 168,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "لو أن عندنا ذكرا من الأولين"
  },
  {
    "number": 3957,
    "text": "لَكُنَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ",
    "numberInSurah": 169,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "لكنا عباد الله المخلصين"
  },
  {
    "number": 3958,
    "text": "فَكَفَرُواْ بِهِۦۖ فَسَوۡفَ يَعۡلَمُونَ",
    "numberInSurah": 170,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "فكفروا به فسوف يعلمون"
  },
  {
    "number": 3959,
    "text": "وَلَقَدۡ سَبَقَتۡ كَلِمَتُنَا لِعِبَادِنَا ٱلۡمُرۡسَلِينَ",
    "numberInSurah": 171,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "ولقد سبقت كلمتنا لعبادنا المرسلين"
  },
  {
    "number": 3960,
    "text": "إِنَّهُمۡ لَهُمُ ٱلۡمَنصُورُونَ",
    "numberInSurah": 172,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "إنهم لهم المنصورون"
  },
  {
    "number": 3961,
    "text": "وَإِنَّ جُندَنَا لَهُمُ ٱلۡغَٰلِبُونَ",
    "numberInSurah": 173,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "وإن جندنا لهم الغالبون"
  },
  {
    "number": 3962,
    "text": "فَتَوَلَّ عَنۡهُمۡ حَتَّىٰ حِينٖ",
    "numberInSurah": 174,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "فتول عنهم حتى حين"
  },
  {
    "number": 3963,
    "text": "وَأَبۡصِرۡهُمۡ فَسَوۡفَ يُبۡصِرُونَ",
    "numberInSurah": 175,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "وأبصرهم فسوف يبصرون"
  },
  {
    "number": 3964,
    "text": "أَفَبِعَذَابِنَا يَسۡتَعۡجِلُونَ",
    "numberInSurah": 176,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "أفبعذابنا يستعجلون"
  },
  {
    "number": 3965,
    "text": "فَإِذَا نَزَلَ بِسَاحَتِهِمۡ فَسَآءَ صَبَاحُ ٱلۡمُنذَرِينَ",
    "numberInSurah": 177,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "فإذا نزل بساحتهم فساء صباح المنذرين"
  },
  {
    "number": 3966,
    "text": "وَتَوَلَّ عَنۡهُمۡ حَتَّىٰ حِينٖ",
    "numberInSurah": 178,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "وتول عنهم حتى حين"
  },
  {
    "number": 3967,
    "text": "وَأَبۡصِرۡ فَسَوۡفَ يُبۡصِرُونَ",
    "numberInSurah": 179,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "وأبصر فسوف يبصرون"
  },
  {
    "number": 3968,
    "text": "سُبۡحَٰنَ رَبِّكَ رَبِّ ٱلۡعِزَّةِ عَمَّا يَصِفُونَ",
    "numberInSurah": 180,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "سبحان ربك رب العزة عما يصفون"
  },
  {
    "number": 3969,
    "text": "وَسَلَٰمٌ عَلَى ٱلۡمُرۡسَلِينَ",
    "numberInSurah": 181,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "وسلام على المرسلين"
  },
  {
    "number": 3970,
    "text": "وَٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ",
    "numberInSurah": 182,
    "juz": 23,
    "manzil": 6,
    "page": 452,
    "ruku": 390,
    "hizbQuarter": 181,
    "sajda": false,
    "no_Tashkeel_text": "والحمد لله رب العالمين"
  }
]