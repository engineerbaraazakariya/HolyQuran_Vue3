[
  {
    "number": 3789,
    "text": "وَٱلصَّـٰٓفَّـٰتِ صَفّٗا",
    "numberInSurah": 1,
    "juz": 23,
    "manzil": 6,
    "page": 446,
    "ruku": 386,
    "hizbQuarter": 178,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم والصافات صفا"
  },
  {
    "number": 3790,
    "text": "فَٱلزَّـٰجِرَٰتِ زَجۡرٗا",
    "numberInSurah": 2,
    "juz": 23,
    "manzil": 6,
    "page": 446,
    "ruku": 386,
    "hizbQuarter": 178,
    "sajda": false,
    "no_Tashkeel_text": "فالزاجرات زجرا"
  },
  {
    "number": 3791,
    "text": "فَٱلتَّـٰلِيَٰتِ ذِكۡرًا",
    "numberInSurah": 3,
    "juz": 23,
    "manzil": 6,
    "page": 446,
    "ruku": 386,
    "hizbQuarter": 178,
    "sajda": false,
    "no_Tashkeel_text": "فالتاليات ذكرا"
  },
  {
    "number": 3792,
    "text": "إِنَّ إِلَٰهَكُمۡ لَوَٰحِدٞ",
    "numberInSurah": 4,
    "juz": 23,
    "manzil": 6,
    "page": 446,
    "ruku": 386,
    "hizbQuarter": 178,
    "sajda": false,
    "no_Tashkeel_text": "إن إلهكم لواحد"
  },
  {
    "number": 3793,
    "text": "رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا وَرَبُّ ٱلۡمَشَٰرِقِ",
    "numberInSurah": 5,
    "juz": 23,
    "manzil": 6,
    "page": 446,
    "ruku": 386,
    "hizbQuarter": 178,
    "sajda": false,
    "no_Tashkeel_text": "رب السماوات والأرض وما بينهما ورب المشارق"
  },
  {
    "number": 3794,
    "text": "إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنۡيَا بِزِينَةٍ ٱلۡكَوَاكِبِ",
    "numberInSurah": 6,
    "juz": 23,
    "manzil": 6,
    "page": 446,
    "ruku": 386,
    "hizbQuarter": 178,
    "sajda": false,
    "no_Tashkeel_text": "إنا زينا السماء الدنيا بزينة الكواكب"
  },
  {
    "number": 3795,
    "text": "وَحِفۡظٗا مِّن كُلِّ شَيۡطَٰنٖ مَّارِدٖ",
    "numberInSurah": 7,
    "juz": 23,
    "manzil": 6,
    "page": 446,
    "ruku": 386,
    "hizbQuarter": 178,
    "sajda": false,
    "no_Tashkeel_text": "وحفظا من كل شيطان مارد"
  },
  {
    "number": 3796,
    "text": "لَّا يَسَّمَّعُونَ إِلَى ٱلۡمَلَإِ ٱلۡأَعۡلَىٰ وَيُقۡذَفُونَ مِن كُلِّ جَانِبٖ",
    "numberInSurah": 8,
    "juz": 23,
    "manzil": 6,
    "page": 446,
    "ruku": 386,
    "hizbQuarter": 178,
    "sajda": false,
    "no_Tashkeel_text": "لا يسمعون إلى الملإ الأعلى ويقذفون من كل جانب"
  },
  {
    "number": 3797,
    "text": "دُحُورٗاۖ وَلَهُمۡ عَذَابٞ وَاصِبٌ",
    "numberInSurah": 9,
    "juz": 23,
    "manzil": 6,
    "page": 446,
    "ruku": 386,
    "hizbQuarter": 178,
    "sajda": false,
    "no_Tashkeel_text": "دحورا ولهم عذاب واصب"
  },
  {
    "number": 3798,
    "text": "إِلَّا مَنۡ خَطِفَ ٱلۡخَطۡفَةَ فَأَتۡبَعَهُۥ شِهَابٞ ثَاقِبٞ",
    "numberInSurah": 10,
    "juz": 23,
    "manzil": 6,
    "page": 446,
    "ruku": 386,
    "hizbQuarter": 178,
    "sajda": false,
    "no_Tashkeel_text": "إلا من خطف الخطفة فأتبعه شهاب ثاقب"
  },
  {
    "number": 3799,
    "text": "فَٱسۡتَفۡتِهِمۡ أَهُمۡ أَشَدُّ خَلۡقًا أَم مَّنۡ خَلَقۡنَآۚ إِنَّا خَلَقۡنَٰهُم مِّن طِينٖ لَّازِبِۭ",
    "numberInSurah": 11,
    "juz": 23,
    "manzil": 6,
    "page": 446,
    "ruku": 386,
    "hizbQuarter": 178,
    "sajda": false,
    "no_Tashkeel_text": "فاستفتهم أهم أشد خلقا أم من خلقنا إنا خلقناهم من طين لازب"
  },
  {
    "number": 3800,
    "text": "بَلۡ عَجِبۡتَ وَيَسۡخَرُونَ",
    "numberInSurah": 12,
    "juz": 23,
    "manzil": 6,
    "page": 446,
    "ruku": 386,
    "hizbQuarter": 178,
    "sajda": false,
    "no_Tashkeel_text": "بل عجبت ويسخرون"
  },
  {
    "number": 3801,
    "text": "وَإِذَا ذُكِّرُواْ لَا يَذۡكُرُونَ",
    "numberInSurah": 13,
    "juz": 23,
    "manzil": 6,
    "page": 446,
    "ruku": 386,
    "hizbQuarter": 178,
    "sajda": false,
    "no_Tashkeel_text": "وإذا ذكروا لا يذكرون"
  },
  {
    "number": 3802,
    "text": "وَإِذَا رَأَوۡاْ ءَايَةٗ يَسۡتَسۡخِرُونَ",
    "numberInSurah": 14,
    "juz": 23,
    "manzil": 6,
    "page": 446,
    "ruku": 386,
    "hizbQuarter": 178,
    "sajda": false,
    "no_Tashkeel_text": "وإذا رأوا آية يستسخرون"
  },
  {
    "number": 3803,
    "text": "وَقَالُوٓاْ إِنۡ هَٰذَآ إِلَّا سِحۡرٞ مُّبِينٌ",
    "numberInSurah": 15,
    "juz": 23,
    "manzil": 6,
    "page": 446,
    "ruku": 386,
    "hizbQuarter": 178,
    "sajda": false,
    "no_Tashkeel_text": "وقالوا إن هذا إلا سحر مبين"
  },
  {
    "number": 3804,
    "text": "أَءِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ",
    "numberInSurah": 16,
    "juz": 23,
    "manzil": 6,
    "page": 446,
    "ruku": 386,
    "hizbQuarter": 178,
    "sajda": false,
    "no_Tashkeel_text": "أإذا متنا وكنا ترابا وعظاما أإنا لمبعوثون"
  },
  {
    "number": 3805,
    "text": "أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ",
    "numberInSurah": 17,
    "juz": 23,
    "manzil": 6,
    "page": 446,
    "ruku": 386,
    "hizbQuarter": 178,
    "sajda": false,
    "no_Tashkeel_text": "أوآباؤنا الأولون"
  },
  {
    "number": 3806,
    "text": "قُلۡ نَعَمۡ وَأَنتُمۡ دَٰخِرُونَ",
    "numberInSurah": 18,
    "juz": 23,
    "manzil": 6,
    "page": 446,
    "ruku": 386,
    "hizbQuarter": 178,
    "sajda": false,
    "no_Tashkeel_text": "قل نعم وأنتم داخرون"
  },
  {
    "number": 3807,
    "text": "فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ فَإِذَا هُمۡ يَنظُرُونَ",
    "numberInSurah": 19,
    "juz": 23,
    "manzil": 6,
    "page": 446,
    "ruku": 386,
    "hizbQuarter": 178,
    "sajda": false,
    "no_Tashkeel_text": "فإنما هي زجرة واحدة فإذا هم ينظرون"
  },
  {
    "number": 3808,
    "text": "وَقَالُواْ يَٰوَيۡلَنَا هَٰذَا يَوۡمُ ٱلدِّينِ",
    "numberInSurah": 20,
    "juz": 23,
    "manzil": 6,
    "page": 446,
    "ruku": 386,
    "hizbQuarter": 178,
    "sajda": false,
    "no_Tashkeel_text": "وقالوا يا ويلنا هذا يوم الدين"
  },
  {
    "number": 3809,
    "text": "هَٰذَا يَوۡمُ ٱلۡفَصۡلِ ٱلَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ",
    "numberInSurah": 21,
    "juz": 23,
    "manzil": 6,
    "page": 446,
    "ruku": 386,
    "hizbQuarter": 178,
    "sajda": false,
    "no_Tashkeel_text": "هذا يوم الفصل الذي كنتم به تكذبون"
  },
  {
    "number": 3810,
    "text": "۞ٱحۡشُرُواْ ٱلَّذِينَ ظَلَمُواْ وَأَزۡوَٰجَهُمۡ وَمَا كَانُواْ يَعۡبُدُونَ",
    "numberInSurah": 22,
    "juz": 23,
    "manzil": 6,
    "page": 446,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "احشروا الذين ظلموا وأزواجهم وما كانوا يعبدون"
  },
  {
    "number": 3811,
    "text": "مِن دُونِ ٱللَّهِ فَٱهۡدُوهُمۡ إِلَىٰ صِرَٰطِ ٱلۡجَحِيمِ",
    "numberInSurah": 23,
    "juz": 23,
    "manzil": 6,
    "page": 446,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "من دون الله فاهدوهم إلى صراط الجحيم"
  },
  {
    "number": 3812,
    "text": "وَقِفُوهُمۡۖ إِنَّهُم مَّسۡـُٔولُونَ",
    "numberInSurah": 24,
    "juz": 23,
    "manzil": 6,
    "page": 446,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "وقفوهم إنهم مسئولون"
  }
]