[
  {
    "number": 5314,
    "text": "خَٰشِعَةً أَبۡصَٰرُهُمۡ تَرۡهَقُهُمۡ ذِلَّةٞۖ وَقَدۡ كَانُواْ يُدۡعَوۡنَ إِلَى ٱلسُّجُودِ وَهُمۡ سَٰلِمُونَ",
    "numberInSurah": 43,
    "juz": 29,
    "manzil": 7,
    "page": 566,
    "ruku": 499,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "خاشعة أبصارهم ترهقهم ذلة وقد كانوا يدعون إلى السجود وهم سالمون"
  },
  {
    "number": 5315,
    "text": "فَذَرۡنِي وَمَن يُكَذِّبُ بِهَٰذَا ٱلۡحَدِيثِۖ سَنَسۡتَدۡرِجُهُم مِّنۡ حَيۡثُ لَا يَعۡلَمُونَ",
    "numberInSurah": 44,
    "juz": 29,
    "manzil": 7,
    "page": 566,
    "ruku": 499,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "فذرني ومن يكذب بهذا الحديث سنستدرجهم من حيث لا يعلمون"
  },
  {
    "number": 5316,
    "text": "وَأُمۡلِي لَهُمۡۚ إِنَّ كَيۡدِي مَتِينٌ",
    "numberInSurah": 45,
    "juz": 29,
    "manzil": 7,
    "page": 566,
    "ruku": 499,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "وأملي لهم إن كيدي متين"
  },
  {
    "number": 5317,
    "text": "أَمۡ تَسۡـَٔلُهُمۡ أَجۡرٗا فَهُم مِّن مَّغۡرَمٖ مُّثۡقَلُونَ",
    "numberInSurah": 46,
    "juz": 29,
    "manzil": 7,
    "page": 566,
    "ruku": 499,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "أم تسألهم أجرا فهم من مغرم مثقلون"
  },
  {
    "number": 5318,
    "text": "أَمۡ عِندَهُمُ ٱلۡغَيۡبُ فَهُمۡ يَكۡتُبُونَ",
    "numberInSurah": 47,
    "juz": 29,
    "manzil": 7,
    "page": 566,
    "ruku": 499,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "أم عندهم الغيب فهم يكتبون"
  },
  {
    "number": 5319,
    "text": "فَٱصۡبِرۡ لِحُكۡمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ ٱلۡحُوتِ إِذۡ نَادَىٰ وَهُوَ مَكۡظُومٞ",
    "numberInSurah": 48,
    "juz": 29,
    "manzil": 7,
    "page": 566,
    "ruku": 499,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "فاصبر لحكم ربك ولا تكن كصاحب الحوت إذ نادى وهو مكظوم"
  },
  {
    "number": 5320,
    "text": "لَّوۡلَآ أَن تَدَٰرَكَهُۥ نِعۡمَةٞ مِّن رَّبِّهِۦ لَنُبِذَ بِٱلۡعَرَآءِ وَهُوَ مَذۡمُومٞ",
    "numberInSurah": 49,
    "juz": 29,
    "manzil": 7,
    "page": 566,
    "ruku": 499,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "لولا أن تداركه نعمة من ربه لنبذ بالعراء وهو مذموم"
  },
  {
    "number": 5321,
    "text": "فَٱجۡتَبَٰهُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ ٱلصَّـٰلِحِينَ",
    "numberInSurah": 50,
    "juz": 29,
    "manzil": 7,
    "page": 566,
    "ruku": 499,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "فاجتباه ربه فجعله من الصالحين"
  },
  {
    "number": 5322,
    "text": "وَإِن يَكَادُ ٱلَّذِينَ كَفَرُواْ لَيُزۡلِقُونَكَ بِأَبۡصَٰرِهِمۡ لَمَّا سَمِعُواْ ٱلذِّكۡرَ وَيَقُولُونَ إِنَّهُۥ لَمَجۡنُونٞ",
    "numberInSurah": 51,
    "juz": 29,
    "manzil": 7,
    "page": 566,
    "ruku": 499,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "وإن يكاد الذين كفروا ليزلقونك بأبصارهم لما سمعوا الذكر ويقولون إنه لمجنون"
  },
  {
    "number": 5323,
    "text": "وَمَا هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ",
    "numberInSurah": 52,
    "juz": 29,
    "manzil": 7,
    "page": 566,
    "ruku": 499,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "وما هو إلا ذكر للعالمين"
  },
  {
    "number": 5324,
    "text": "ٱلۡحَآقَّةُ",
    "numberInSurah": 1,
    "juz": 29,
    "manzil": 7,
    "page": 566,
    "ruku": 500,
    "hizbQuarter": 227,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم الحاقة"
  },
  {
    "number": 5325,
    "text": "مَا ٱلۡحَآقَّةُ",
    "numberInSurah": 2,
