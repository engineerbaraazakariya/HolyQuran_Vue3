  },
  {
    "number": 5326,
    "text": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡحَآقَّةُ",
    "numberInSurah": 3,
    "juz": 29,
    "manzil": 7,
    "page": 566,
    "ruku": 500,
    "hizbQuarter": 227,
    "sajda": false,
    "no_Tashkeel_text": "وما أدراك ما الحاقة"
  },
  {
    "number": 5327,
    "text": "كَذَّبَتۡ ثَمُودُ وَعَادُۢ بِٱلۡقَارِعَةِ",
    "numberInSurah": 4,
    "juz": 29,
    "manzil": 7,
    "page": 566,
    "ruku": 500,
    "hizbQuarter": 227,
    "sajda": false,
    "no_Tashkeel_text": "كذبت ثمود وعاد بالقارعة"
  },
  {
    "number": 5328,
    "text": "فَأَمَّا ثَمُودُ فَأُهۡلِكُواْ بِٱلطَّاغِيَةِ",
    "numberInSurah": 5,
    "juz": 29,
    "manzil": 7,
    "page": 566,
    "ruku": 500,
    "hizbQuarter": 227,
    "sajda": false,
    "no_Tashkeel_text": "فأما ثمود فأهلكوا بالطاغية"
  },
  {
    "number": 5329,
    "text": "وَأَمَّا عَادٞ فَأُهۡلِكُواْ بِرِيحٖ صَرۡصَرٍ عَاتِيَةٖ",
    "numberInSurah": 6,
    "juz": 29,
    "manzil": 7,
    "page": 566,
    "ruku": 500,
    "hizbQuarter": 227,
    "sajda": false,
    "no_Tashkeel_text": "وأما عاد فأهلكوا بريح صرصر عاتية"
  },
  {
    "number": 5330,
    "text": "سَخَّرَهَا عَلَيۡهِمۡ سَبۡعَ لَيَالٖ وَثَمَٰنِيَةَ أَيَّامٍ حُسُومٗاۖ فَتَرَى ٱلۡقَوۡمَ فِيهَا صَرۡعَىٰ كَأَنَّهُمۡ أَعۡجَازُ نَخۡلٍ خَاوِيَةٖ",
    "numberInSurah": 7,
    "juz": 29,
    "manzil": 7,
    "page": 566,
    "ruku": 500,
    "hizbQuarter": 227,
    "sajda": false,
    "no_Tashkeel_text": "سخرها عليهم سبع ليال وثمانية أيام حسوما فترى القوم فيها صرعى كأنهم أعجاز نخل خاوية"
  },
  {
