    "juz": 27,
    "manzil": 7,
    "page": 535,
    "ruku": 469,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "جزاء بما كانوا يعملون"
  },
  {
    "number": 5004,
    "text": "لَا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا تَأۡثِيمًا",
