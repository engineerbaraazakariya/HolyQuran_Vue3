    "juz": 27,
    "manzil": 7,
    "page": 535,
    "ruku": 469,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "لا يسمعون فيها لغوا ولا تأثيما"
  },
  {
    "number": 5005,
    "text": "إِلَّا قِيلٗا سَلَٰمٗا سَلَٰمٗا",
