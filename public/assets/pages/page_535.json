[
  {
    "number": 4996,
    "text": "يَطُوفُ عَلَيۡهِمۡ وِلۡدَٰنٞ مُّخَلَّدُونَ",
    "numberInSurah": 17,
    "juz": 27,
    "manzil": 7,
    "page": 535,
    "ruku": 469,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "يطوف عليهم ولدان مخلدون"
  },
  {
    "number": 4997,
    "text": "بِأَكۡوَابٖ وَأَبَارِيقَ وَكَأۡسٖ مِّن مَّعِينٖ",
    "numberInSurah": 18,
    "juz": 27,
    "manzil": 7,
    "page": 535,
    "ruku": 469,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "بأكواب وأباريق وكأس من معين"
  },
  {
    "number": 4998,
    "text": "لَّا يُصَدَّعُونَ عَنۡهَا وَلَا يُنزِفُونَ",
    "numberInSurah": 19,
    "juz": 27,
    "manzil": 7,
    "page": 535,
    "ruku": 469,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "لا يصدعون عنها ولا ينزفون"
  },
  {
    "number": 4999,
    "text": "وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ",
