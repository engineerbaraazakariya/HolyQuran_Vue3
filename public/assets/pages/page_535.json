    "juz": 27,
    "manzil": 7,
    "page": 535,
    "ruku": 469,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "وفاكهة مما يتخيرون"
  },
  {
    "number": 5000,
    "text": "وَلَحۡمِ طَيۡرٖ مِّمَّا يَشۡتَهُونَ",
    "numberInSurah": 21,
    "juz": 27,
    "manzil": 7,
    "page": 535,
    "ruku": 469,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "ولحم طير مما يشتهون"
  },
  {
    "number": 5001,
    "text": "وَحُورٌ عِينٞ",
