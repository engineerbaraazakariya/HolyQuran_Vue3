    "juz": 27,
    "manzil": 7,
    "page": 535,
    "ruku": 469,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "كأمثال اللؤلؤ المكنون"
  },
  {
    "number": 5003,
    "text": "جَزَآءَۢ بِمَا كَانُواْ يَعۡمَلُونَ",
