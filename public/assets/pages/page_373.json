[
  {
    "number": 3069,
    "text": "إِنۡ هَٰذَآ إِلَّا خُلُقُ ٱلۡأَوَّلِينَ",
    "numberInSurah": 137,
    "juz": 19,
    "manzil": 5,
    "page": 373,
    "ruku": 322,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "إن هذا إلا خلق الأولين"
  },
  {
    "number": 3070,
    "text": "وَمَا نَحۡنُ بِمُعَذَّبِينَ",
    "numberInSurah": 138,
    "juz": 19,
    "manzil": 5,
    "page": 373,
    "ruku": 322,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "وما نحن بمعذبين"
  },
  {
    "number": 3071,
    "text": "فَكَذَّبُوهُ فَأَهۡلَكۡنَٰهُمۡۚ إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ",
    "numberInSurah": 139,
    "juz": 19,
    "manzil": 5,
    "page": 373,
    "ruku": 322,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "فكذبوه فأهلكناهم إن في ذلك لآية وما كان أكثرهم مؤمنين"
  },
  {
    "number": 3072,
    "text": "وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ",
    "numberInSurah": 140,
    "juz": 19,
    "manzil": 5,
    "page": 373,
    "ruku": 322,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "وإن ربك لهو العزيز الرحيم"
  },
  {
    "number": 3073,
    "text": "كَذَّبَتۡ ثَمُودُ ٱلۡمُرۡسَلِينَ",
    "numberInSurah": 141,
    "juz": 19,
    "manzil": 5,
    "page": 373,
    "ruku": 323,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "كذبت ثمود المرسلين"
  },
  {
    "number": 3074,
    "text": "إِذۡ قَالَ لَهُمۡ أَخُوهُمۡ صَٰلِحٌ أَلَا تَتَّقُونَ",
    "numberInSurah": 142,
    "juz": 19,
    "manzil": 5,
    "page": 373,
    "ruku": 323,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "إذ قال لهم أخوهم صالح ألا تتقون"
  },
  {
    "number": 3075,
    "text": "إِنِّي لَكُمۡ رَسُولٌ أَمِينٞ",
    "numberInSurah": 143,
    "juz": 19,
    "manzil": 5,
    "page": 373,
    "ruku": 323,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "إني لكم رسول أمين"
  },
  {
    "number": 3076,
    "text": "فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ",
    "numberInSurah": 144,
    "juz": 19,
    "manzil": 5,
    "page": 373,
    "ruku": 323,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "فاتقوا الله وأطيعون"
  },
  {
    "number": 3077,
    "text": "وَمَآ أَسۡـَٔلُكُمۡ عَلَيۡهِ مِنۡ أَجۡرٍۖ إِنۡ أَجۡرِيَ إِلَّا عَلَىٰ رَبِّ ٱلۡعَٰلَمِينَ",
    "numberInSurah": 145,
    "juz": 19,
    "manzil": 5,
    "page": 373,
    "ruku": 323,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "وما أسألكم عليه من أجر إن أجري إلا على رب العالمين"
  },
  {
    "number": 3078,
    "text": "أَتُتۡرَكُونَ فِي مَا هَٰهُنَآ ءَامِنِينَ",
    "numberInSurah": 146,
    "juz": 19,
    "manzil": 5,
    "page": 373,
    "ruku": 323,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "أتتركون في ما هاهنا آمنين"
  },
  {
    "number": 3079,
    "text": "فِي جَنَّـٰتٖ وَعُيُونٖ",
    "numberInSurah": 147,
    "juz": 19,
    "manzil": 5,
    "page": 373,
    "ruku": 323,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "في جنات وعيون"
  },
  {
    "number": 3080,
    "text": "وَزُرُوعٖ وَنَخۡلٖ طَلۡعُهَا هَضِيمٞ",
    "numberInSurah": 148,
    "juz": 19,
    "manzil": 5,
    "page": 373,
    "ruku": 323,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "وزروع ونخل طلعها هضيم"
  },
  {
    "number": 3081,
    "text": "وَتَنۡحِتُونَ مِنَ ٱلۡجِبَالِ بُيُوتٗا فَٰرِهِينَ",
    "numberInSurah": 149,
    "juz": 19,
    "manzil": 5,
    "page": 373,
    "ruku": 323,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "وتنحتون من الجبال بيوتا فارهين"
  },
  {
    "number": 3082,
    "text": "فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ",
    "numberInSurah": 150,
    "juz": 19,
    "manzil": 5,
    "page": 373,
    "ruku": 323,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "فاتقوا الله وأطيعون"
  },
  {
    "number": 3083,
    "text": "وَلَا تُطِيعُوٓاْ أَمۡرَ ٱلۡمُسۡرِفِينَ",
    "numberInSurah": 151,
    "juz": 19,
    "manzil": 5,
    "page": 373,
    "ruku": 323,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "ولا تطيعوا أمر المسرفين"
  },
  {
    "number": 3084,
    "text": "ٱلَّذِينَ يُفۡسِدُونَ فِي ٱلۡأَرۡضِ وَلَا يُصۡلِحُونَ",
    "numberInSurah": 152,
    "juz": 19,
    "manzil": 5,
    "page": 373,
    "ruku": 323,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "الذين يفسدون في الأرض ولا يصلحون"
  },
  {
    "number": 3085,
    "text": "قَالُوٓاْ إِنَّمَآ أَنتَ مِنَ ٱلۡمُسَحَّرِينَ",
    "numberInSurah": 153,
    "juz": 19,
    "manzil": 5,
    "page": 373,
    "ruku": 323,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "قالوا إنما أنت من المسحرين"
  },
  {
    "number": 3086,
    "text": "مَآ أَنتَ إِلَّا بَشَرٞ مِّثۡلُنَا فَأۡتِ بِـَٔايَةٍ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ",
    "numberInSurah": 154,
    "juz": 19,
    "manzil": 5,
    "page": 373,
    "ruku": 323,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "ما أنت إلا بشر مثلنا فأت بآية إن كنت من الصادقين"
  },
  {
    "number": 3087,
    "text": "قَالَ هَٰذِهِۦ نَاقَةٞ لَّهَا شِرۡبٞ وَلَكُمۡ شِرۡبُ يَوۡمٖ مَّعۡلُومٖ",
    "numberInSurah": 155,
    "juz": 19,
    "manzil": 5,
    "page": 373,
    "ruku": 323,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "قال هذه ناقة لها شرب ولكم شرب يوم معلوم"
  },
  {
    "number": 3088,
    "text": "وَلَا تَمَسُّوهَا بِسُوٓءٖ فَيَأۡخُذَكُمۡ عَذَابُ يَوۡمٍ عَظِيمٖ",
    "numberInSurah": 156,
    "juz": 19,
    "manzil": 5,
    "page": 373,
    "ruku": 323,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "ولا تمسوها بسوء فيأخذكم عذاب يوم عظيم"
  },
  {
    "number": 3089,
    "text": "فَعَقَرُوهَا فَأَصۡبَحُواْ نَٰدِمِينَ",
    "numberInSurah": 157,
    "juz": 19,
    "manzil": 5,
    "page": 373,
    "ruku": 323,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "فعقروها فأصبحوا نادمين"
  },
  {
    "number": 3090,
    "text": "فَأَخَذَهُمُ ٱلۡعَذَابُۚ إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ",
    "numberInSurah": 158,
    "juz": 19,
    "manzil": 5,
    "page": 373,
    "ruku": 323,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "فأخذهم العذاب إن في ذلك لآية وما كان أكثرهم مؤمنين"
  },
  {
    "number": 3091,
    "text": "وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ",
    "numberInSurah": 159,
    "juz": 19,
    "manzil": 5,
    "page": 373,
    "ruku": 323,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "وإن ربك لهو العزيز الرحيم"
  }
