[
  {
    "number": 2327,
    "text": "أَفَرَءَيۡتَ ٱلَّذِي كَفَرَ بِـَٔايَٰتِنَا وَقَالَ لَأُوتَيَنَّ مَالٗا وَوَلَدًا",
    "numberInSurah": 77,
    "juz": 16,
    "manzil": 4,
    "page": 311,
    "ruku": 268,
    "hizbQuarter": 124,
    "sajda": false,
    "no_Tashkeel_text": "أفرأيت الذي كفر بآياتنا وقال لأوتين مالا وولدا"
  },
  {
    "number": 2328,
    "text": "أَطَّلَعَ ٱلۡغَيۡبَ أَمِ ٱتَّخَذَ عِندَ ٱلرَّحۡمَٰنِ عَهۡدٗا",
    "numberInSurah": 78,
    "juz": 16,
    "manzil": 4,
    "page": 311,
    "ruku": 268,
    "hizbQuarter": 124,
    "sajda": false,
    "no_Tashkeel_text": "أطلع الغيب أم اتخذ عند الرحمن عهدا"
  },
  {
    "number": 2329,
    "text": "كَلَّاۚ سَنَكۡتُبُ مَا يَقُولُ وَنَمُدُّ لَهُۥ مِنَ ٱلۡعَذَابِ مَدّٗا",
    "numberInSurah": 79,
    "juz": 16,
    "manzil": 4,
    "page": 311,
    "ruku": 268,
    "hizbQuarter": 124,
    "sajda": false,
    "no_Tashkeel_text": "كلا سنكتب ما يقول ونمد له من العذاب مدا"
  },
  {
    "number": 2330,
    "text": "وَنَرِثُهُۥ مَا يَقُولُ وَيَأۡتِينَا فَرۡدٗا",
    "numberInSurah": 80,
    "juz": 16,
    "manzil": 4,
    "page": 311,
    "ruku": 268,
    "hizbQuarter": 124,
    "sajda": false,
    "no_Tashkeel_text": "ونرثه ما يقول ويأتينا فردا"
  },
  {
    "number": 2331,
    "text": "وَٱتَّخَذُواْ مِن دُونِ ٱللَّهِ ءَالِهَةٗ لِّيَكُونُواْ لَهُمۡ عِزّٗا",
    "numberInSurah": 81,
    "juz": 16,
    "manzil": 4,
    "page": 311,
    "ruku": 268,
    "hizbQuarter": 124,
    "sajda": false,
    "no_Tashkeel_text": "واتخذوا من دون الله آلهة ليكونوا لهم عزا"
  },
  {
    "number": 2332,
    "text": "كَلَّاۚ سَيَكۡفُرُونَ بِعِبَادَتِهِمۡ وَيَكُونُونَ عَلَيۡهِمۡ ضِدًّا",
    "numberInSurah": 82,
    "juz": 16,
    "manzil": 4,
    "page": 311,
    "ruku": 268,
    "hizbQuarter": 124,
    "sajda": false,
    "no_Tashkeel_text": "كلا سيكفرون بعبادتهم ويكونون عليهم ضدا"
  },
  {
    "number": 2333,
    "text": "أَلَمۡ تَرَ أَنَّآ أَرۡسَلۡنَا ٱلشَّيَٰطِينَ عَلَى ٱلۡكَٰفِرِينَ تَؤُزُّهُمۡ أَزّٗا",
    "numberInSurah": 83,
    "juz": 16,
    "manzil": 4,
    "page": 311,
    "ruku": 269,
    "hizbQuarter": 124,
    "sajda": false,
    "no_Tashkeel_text": "ألم تر أنا أرسلنا الشياطين على الكافرين تؤزهم أزا"
  },
  {
    "number": 2334,
    "text": "فَلَا تَعۡجَلۡ عَلَيۡهِمۡۖ إِنَّمَا نَعُدُّ لَهُمۡ عَدّٗا",
    "numberInSurah": 84,
    "juz": 16,
    "manzil": 4,
    "page": 311,
    "ruku": 269,
    "hizbQuarter": 124,
    "sajda": false,
    "no_Tashkeel_text": "فلا تعجل عليهم إنما نعد لهم عدا"
  },
  {
    "number": 2335,
    "text": "يَوۡمَ نَحۡشُرُ ٱلۡمُتَّقِينَ إِلَى ٱلرَّحۡمَٰنِ وَفۡدٗا",
    "numberInSurah": 85,
    "juz": 16,
    "manzil": 4,
    "page": 311,
    "ruku": 269,
    "hizbQuarter": 124,
    "sajda": false,
    "no_Tashkeel_text": "يوم نحشر المتقين إلى الرحمن وفدا"
  },
  {
    "number": 2336,
    "text": "وَنَسُوقُ ٱلۡمُجۡرِمِينَ إِلَىٰ جَهَنَّمَ وِرۡدٗا",
    "numberInSurah": 86,
    "juz": 16,
    "manzil": 4,
    "page": 311,
    "ruku": 269,
    "hizbQuarter": 124,
    "sajda": false,
    "no_Tashkeel_text": "ونسوق المجرمين إلى جهنم وردا"
  },
  {
    "number": 2337,
    "text": "لَّا يَمۡلِكُونَ ٱلشَّفَٰعَةَ إِلَّا مَنِ ٱتَّخَذَ عِندَ ٱلرَّحۡمَٰنِ عَهۡدٗا",
    "numberInSurah": 87,
    "juz": 16,
    "manzil": 4,
    "page": 311,
    "ruku": 269,
    "hizbQuarter": 124,
    "sajda": false,
    "no_Tashkeel_text": "لا يملكون الشفاعة إلا من اتخذ عند الرحمن عهدا"
  },
  {
    "number": 2338,
    "text": "وَقَالُواْ ٱتَّخَذَ ٱلرَّحۡمَٰنُ وَلَدٗا",
    "numberInSurah": 88,
    "juz": 16,
    "manzil": 4,
    "page": 311,
    "ruku": 269,
    "hizbQuarter": 124,
    "sajda": false,
    "no_Tashkeel_text": "وقالوا اتخذ الرحمن ولدا"
  },
  {
    "number": 2339,
    "text": "لَّقَدۡ جِئۡتُمۡ شَيۡـًٔا إِدّٗا",
    "numberInSurah": 89,
    "juz": 16,
    "manzil": 4,
    "page": 311,
    "ruku": 269,
    "hizbQuarter": 124,
    "sajda": false,
    "no_Tashkeel_text": "لقد جئتم شيئا إدا"
  },
  {
    "number": 2340,
    "text": "تَكَادُ ٱلسَّمَٰوَٰتُ يَتَفَطَّرۡنَ مِنۡهُ وَتَنشَقُّ ٱلۡأَرۡضُ وَتَخِرُّ ٱلۡجِبَالُ هَدًّا",
    "numberInSurah": 90,
    "juz": 16,
    "manzil": 4,
    "page": 311,
    "ruku": 269,
    "hizbQuarter": 124,
    "sajda": false,
    "no_Tashkeel_text": "تكاد السماوات يتفطرن منه وتنشق الأرض وتخر الجبال هدا"
  },
  {
    "number": 2341,
    "text": "أَن دَعَوۡاْ لِلرَّحۡمَٰنِ وَلَدٗا",
    "numberInSurah": 91,
    "juz": 16,
    "manzil": 4,
    "page": 311,
    "ruku": 269,
    "hizbQuarter": 124,
    "sajda": false,
    "no_Tashkeel_text": "أن دعوا للرحمن ولدا"
  },
  {
    "number": 2342,
    "text": "وَمَا يَنۢبَغِي لِلرَّحۡمَٰنِ أَن يَتَّخِذَ وَلَدًا",
    "numberInSurah": 92,
    "juz": 16,
    "manzil": 4,
    "page": 311,
    "ruku": 269,
    "hizbQuarter": 124,
    "sajda": false,
    "no_Tashkeel_text": "وما ينبغي للرحمن أن يتخذ ولدا"
  },
  {
    "number": 2343,
    "text": "إِن كُلُّ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ إِلَّآ ءَاتِي ٱلرَّحۡمَٰنِ عَبۡدٗا",
    "numberInSurah": 93,
    "juz": 16,
    "manzil": 4,
    "page": 311,
    "ruku": 269,
    "hizbQuarter": 124,
    "sajda": false,
    "no_Tashkeel_text": "إن كل من في السماوات والأرض إلا آتي الرحمن عبدا"
  },
  {
    "number": 2344,
    "text": "لَّقَدۡ أَحۡصَىٰهُمۡ وَعَدَّهُمۡ عَدّٗا",
    "numberInSurah": 94,
    "juz": 16,
    "manzil": 4,
    "page": 311,
    "ruku": 269,
    "hizbQuarter": 124,
    "sajda": false,
    "no_Tashkeel_text": "لقد أحصاهم وعدهم عدا"
  },
  {
    "number": 2345,
    "text": "وَكُلُّهُمۡ ءَاتِيهِ يَوۡمَ ٱلۡقِيَٰمَةِ فَرۡدًا",
    "numberInSurah": 95,
    "juz": 16,
    "manzil": 4,
    "page": 311,
    "ruku": 269,
    "hizbQuarter": 124,
    "sajda": false,
    "no_Tashkeel_text": "وكلهم آتيه يوم القيامة فردا"
  }
]