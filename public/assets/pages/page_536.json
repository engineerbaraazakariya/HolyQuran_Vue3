[
  {
    "number": 5030,
    "text": "ثُمَّ إِنَّكُمۡ أَيُّهَا ٱلضَّآلُّونَ ٱلۡمُكَذِّبُونَ",
    "numberInSurah": 51,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 470,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "ثم إنكم أيها الضالون المكذبون"
  },
  {
    "number": 5031,
    "text": "لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ",
    "numberInSurah": 52,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 470,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "لآكلون من شجر من زقوم"
  },
  {
    "number": 5032,
    "text": "فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ",
    "numberInSurah": 53,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 470,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "فمالئون منها البطون"
  },
  {
    "number": 5033,
    "text": "فَشَٰرِبُونَ عَلَيۡهِ مِنَ ٱلۡحَمِيمِ",
    "numberInSurah": 54,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 470,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "فشاربون عليه من الحميم"
  },
  {
    "number": 5034,
    "text": "فَشَٰرِبُونَ شُرۡبَ ٱلۡهِيمِ",
    "numberInSurah": 55,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 470,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "فشاربون شرب الهيم"
  },
  {
    "number": 5035,
    "text": "هَٰذَا نُزُلُهُمۡ يَوۡمَ ٱلدِّينِ",
    "numberInSurah": 56,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 470,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "هذا نزلهم يوم الدين"
  },
  {
    "number": 5036,
    "text": "نَحۡنُ خَلَقۡنَٰكُمۡ فَلَوۡلَا تُصَدِّقُونَ",
    "numberInSurah": 57,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 470,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "نحن خلقناكم فلولا تصدقون"
  },
  {
    "number": 5037,
    "text": "أَفَرَءَيۡتُم مَّا تُمۡنُونَ",
    "numberInSurah": 58,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 470,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "أفرأيتم ما تمنون"
  },
  {
    "number": 5038,
    "text": "ءَأَنتُمۡ تَخۡلُقُونَهُۥٓ أَمۡ نَحۡنُ ٱلۡخَٰلِقُونَ",
    "numberInSurah": 59,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 470,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "أأنتم تخلقونه أم نحن الخالقون"
  },
  {
    "number": 5039,
    "text": "نَحۡنُ قَدَّرۡنَا بَيۡنَكُمُ ٱلۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ",
    "numberInSurah": 60,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 470,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "نحن قدرنا بينكم الموت وما نحن بمسبوقين"
  },
  {
    "number": 5040,
    "text": "عَلَىٰٓ أَن نُّبَدِّلَ أَمۡثَٰلَكُمۡ وَنُنشِئَكُمۡ فِي مَا لَا تَعۡلَمُونَ",
    "numberInSurah": 61,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 470,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "على أن نبدل أمثالكم وننشئكم في ما لا تعلمون"
  },
  {
    "number": 5041,
    "text": "وَلَقَدۡ عَلِمۡتُمُ ٱلنَّشۡأَةَ ٱلۡأُولَىٰ فَلَوۡلَا تَذَكَّرُونَ",
    "numberInSurah": 62,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 470,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "ولقد علمتم النشأة الأولى فلولا تذكرون"
  },
  {
    "number": 5042,
    "text": "أَفَرَءَيۡتُم مَّا تَحۡرُثُونَ",
    "numberInSurah": 63,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 470,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "أفرأيتم ما تحرثون"
  },
  {
    "number": 5043,
    "text": "ءَأَنتُمۡ تَزۡرَعُونَهُۥٓ أَمۡ نَحۡنُ ٱلزَّـٰرِعُونَ",
    "numberInSurah": 64,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 470,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "أأنتم تزرعونه أم نحن الزارعون"
  },
  {
    "number": 5044,
    "text": "لَوۡ نَشَآءُ لَجَعَلۡنَٰهُ حُطَٰمٗا فَظَلۡتُمۡ تَفَكَّهُونَ",
    "numberInSurah": 65,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 470,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "لو نشاء لجعلناه حطاما فظلتم تفكهون"
  },
  {
    "number": 5045,
    "text": "إِنَّا لَمُغۡرَمُونَ",
    "numberInSurah": 66,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 470,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "إنا لمغرمون"
  },
  {
    "number": 5046,
    "text": "بَلۡ نَحۡنُ مَحۡرُومُونَ",
    "numberInSurah": 67,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 470,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "بل نحن محرومون"
  },
  {
    "number": 5047,
    "text": "أَفَرَءَيۡتُمُ ٱلۡمَآءَ ٱلَّذِي تَشۡرَبُونَ",
    "numberInSurah": 68,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 470,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "أفرأيتم الماء الذي تشربون"
  },
  {
    "number": 5048,
    "text": "ءَأَنتُمۡ أَنزَلۡتُمُوهُ مِنَ ٱلۡمُزۡنِ أَمۡ نَحۡنُ ٱلۡمُنزِلُونَ",
    "numberInSurah": 69,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 470,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "أأنتم أنزلتموه من المزن أم نحن المنزلون"
  },
  {
    "number": 5049,
    "text": "لَوۡ نَشَآءُ جَعَلۡنَٰهُ أُجَاجٗا فَلَوۡلَا تَشۡكُرُونَ",
    "numberInSurah": 70,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 470,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "لو نشاء جعلناه أجاجا فلولا تشكرون"
  },
  {
    "number": 5050,
    "text": "أَفَرَءَيۡتُمُ ٱلنَّارَ ٱلَّتِي تُورُونَ",
    "numberInSurah": 71,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 470,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "أفرأيتم النار التي تورون"
  },
  {
    "number": 5051,
    "text": "ءَأَنتُمۡ أَنشَأۡتُمۡ شَجَرَتَهَآ أَمۡ نَحۡنُ ٱلۡمُنشِـُٔونَ",
    "numberInSurah": 72,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 470,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "أأنتم أنشأتم شجرتها أم نحن المنشئون"
  },
  {
    "number": 5052,
    "text": "نَحۡنُ جَعَلۡنَٰهَا تَذۡكِرَةٗ وَمَتَٰعٗا لِّلۡمُقۡوِينَ",
    "numberInSurah": 73,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 470,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "نحن جعلناها تذكرة ومتاعا للمقوين"
  },
  {
    "number": 5053,
    "text": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ",
    "numberInSurah": 74,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 470,
    "hizbQuarter": 214,
    "sajda": false,
    "no_Tashkeel_text": "فسبح باسم ربك العظيم"
  },
  {
    "number": 5054,
    "text": "۞فَلَآ أُقۡسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ",
    "numberInSurah": 75,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 471,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "فلا أقسم بمواقع النجوم"
  },
  {
    "number": 5055,
    "text": "وَإِنَّهُۥ لَقَسَمٞ لَّوۡ تَعۡلَمُونَ عَظِيمٌ",
    "numberInSurah": 76,
    "juz": 27,
    "manzil": 7,
    "page": 536,
    "ruku": 471,
    "hizbQuarter": 215,
    "sajda": false,
    "no_Tashkeel_text": "وإنه لقسم لو تعلمون عظيم"
  }
]