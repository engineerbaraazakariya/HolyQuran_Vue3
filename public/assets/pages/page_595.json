[
  {
    "number": 6044,
    "text": "وَٱلشَّمۡسِ وَضُحَىٰهَا",
    "numberInSurah": 1,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 533,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم والشمس وضحاها"
  },
  {
    "number": 6045,
    "text": "وَٱلۡقَمَرِ إِذَا تَلَىٰهَا",
    "numberInSurah": 2,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 533,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "والقمر إذا تلاها"
  },
  {
    "number": 6046,
    "text": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا",
    "numberInSurah": 3,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 533,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "والنهار إذا جلاها"
  },
  {
    "number": 6047,
    "text": "وَٱلَّيۡلِ إِذَا يَغۡشَىٰهَا",
    "numberInSurah": 4,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 533,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "والليل إذا يغشاها"
  },
  {
    "number": 6048,
    "text": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا",
    "numberInSurah": 5,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 533,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "والسماء وما بناها"
  },
  {
    "number": 6049,
    "text": "وَٱلۡأَرۡضِ وَمَا طَحَىٰهَا",
    "numberInSurah": 6,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 533,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "والأرض وما طحاها"
  },
  {
    "number": 6050,
    "text": "وَنَفۡسٖ وَمَا سَوَّىٰهَا",
    "numberInSurah": 7,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 533,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "ونفس وما سواها"
  },
  {
    "number": 6051,
    "text": "فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡوَىٰهَا",
    "numberInSurah": 8,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 533,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "فألهمها فجورها وتقواها"
  },
  {
    "number": 6052,
    "text": "قَدۡ أَفۡلَحَ مَن زَكَّىٰهَا",
    "numberInSurah": 9,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 533,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "قد أفلح من زكاها"
  },
  {
    "number": 6053,
    "text": "وَقَدۡ خَابَ مَن دَسَّىٰهَا",
    "numberInSurah": 10,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 533,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "وقد خاب من دساها"
  },
  {
    "number": 6054,
    "text": "كَذَّبَتۡ ثَمُودُ بِطَغۡوَىٰهَآ",
    "numberInSurah": 11,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 533,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "كذبت ثمود بطغواها"
  },
  {
    "number": 6055,
    "text": "إِذِ ٱنۢبَعَثَ أَشۡقَىٰهَا",
    "numberInSurah": 12,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 533,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "إذ انبعث أشقاها"
  },
  {
    "number": 6056,
    "text": "فَقَالَ لَهُمۡ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقۡيَٰهَا",
    "numberInSurah": 13,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 533,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "فقال لهم رسول الله ناقة الله وسقياها"
  },
  {
    "number": 6057,
    "text": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمۡدَمَ عَلَيۡهِمۡ رَبُّهُم بِذَنۢبِهِمۡ فَسَوَّىٰهَا",
    "numberInSurah": 14,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 533,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "فكذبوه فعقروها فدمدم عليهم ربهم بذنبهم فسواها"
  },
  {
    "number": 6058,
    "text": "وَلَا يَخَافُ عُقۡبَٰهَا",
    "numberInSurah": 15,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 533,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "ولا يخاف عقباها"
  },
  {
    "number": 6059,
    "text": "وَٱلَّيۡلِ إِذَا يَغۡشَىٰ",
    "numberInSurah": 1,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 534,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم والليل إذا يغشى"
  },
  {
    "number": 6060,
    "text": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",
    "numberInSurah": 2,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 534,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "والنهار إذا تجلى"
  },
  {
    "number": 6061,
    "text": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ",
    "numberInSurah": 3,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 534,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "وما خلق الذكر والأنثى"
  },
  {
    "number": 6062,
    "text": "إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ",
    "numberInSurah": 4,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 534,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "إن سعيكم لشتى"
  },
  {
    "number": 6063,
    "text": "فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ",
    "numberInSurah": 5,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 534,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "فأما من أعطى واتقى"
  },
  {
    "number": 6064,
    "text": "وَصَدَّقَ بِٱلۡحُسۡنَىٰ",
    "numberInSurah": 6,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 534,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "وصدق بالحسنى"
  },
  {
    "number": 6065,
    "text": "فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ",
    "numberInSurah": 7,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 534,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "فسنيسره لليسرى"
  },
  {
    "number": 6066,
    "text": "وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ",
    "numberInSurah": 8,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 534,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "وأما من بخل واستغنى"
  },
  {
    "number": 6067,
    "text": "وَكَذَّبَ بِٱلۡحُسۡنَىٰ",
    "numberInSurah": 9,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 534,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "وكذب بالحسنى"
  },
  {
    "number": 6068,
    "text": "فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ",
    "numberInSurah": 10,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 534,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "فسنيسره للعسرى"
  },
  {
    "number": 6069,
    "text": "وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",
    "numberInSurah": 11,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 534,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "وما يغني عنه ماله إذا تردى"
  },
  {
    "number": 6070,
    "text": "إِنَّ عَلَيۡنَا لَلۡهُدَىٰ",
    "numberInSurah": 12,
    "juz": 30,
    "manzil": 7,
    "page": 595,
    "ruku": 534,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "إن علينا للهدى"
  },
  {
    "number": 6071,
    "text": "وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ",
