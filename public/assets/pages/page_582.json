[
  {
    "number": 5673,
    "text": "عَمَّ يَتَسَآءَلُونَ",
    "numberInSurah": 1,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم عم يتساءلون"
  },
  {
    "number": 5674,
    "text": "عَنِ ٱلنَّبَإِ ٱلۡعَظِيمِ",
    "numberInSurah": 2,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "عن النبإ العظيم"
  },
  {
    "number": 5675,
    "text": "ٱلَّذِي هُمۡ فِيهِ مُخۡتَلِفُونَ",
    "numberInSurah": 3,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "الذي هم فيه مختلفون"
  },
  {
    "number": 5676,
    "text": "كَلَّا سَيَعۡلَمُونَ",
    "numberInSurah": 4,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "كلا سيعلمون"
  },
  {
    "number": 5677,
    "text": "ثُمَّ كَلَّا سَيَعۡلَمُونَ",
    "numberInSurah": 5,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "ثم كلا سيعلمون"
  },
  {
    "number": 5678,
    "text": "أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَٰدٗا",
    "numberInSurah": 6,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "ألم نجعل الأرض مهادا"
  },
  {
    "number": 5679,
    "text": "وَٱلۡجِبَالَ أَوۡتَادٗا",
    "numberInSurah": 7,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "والجبال أوتادا"
  },
  {
    "number": 5680,
    "text": "وَخَلَقۡنَٰكُمۡ أَزۡوَٰجٗا",
    "numberInSurah": 8,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "وخلقناكم أزواجا"
  },
  {
    "number": 5681,
    "text": "وَجَعَلۡنَا نَوۡمَكُمۡ سُبَاتٗا",
    "numberInSurah": 9,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "وجعلنا نومكم سباتا"
  },
  {
    "number": 5682,
    "text": "وَجَعَلۡنَا ٱلَّيۡلَ لِبَاسٗا",
    "numberInSurah": 10,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "وجعلنا الليل لباسا"
  },
  {
    "number": 5683,
    "text": "وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشٗا",
    "numberInSurah": 11,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "وجعلنا النهار معاشا"
  },
  {
    "number": 5684,
    "text": "وَبَنَيۡنَا فَوۡقَكُمۡ سَبۡعٗا شِدَادٗا",
    "numberInSurah": 12,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "وبنينا فوقكم سبعا شدادا"
  },
  {
    "number": 5685,
    "text": "وَجَعَلۡنَا سِرَاجٗا وَهَّاجٗا",
    "numberInSurah": 13,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "وجعلنا سراجا وهاجا"
  },
  {
    "number": 5686,
    "text": "وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَٰتِ مَآءٗ ثَجَّاجٗا",
    "numberInSurah": 14,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "وأنزلنا من المعصرات ماء ثجاجا"
  },
  {
    "number": 5687,
    "text": "لِّنُخۡرِجَ بِهِۦ حَبّٗا وَنَبَاتٗا",
    "numberInSurah": 15,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "لنخرج به حبا ونباتا"
  },
  {
    "number": 5688,
    "text": "وَجَنَّـٰتٍ أَلۡفَافًا",
    "numberInSurah": 16,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "وجنات ألفافا"
  },
  {
    "number": 5689,
    "text": "إِنَّ يَوۡمَ ٱلۡفَصۡلِ كَانَ مِيقَٰتٗا",
    "numberInSurah": 17,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "إن يوم الفصل كان ميقاتا"
  },
  {
    "number": 5690,
    "text": "يَوۡمَ يُنفَخُ فِي ٱلصُّورِ فَتَأۡتُونَ أَفۡوَاجٗا",
    "numberInSurah": 18,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "يوم ينفخ في الصور فتأتون أفواجا"
  },
  {
    "number": 5691,
    "text": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتۡ أَبۡوَٰبٗا",
    "numberInSurah": 19,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "وفتحت السماء فكانت أبوابا"
  },
  {
    "number": 5692,
    "text": "وَسُيِّرَتِ ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا",
    "numberInSurah": 20,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "وسيرت الجبال فكانت سرابا"
  },
  {
    "number": 5693,
    "text": "إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادٗا",
    "numberInSurah": 21,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "إن جهنم كانت مرصادا"
  },
  {
    "number": 5694,
    "text": "لِّلطَّـٰغِينَ مَـَٔابٗا",
    "numberInSurah": 22,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "للطاغين مآبا"
  },
  {
    "number": 5695,
    "text": "لَّـٰبِثِينَ فِيهَآ أَحۡقَابٗا",
    "numberInSurah": 23,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "لابثين فيها أحقابا"
  },
  {
    "number": 5696,
    "text": "لَّا يَذُوقُونَ فِيهَا بَرۡدٗا وَلَا شَرَابًا",
    "numberInSurah": 24,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "لا يذوقون فيها بردا ولا شرابا"
  },
  {
    "number": 5697,
    "text": "إِلَّا حَمِيمٗا وَغَسَّاقٗا",
    "numberInSurah": 25,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "إلا حميما وغساقا"
  },
  {
    "number": 5698,
    "text": "جَزَآءٗ وِفَاقًا",
    "numberInSurah": 26,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "جزاء وفاقا"
  },
  {
    "number": 5699,
    "text": "إِنَّهُمۡ كَانُواْ لَا يَرۡجُونَ حِسَابٗا",
    "numberInSurah": 27,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "إنهم كانوا لا يرجون حسابا"
  },
  {
    "number": 5700,
    "text": "وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّابٗا",
    "numberInSurah": 28,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "وكذبوا بآياتنا كذابا"
  },
  {
    "number": 5701,
    "text": "وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُ كِتَٰبٗا",
    "numberInSurah": 29,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "وكل شيء أحصيناه كتابا"
  },
  {
    "number": 5702,
    "text": "فَذُوقُواْ فَلَن نَّزِيدَكُمۡ إِلَّا عَذَابًا",
    "numberInSurah": 30,
    "juz": 30,
    "manzil": 7,
    "page": 582,
    "ruku": 518,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "فذوقوا فلن نزيدكم إلا عذابا"
  }
]