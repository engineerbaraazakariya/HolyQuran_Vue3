[
  {
    "number": 4785,
    "text": "وَٱلنَّجۡمِ إِذَا هَوَىٰ",
    "numberInSurah": 1,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم والنجم إذا هوى"
  },
  {
    "number": 4786,
    "text": "مَا ضَلَّ صَاحِبُكُمۡ وَمَا غَوَىٰ",
    "numberInSurah": 2,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "ما ضل صاحبكم وما غوى"
  },
  {
    "number": 4787,
    "text": "وَمَا يَنطِقُ عَنِ ٱلۡهَوَىٰٓ",
    "numberInSurah": 3,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "وما ينطق عن الهوى"
  },
  {
    "number": 4788,
    "text": "إِنۡ هُوَ إِلَّا وَحۡيٞ يُوحَىٰ",
    "numberInSurah": 4,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "إن هو إلا وحي يوحى"
  },
  {
    "number": 4789,
    "text": "عَلَّمَهُۥ شَدِيدُ ٱلۡقُوَىٰ",
    "numberInSurah": 5,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "علمه شديد القوى"
  },
  {
    "number": 4790,
    "text": "ذُو مِرَّةٖ فَٱسۡتَوَىٰ",
    "numberInSurah": 6,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "ذو مرة فاستوى"
  },
  {
    "number": 4791,
    "text": "وَهُوَ بِٱلۡأُفُقِ ٱلۡأَعۡلَىٰ",
    "numberInSurah": 7,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "وهو بالأفق الأعلى"
  },
  {
    "number": 4792,
    "text": "ثُمَّ دَنَا فَتَدَلَّىٰ",
    "numberInSurah": 8,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "ثم دنا فتدلى"
  },
  {
    "number": 4793,
    "text": "فَكَانَ قَابَ قَوۡسَيۡنِ أَوۡ أَدۡنَىٰ",
    "numberInSurah": 9,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "فكان قاب قوسين أو أدنى"
  },
  {
    "number": 4794,
    "text": "فَأَوۡحَىٰٓ إِلَىٰ عَبۡدِهِۦ مَآ أَوۡحَىٰ",
    "numberInSurah": 10,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "فأوحى إلى عبده ما أوحى"
  },
  {
    "number": 4795,
    "text": "مَا كَذَبَ ٱلۡفُؤَادُ مَا رَأَىٰٓ",
    "numberInSurah": 11,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "ما كذب الفؤاد ما رأى"
  },
  {
    "number": 4796,
    "text": "أَفَتُمَٰرُونَهُۥ عَلَىٰ مَا يَرَىٰ",
    "numberInSurah": 12,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "أفتمارونه على ما يرى"
  },
  {
    "number": 4797,
    "text": "وَلَقَدۡ رَءَاهُ نَزۡلَةً أُخۡرَىٰ",
    "numberInSurah": 13,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "ولقد رآه نزلة أخرى"
  },
  {
    "number": 4798,
    "text": "عِندَ سِدۡرَةِ ٱلۡمُنتَهَىٰ",
    "numberInSurah": 14,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "عند سدرة المنتهى"
  },
  {
    "number": 4799,
    "text": "عِندَهَا جَنَّةُ ٱلۡمَأۡوَىٰٓ",
    "numberInSurah": 15,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "عندها جنة المأوى"
  },
  {
    "number": 4800,
    "text": "إِذۡ يَغۡشَى ٱلسِّدۡرَةَ مَا يَغۡشَىٰ",
    "numberInSurah": 16,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "إذ يغشى السدرة ما يغشى"
  },
  {
    "number": 4801,
    "text": "مَا زَاغَ ٱلۡبَصَرُ وَمَا طَغَىٰ",
    "numberInSurah": 17,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "ما زاغ البصر وما طغى"
  },
  {
    "number": 4802,
    "text": "لَقَدۡ رَأَىٰ مِنۡ ءَايَٰتِ رَبِّهِ ٱلۡكُبۡرَىٰٓ",
    "numberInSurah": 18,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "لقد رأى من آيات ربه الكبرى"
  },
  {
    "number": 4803,
    "text": "أَفَرَءَيۡتُمُ ٱللَّـٰتَ وَٱلۡعُزَّىٰ",
    "numberInSurah": 19,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "أفرأيتم اللات والعزى"
  },
  {
    "number": 4804,
    "text": "وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلۡأُخۡرَىٰٓ",
    "numberInSurah": 20,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "ومناة الثالثة الأخرى"
  },
  {
    "number": 4805,
    "text": "أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلۡأُنثَىٰ",
    "numberInSurah": 21,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "ألكم الذكر وله الأنثى"
  },
  {
    "number": 4806,
    "text": "تِلۡكَ إِذٗا قِسۡمَةٞ ضِيزَىٰٓ",
    "numberInSurah": 22,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "تلك إذا قسمة ضيزى"
  },
  {
    "number": 4807,
    "text": "إِنۡ هِيَ إِلَّآ أَسۡمَآءٞ سَمَّيۡتُمُوهَآ أَنتُمۡ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلۡطَٰنٍۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهۡوَى ٱلۡأَنفُسُۖ وَلَقَدۡ جَآءَهُم مِّن رَّبِّهِمُ ٱلۡهُدَىٰٓ",
    "numberInSurah": 23,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "إن هي إلا أسماء سميتموها أنتم وآباؤكم ما أنزل الله بها من سلطان إن يتبعون إلا الظن وما تهوى الأنفس ولقد جاءهم من ربهم الهدى"
  },
  {
    "number": 4808,
    "text": "أَمۡ لِلۡإِنسَٰنِ مَا تَمَنَّىٰ",
    "numberInSurah": 24,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "أم للإنسان ما تمنى"
  },
  {
    "number": 4809,
    "text": "فَلِلَّهِ ٱلۡأٓخِرَةُ وَٱلۡأُولَىٰ",
    "numberInSurah": 25,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 460,
    "hizbQuarter": 210,
    "sajda": false,
    "no_Tashkeel_text": "فلله الآخرة والأولى"
  },
  {
    "number": 4810,
    "text": "۞وَكَم مِّن مَّلَكٖ فِي ٱلسَّمَٰوَٰتِ لَا تُغۡنِي شَفَٰعَتُهُمۡ شَيۡـًٔا إِلَّا مِنۢ بَعۡدِ أَن يَأۡذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرۡضَىٰٓ",
    "numberInSurah": 26,
    "juz": 27,
    "manzil": 7,
    "page": 526,
    "ruku": 461,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "وكم من ملك في السماوات لا تغني شفاعتهم شيئا إلا من بعد أن يأذن الله لمن يشاء ويرضى"
  }
]