    "manzil": 7,
    "page": 600,
    "ruku": 543,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "فهو في عيشة راضية"
  },
  {
    "number": 6165,
    "text": "وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ",
