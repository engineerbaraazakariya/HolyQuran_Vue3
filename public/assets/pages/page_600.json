    "manzil": 7,
    "page": 600,
    "ruku": 543,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "فأمه هاوية"
  },
  {
    "number": 6167,
    "text": "وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ",
