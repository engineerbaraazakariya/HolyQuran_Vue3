    "text": "مَا ٱلۡقَارِعَةُ",
    "numberInSurah": 2,
    "juz": 30,
    "manzil": 7,
    "page": 600,
    "ruku": 543,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "ما القارعة"
  },
  {
    "number": 6160,
    "text": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ",
    "numberInSurah": 3,
    "juz": 30,
    "manzil": 7,
    "page": 600,
    "ruku": 543,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "وما أدراك ما القارعة"
  },
  {
    "number": 6161,
    "text": "يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ",
    "numberInSurah": 4,
    "juz": 30,
    "manzil": 7,
    "page": 600,
    "ruku": 543,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "يوم يكون الناس كالفراش المبثوث"
  },
  {
    "number": 6162,
    "text": "وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ",
    "numberInSurah": 5,
    "juz": 30,
    "manzil": 7,
    "page": 600,
    "ruku": 543,
    "hizbQuarter": 240,
    "sajda": false,
