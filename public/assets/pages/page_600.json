    "manzil": 7,
    "page": 600,
    "ruku": 543,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "نار حامية"
  },
  {
    "number": 6169,
    "text": "أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ",
