    "juz": 30,
    "manzil": 7,
    "page": 600,
    "ruku": 543,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "وأما من خفت موازينه"
  },
  {
    "number": 6166,
    "text": "فَأُمُّهُۥ هَاوِيَةٞ",
