    "juz": 30,
    "manzil": 7,
    "page": 600,
    "ruku": 543,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "فأما من ثقلت موازينه"
  },
  {
    "number": 6164,
    "text": "فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ",
