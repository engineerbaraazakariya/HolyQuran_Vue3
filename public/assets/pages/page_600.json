    "manzil": 7,
    "page": 600,
    "ruku": 544,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم ألهاكم التكاثر"
  },
  {
    "number": 6170,
    "text": "حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ",
