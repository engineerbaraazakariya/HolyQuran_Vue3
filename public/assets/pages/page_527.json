[
  {
    "number": 4811,
    "text": "إِنَّ ٱلَّذِينَ لَا يُؤۡمِنُونَ بِٱلۡأٓخِرَةِ لَيُسَمُّونَ ٱلۡمَلَـٰٓئِكَةَ تَسۡمِيَةَ ٱلۡأُنثَىٰ",
    "numberInSurah": 27,
    "juz": 27,
    "manzil": 7,
    "page": 527,
    "ruku": 461,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "إن الذين لا يؤمنون بالآخرة ليسمون الملائكة تسمية الأنثى"
  },
  {
    "number": 4812,
    "text": "وَمَا لَهُم بِهِۦ مِنۡ عِلۡمٍۖ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّۖ وَإِنَّ ٱلظَّنَّ لَا يُغۡنِي مِنَ ٱلۡحَقِّ شَيۡـٔٗا",
    "numberInSurah": 28,
    "juz": 27,
    "manzil": 7,
    "page": 527,
    "ruku": 461,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "وما لهم به من علم إن يتبعون إلا الظن وإن الظن لا يغني من الحق شيئا"
  },
  {
    "number": 4813,
    "text": "فَأَعۡرِضۡ عَن مَّن تَوَلَّىٰ عَن ذِكۡرِنَا وَلَمۡ يُرِدۡ إِلَّا ٱلۡحَيَوٰةَ ٱلدُّنۡيَا",
    "numberInSurah": 29,
    "juz": 27,
    "manzil": 7,
    "page": 527,
    "ruku": 461,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "فأعرض عن من تولى عن ذكرنا ولم يرد إلا الحياة الدنيا"
  },
  {
    "number": 4814,
    "text": "ذَٰلِكَ مَبۡلَغُهُم مِّنَ ٱلۡعِلۡمِۚ إِنَّ رَبَّكَ هُوَ أَعۡلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعۡلَمُ بِمَنِ ٱهۡتَدَىٰ",
    "numberInSurah": 30,
    "juz": 27,
    "manzil": 7,
    "page": 527,
    "ruku": 461,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "ذلك مبلغهم من العلم إن ربك هو أعلم بمن ضل عن سبيله وهو أعلم بمن اهتدى"
  },
  {
    "number": 4815,
    "text": "وَلِلَّهِ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِ لِيَجۡزِيَ ٱلَّذِينَ أَسَـٰٓـُٔواْ بِمَا عَمِلُواْ وَيَجۡزِيَ ٱلَّذِينَ أَحۡسَنُواْ بِٱلۡحُسۡنَى",
    "numberInSurah": 31,
    "juz": 27,
    "manzil": 7,
    "page": 527,
    "ruku": 461,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "ولله ما في السماوات وما في الأرض ليجزي الذين أساءوا بما عملوا ويجزي الذين أحسنوا بالحسنى"
  },
  {
    "number": 4816,
    "text": "ٱلَّذِينَ يَجۡتَنِبُونَ كَبَـٰٓئِرَ ٱلۡإِثۡمِ وَٱلۡفَوَٰحِشَ إِلَّا ٱللَّمَمَۚ إِنَّ رَبَّكَ وَٰسِعُ ٱلۡمَغۡفِرَةِۚ هُوَ أَعۡلَمُ بِكُمۡ إِذۡ أَنشَأَكُم مِّنَ ٱلۡأَرۡضِ وَإِذۡ أَنتُمۡ أَجِنَّةٞ فِي بُطُونِ أُمَّهَٰتِكُمۡۖ فَلَا تُزَكُّوٓاْ أَنفُسَكُمۡۖ هُوَ أَعۡلَمُ بِمَنِ ٱتَّقَىٰٓ",
    "numberInSurah": 32,
    "juz": 27,
    "manzil": 7,
    "page": 527,
    "ruku": 461,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "الذين يجتنبون كبائر الإثم والفواحش إلا اللمم إن ربك واسع المغفرة هو أعلم بكم إذ أنشأكم من الأرض وإذ أنتم أجنة في بطون أمهاتكم فلا تزكوا أنفسكم هو أعلم بمن اتقى"
  },
  {
    "number": 4817,
    "text": "أَفَرَءَيۡتَ ٱلَّذِي تَوَلَّىٰ",
    "numberInSurah": 33,
    "juz": 27,
    "manzil": 7,
    "page": 527,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "أفرأيت الذي تولى"
  },
  {
    "number": 4818,
    "text": "وَأَعۡطَىٰ قَلِيلٗا وَأَكۡدَىٰٓ",
    "numberInSurah": 34,
    "juz": 27,
    "manzil": 7,
    "page": 527,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "وأعطى قليلا وأكدى"
  },
  {
    "number": 4819,
    "text": "أَعِندَهُۥ عِلۡمُ ٱلۡغَيۡبِ فَهُوَ يَرَىٰٓ",
    "numberInSurah": 35,
    "juz": 27,
    "manzil": 7,
    "page": 527,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "أعنده علم الغيب فهو يرى"
  },
  {
    "number": 4820,
    "text": "أَمۡ لَمۡ يُنَبَّأۡ بِمَا فِي صُحُفِ مُوسَىٰ",
    "numberInSurah": 36,
    "juz": 27,
    "manzil": 7,
    "page": 527,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "أم لم ينبأ بما في صحف موسى"
  },
  {
    "number": 4821,
    "text": "وَإِبۡرَٰهِيمَ ٱلَّذِي وَفَّىٰٓ",
    "numberInSurah": 37,
    "juz": 27,
    "manzil": 7,
    "page": 527,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "وإبراهيم الذي وفى"
  },
  {
    "number": 4822,
    "text": "أَلَّا تَزِرُ وَازِرَةٞ وِزۡرَ أُخۡرَىٰ",
    "numberInSurah": 38,
    "juz": 27,
    "manzil": 7,
    "page": 527,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "ألا تزر وازرة وزر أخرى"
  },
  {
    "number": 4823,
    "text": "وَأَن لَّيۡسَ لِلۡإِنسَٰنِ إِلَّا مَا سَعَىٰ",
    "numberInSurah": 39,
    "juz": 27,
    "manzil": 7,
    "page": 527,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "وأن ليس للإنسان إلا ما سعى"
  },
  {
    "number": 4824,
    "text": "وَأَنَّ سَعۡيَهُۥ سَوۡفَ يُرَىٰ",
    "numberInSurah": 40,
    "juz": 27,
    "manzil": 7,
    "page": 527,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "وأن سعيه سوف يرى"
  },
  {
    "number": 4825,
    "text": "ثُمَّ يُجۡزَىٰهُ ٱلۡجَزَآءَ ٱلۡأَوۡفَىٰ",
    "numberInSurah": 41,
    "juz": 27,
    "manzil": 7,
    "page": 527,
    "ruku": 462,
    "hizbQuarter": 211,
    "sajda": false,
    "no_Tashkeel_text": "ثم يجزاه الجزاء الأوفى"
  },
  {
    "number": 4826,
    "text": "وَأَنَّ إِلَىٰ رَبِّكَ ٱلۡمُنتَهَىٰ",
