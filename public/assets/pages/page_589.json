[
  {
    "number": 5883,
    "text": "عَلَى ٱلۡأَرَآئِكِ يَنظُرُونَ",
    "numberInSurah": 35,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 525,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "على الأرائك ينظرون"
  },
  {
    "number": 5884,
    "text": "هَلۡ ثُوِّبَ ٱلۡكُفَّارُ مَا كَانُواْ يَفۡعَلُونَ",
    "numberInSurah": 36,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 525,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "هل ثوب الكفار ما كانوا يفعلون"
  },
  {
    "number": 5885,
    "text": "إِذَا ٱلسَّمَآءُ ٱنشَقَّتۡ",
    "numberInSurah": 1,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم إذا السماء انشقت"
  },
  {
    "number": 5886,
    "text": "وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ",
    "numberInSurah": 2,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "وأذنت لربها وحقت"
  },
  {
    "number": 5887,
    "text": "وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ",
    "numberInSurah": 3,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "وإذا الأرض مدت"
  },
  {
    "number": 5888,
    "text": "وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ",
    "numberInSurah": 4,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "وألقت ما فيها وتخلت"
  },
  {
    "number": 5889,
    "text": "وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ",
    "numberInSurah": 5,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "وأذنت لربها وحقت"
  },
  {
    "number": 5890,
    "text": "يَـٰٓأَيُّهَا ٱلۡإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحٗا فَمُلَٰقِيهِ",
    "numberInSurah": 6,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "يا أيها الإنسان إنك كادح إلى ربك كدحا فملاقيه"
  },
  {
    "number": 5891,
    "text": "فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ",
    "numberInSurah": 7,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "فأما من أوتي كتابه بيمينه"
  },
  {
    "number": 5892,
    "text": "فَسَوۡفَ يُحَاسَبُ حِسَابٗا يَسِيرٗا",
    "numberInSurah": 8,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "فسوف يحاسب حسابا يسيرا"
  },
  {
    "number": 5893,
    "text": "وَيَنقَلِبُ إِلَىٰٓ أَهۡلِهِۦ مَسۡرُورٗا",
    "numberInSurah": 9,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "وينقلب إلى أهله مسرورا"
  },
  {
    "number": 5894,
    "text": "وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهۡرِهِۦ",
    "numberInSurah": 10,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "وأما من أوتي كتابه وراء ظهره"
  },
  {
    "number": 5895,
    "text": "فَسَوۡفَ يَدۡعُواْ ثُبُورٗا",
    "numberInSurah": 11,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "فسوف يدعو ثبورا"
  },
  {
    "number": 5896,
    "text": "وَيَصۡلَىٰ سَعِيرًا",
    "numberInSurah": 12,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "ويصلى سعيرا"
  },
  {
    "number": 5897,
    "text": "إِنَّهُۥ كَانَ فِيٓ أَهۡلِهِۦ مَسۡرُورًا",
    "numberInSurah": 13,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "إنه كان في أهله مسرورا"
  },
  {
    "number": 5898,
    "text": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ",
    "numberInSurah": 14,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "إنه ظن أن لن يحور"
  },
  {
    "number": 5899,
    "text": "بَلَىٰٓۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرٗا",
    "numberInSurah": 15,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "بلى إن ربه كان به بصيرا"
  },
  {
    "number": 5900,
    "text": "فَلَآ أُقۡسِمُ بِٱلشَّفَقِ",
    "numberInSurah": 16,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "فلا أقسم بالشفق"
  },
  {
    "number": 5901,
    "text": "وَٱلَّيۡلِ وَمَا وَسَقَ",
    "numberInSurah": 17,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "والليل وما وسق"
  },
  {
    "number": 5902,
    "text": "وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ",
    "numberInSurah": 18,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "والقمر إذا اتسق"
  },
  {
    "number": 5903,
    "text": "لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقٖ",
    "numberInSurah": 19,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "لتركبن طبقا عن طبق"
  },
  {
    "number": 5904,
    "text": "فَمَا لَهُمۡ لَا يُؤۡمِنُونَ",
    "numberInSurah": 20,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "فما لهم لا يؤمنون"
  },
  {
    "number": 5905,
    "text": "وَإِذَا قُرِئَ عَلَيۡهِمُ ٱلۡقُرۡءَانُ لَا يَسۡجُدُونَۤ۩",
    "numberInSurah": 21,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": {
      "id": 14,
      "recommended": true,
      "obligatory": false
    },
    "no_Tashkeel_text": "وإذا قرئ عليهم القرآن لا يسجدون"
  },
  {
    "number": 5906,
    "text": "بَلِ ٱلَّذِينَ كَفَرُواْ يُكَذِّبُونَ",
    "numberInSurah": 22,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "بل الذين كفروا يكذبون"
  },
  {
    "number": 5907,
    "text": "وَٱللَّهُ أَعۡلَمُ بِمَا يُوعُونَ",
    "numberInSurah": 23,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "والله أعلم بما يوعون"
  },
  {
    "number": 5908,
    "text": "فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٍ",
    "numberInSurah": 24,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "فبشرهم بعذاب أليم"
  },
  {
    "number": 5909,
    "text": "إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ لَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونِۭ",
    "numberInSurah": 25,
    "juz": 30,
    "manzil": 7,
    "page": 589,
    "ruku": 526,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "إلا الذين آمنوا وعملوا الصالحات لهم أجر غير ممنون"
  }
