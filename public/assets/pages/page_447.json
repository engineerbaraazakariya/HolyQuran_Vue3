[
  {
    "number": 3813,
    "text": "مَا لَكُمۡ لَا تَنَاصَرُونَ",
    "numberInSurah": 25,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "ما لكم لا تناصرون"
  },
  {
    "number": 3814,
    "text": "بَلۡ هُمُ ٱلۡيَوۡمَ مُسۡتَسۡلِمُونَ",
    "numberInSurah": 26,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "بل هم اليوم مستسلمون"
  },
  {
    "number": 3815,
    "text": "وَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ",
    "numberInSurah": 27,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "وأقبل بعضهم على بعض يتساءلون"
  },
  {
    "number": 3816,
    "text": "قَالُوٓاْ إِنَّكُمۡ كُنتُمۡ تَأۡتُونَنَا عَنِ ٱلۡيَمِينِ",
    "numberInSurah": 28,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "قالوا إنكم كنتم تأتوننا عن اليمين"
  },
  {
    "number": 3817,
    "text": "قَالُواْ بَل لَّمۡ تَكُونُواْ مُؤۡمِنِينَ",
    "numberInSurah": 29,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "قالوا بل لم تكونوا مؤمنين"
  },
  {
    "number": 3818,
    "text": "وَمَا كَانَ لَنَا عَلَيۡكُم مِّن سُلۡطَٰنِۭۖ بَلۡ كُنتُمۡ قَوۡمٗا طَٰغِينَ",
    "numberInSurah": 30,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "وما كان لنا عليكم من سلطان بل كنتم قوما طاغين"
  },
  {
    "number": 3819,
    "text": "فَحَقَّ عَلَيۡنَا قَوۡلُ رَبِّنَآۖ إِنَّا لَذَآئِقُونَ",
    "numberInSurah": 31,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "فحق علينا قول ربنا إنا لذائقون"
  },
  {
    "number": 3820,
    "text": "فَأَغۡوَيۡنَٰكُمۡ إِنَّا كُنَّا غَٰوِينَ",
    "numberInSurah": 32,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "فأغويناكم إنا كنا غاوين"
  },
  {
    "number": 3821,
    "text": "فَإِنَّهُمۡ يَوۡمَئِذٖ فِي ٱلۡعَذَابِ مُشۡتَرِكُونَ",
    "numberInSurah": 33,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "فإنهم يومئذ في العذاب مشتركون"
  },
  {
    "number": 3822,
    "text": "إِنَّا كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ",
    "numberInSurah": 34,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "إنا كذلك نفعل بالمجرمين"
  },
  {
    "number": 3823,
    "text": "إِنَّهُمۡ كَانُوٓاْ إِذَا قِيلَ لَهُمۡ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسۡتَكۡبِرُونَ",
    "numberInSurah": 35,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "إنهم كانوا إذا قيل لهم لا إله إلا الله يستكبرون"
  },
  {
    "number": 3824,
    "text": "وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓاْ ءَالِهَتِنَا لِشَاعِرٖ مَّجۡنُونِۭ",
    "numberInSurah": 36,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "ويقولون أئنا لتاركو آلهتنا لشاعر مجنون"
  },
  {
    "number": 3825,
    "text": "بَلۡ جَآءَ بِٱلۡحَقِّ وَصَدَّقَ ٱلۡمُرۡسَلِينَ",
    "numberInSurah": 37,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "بل جاء بالحق وصدق المرسلين"
  },
  {
    "number": 3826,
    "text": "إِنَّكُمۡ لَذَآئِقُواْ ٱلۡعَذَابِ ٱلۡأَلِيمِ",
    "numberInSurah": 38,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "إنكم لذائقو العذاب الأليم"
  },
  {
    "number": 3827,
    "text": "وَمَا تُجۡزَوۡنَ إِلَّا مَا كُنتُمۡ تَعۡمَلُونَ",
    "numberInSurah": 39,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "وما تجزون إلا ما كنتم تعملون"
  },
  {
    "number": 3828,
    "text": "إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ",
    "numberInSurah": 40,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "إلا عباد الله المخلصين"
  },
  {
    "number": 3829,
    "text": "أُوْلَـٰٓئِكَ لَهُمۡ رِزۡقٞ مَّعۡلُومٞ",
    "numberInSurah": 41,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "أولئك لهم رزق معلوم"
  },
  {
    "number": 3830,
    "text": "فَوَٰكِهُ وَهُم مُّكۡرَمُونَ",
    "numberInSurah": 42,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "فواكه وهم مكرمون"
  },
  {
    "number": 3831,
    "text": "فِي جَنَّـٰتِ ٱلنَّعِيمِ",
    "numberInSurah": 43,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "في جنات النعيم"
  },
  {
    "number": 3832,
    "text": "عَلَىٰ سُرُرٖ مُّتَقَٰبِلِينَ",
    "numberInSurah": 44,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "على سرر متقابلين"
  },
  {
    "number": 3833,
    "text": "يُطَافُ عَلَيۡهِم بِكَأۡسٖ مِّن مَّعِينِۭ",
    "numberInSurah": 45,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "يطاف عليهم بكأس من معين"
  },
  {
    "number": 3834,
    "text": "بَيۡضَآءَ لَذَّةٖ لِّلشَّـٰرِبِينَ",
    "numberInSurah": 46,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "بيضاء لذة للشاربين"
  },
  {
    "number": 3835,
    "text": "لَا فِيهَا غَوۡلٞ وَلَا هُمۡ عَنۡهَا يُنزَفُونَ",
    "numberInSurah": 47,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "لا فيها غول ولا هم عنها ينزفون"
  },
  {
    "number": 3836,
    "text": "وَعِندَهُمۡ قَٰصِرَٰتُ ٱلطَّرۡفِ عِينٞ",
    "numberInSurah": 48,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "وعندهم قاصرات الطرف عين"
  },
  {
    "number": 3837,
    "text": "كَأَنَّهُنَّ بَيۡضٞ مَّكۡنُونٞ",
    "numberInSurah": 49,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "كأنهن بيض مكنون"
  },
  {
    "number": 3838,
    "text": "فَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ",
    "numberInSurah": 50,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "فأقبل بعضهم على بعض يتساءلون"
  },
  {
    "number": 3839,
    "text": "قَالَ قَآئِلٞ مِّنۡهُمۡ إِنِّي كَانَ لِي قَرِينٞ",
    "numberInSurah": 51,
    "juz": 23,
    "manzil": 6,
    "page": 447,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "قال قائل منهم إني كان لي قرين"
  }
]