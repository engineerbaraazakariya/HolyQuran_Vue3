    "juz": 30,
    "manzil": 7,
    "page": 603,
    "ruku": 551,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "لكم دينكم ولي دين"
  },
  {
    "number": 6214,
    "text": "إِذَا جَآءَ نَصۡرُ ٱللَّهِ وَٱلۡفَتۡحُ",
    "numberInSurah": 1,
    "juz": 30,
    "manzil": 7,
    "page": 603,
    "ruku": 552,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم إذا جاء نصر الله والفتح"
  },
  {
    "number": 6215,
    "text": "وَرَأَيۡتَ ٱلنَّاسَ يَدۡخُلُونَ فِي دِينِ ٱللَّهِ أَفۡوَاجٗا",
    "numberInSurah": 2,
    "juz": 30,
    "manzil": 7,
    "page": 603,
    "ruku": 552,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "ورأيت الناس يدخلون في دين الله أفواجا"
  },
  {
    "number": 6216,
    "text": "فَسَبِّحۡ بِحَمۡدِ رَبِّكَ وَٱسۡتَغۡفِرۡهُۚ إِنَّهُۥ كَانَ تَوَّابَۢا",
    "numberInSurah": 3,
    "juz": 30,
    "manzil": 7,
    "page": 603,
    "ruku": 552,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "فسبح بحمد ربك واستغفره إنه كان توابا"
  },
  {
    "number": 6217,
    "text": "تَبَّتۡ يَدَآ أَبِي لَهَبٖ وَتَبَّ",
    "numberInSurah": 1,
    "juz": 30,
    "manzil": 7,
    "page": 603,
    "ruku": 553,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم تبت يدا أبي لهب وتب"
  },
  {
    "number": 6218,
    "text": "مَآ أَغۡنَىٰ عَنۡهُ مَالُهُۥ وَمَا كَسَبَ",
