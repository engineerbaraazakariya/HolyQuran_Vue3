    "ruku": 498,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "ما أنت بنعمة ربك بمجنون"
  },
  {
    "number": 5274,
    "text": "وَإِنَّ لَكَ لَأَجۡرًا غَيۡرَ مَمۡنُونٖ",
