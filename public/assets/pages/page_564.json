[
  {
    "number": 5268,
    "text": "فَلَمَّا رَأَوۡهُ زُلۡفَةٗ سِيٓـَٔتۡ وُجُوهُ ٱلَّذِينَ كَفَرُواْ وَقِيلَ هَٰذَا ٱلَّذِي كُنتُم بِهِۦ تَدَّعُونَ",
    "numberInSurah": 27,
    "juz": 29,
    "manzil": 7,
    "page": 564,
    "ruku": 497,
    "hizbQuarter": 225,
    "sajda": false,
    "no_Tashkeel_text": "فلما رأوه زلفة سيئت وجوه الذين كفروا وقيل هذا الذي كنتم به تدعون"
  },
  {
    "number": 5269,
    "text": "قُلۡ أَرَءَيۡتُمۡ إِنۡ أَهۡلَكَنِيَ ٱللَّهُ وَمَن مَّعِيَ أَوۡ رَحِمَنَا فَمَن يُجِيرُ ٱلۡكَٰفِرِينَ مِنۡ عَذَابٍ أَلِيمٖ",
    "numberInSurah": 28,
    "juz": 29,
    "manzil": 7,
    "page": 564,
    "ruku": 497,
    "hizbQuarter": 225,
    "sajda": false,
    "no_Tashkeel_text": "قل أرأيتم إن أهلكني الله ومن معي أو رحمنا فمن يجير الكافرين من عذاب أليم"
  },
  {
    "number": 5270,
    "text": "قُلۡ هُوَ ٱلرَّحۡمَٰنُ ءَامَنَّا بِهِۦ وَعَلَيۡهِ تَوَكَّلۡنَاۖ فَسَتَعۡلَمُونَ مَنۡ هُوَ فِي ضَلَٰلٖ مُّبِينٖ",
    "numberInSurah": 29,
    "juz": 29,
    "manzil": 7,
    "page": 564,
    "ruku": 497,
    "hizbQuarter": 225,
    "sajda": false,
    "no_Tashkeel_text": "قل هو الرحمن آمنا به وعليه توكلنا فستعلمون من هو في ضلال مبين"
  },
  {
    "number": 5271,
    "text": "قُلۡ أَرَءَيۡتُمۡ إِنۡ أَصۡبَحَ مَآؤُكُمۡ غَوۡرٗا فَمَن يَأۡتِيكُم بِمَآءٖ مَّعِينِۭ",
    "numberInSurah": 30,
    "juz": 29,
    "manzil": 7,
    "page": 564,
    "ruku": 497,
    "hizbQuarter": 225,
    "sajda": false,
    "no_Tashkeel_text": "قل أرأيتم إن أصبح ماؤكم غورا فمن يأتيكم بماء معين"
  },
  {
    "number": 5272,
    "text": "نٓۚ وَٱلۡقَلَمِ وَمَا يَسۡطُرُونَ",
    "numberInSurah": 1,
    "juz": 29,
    "manzil": 7,
    "page": 564,
    "ruku": 498,
    "hizbQuarter": 226,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم ن والقلم وما يسطرون"
  },
  {
    "number": 5273,
    "text": "مَآ أَنتَ بِنِعۡمَةِ رَبِّكَ بِمَجۡنُونٖ",
