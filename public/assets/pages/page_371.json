[
  {
    "number": 3016,
    "text": "وَٱجۡعَل لِّي لِسَانَ صِدۡقٖ فِي ٱلۡأٓخِرِينَ",
    "numberInSurah": 84,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "واجعل لي لسان صدق في الآخرين"
  },
  {
    "number": 3017,
    "text": "وَٱجۡعَلۡنِي مِن وَرَثَةِ جَنَّةِ ٱلنَّعِيمِ",
    "numberInSurah": 85,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "واجعلني من ورثة جنة النعيم"
  },
  {
    "number": 3018,
    "text": "وَٱغۡفِرۡ لِأَبِيٓ إِنَّهُۥ كَانَ مِنَ ٱلضَّآلِّينَ",
    "numberInSurah": 86,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "واغفر لأبي إنه كان من الضالين"
  },
  {
    "number": 3019,
    "text": "وَلَا تُخۡزِنِي يَوۡمَ يُبۡعَثُونَ",
    "numberInSurah": 87,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "ولا تخزني يوم يبعثون"
  },
  {
    "number": 3020,
    "text": "يَوۡمَ لَا يَنفَعُ مَالٞ وَلَا بَنُونَ",
    "numberInSurah": 88,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "يوم لا ينفع مال ولا بنون"
  },
  {
    "number": 3021,
    "text": "إِلَّا مَنۡ أَتَى ٱللَّهَ بِقَلۡبٖ سَلِيمٖ",
    "numberInSurah": 89,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "إلا من أتى الله بقلب سليم"
  },
  {
    "number": 3022,
    "text": "وَأُزۡلِفَتِ ٱلۡجَنَّةُ لِلۡمُتَّقِينَ",
    "numberInSurah": 90,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "وأزلفت الجنة للمتقين"
  },
  {
    "number": 3023,
    "text": "وَبُرِّزَتِ ٱلۡجَحِيمُ لِلۡغَاوِينَ",
    "numberInSurah": 91,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "وبرزت الجحيم للغاوين"
  },
  {
    "number": 3024,
    "text": "وَقِيلَ لَهُمۡ أَيۡنَ مَا كُنتُمۡ تَعۡبُدُونَ",
    "numberInSurah": 92,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "وقيل لهم أين ما كنتم تعبدون"
  },
  {
    "number": 3025,
    "text": "مِن دُونِ ٱللَّهِ هَلۡ يَنصُرُونَكُمۡ أَوۡ يَنتَصِرُونَ",
    "numberInSurah": 93,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "من دون الله هل ينصرونكم أو ينتصرون"
  },
  {
    "number": 3026,
    "text": "فَكُبۡكِبُواْ فِيهَا هُمۡ وَٱلۡغَاوُۥنَ",
    "numberInSurah": 94,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "فكبكبوا فيها هم والغاوون"
  },
  {
    "number": 3027,
    "text": "وَجُنُودُ إِبۡلِيسَ أَجۡمَعُونَ",
    "numberInSurah": 95,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "وجنود إبليس أجمعون"
  },
  {
    "number": 3028,
    "text": "قَالُواْ وَهُمۡ فِيهَا يَخۡتَصِمُونَ",
    "numberInSurah": 96,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "قالوا وهم فيها يختصمون"
  },
  {
    "number": 3029,
    "text": "تَٱللَّهِ إِن كُنَّا لَفِي ضَلَٰلٖ مُّبِينٍ",
    "numberInSurah": 97,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "تالله إن كنا لفي ضلال مبين"
  },
  {
    "number": 3030,
    "text": "إِذۡ نُسَوِّيكُم بِرَبِّ ٱلۡعَٰلَمِينَ",
    "numberInSurah": 98,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "إذ نسويكم برب العالمين"
  },
  {
    "number": 3031,
    "text": "وَمَآ أَضَلَّنَآ إِلَّا ٱلۡمُجۡرِمُونَ",
    "numberInSurah": 99,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "وما أضلنا إلا المجرمون"
  },
  {
    "number": 3032,
    "text": "فَمَا لَنَا مِن شَٰفِعِينَ",
    "numberInSurah": 100,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "فما لنا من شافعين"
  },
  {
    "number": 3033,
    "text": "وَلَا صَدِيقٍ حَمِيمٖ",
    "numberInSurah": 101,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "ولا صديق حميم"
  },
  {
    "number": 3034,
    "text": "فَلَوۡ أَنَّ لَنَا كَرَّةٗ فَنَكُونَ مِنَ ٱلۡمُؤۡمِنِينَ",
    "numberInSurah": 102,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "فلو أن لنا كرة فنكون من المؤمنين"
  },
  {
    "number": 3035,
    "text": "إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ",
    "numberInSurah": 103,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "إن في ذلك لآية وما كان أكثرهم مؤمنين"
  },
  {
    "number": 3036,
    "text": "وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ",
    "numberInSurah": 104,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "وإن ربك لهو العزيز الرحيم"
  },
  {
    "number": 3037,
    "text": "كَذَّبَتۡ قَوۡمُ نُوحٍ ٱلۡمُرۡسَلِينَ",
    "numberInSurah": 105,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 321,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "كذبت قوم نوح المرسلين"
  },
  {
    "number": 3038,
    "text": "إِذۡ قَالَ لَهُمۡ أَخُوهُمۡ نُوحٌ أَلَا تَتَّقُونَ",
    "numberInSurah": 106,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 321,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "إذ قال لهم أخوهم نوح ألا تتقون"
  },
  {
    "number": 3039,
    "text": "إِنِّي لَكُمۡ رَسُولٌ أَمِينٞ",
    "numberInSurah": 107,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 321,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "إني لكم رسول أمين"
  },
  {
    "number": 3040,
    "text": "فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ",
    "numberInSurah": 108,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 321,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "فاتقوا الله وأطيعون"
  },
  {
    "number": 3041,
    "text": "وَمَآ أَسۡـَٔلُكُمۡ عَلَيۡهِ مِنۡ أَجۡرٍۖ إِنۡ أَجۡرِيَ إِلَّا عَلَىٰ رَبِّ ٱلۡعَٰلَمِينَ",
    "numberInSurah": 109,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 321,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "وما أسألكم عليه من أجر إن أجري إلا على رب العالمين"
  },
  {
    "number": 3042,
    "text": "فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ",
    "numberInSurah": 110,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 321,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "فاتقوا الله وأطيعون"
  },
  {
    "number": 3043,
    "text": "۞قَالُوٓاْ أَنُؤۡمِنُ لَكَ وَٱتَّبَعَكَ ٱلۡأَرۡذَلُونَ",
    "numberInSurah": 111,
    "juz": 19,
    "manzil": 5,
    "page": 371,
    "ruku": 321,
    "hizbQuarter": 149,
    "sajda": false,
    "no_Tashkeel_text": "قالوا أنؤمن لك واتبعك الأرذلون"
  }
]