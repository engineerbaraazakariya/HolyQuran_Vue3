[
  {
    "number": 4454,
    "text": "إِنَّ يَوۡمَ ٱلۡفَصۡلِ مِيقَٰتُهُمۡ أَجۡمَعِينَ",
    "numberInSurah": 40,
    "juz": 25,
    "manzil": 6,
    "page": 498,
    "ruku": 432,
    "hizbQuarter": 199,
    "sajda": false,
    "no_Tashkeel_text": "إن يوم الفصل ميقاتهم أجمعين"
  },
  {
    "number": 4455,
    "text": "يَوۡمَ لَا يُغۡنِي مَوۡلًى عَن مَّوۡلٗى شَيۡـٔٗا وَلَا هُمۡ يُنصَرُونَ",
    "numberInSurah": 41,
    "juz": 25,
    "manzil": 6,
    "page": 498,
    "ruku": 432,
    "hizbQuarter": 199,
    "sajda": false,
    "no_Tashkeel_text": "يوم لا يغني مولى عن مولى شيئا ولا هم ينصرون"
  },
  {
    "number": 4456,
    "text": "إِلَّا مَن رَّحِمَ ٱللَّهُۚ إِنَّهُۥ هُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ",
    "numberInSurah": 42,
    "juz": 25,
    "manzil": 6,
    "page": 498,
    "ruku": 432,
    "hizbQuarter": 199,
    "sajda": false,
    "no_Tashkeel_text": "إلا من رحم الله إنه هو العزيز الرحيم"
  },
  {
    "number": 4457,
    "text": "إِنَّ شَجَرَتَ ٱلزَّقُّومِ",
    "numberInSurah": 43,
    "juz": 25,
    "manzil": 6,
    "page": 498,
    "ruku": 433,
    "hizbQuarter": 199,
    "sajda": false,
    "no_Tashkeel_text": "إن شجرت الزقوم"
  },
  {
    "number": 4458,
    "text": "طَعَامُ ٱلۡأَثِيمِ",
    "numberInSurah": 44,
    "juz": 25,
    "manzil": 6,
    "page": 498,
    "ruku": 433,
    "hizbQuarter": 199,
    "sajda": false,
    "no_Tashkeel_text": "طعام الأثيم"
  },
  {
    "number": 4459,
    "text": "كَٱلۡمُهۡلِ يَغۡلِي فِي ٱلۡبُطُونِ",
    "numberInSurah": 45,
    "juz": 25,
    "manzil": 6,
    "page": 498,
    "ruku": 433,
    "hizbQuarter": 199,
    "sajda": false,
    "no_Tashkeel_text": "كالمهل يغلي في البطون"
  },
  {
    "number": 4460,
    "text": "كَغَلۡيِ ٱلۡحَمِيمِ",
    "numberInSurah": 46,
    "juz": 25,
    "manzil": 6,
    "page": 498,
    "ruku": 433,
    "hizbQuarter": 199,
    "sajda": false,
    "no_Tashkeel_text": "كغلي الحميم"
  },
  {
    "number": 4461,
    "text": "خُذُوهُ فَٱعۡتِلُوهُ إِلَىٰ سَوَآءِ ٱلۡجَحِيمِ",
    "numberInSurah": 47,
    "juz": 25,
    "manzil": 6,
    "page": 498,
    "ruku": 433,
    "hizbQuarter": 199,
    "sajda": false,
    "no_Tashkeel_text": "خذوه فاعتلوه إلى سواء الجحيم"
  },
  {
    "number": 4462,
    "text": "ثُمَّ صُبُّواْ فَوۡقَ رَأۡسِهِۦ مِنۡ عَذَابِ ٱلۡحَمِيمِ",
    "numberInSurah": 48,
    "juz": 25,
    "manzil": 6,
    "page": 498,
    "ruku": 433,
    "hizbQuarter": 199,
    "sajda": false,
    "no_Tashkeel_text": "ثم صبوا فوق رأسه من عذاب الحميم"
  },
  {
    "number": 4463,
    "text": "ذُقۡ إِنَّكَ أَنتَ ٱلۡعَزِيزُ ٱلۡكَرِيمُ",
    "numberInSurah": 49,
    "juz": 25,
    "manzil": 6,
    "page": 498,
    "ruku": 433,
    "hizbQuarter": 199,
    "sajda": false,
    "no_Tashkeel_text": "ذق إنك أنت العزيز الكريم"
  },
  {
    "number": 4464,
    "text": "إِنَّ هَٰذَا مَا كُنتُم بِهِۦ تَمۡتَرُونَ",
    "numberInSurah": 50,
    "juz": 25,
    "manzil": 6,
    "page": 498,
    "ruku": 433,
    "hizbQuarter": 199,
    "sajda": false,
    "no_Tashkeel_text": "إن هذا ما كنتم به تمترون"
  },
  {
    "number": 4465,
    "text": "إِنَّ ٱلۡمُتَّقِينَ فِي مَقَامٍ أَمِينٖ",
    "numberInSurah": 51,
    "juz": 25,
    "manzil": 6,
    "page": 498,
    "ruku": 433,
    "hizbQuarter": 199,
    "sajda": false,
    "no_Tashkeel_text": "إن المتقين في مقام أمين"
  },
  {
    "number": 4466,
    "text": "فِي جَنَّـٰتٖ وَعُيُونٖ",
    "numberInSurah": 52,
    "juz": 25,
    "manzil": 6,
    "page": 498,
    "ruku": 433,
    "hizbQuarter": 199,
    "sajda": false,
    "no_Tashkeel_text": "في جنات وعيون"
  },
  {
    "number": 4467,
    "text": "يَلۡبَسُونَ مِن سُندُسٖ وَإِسۡتَبۡرَقٖ مُّتَقَٰبِلِينَ",
    "numberInSurah": 53,
    "juz": 25,
    "manzil": 6,
    "page": 498,
    "ruku": 433,
    "hizbQuarter": 199,
    "sajda": false,
    "no_Tashkeel_text": "يلبسون من سندس وإستبرق متقابلين"
  },
  {
    "number": 4468,
    "text": "كَذَٰلِكَ وَزَوَّجۡنَٰهُم بِحُورٍ عِينٖ",
    "numberInSurah": 54,
    "juz": 25,
    "manzil": 6,
    "page": 498,
    "ruku": 433,
    "hizbQuarter": 199,
    "sajda": false,
    "no_Tashkeel_text": "كذلك وزوجناهم بحور عين"
  },
  {
    "number": 4469,
    "text": "يَدۡعُونَ فِيهَا بِكُلِّ فَٰكِهَةٍ ءَامِنِينَ",
    "numberInSurah": 55,
    "juz": 25,
    "manzil": 6,
    "page": 498,
    "ruku": 433,
    "hizbQuarter": 199,
    "sajda": false,
    "no_Tashkeel_text": "يدعون فيها بكل فاكهة آمنين"
  },
  {
    "number": 4470,
    "text": "لَا يَذُوقُونَ فِيهَا ٱلۡمَوۡتَ إِلَّا ٱلۡمَوۡتَةَ ٱلۡأُولَىٰۖ وَوَقَىٰهُمۡ عَذَابَ ٱلۡجَحِيمِ",
    "numberInSurah": 56,
    "juz": 25,
    "manzil": 6,
    "page": 498,
    "ruku": 433,
    "hizbQuarter": 199,
    "sajda": false,
    "no_Tashkeel_text": "لا يذوقون فيها الموت إلا الموتة الأولى ووقاهم عذاب الجحيم"
  },
  {
    "number": 4471,
    "text": "فَضۡلٗا مِّن رَّبِّكَۚ ذَٰلِكَ هُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ",
    "numberInSurah": 57,
    "juz": 25,
    "manzil": 6,
    "page": 498,
    "ruku": 433,
    "hizbQuarter": 199,
    "sajda": false,
    "no_Tashkeel_text": "فضلا من ربك ذلك هو الفوز العظيم"
  },
  {
    "number": 4472,
    "text": "فَإِنَّمَا يَسَّرۡنَٰهُ بِلِسَانِكَ لَعَلَّهُمۡ يَتَذَكَّرُونَ",
    "numberInSurah": 58,
    "juz": 25,
    "manzil": 6,
    "page": 498,
    "ruku": 433,
    "hizbQuarter": 199,
    "sajda": false,
    "no_Tashkeel_text": "فإنما يسرناه بلسانك لعلهم يتذكرون"
  },
  {
    "number": 4473,
    "text": "فَٱرۡتَقِبۡ إِنَّهُم مُّرۡتَقِبُونَ",
    "numberInSurah": 59,
    "juz": 25,
    "manzil": 6,
    "page": 498,
    "ruku": 433,
    "hizbQuarter": 199,
    "sajda": false,
    "no_Tashkeel_text": "فارتقب إنهم مرتقبون"
  }
]