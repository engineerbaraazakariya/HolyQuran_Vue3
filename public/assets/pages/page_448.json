[
  {
    "number": 3840,
    "text": "يَقُولُ أَءِنَّكَ لَمِنَ ٱلۡمُصَدِّقِينَ",
    "numberInSurah": 52,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "يقول أإنك لمن المصدقين"
  },
  {
    "number": 3841,
    "text": "أَءِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ",
    "numberInSurah": 53,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "أإذا متنا وكنا ترابا وعظاما أإنا لمدينون"
  },
  {
    "number": 3842,
    "text": "قَالَ هَلۡ أَنتُم مُّطَّلِعُونَ",
    "numberInSurah": 54,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "قال هل أنتم مطلعون"
  },
  {
    "number": 3843,
    "text": "فَٱطَّلَعَ فَرَءَاهُ فِي سَوَآءِ ٱلۡجَحِيمِ",
    "numberInSurah": 55,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "فاطلع فرآه في سواء الجحيم"
  },
  {
    "number": 3844,
    "text": "قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرۡدِينِ",
    "numberInSurah": 56,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "قال تالله إن كدت لتردين"
  },
  {
    "number": 3845,
    "text": "وَلَوۡلَا نِعۡمَةُ رَبِّي لَكُنتُ مِنَ ٱلۡمُحۡضَرِينَ",
    "numberInSurah": 57,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "ولولا نعمة ربي لكنت من المحضرين"
  },
  {
    "number": 3846,
    "text": "أَفَمَا نَحۡنُ بِمَيِّتِينَ",
    "numberInSurah": 58,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "أفما نحن بميتين"
  },
  {
    "number": 3847,
    "text": "إِلَّا مَوۡتَتَنَا ٱلۡأُولَىٰ وَمَا نَحۡنُ بِمُعَذَّبِينَ",
    "numberInSurah": 59,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "إلا موتتنا الأولى وما نحن بمعذبين"
  },
  {
    "number": 3848,
    "text": "إِنَّ هَٰذَا لَهُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ",
    "numberInSurah": 60,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "إن هذا لهو الفوز العظيم"
  },
  {
    "number": 3849,
    "text": "لِمِثۡلِ هَٰذَا فَلۡيَعۡمَلِ ٱلۡعَٰمِلُونَ",
    "numberInSurah": 61,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "لمثل هذا فليعمل العاملون"
  },
  {
    "number": 3850,
    "text": "أَذَٰلِكَ خَيۡرٞ نُّزُلًا أَمۡ شَجَرَةُ ٱلزَّقُّومِ",
    "numberInSurah": 62,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "أذلك خير نزلا أم شجرة الزقوم"
  },
  {
    "number": 3851,
    "text": "إِنَّا جَعَلۡنَٰهَا فِتۡنَةٗ لِّلظَّـٰلِمِينَ",
    "numberInSurah": 63,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "إنا جعلناها فتنة للظالمين"
  },
  {
    "number": 3852,
    "text": "إِنَّهَا شَجَرَةٞ تَخۡرُجُ فِيٓ أَصۡلِ ٱلۡجَحِيمِ",
    "numberInSurah": 64,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "إنها شجرة تخرج في أصل الجحيم"
  },
  {
    "number": 3853,
    "text": "طَلۡعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ",
    "numberInSurah": 65,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "طلعها كأنه رءوس الشياطين"
  },
  {
    "number": 3854,
    "text": "فَإِنَّهُمۡ لَأٓكِلُونَ مِنۡهَا فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ",
    "numberInSurah": 66,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "فإنهم لآكلون منها فمالئون منها البطون"
  },
  {
    "number": 3855,
    "text": "ثُمَّ إِنَّ لَهُمۡ عَلَيۡهَا لَشَوۡبٗا مِّنۡ حَمِيمٖ",
    "numberInSurah": 67,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "ثم إن لهم عليها لشوبا من حميم"
  },
  {
    "number": 3856,
    "text": "ثُمَّ إِنَّ مَرۡجِعَهُمۡ لَإِلَى ٱلۡجَحِيمِ",
    "numberInSurah": 68,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "ثم إن مرجعهم لإلى الجحيم"
  },
  {
    "number": 3857,
    "text": "إِنَّهُمۡ أَلۡفَوۡاْ ءَابَآءَهُمۡ ضَآلِّينَ",
    "numberInSurah": 69,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "إنهم ألفوا آباءهم ضالين"
  },
  {
    "number": 3858,
    "text": "فَهُمۡ عَلَىٰٓ ءَاثَٰرِهِمۡ يُهۡرَعُونَ",
    "numberInSurah": 70,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "فهم على آثارهم يهرعون"
  },
  {
    "number": 3859,
    "text": "وَلَقَدۡ ضَلَّ قَبۡلَهُمۡ أَكۡثَرُ ٱلۡأَوَّلِينَ",
    "numberInSurah": 71,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "ولقد ضل قبلهم أكثر الأولين"
  },
  {
    "number": 3860,
    "text": "وَلَقَدۡ أَرۡسَلۡنَا فِيهِم مُّنذِرِينَ",
    "numberInSurah": 72,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "ولقد أرسلنا فيهم منذرين"
  },
  {
    "number": 3861,
    "text": "فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُنذَرِينَ",
    "numberInSurah": 73,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "فانظر كيف كان عاقبة المنذرين"
  },
  {
    "number": 3862,
    "text": "إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ",
    "numberInSurah": 74,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 387,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "إلا عباد الله المخلصين"
  },
  {
    "number": 3863,
    "text": "وَلَقَدۡ نَادَىٰنَا نُوحٞ فَلَنِعۡمَ ٱلۡمُجِيبُونَ",
    "numberInSurah": 75,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 388,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "ولقد نادانا نوح فلنعم المجيبون"
  },
  {
    "number": 3864,
    "text": "وَنَجَّيۡنَٰهُ وَأَهۡلَهُۥ مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ",
    "numberInSurah": 76,
    "juz": 23,
    "manzil": 6,
    "page": 448,
    "ruku": 388,
    "hizbQuarter": 179,
    "sajda": false,
    "no_Tashkeel_text": "ونجيناه وأهله من الكرب العظيم"
  }
]