[
  {
    "number": 5830,
    "text": "إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ",
    "numberInSurah": 1,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 524,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم إذا السماء انفطرت"
  },
  {
    "number": 5831,
    "text": "وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ",
    "numberInSurah": 2,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 524,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "وإذا الكواكب انتثرت"
  },
  {
    "number": 5832,
    "text": "وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ",
    "numberInSurah": 3,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 524,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "وإذا البحار فجرت"
  },
  {
    "number": 5833,
    "text": "وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ",
    "numberInSurah": 4,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 524,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "وإذا القبور بعثرت"
  },
  {
    "number": 5834,
    "text": "عَلِمَتۡ نَفۡسٞ مَّا قَدَّمَتۡ وَأَخَّرَتۡ",
    "numberInSurah": 5,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 524,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "علمت نفس ما قدمت وأخرت"
  },
  {
    "number": 5835,
    "text": "يَـٰٓأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ",
    "numberInSurah": 6,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 524,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "يا أيها الإنسان ما غرك بربك الكريم"
  },
  {
    "number": 5836,
    "text": "ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ",
    "numberInSurah": 7,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 524,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "الذي خلقك فسواك فعدلك"
  },
  {
    "number": 5837,
    "text": "فِيٓ أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَ",
    "numberInSurah": 8,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 524,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "في أي صورة ما شاء ركبك"
  },
  {
    "number": 5838,
    "text": "كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ",
    "numberInSurah": 9,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 524,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "كلا بل تكذبون بالدين"
  },
  {
    "number": 5839,
    "text": "وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ",
    "numberInSurah": 10,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 524,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "وإن عليكم لحافظين"
  },
  {
    "number": 5840,
    "text": "كِرَامٗا كَٰتِبِينَ",
    "numberInSurah": 11,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 524,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "كراما كاتبين"
  },
  {
    "number": 5841,
    "text": "يَعۡلَمُونَ مَا تَفۡعَلُونَ",
    "numberInSurah": 12,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 524,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "يعلمون ما تفعلون"
  },
  {
    "number": 5842,
    "text": "إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٖ",
    "numberInSurah": 13,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 524,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "إن الأبرار لفي نعيم"
  },
  {
    "number": 5843,
    "text": "وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمٖ",
    "numberInSurah": 14,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 524,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "وإن الفجار لفي جحيم"
  },
  {
    "number": 5844,
    "text": "يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ",
    "numberInSurah": 15,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 524,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "يصلونها يوم الدين"
  },
  {
    "number": 5845,
    "text": "وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ",
    "numberInSurah": 16,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 524,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "وما هم عنها بغائبين"
  },
  {
    "number": 5846,
    "text": "وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ",
    "numberInSurah": 17,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 524,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "وما أدراك ما يوم الدين"
  },
  {
    "number": 5847,
    "text": "ثُمَّ مَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ",
    "numberInSurah": 18,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 524,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "ثم ما أدراك ما يوم الدين"
  },
  {
    "number": 5848,
    "text": "يَوۡمَ لَا تَمۡلِكُ نَفۡسٞ لِّنَفۡسٖ شَيۡـٔٗاۖ وَٱلۡأَمۡرُ يَوۡمَئِذٖ لِّلَّهِ",
    "numberInSurah": 19,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 524,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "يوم لا تملك نفس لنفس شيئا والأمر يومئذ لله"
  },
  {
    "number": 5849,
    "text": "وَيۡلٞ لِّلۡمُطَفِّفِينَ",
    "numberInSurah": 1,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 525,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم ويل للمطففين"
  },
  {
    "number": 5850,
    "text": "ٱلَّذِينَ إِذَا ٱكۡتَالُواْ عَلَى ٱلنَّاسِ يَسۡتَوۡفُونَ",
    "numberInSurah": 2,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 525,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "الذين إذا اكتالوا على الناس يستوفون"
  },
  {
    "number": 5851,
    "text": "وَإِذَا كَالُوهُمۡ أَو وَّزَنُوهُمۡ يُخۡسِرُونَ",
    "numberInSurah": 3,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 525,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "وإذا كالوهم أو وزنوهم يخسرون"
  },
  {
    "number": 5852,
    "text": "أَلَا يَظُنُّ أُوْلَـٰٓئِكَ أَنَّهُم مَّبۡعُوثُونَ",
    "numberInSurah": 4,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 525,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "ألا يظن أولئك أنهم مبعوثون"
  },
  {
    "number": 5853,
    "text": "لِيَوۡمٍ عَظِيمٖ",
    "numberInSurah": 5,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 525,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "ليوم عظيم"
  },
  {
    "number": 5854,
    "text": "يَوۡمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلۡعَٰلَمِينَ",
    "numberInSurah": 6,
    "juz": 30,
    "manzil": 7,
    "page": 587,
    "ruku": 525,
    "hizbQuarter": 235,
    "sajda": false,
    "no_Tashkeel_text": "يوم يقوم الناس لرب العالمين"
  }
]