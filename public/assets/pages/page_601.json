[
  {
    "number": 6177,
    "text": "وَٱلۡعَصۡرِ",
    "numberInSurah": 1,
    "juz": 30,
    "manzil": 7,
    "page": 601,
    "ruku": 545,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم والعصر"
  },
  {
    "number": 6178,
    "text": "إِنَّ ٱلۡإِنسَٰنَ لَفِي خُسۡرٍ",
    "numberInSurah": 2,
    "juz": 30,
    "manzil": 7,
    "page": 601,
    "ruku": 545,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "إن الإنسان لفي خسر"
  },
  {
    "number": 6179,
    "text": "إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ وَتَوَاصَوۡاْ بِٱلۡحَقِّ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ",
    "numberInSurah": 3,
    "juz": 30,
    "manzil": 7,
    "page": 601,
    "ruku": 545,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "إلا الذين آمنوا وعملوا الصالحات وتواصوا بالحق وتواصوا بالصبر"
  },
  {
    "number": 6180,
    "text": "وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ",
    "numberInSurah": 1,
    "juz": 30,
    "manzil": 7,
    "page": 601,
    "ruku": 546,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم ويل لكل همزة لمزة"
  },
  {
    "number": 6181,
    "text": "ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ",
    "numberInSurah": 2,
    "juz": 30,
    "manzil": 7,
    "page": 601,
    "ruku": 546,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "الذي جمع مالا وعدده"
  },
  {
    "number": 6182,
    "text": "يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ",
    "numberInSurah": 3,
    "juz": 30,
    "manzil": 7,
    "page": 601,
    "ruku": 546,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "يحسب أن ماله أخلده"
  },
  {
    "number": 6183,
    "text": "كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ",
    "numberInSurah": 4,
    "juz": 30,
    "manzil": 7,
    "page": 601,
    "ruku": 546,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "كلا لينبذن في الحطمة"
  },
  {
    "number": 6184,
    "text": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ",
    "numberInSurah": 5,
    "juz": 30,
    "manzil": 7,
    "page": 601,
    "ruku": 546,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "وما أدراك ما الحطمة"
  },
  {
    "number": 6185,
    "text": "نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ",
    "numberInSurah": 6,
    "juz": 30,
    "manzil": 7,
    "page": 601,
    "ruku": 546,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "نار الله الموقدة"
  },
  {
    "number": 6186,
    "text": "ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ",
    "numberInSurah": 7,
    "juz": 30,
    "manzil": 7,
    "page": 601,
    "ruku": 546,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "التي تطلع على الأفئدة"
  },
  {
    "number": 6187,
    "text": "إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ",
    "numberInSurah": 8,
    "juz": 30,
    "manzil": 7,
    "page": 601,
    "ruku": 546,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "إنها عليهم مؤصدة"
  },
  {
    "number": 6188,
    "text": "فِي عَمَدٖ مُّمَدَّدَةِۭ",
    "numberInSurah": 9,
    "juz": 30,
    "manzil": 7,
    "page": 601,
    "ruku": 546,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "في عمد ممددة"
  },
  {
    "number": 6189,
    "text": "أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِأَصۡحَٰبِ ٱلۡفِيلِ",
    "numberInSurah": 1,
    "juz": 30,
    "manzil": 7,
    "page": 601,
    "ruku": 547,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم ألم تر كيف فعل ربك بأصحاب الفيل"
  },
  {
    "number": 6190,
    "text": "أَلَمۡ يَجۡعَلۡ كَيۡدَهُمۡ فِي تَضۡلِيلٖ",
    "numberInSurah": 2,
    "juz": 30,
    "manzil": 7,
    "page": 601,
    "ruku": 547,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "ألم يجعل كيدهم في تضليل"
  },
  {
    "number": 6191,
    "text": "وَأَرۡسَلَ عَلَيۡهِمۡ طَيۡرًا أَبَابِيلَ",
    "numberInSurah": 3,
    "juz": 30,
    "manzil": 7,
    "page": 601,
    "ruku": 547,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "وأرسل عليهم طيرا أبابيل"
  },
  {
    "number": 6192,
    "text": "تَرۡمِيهِم بِحِجَارَةٖ مِّن سِجِّيلٖ",
    "numberInSurah": 4,
    "juz": 30,
    "manzil": 7,
    "page": 601,
    "ruku": 547,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "ترميهم بحجارة من سجيل"
  },
  {
    "number": 6193,
    "text": "فَجَعَلَهُمۡ كَعَصۡفٖ مَّأۡكُولِۭ",
    "numberInSurah": 5,
    "juz": 30,
    "manzil": 7,
    "page": 601,
    "ruku": 547,
    "hizbQuarter": 240,
    "sajda": false,
    "no_Tashkeel_text": "فجعلهم كعصف مأكول"
  }
]