[
  {
    "number": 1854,
    "text": "إِذۡ دَخَلُواْ عَلَيۡهِ فَقَالُواْ سَلَٰمٗا قَالَ إِنَّا مِنكُمۡ وَجِلُونَ",
    "numberInSurah": 52,
    "juz": 14,
    "manzil": 3,
    "page": 265,
    "ruku": 221,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "إذ دخلوا عليه فقالوا سلاما قال إنا منكم وجلون"
  },
  {
    "number": 1855,
    "text": "قَالُواْ لَا تَوۡجَلۡ إِنَّا نُبَشِّرُكَ بِغُلَٰمٍ عَلِيمٖ",
    "numberInSurah": 53,
    "juz": 14,
    "manzil": 3,
    "page": 265,
    "ruku": 221,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "قالوا لا توجل إنا نبشرك بغلام عليم"
  },
  {
    "number": 1856,
    "text": "قَالَ أَبَشَّرۡتُمُونِي عَلَىٰٓ أَن مَّسَّنِيَ ٱلۡكِبَرُ فَبِمَ تُبَشِّرُونَ",
    "numberInSurah": 54,
    "juz": 14,
    "manzil": 3,
    "page": 265,
    "ruku": 221,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "قال أبشرتموني على أن مسني الكبر فبم تبشرون"
  },
  {
    "number": 1857,
    "text": "قَالُواْ بَشَّرۡنَٰكَ بِٱلۡحَقِّ فَلَا تَكُن مِّنَ ٱلۡقَٰنِطِينَ",
    "numberInSurah": 55,
    "juz": 14,
    "manzil": 3,
    "page": 265,
    "ruku": 221,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "قالوا بشرناك بالحق فلا تكن من القانطين"
  },
  {
    "number": 1858,
    "text": "قَالَ وَمَن يَقۡنَطُ مِن رَّحۡمَةِ رَبِّهِۦٓ إِلَّا ٱلضَّآلُّونَ",
    "numberInSurah": 56,
    "juz": 14,
    "manzil": 3,
    "page": 265,
    "ruku": 221,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "قال ومن يقنط من رحمة ربه إلا الضالون"
  },
  {
    "number": 1859,
    "text": "قَالَ فَمَا خَطۡبُكُمۡ أَيُّهَا ٱلۡمُرۡسَلُونَ",
    "numberInSurah": 57,
    "juz": 14,
    "manzil": 3,
    "page": 265,
    "ruku": 221,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "قال فما خطبكم أيها المرسلون"
  },
  {
    "number": 1860,
    "text": "قَالُوٓاْ إِنَّآ أُرۡسِلۡنَآ إِلَىٰ قَوۡمٖ مُّجۡرِمِينَ",
    "numberInSurah": 58,
    "juz": 14,
    "manzil": 3,
    "page": 265,
    "ruku": 221,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "قالوا إنا أرسلنا إلى قوم مجرمين"
  },
  {
    "number": 1861,
    "text": "إِلَّآ ءَالَ لُوطٍ إِنَّا لَمُنَجُّوهُمۡ أَجۡمَعِينَ",
    "numberInSurah": 59,
    "juz": 14,
    "manzil": 3,
    "page": 265,
    "ruku": 221,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "إلا آل لوط إنا لمنجوهم أجمعين"
  },
  {
    "number": 1862,
    "text": "إِلَّا ٱمۡرَأَتَهُۥ قَدَّرۡنَآ إِنَّهَا لَمِنَ ٱلۡغَٰبِرِينَ",
    "numberInSurah": 60,
    "juz": 14,
    "manzil": 3,
    "page": 265,
    "ruku": 221,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "إلا امرأته قدرنا إنها لمن الغابرين"
  },
  {
    "number": 1863,
    "text": "فَلَمَّا جَآءَ ءَالَ لُوطٍ ٱلۡمُرۡسَلُونَ",
    "numberInSurah": 61,
    "juz": 14,
    "manzil": 3,
    "page": 265,
    "ruku": 222,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "فلما جاء آل لوط المرسلون"
  },
  {
    "number": 1864,
    "text": "قَالَ إِنَّكُمۡ قَوۡمٞ مُّنكَرُونَ",
    "numberInSurah": 62,
    "juz": 14,
    "manzil": 3,
    "page": 265,
    "ruku": 222,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "قال إنكم قوم منكرون"
  },
  {
    "number": 1865,
    "text": "قَالُواْ بَلۡ جِئۡنَٰكَ بِمَا كَانُواْ فِيهِ يَمۡتَرُونَ",
    "numberInSurah": 63,
    "juz": 14,
    "manzil": 3,
    "page": 265,
    "ruku": 222,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "قالوا بل جئناك بما كانوا فيه يمترون"
  },
  {
    "number": 1866,
    "text": "وَأَتَيۡنَٰكَ بِٱلۡحَقِّ وَإِنَّا لَصَٰدِقُونَ",
    "numberInSurah": 64,
    "juz": 14,
    "manzil": 3,
    "page": 265,
    "ruku": 222,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "وأتيناك بالحق وإنا لصادقون"
  },
  {
    "number": 1867,
    "text": "فَأَسۡرِ بِأَهۡلِكَ بِقِطۡعٖ مِّنَ ٱلَّيۡلِ وَٱتَّبِعۡ أَدۡبَٰرَهُمۡ وَلَا يَلۡتَفِتۡ مِنكُمۡ أَحَدٞ وَٱمۡضُواْ حَيۡثُ تُؤۡمَرُونَ",
    "numberInSurah": 65,
    "juz": 14,
    "manzil": 3,
    "page": 265,
    "ruku": 222,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "فأسر بأهلك بقطع من الليل واتبع أدبارهم ولا يلتفت منكم أحد وامضوا حيث تؤمرون"
  },
  {
    "number": 1868,
    "text": "وَقَضَيۡنَآ إِلَيۡهِ ذَٰلِكَ ٱلۡأَمۡرَ أَنَّ دَابِرَ هَـٰٓؤُلَآءِ مَقۡطُوعٞ مُّصۡبِحِينَ",
    "numberInSurah": 66,
    "juz": 14,
    "manzil": 3,
    "page": 265,
    "ruku": 222,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "وقضينا إليه ذلك الأمر أن دابر هؤلاء مقطوع مصبحين"
  },
  {
    "number": 1869,
    "text": "وَجَآءَ أَهۡلُ ٱلۡمَدِينَةِ يَسۡتَبۡشِرُونَ",
    "numberInSurah": 67,
    "juz": 14,
    "manzil": 3,
    "page": 265,
    "ruku": 222,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "وجاء أهل المدينة يستبشرون"
  },
  {
    "number": 1870,
    "text": "قَالَ إِنَّ هَـٰٓؤُلَآءِ ضَيۡفِي فَلَا تَفۡضَحُونِ",
    "numberInSurah": 68,
    "juz": 14,
    "manzil": 3,
    "page": 265,
    "ruku": 222,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "قال إن هؤلاء ضيفي فلا تفضحون"
  },
  {
    "number": 1871,
    "text": "وَٱتَّقُواْ ٱللَّهَ وَلَا تُخۡزُونِ",
    "numberInSurah": 69,
    "juz": 14,
    "manzil": 3,
    "page": 265,
    "ruku": 222,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "واتقوا الله ولا تخزون"
  },
  {
    "number": 1872,
    "text": "قَالُوٓاْ أَوَلَمۡ نَنۡهَكَ عَنِ ٱلۡعَٰلَمِينَ",
    "numberInSurah": 70,
    "juz": 14,
    "manzil": 3,
    "page": 265,
    "ruku": 222,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "قالوا أولم ننهك عن العالمين"
  }
]