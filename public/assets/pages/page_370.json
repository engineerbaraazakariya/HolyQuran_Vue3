[
  {
    "number": 2993,
    "text": "فَلَمَّا تَرَـٰٓءَا ٱلۡجَمۡعَانِ قَالَ أَصۡحَٰبُ مُوسَىٰٓ إِنَّا لَمُدۡرَكُونَ",
    "numberInSurah": 61,
    "juz": 19,
    "manzil": 5,
    "page": 370,
    "ruku": 319,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "فلما تراءى الجمعان قال أصحاب موسى إنا لمدركون"
  },
  {
    "number": 2994,
    "text": "قَالَ كَلَّآۖ إِنَّ مَعِيَ رَبِّي سَيَهۡدِينِ",
    "numberInSurah": 62,
    "juz": 19,
    "manzil": 5,
    "page": 370,
    "ruku": 319,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "قال كلا إن معي ربي سيهدين"
  },
  {
    "number": 2995,
    "text": "فَأَوۡحَيۡنَآ إِلَىٰ مُوسَىٰٓ أَنِ ٱضۡرِب بِّعَصَاكَ ٱلۡبَحۡرَۖ فَٱنفَلَقَ فَكَانَ كُلُّ فِرۡقٖ كَٱلطَّوۡدِ ٱلۡعَظِيمِ",
    "numberInSurah": 63,
    "juz": 19,
    "manzil": 5,
    "page": 370,
    "ruku": 319,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "فأوحينا إلى موسى أن اضرب بعصاك البحر فانفلق فكان كل فرق كالطود العظيم"
  },
  {
    "number": 2996,
    "text": "وَأَزۡلَفۡنَا ثَمَّ ٱلۡأٓخَرِينَ",
    "numberInSurah": 64,
    "juz": 19,
    "manzil": 5,
    "page": 370,
    "ruku": 319,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "وأزلفنا ثم الآخرين"
  },
  {
    "number": 2997,
    "text": "وَأَنجَيۡنَا مُوسَىٰ وَمَن مَّعَهُۥٓ أَجۡمَعِينَ",
    "numberInSurah": 65,
    "juz": 19,
    "manzil": 5,
    "page": 370,
    "ruku": 319,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "وأنجينا موسى ومن معه أجمعين"
  },
  {
    "number": 2998,
    "text": "ثُمَّ أَغۡرَقۡنَا ٱلۡأٓخَرِينَ",
    "numberInSurah": 66,
    "juz": 19,
    "manzil": 5,
    "page": 370,
    "ruku": 319,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "ثم أغرقنا الآخرين"
  },
  {
    "number": 2999,
    "text": "إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ",
    "numberInSurah": 67,
    "juz": 19,
    "manzil": 5,
    "page": 370,
    "ruku": 319,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "إن في ذلك لآية وما كان أكثرهم مؤمنين"
  },
  {
    "number": 3000,
    "text": "وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ",
    "numberInSurah": 68,
    "juz": 19,
    "manzil": 5,
    "page": 370,
    "ruku": 319,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "وإن ربك لهو العزيز الرحيم"
  },
  {
    "number": 3001,
    "text": "وَٱتۡلُ عَلَيۡهِمۡ نَبَأَ إِبۡرَٰهِيمَ",
    "numberInSurah": 69,
    "juz": 19,
    "manzil": 5,
    "page": 370,
    "ruku": 319,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "واتل عليهم نبأ إبراهيم"
  },
  {
    "number": 3002,
    "text": "إِذۡ قَالَ لِأَبِيهِ وَقَوۡمِهِۦ مَا تَعۡبُدُونَ",
    "numberInSurah": 70,
    "juz": 19,
    "manzil": 5,
    "page": 370,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "إذ قال لأبيه وقومه ما تعبدون"
  },
  {
    "number": 3003,
    "text": "قَالُواْ نَعۡبُدُ أَصۡنَامٗا فَنَظَلُّ لَهَا عَٰكِفِينَ",
    "numberInSurah": 71,
    "juz": 19,
    "manzil": 5,
    "page": 370,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "قالوا نعبد أصناما فنظل لها عاكفين"
  },
  {
    "number": 3004,
    "text": "قَالَ هَلۡ يَسۡمَعُونَكُمۡ إِذۡ تَدۡعُونَ",
    "numberInSurah": 72,
    "juz": 19,
    "manzil": 5,
    "page": 370,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "قال هل يسمعونكم إذ تدعون"
  },
  {
    "number": 3005,
    "text": "أَوۡ يَنفَعُونَكُمۡ أَوۡ يَضُرُّونَ",
    "numberInSurah": 73,
    "juz": 19,
    "manzil": 5,
    "page": 370,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "أو ينفعونكم أو يضرون"
  },
  {
    "number": 3006,
    "text": "قَالُواْ بَلۡ وَجَدۡنَآ ءَابَآءَنَا كَذَٰلِكَ يَفۡعَلُونَ",
    "numberInSurah": 74,
    "juz": 19,
    "manzil": 5,
    "page": 370,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "قالوا بل وجدنا آباءنا كذلك يفعلون"
  },
  {
    "number": 3007,
    "text": "قَالَ أَفَرَءَيۡتُم مَّا كُنتُمۡ تَعۡبُدُونَ",
    "numberInSurah": 75,
    "juz": 19,
    "manzil": 5,
    "page": 370,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "قال أفرأيتم ما كنتم تعبدون"
  },
  {
    "number": 3008,
    "text": "أَنتُمۡ وَءَابَآؤُكُمُ ٱلۡأَقۡدَمُونَ",
    "numberInSurah": 76,
    "juz": 19,
    "manzil": 5,
    "page": 370,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "أنتم وآباؤكم الأقدمون"
  },
  {
    "number": 3009,
    "text": "فَإِنَّهُمۡ عَدُوّٞ لِّيٓ إِلَّا رَبَّ ٱلۡعَٰلَمِينَ",
    "numberInSurah": 77,
    "juz": 19,
    "manzil": 5,
    "page": 370,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "فإنهم عدو لي إلا رب العالمين"
  },
  {
    "number": 3010,
    "text": "ٱلَّذِي خَلَقَنِي فَهُوَ يَهۡدِينِ",
    "numberInSurah": 78,
    "juz": 19,
    "manzil": 5,
    "page": 370,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "الذي خلقني فهو يهدين"
  },
  {
    "number": 3011,
    "text": "وَٱلَّذِي هُوَ يُطۡعِمُنِي وَيَسۡقِينِ",
    "numberInSurah": 79,
    "juz": 19,
    "manzil": 5,
    "page": 370,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "والذي هو يطعمني ويسقين"
  },
  {
    "number": 3012,
    "text": "وَإِذَا مَرِضۡتُ فَهُوَ يَشۡفِينِ",
    "numberInSurah": 80,
    "juz": 19,
    "manzil": 5,
    "page": 370,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "وإذا مرضت فهو يشفين"
  },
  {
    "number": 3013,
    "text": "وَٱلَّذِي يُمِيتُنِي ثُمَّ يُحۡيِينِ",
    "numberInSurah": 81,
    "juz": 19,
    "manzil": 5,
    "page": 370,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "والذي يميتني ثم يحيين"
  },
  {
    "number": 3014,
    "text": "وَٱلَّذِيٓ أَطۡمَعُ أَن يَغۡفِرَ لِي خَطِيٓـَٔتِي يَوۡمَ ٱلدِّينِ",
    "numberInSurah": 82,
    "juz": 19,
    "manzil": 5,
    "page": 370,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "والذي أطمع أن يغفر لي خطيئتي يوم الدين"
  },
  {
    "number": 3015,
    "text": "رَبِّ هَبۡ لِي حُكۡمٗا وَأَلۡحِقۡنِي بِٱلصَّـٰلِحِينَ",
    "numberInSurah": 83,
    "juz": 19,
    "manzil": 5,
    "page": 370,
    "ruku": 320,
    "hizbQuarter": 148,
    "sajda": false,
    "no_Tashkeel_text": "رب هب لي حكما وألحقني بالصالحين"
  }
]