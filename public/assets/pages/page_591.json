[
  {
    "number": 5932,
    "text": "وَٱلسَّمَآءِ وَٱلطَّارِقِ",
    "numberInSurah": 1,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 528,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم والسماء والطارق"
  },
  {
    "number": 5933,
    "text": "وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ",
    "numberInSurah": 2,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 528,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "وما أدراك ما الطارق"
  },
  {
    "number": 5934,
    "text": "ٱلنَّجۡمُ ٱلثَّاقِبُ",
    "numberInSurah": 3,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 528,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "النجم الثاقب"
  },
  {
    "number": 5935,
    "text": "إِن كُلُّ نَفۡسٖ لَّمَّا عَلَيۡهَا حَافِظٞ",
    "numberInSurah": 4,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 528,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "إن كل نفس لما عليها حافظ"
  },
  {
    "number": 5936,
    "text": "فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ",
    "numberInSurah": 5,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 528,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "فلينظر الإنسان مم خلق"
  },
  {
    "number": 5937,
    "text": "خُلِقَ مِن مَّآءٖ دَافِقٖ",
    "numberInSurah": 6,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 528,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "خلق من ماء دافق"
  },
  {
    "number": 5938,
    "text": "يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ",
    "numberInSurah": 7,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 528,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "يخرج من بين الصلب والترائب"
  },
  {
    "number": 5939,
    "text": "إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرٞ",
    "numberInSurah": 8,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 528,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "إنه على رجعه لقادر"
  },
  {
    "number": 5940,
    "text": "يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ",
    "numberInSurah": 9,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 528,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "يوم تبلى السرائر"
  },
  {
    "number": 5941,
    "text": "فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖ",
    "numberInSurah": 10,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 528,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "فما له من قوة ولا ناصر"
  },
  {
    "number": 5942,
    "text": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ",
    "numberInSurah": 11,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 528,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "والسماء ذات الرجع"
  },
  {
    "number": 5943,
    "text": "وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ",
    "numberInSurah": 12,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 528,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "والأرض ذات الصدع"
  },
  {
    "number": 5944,
    "text": "إِنَّهُۥ لَقَوۡلٞ فَصۡلٞ",
    "numberInSurah": 13,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 528,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "إنه لقول فصل"
  },
  {
    "number": 5945,
    "text": "وَمَا هُوَ بِٱلۡهَزۡلِ",
    "numberInSurah": 14,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 528,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "وما هو بالهزل"
  },
  {
    "number": 5946,
    "text": "إِنَّهُمۡ يَكِيدُونَ كَيۡدٗا",
    "numberInSurah": 15,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 528,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "إنهم يكيدون كيدا"
  },
  {
    "number": 5947,
    "text": "وَأَكِيدُ كَيۡدٗا",
    "numberInSurah": 16,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 528,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "وأكيد كيدا"
  },
  {
    "number": 5948,
    "text": "فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا",
    "numberInSurah": 17,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 528,
    "hizbQuarter": 236,
    "sajda": false,
    "no_Tashkeel_text": "فمهل الكافرين أمهلهم رويدا"
  },
  {
    "number": 5949,
    "text": "سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى",
    "numberInSurah": 1,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 529,
    "hizbQuarter": 237,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم سبح اسم ربك الأعلى"
  },
  {
    "number": 5950,
    "text": "ٱلَّذِي خَلَقَ فَسَوَّىٰ",
    "numberInSurah": 2,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 529,
    "hizbQuarter": 237,
    "sajda": false,
    "no_Tashkeel_text": "الذي خلق فسوى"
  },
  {
    "number": 5951,
    "text": "وَٱلَّذِي قَدَّرَ فَهَدَىٰ",
    "numberInSurah": 3,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 529,
    "hizbQuarter": 237,
    "sajda": false,
    "no_Tashkeel_text": "والذي قدر فهدى"
  },
  {
    "number": 5952,
    "text": "وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ",
    "numberInSurah": 4,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 529,
    "hizbQuarter": 237,
    "sajda": false,
    "no_Tashkeel_text": "والذي أخرج المرعى"
  },
  {
    "number": 5953,
    "text": "فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ",
    "numberInSurah": 5,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 529,
    "hizbQuarter": 237,
    "sajda": false,
    "no_Tashkeel_text": "فجعله غثاء أحوى"
  },
  {
    "number": 5954,
    "text": "سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ",
    "numberInSurah": 6,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 529,
    "hizbQuarter": 237,
    "sajda": false,
    "no_Tashkeel_text": "سنقرئك فلا تنسى"
  },
  {
    "number": 5955,
    "text": "إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ",
    "numberInSurah": 7,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 529,
    "hizbQuarter": 237,
    "sajda": false,
    "no_Tashkeel_text": "إلا ما شاء الله إنه يعلم الجهر وما يخفى"
  },
  {
    "number": 5956,
    "text": "وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ",
    "numberInSurah": 8,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 529,
    "hizbQuarter": 237,
    "sajda": false,
    "no_Tashkeel_text": "ونيسرك لليسرى"
  },
  {
    "number": 5957,
    "text": "فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ",
    "numberInSurah": 9,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 529,
    "hizbQuarter": 237,
    "sajda": false,
    "no_Tashkeel_text": "فذكر إن نفعت الذكرى"
  },
  {
    "number": 5958,
    "text": "سَيَذَّكَّرُ مَن يَخۡشَىٰ",
    "numberInSurah": 10,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 529,
    "hizbQuarter": 237,
    "sajda": false,
    "no_Tashkeel_text": "سيذكر من يخشى"
  },
  {
    "number": 5959,
    "text": "وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى",
    "numberInSurah": 11,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 529,
    "hizbQuarter": 237,
    "sajda": false,
    "no_Tashkeel_text": "ويتجنبها الأشقى"
  },
  {
    "number": 5960,
    "text": "ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ",
    "numberInSurah": 12,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 529,
    "hizbQuarter": 237,
    "sajda": false,
    "no_Tashkeel_text": "الذي يصلى النار الكبرى"
  },
  {
    "number": 5961,
    "text": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ",
    "numberInSurah": 13,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 529,
    "hizbQuarter": 237,
    "sajda": false,
    "no_Tashkeel_text": "ثم لا يموت فيها ولا يحيى"
  },
  {
    "number": 5962,
    "text": "قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ",
    "numberInSurah": 14,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 529,
    "hizbQuarter": 237,
    "sajda": false,
    "no_Tashkeel_text": "قد أفلح من تزكى"
  },
  {
    "number": 5963,
    "text": "وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ",
    "numberInSurah": 15,
    "juz": 30,
    "manzil": 7,
    "page": 591,
    "ruku": 529,
    "hizbQuarter": 237,
    "sajda": false,
    "no_Tashkeel_text": "وذكر اسم ربه فصلى"
  }
]