[
  {
    "number": 5703,
    "text": "إِنَّ لِلۡمُتَّقِينَ مَفَازًا",
    "numberInSurah": 31,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 519,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "إن للمتقين مفازا"
  },
  {
    "number": 5704,
    "text": "حَدَآئِقَ وَأَعۡنَٰبٗا",
    "numberInSurah": 32,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 519,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "حدائق وأعنابا"
  },
  {
    "number": 5705,
    "text": "وَكَوَاعِبَ أَتۡرَابٗا",
    "numberInSurah": 33,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 519,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "وكواعب أترابا"
  },
  {
    "number": 5706,
    "text": "وَكَأۡسٗا دِهَاقٗا",
    "numberInSurah": 34,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 519,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "وكأسا دهاقا"
  },
  {
    "number": 5707,
    "text": "لَّا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا كِذَّـٰبٗا",
    "numberInSurah": 35,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 519,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "لا يسمعون فيها لغوا ولا كذابا"
  },
  {
    "number": 5708,
    "text": "جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَابٗا",
    "numberInSurah": 36,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 519,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "جزاء من ربك عطاء حسابا"
  },
  {
    "number": 5709,
    "text": "رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنِۖ لَا يَمۡلِكُونَ مِنۡهُ خِطَابٗا",
    "numberInSurah": 37,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 519,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "رب السماوات والأرض وما بينهما الرحمن لا يملكون منه خطابا"
  },
  {
    "number": 5710,
    "text": "يَوۡمَ يَقُومُ ٱلرُّوحُ وَٱلۡمَلَـٰٓئِكَةُ صَفّٗاۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَٰنُ وَقَالَ صَوَابٗا",
    "numberInSurah": 38,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 519,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "يوم يقوم الروح والملائكة صفا لا يتكلمون إلا من أذن له الرحمن وقال صوابا"
  },
  {
    "number": 5711,
    "text": "ذَٰلِكَ ٱلۡيَوۡمُ ٱلۡحَقُّۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا",
    "numberInSurah": 39,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 519,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "ذلك اليوم الحق فمن شاء اتخذ إلى ربه مآبا"
  },
  {
    "number": 5712,
    "text": "إِنَّآ أَنذَرۡنَٰكُمۡ عَذَابٗا قَرِيبٗا يَوۡمَ يَنظُرُ ٱلۡمَرۡءُ مَا قَدَّمَتۡ يَدَاهُ وَيَقُولُ ٱلۡكَافِرُ يَٰلَيۡتَنِي كُنتُ تُرَٰبَۢا",
    "numberInSurah": 40,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 519,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "إنا أنذرناكم عذابا قريبا يوم ينظر المرء ما قدمت يداه ويقول الكافر يا ليتني كنت ترابا"
  },
  {
    "number": 5713,
    "text": "وَٱلنَّـٰزِعَٰتِ غَرۡقٗا",
    "numberInSurah": 1,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم والنازعات غرقا"
  },
  {
    "number": 5714,
    "text": "وَٱلنَّـٰشِطَٰتِ نَشۡطٗا",
    "numberInSurah": 2,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "والناشطات نشطا"
  },
  {
    "number": 5715,
    "text": "وَٱلسَّـٰبِحَٰتِ سَبۡحٗا",
    "numberInSurah": 3,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "والسابحات سبحا"
  },
  {
    "number": 5716,
    "text": "فَٱلسَّـٰبِقَٰتِ سَبۡقٗا",
    "numberInSurah": 4,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "فالسابقات سبقا"
  },
  {
    "number": 5717,
    "text": "فَٱلۡمُدَبِّرَٰتِ أَمۡرٗا",
    "numberInSurah": 5,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "فالمدبرات أمرا"
  },
  {
    "number": 5718,
    "text": "يَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ",
    "numberInSurah": 6,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "يوم ترجف الراجفة"
  },
  {
    "number": 5719,
    "text": "تَتۡبَعُهَا ٱلرَّادِفَةُ",
    "numberInSurah": 7,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "تتبعها الرادفة"
  },
  {
    "number": 5720,
    "text": "قُلُوبٞ يَوۡمَئِذٖ وَاجِفَةٌ",
    "numberInSurah": 8,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "قلوب يومئذ واجفة"
  },
  {
    "number": 5721,
    "text": "أَبۡصَٰرُهَا خَٰشِعَةٞ",
    "numberInSurah": 9,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "أبصارها خاشعة"
  },
  {
    "number": 5722,
    "text": "يَقُولُونَ أَءِنَّا لَمَرۡدُودُونَ فِي ٱلۡحَافِرَةِ",
    "numberInSurah": 10,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "يقولون أإنا لمردودون في الحافرة"
  },
  {
    "number": 5723,
    "text": "أَءِذَا كُنَّا عِظَٰمٗا نَّخِرَةٗ",
    "numberInSurah": 11,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "أإذا كنا عظاما نخرة"
  },
  {
    "number": 5724,
    "text": "قَالُواْ تِلۡكَ إِذٗا كَرَّةٌ خَاسِرَةٞ",
    "numberInSurah": 12,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "قالوا تلك إذا كرة خاسرة"
  },
  {
    "number": 5725,
    "text": "فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ",
    "numberInSurah": 13,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "فإنما هي زجرة واحدة"
  },
  {
    "number": 5726,
    "text": "فَإِذَا هُم بِٱلسَّاهِرَةِ",
    "numberInSurah": 14,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "فإذا هم بالساهرة"
  },
  {
    "number": 5727,
    "text": "هَلۡ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ",
    "numberInSurah": 15,
    "juz": 30,
    "manzil": 7,
    "page": 583,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "هل أتاك حديث موسى"
  }
]