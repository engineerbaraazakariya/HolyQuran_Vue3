[
  {
    "number": 1834,
    "text": "قَالَ يَـٰٓإِبۡلِيسُ مَا لَكَ أَلَّا تَكُونَ مَعَ ٱلسَّـٰجِدِينَ",
    "numberInSurah": 32,
    "juz": 14,
    "manzil": 3,
    "page": 264,
    "ruku": 220,
    "hizbQuarter": 105,
    "sajda": false,
    "no_Tashkeel_text": "قال يا إبليس ما لك ألا تكون مع الساجدين"
  },
  {
    "number": 1835,
    "text": "قَالَ لَمۡ أَكُن لِّأَسۡجُدَ لِبَشَرٍ خَلَقۡتَهُۥ مِن صَلۡصَٰلٖ مِّنۡ حَمَإٖ مَّسۡنُونٖ",
    "numberInSurah": 33,
    "juz": 14,
    "manzil": 3,
    "page": 264,
    "ruku": 220,
    "hizbQuarter": 105,
    "sajda": false,
    "no_Tashkeel_text": "قال لم أكن لأسجد لبشر خلقته من صلصال من حمإ مسنون"
  },
  {
    "number": 1836,
    "text": "قَالَ فَٱخۡرُجۡ مِنۡهَا فَإِنَّكَ رَجِيمٞ",
    "numberInSurah": 34,
    "juz": 14,
    "manzil": 3,
    "page": 264,
    "ruku": 220,
    "hizbQuarter": 105,
    "sajda": false,
    "no_Tashkeel_text": "قال فاخرج منها فإنك رجيم"
  },
  {
    "number": 1837,
    "text": "وَإِنَّ عَلَيۡكَ ٱللَّعۡنَةَ إِلَىٰ يَوۡمِ ٱلدِّينِ",
    "numberInSurah": 35,
    "juz": 14,
    "manzil": 3,
    "page": 264,
    "ruku": 220,
    "hizbQuarter": 105,
    "sajda": false,
    "no_Tashkeel_text": "وإن عليك اللعنة إلى يوم الدين"
  },
  {
    "number": 1838,
    "text": "قَالَ رَبِّ فَأَنظِرۡنِيٓ إِلَىٰ يَوۡمِ يُبۡعَثُونَ",
    "numberInSurah": 36,
    "juz": 14,
    "manzil": 3,
    "page": 264,
    "ruku": 220,
    "hizbQuarter": 105,
    "sajda": false,
    "no_Tashkeel_text": "قال رب فأنظرني إلى يوم يبعثون"
  },
  {
    "number": 1839,
    "text": "قَالَ فَإِنَّكَ مِنَ ٱلۡمُنظَرِينَ",
    "numberInSurah": 37,
    "juz": 14,
    "manzil": 3,
    "page": 264,
    "ruku": 220,
    "hizbQuarter": 105,
    "sajda": false,
    "no_Tashkeel_text": "قال فإنك من المنظرين"
  },
  {
    "number": 1840,
    "text": "إِلَىٰ يَوۡمِ ٱلۡوَقۡتِ ٱلۡمَعۡلُومِ",
    "numberInSurah": 38,
    "juz": 14,
    "manzil": 3,
    "page": 264,
    "ruku": 220,
    "hizbQuarter": 105,
    "sajda": false,
    "no_Tashkeel_text": "إلى يوم الوقت المعلوم"
  },
  {
    "number": 1841,
    "text": "قَالَ رَبِّ بِمَآ أَغۡوَيۡتَنِي لَأُزَيِّنَنَّ لَهُمۡ فِي ٱلۡأَرۡضِ وَلَأُغۡوِيَنَّهُمۡ أَجۡمَعِينَ",
    "numberInSurah": 39,
    "juz": 14,
    "manzil": 3,
    "page": 264,
    "ruku": 220,
    "hizbQuarter": 105,
    "sajda": false,
    "no_Tashkeel_text": "قال رب بما أغويتني لأزينن لهم في الأرض ولأغوينهم أجمعين"
  },
  {
    "number": 1842,
    "text": "إِلَّا عِبَادَكَ مِنۡهُمُ ٱلۡمُخۡلَصِينَ",
    "numberInSurah": 40,
    "juz": 14,
    "manzil": 3,
    "page": 264,
    "ruku": 220,
    "hizbQuarter": 105,
    "sajda": false,
    "no_Tashkeel_text": "إلا عبادك منهم المخلصين"
  },
  {
    "number": 1843,
    "text": "قَالَ هَٰذَا صِرَٰطٌ عَلَيَّ مُسۡتَقِيمٌ",
    "numberInSurah": 41,
    "juz": 14,
    "manzil": 3,
    "page": 264,
    "ruku": 220,
    "hizbQuarter": 105,
    "sajda": false,
    "no_Tashkeel_text": "قال هذا صراط علي مستقيم"
  },
  {
    "number": 1844,
    "text": "إِنَّ عِبَادِي لَيۡسَ لَكَ عَلَيۡهِمۡ سُلۡطَٰنٌ إِلَّا مَنِ ٱتَّبَعَكَ مِنَ ٱلۡغَاوِينَ",
    "numberInSurah": 42,
    "juz": 14,
    "manzil": 3,
    "page": 264,
    "ruku": 220,
    "hizbQuarter": 105,
    "sajda": false,
    "no_Tashkeel_text": "إن عبادي ليس لك عليهم سلطان إلا من اتبعك من الغاوين"
  },
  {
    "number": 1845,
    "text": "وَإِنَّ جَهَنَّمَ لَمَوۡعِدُهُمۡ أَجۡمَعِينَ",
    "numberInSurah": 43,
    "juz": 14,
    "manzil": 3,
    "page": 264,
    "ruku": 220,
    "hizbQuarter": 105,
    "sajda": false,
    "no_Tashkeel_text": "وإن جهنم لموعدهم أجمعين"
  },
  {
    "number": 1846,
    "text": "لَهَا سَبۡعَةُ أَبۡوَٰبٖ لِّكُلِّ بَابٖ مِّنۡهُمۡ جُزۡءٞ مَّقۡسُومٌ",
    "numberInSurah": 44,
    "juz": 14,
    "manzil": 3,
    "page": 264,
    "ruku": 220,
    "hizbQuarter": 105,
    "sajda": false,
    "no_Tashkeel_text": "لها سبعة أبواب لكل باب منهم جزء مقسوم"
  },
  {
    "number": 1847,
    "text": "إِنَّ ٱلۡمُتَّقِينَ فِي جَنَّـٰتٖ وَعُيُونٍ",
    "numberInSurah": 45,
    "juz": 14,
    "manzil": 3,
    "page": 264,
    "ruku": 221,
    "hizbQuarter": 105,
    "sajda": false,
    "no_Tashkeel_text": "إن المتقين في جنات وعيون"
  },
  {
    "number": 1848,
    "text": "ٱدۡخُلُوهَا بِسَلَٰمٍ ءَامِنِينَ",
    "numberInSurah": 46,
    "juz": 14,
    "manzil": 3,
    "page": 264,
    "ruku": 221,
    "hizbQuarter": 105,
    "sajda": false,
    "no_Tashkeel_text": "ادخلوها بسلام آمنين"
  },
  {
    "number": 1849,
    "text": "وَنَزَعۡنَا مَا فِي صُدُورِهِم مِّنۡ غِلٍّ إِخۡوَٰنًا عَلَىٰ سُرُرٖ مُّتَقَٰبِلِينَ",
    "numberInSurah": 47,
    "juz": 14,
    "manzil": 3,
    "page": 264,
    "ruku": 221,
    "hizbQuarter": 105,
    "sajda": false,
    "no_Tashkeel_text": "ونزعنا ما في صدورهم من غل إخوانا على سرر متقابلين"
  },
  {
    "number": 1850,
    "text": "لَا يَمَسُّهُمۡ فِيهَا نَصَبٞ وَمَا هُم مِّنۡهَا بِمُخۡرَجِينَ",
    "numberInSurah": 48,
    "juz": 14,
    "manzil": 3,
    "page": 264,
    "ruku": 221,
    "hizbQuarter": 105,
    "sajda": false,
    "no_Tashkeel_text": "لا يمسهم فيها نصب وما هم منها بمخرجين"
  },
  {
    "number": 1851,
    "text": "۞نَبِّئۡ عِبَادِيٓ أَنِّيٓ أَنَا ٱلۡغَفُورُ ٱلرَّحِيمُ",
    "numberInSurah": 49,
    "juz": 14,
    "manzil": 3,
    "page": 264,
    "ruku": 221,
    "hizbQuarter": 105,
    "sajda": false,
    "no_Tashkeel_text": "نبئ عبادي أني أنا الغفور الرحيم"
  },
  {
    "number": 1852,
    "text": "وَأَنَّ عَذَابِي هُوَ ٱلۡعَذَابُ ٱلۡأَلِيمُ",
    "numberInSurah": 50,
    "juz": 14,
    "manzil": 3,
    "page": 264,
    "ruku": 221,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "وأن عذابي هو العذاب الأليم"
  },
  {
    "number": 1853,
    "text": "وَنَبِّئۡهُمۡ عَن ضَيۡفِ إِبۡرَٰهِيمَ",
    "numberInSurah": 51,
    "juz": 14,
    "manzil": 3,
    "page": 264,
    "ruku": 221,
    "hizbQuarter": 106,
    "sajda": false,
    "no_Tashkeel_text": "ونبئهم عن ضيف إبراهيم"
  }
]