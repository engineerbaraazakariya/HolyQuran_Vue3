    "manzil": 7,
    "page": 581,
    "ruku": 516,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "وجعلنا فيها رواسي شامخات وأسقيناكم ماء فراتا"
  },
  {
    "number": 5650,
    "text": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
