    "juz": 29,
    "manzil": 7,
    "page": 581,
    "ruku": 516,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "ألم نجعل الأرض كفاتا"
  },
  {
    "number": 5648,
    "text": "أَحۡيَآءٗ وَأَمۡوَٰتٗا",
