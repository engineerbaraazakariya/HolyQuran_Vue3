    "ruku": 516,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "كأنه جمالت صفر"
  },
  {
    "number": 5656,
    "text": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
