    "juz": 29,
    "manzil": 7,
    "page": 581,
    "ruku": 516,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "ويل يومئذ للمكذبين"
  },
  {
    "number": 5651,
    "text": "ٱنطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ",
    "numberInSurah": 29,
    "juz": 29,
    "manzil": 7,
    "page": 581,
    "ruku": 516,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "انطلقوا إلى ما كنتم به تكذبون"
  },
  {
    "number": 5652,
    "text": "ٱنطَلِقُوٓاْ إِلَىٰ ظِلّٖ ذِي ثَلَٰثِ شُعَبٖ",
    "numberInSurah": 30,
    "juz": 29,
    "manzil": 7,
    "page": 581,
    "ruku": 516,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "انطلقوا إلى ظل ذي ثلاث شعب"
  },
  {
    "number": 5653,
    "text": "لَّا ظَلِيلٖ وَلَا يُغۡنِي مِنَ ٱللَّهَبِ",
