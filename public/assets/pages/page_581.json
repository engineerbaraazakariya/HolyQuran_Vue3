    "page": 581,
    "ruku": 516,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "ويل يومئذ للمكذبين"
  },
  {
    "number": 5647,
    "text": "أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ كِفَاتًا",
