    "manzil": 7,
    "page": 581,
    "ruku": 516,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "أحياء وأمواتا"
  },
  {
    "number": 5649,
    "text": "وَجَعَلۡنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتٖ وَأَسۡقَيۡنَٰكُم مَّآءٗ فُرَاتٗا",
