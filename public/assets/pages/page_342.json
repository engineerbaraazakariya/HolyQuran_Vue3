[
  {
    "number": 2674,
    "text": "قَدۡ أَفۡلَحَ ٱلۡمُؤۡمِنُونَ",
    "numberInSurah": 1,
    "juz": 18,
    "manzil": 4,
    "page": 342,
    "ruku": 295,
    "hizbQuarter": 137,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم قد أفلح المؤمنون"
  },
  {
    "number": 2675,
    "text": "ٱلَّذِينَ هُمۡ فِي صَلَاتِهِمۡ خَٰشِعُونَ",
    "numberInSurah": 2,
    "juz": 18,
    "manzil": 4,
    "page": 342,
    "ruku": 295,
    "hizbQuarter": 137,
    "sajda": false,
    "no_Tashkeel_text": "الذين هم في صلاتهم خاشعون"
  },
  {
    "number": 2676,
    "text": "وَٱلَّذِينَ هُمۡ عَنِ ٱللَّغۡوِ مُعۡرِضُونَ",
    "numberInSurah": 3,
    "juz": 18,
    "manzil": 4,
    "page": 342,
    "ruku": 295,
    "hizbQuarter": 137,
    "sajda": false,
    "no_Tashkeel_text": "والذين هم عن اللغو معرضون"
  },
  {
    "number": 2677,
    "text": "وَٱلَّذِينَ هُمۡ لِلزَّكَوٰةِ فَٰعِلُونَ",
    "numberInSurah": 4,
    "juz": 18,
    "manzil": 4,
    "page": 342,
    "ruku": 295,
    "hizbQuarter": 137,
    "sajda": false,
    "no_Tashkeel_text": "والذين هم للزكاة فاعلون"
  },
  {
    "number": 2678,
    "text": "وَٱلَّذِينَ هُمۡ لِفُرُوجِهِمۡ حَٰفِظُونَ",
    "numberInSurah": 5,
    "juz": 18,
    "manzil": 4,
    "page": 342,
    "ruku": 295,
    "hizbQuarter": 137,
    "sajda": false,
    "no_Tashkeel_text": "والذين هم لفروجهم حافظون"
  },
  {
    "number": 2679,
    "text": "إِلَّا عَلَىٰٓ أَزۡوَٰجِهِمۡ أَوۡ مَا مَلَكَتۡ أَيۡمَٰنُهُمۡ فَإِنَّهُمۡ غَيۡرُ مَلُومِينَ",
    "numberInSurah": 6,
    "juz": 18,
    "manzil": 4,
    "page": 342,
    "ruku": 295,
    "hizbQuarter": 137,
    "sajda": false,
    "no_Tashkeel_text": "إلا على أزواجهم أو ما ملكت أيمانهم فإنهم غير ملومين"
  },
  {
    "number": 2680,
    "text": "فَمَنِ ٱبۡتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُوْلَـٰٓئِكَ هُمُ ٱلۡعَادُونَ",
    "numberInSurah": 7,
    "juz": 18,
    "manzil": 4,
    "page": 342,
    "ruku": 295,
    "hizbQuarter": 137,
    "sajda": false,
    "no_Tashkeel_text": "فمن ابتغى وراء ذلك فأولئك هم العادون"
  },
  {
    "number": 2681,
    "text": "وَٱلَّذِينَ هُمۡ لِأَمَٰنَٰتِهِمۡ وَعَهۡدِهِمۡ رَٰعُونَ",
    "numberInSurah": 8,
    "juz": 18,
    "manzil": 4,
    "page": 342,
    "ruku": 295,
    "hizbQuarter": 137,
    "sajda": false,
    "no_Tashkeel_text": "والذين هم لأماناتهم وعهدهم راعون"
  },
  {
    "number": 2682,
    "text": "وَٱلَّذِينَ هُمۡ عَلَىٰ صَلَوَٰتِهِمۡ يُحَافِظُونَ",
    "numberInSurah": 9,
    "juz": 18,
    "manzil": 4,
    "page": 342,
    "ruku": 295,
    "hizbQuarter": 137,
    "sajda": false,
    "no_Tashkeel_text": "والذين هم على صلواتهم يحافظون"
  },
  {
    "number": 2683,
    "text": "أُوْلَـٰٓئِكَ هُمُ ٱلۡوَٰرِثُونَ",
    "numberInSurah": 10,
    "juz": 18,
    "manzil": 4,
    "page": 342,
    "ruku": 295,
    "hizbQuarter": 137,
    "sajda": false,
    "no_Tashkeel_text": "أولئك هم الوارثون"
  },
  {
    "number": 2684,
    "text": "ٱلَّذِينَ يَرِثُونَ ٱلۡفِرۡدَوۡسَ هُمۡ فِيهَا خَٰلِدُونَ",
    "numberInSurah": 11,
    "juz": 18,
    "manzil": 4,
    "page": 342,
    "ruku": 295,
    "hizbQuarter": 137,
    "sajda": false,
    "no_Tashkeel_text": "الذين يرثون الفردوس هم فيها خالدون"
  },
  {
    "number": 2685,
    "text": "وَلَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ مِن سُلَٰلَةٖ مِّن طِينٖ",
    "numberInSurah": 12,
    "juz": 18,
    "manzil": 4,
    "page": 342,
    "ruku": 295,
    "hizbQuarter": 137,
    "sajda": false,
    "no_Tashkeel_text": "ولقد خلقنا الإنسان من سلالة من طين"
  },
  {
    "number": 2686,
    "text": "ثُمَّ جَعَلۡنَٰهُ نُطۡفَةٗ فِي قَرَارٖ مَّكِينٖ",
    "numberInSurah": 13,
    "juz": 18,
    "manzil": 4,
    "page": 342,
    "ruku": 295,
    "hizbQuarter": 137,
    "sajda": false,
    "no_Tashkeel_text": "ثم جعلناه نطفة في قرار مكين"
  },
  {
    "number": 2687,
    "text": "ثُمَّ خَلَقۡنَا ٱلنُّطۡفَةَ عَلَقَةٗ فَخَلَقۡنَا ٱلۡعَلَقَةَ مُضۡغَةٗ فَخَلَقۡنَا ٱلۡمُضۡغَةَ عِظَٰمٗا فَكَسَوۡنَا ٱلۡعِظَٰمَ لَحۡمٗا ثُمَّ أَنشَأۡنَٰهُ خَلۡقًا ءَاخَرَۚ فَتَبَارَكَ ٱللَّهُ أَحۡسَنُ ٱلۡخَٰلِقِينَ",
    "numberInSurah": 14,
    "juz": 18,
    "manzil": 4,
    "page": 342,
    "ruku": 295,
    "hizbQuarter": 137,
    "sajda": false,
    "no_Tashkeel_text": "ثم خلقنا النطفة علقة فخلقنا العلقة مضغة فخلقنا المضغة عظاما فكسونا العظام لحما ثم أنشأناه خلقا آخر فتبارك الله أحسن الخالقين"
  },
  {
    "number": 2688,
    "text": "ثُمَّ إِنَّكُم بَعۡدَ ذَٰلِكَ لَمَيِّتُونَ",
    "numberInSurah": 15,
    "juz": 18,
    "manzil": 4,
    "page": 342,
    "ruku": 295,
    "hizbQuarter": 137,
    "sajda": false,
    "no_Tashkeel_text": "ثم إنكم بعد ذلك لميتون"
  },
  {
    "number": 2689,
    "text": "ثُمَّ إِنَّكُمۡ يَوۡمَ ٱلۡقِيَٰمَةِ تُبۡعَثُونَ",
    "numberInSurah": 16,
    "juz": 18,
    "manzil": 4,
    "page": 342,
    "ruku": 295,
    "hizbQuarter": 137,
    "sajda": false,
    "no_Tashkeel_text": "ثم إنكم يوم القيامة تبعثون"
  },
  {
    "number": 2690,
    "text": "وَلَقَدۡ خَلَقۡنَا فَوۡقَكُمۡ سَبۡعَ طَرَآئِقَ وَمَا كُنَّا عَنِ ٱلۡخَلۡقِ غَٰفِلِينَ",
    "numberInSurah": 17,
    "juz": 18,
    "manzil": 4,
    "page": 342,
    "ruku": 295,
    "hizbQuarter": 137,
    "sajda": false,
    "no_Tashkeel_text": "ولقد خلقنا فوقكم سبع طرائق وما كنا عن الخلق غافلين"
  }
]