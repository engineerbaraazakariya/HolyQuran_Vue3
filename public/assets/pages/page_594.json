[
  {
    "number": 6017,
    "text": "يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي",
    "numberInSurah": 24,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 531,
    "hizbQuarter": 237,
    "sajda": false,
    "no_Tashkeel_text": "يقول يا ليتني قدمت لحياتي"
  },
  {
    "number": 6018,
    "text": "فَيَوۡمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ",
    "numberInSurah": 25,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 531,
    "hizbQuarter": 237,
    "sajda": false,
    "no_Tashkeel_text": "فيومئذ لا يعذب عذابه أحد"
  },
  {
    "number": 6019,
    "text": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞ",
    "numberInSurah": 26,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 531,
    "hizbQuarter": 237,
    "sajda": false,
    "no_Tashkeel_text": "ولا يوثق وثاقه أحد"
  },
  {
    "number": 6020,
    "text": "يَـٰٓأَيَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ",
    "numberInSurah": 27,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 531,
    "hizbQuarter": 237,
    "sajda": false,
    "no_Tashkeel_text": "يا أيتها النفس المطمئنة"
  },
  {
    "number": 6021,
    "text": "ٱرۡجِعِيٓ إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرۡضِيَّةٗ",
    "numberInSurah": 28,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 531,
    "hizbQuarter": 237,
    "sajda": false,
    "no_Tashkeel_text": "ارجعي إلى ربك راضية مرضية"
  },
  {
    "number": 6022,
    "text": "فَٱدۡخُلِي فِي عِبَٰدِي",
    "numberInSurah": 29,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 531,
    "hizbQuarter": 237,
    "sajda": false,
    "no_Tashkeel_text": "فادخلي في عبادي"
  },
  {
    "number": 6023,
    "text": "وَٱدۡخُلِي جَنَّتِي",
    "numberInSurah": 30,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 531,
    "hizbQuarter": 237,
    "sajda": false,
    "no_Tashkeel_text": "وادخلي جنتي"
  },
  {
    "number": 6024,
    "text": "لَآ أُقۡسِمُ بِهَٰذَا ٱلۡبَلَدِ",
    "numberInSurah": 1,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 532,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم لا أقسم بهذا البلد"
  },
  {
    "number": 6025,
    "text": "وَأَنتَ حِلُّۢ بِهَٰذَا ٱلۡبَلَدِ",
    "numberInSurah": 2,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 532,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "وأنت حل بهذا البلد"
  },
  {
    "number": 6026,
    "text": "وَوَالِدٖ وَمَا وَلَدَ",
    "numberInSurah": 3,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 532,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "ووالد وما ولد"
  },
  {
    "number": 6027,
    "text": "لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِي كَبَدٍ",
    "numberInSurah": 4,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 532,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "لقد خلقنا الإنسان في كبد"
  },
  {
    "number": 6028,
    "text": "أَيَحۡسَبُ أَن لَّن يَقۡدِرَ عَلَيۡهِ أَحَدٞ",
    "numberInSurah": 5,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 532,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "أيحسب أن لن يقدر عليه أحد"
  },
  {
    "number": 6029,
    "text": "يَقُولُ أَهۡلَكۡتُ مَالٗا لُّبَدًا",
    "numberInSurah": 6,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 532,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "يقول أهلكت مالا لبدا"
  },
  {
    "number": 6030,
    "text": "أَيَحۡسَبُ أَن لَّمۡ يَرَهُۥٓ أَحَدٌ",
    "numberInSurah": 7,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 532,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "أيحسب أن لم يره أحد"
  },
  {
    "number": 6031,
    "text": "أَلَمۡ نَجۡعَل لَّهُۥ عَيۡنَيۡنِ",
    "numberInSurah": 8,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 532,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "ألم نجعل له عينين"
  },
  {
    "number": 6032,
    "text": "وَلِسَانٗا وَشَفَتَيۡنِ",
    "numberInSurah": 9,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 532,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "ولسانا وشفتين"
  },
  {
    "number": 6033,
    "text": "وَهَدَيۡنَٰهُ ٱلنَّجۡدَيۡنِ",
    "numberInSurah": 10,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 532,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "وهديناه النجدين"
  },
  {
    "number": 6034,
    "text": "فَلَا ٱقۡتَحَمَ ٱلۡعَقَبَةَ",
    "numberInSurah": 11,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 532,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "فلا اقتحم العقبة"
  },
  {
    "number": 6035,
    "text": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡعَقَبَةُ",
    "numberInSurah": 12,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 532,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "وما أدراك ما العقبة"
  },
  {
    "number": 6036,
    "text": "فَكُّ رَقَبَةٍ",
    "numberInSurah": 13,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 532,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "فك رقبة"
  },
  {
    "number": 6037,
    "text": "أَوۡ إِطۡعَٰمٞ فِي يَوۡمٖ ذِي مَسۡغَبَةٖ",
    "numberInSurah": 14,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 532,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "أو إطعام في يوم ذي مسغبة"
  },
  {
    "number": 6038,
    "text": "يَتِيمٗا ذَا مَقۡرَبَةٍ",
    "numberInSurah": 15,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 532,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "يتيما ذا مقربة"
  },
  {
    "number": 6039,
    "text": "أَوۡ مِسۡكِينٗا ذَا مَتۡرَبَةٖ",
    "numberInSurah": 16,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 532,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "أو مسكينا ذا متربة"
  },
  {
    "number": 6040,
    "text": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُواْ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ وَتَوَاصَوۡاْ بِٱلۡمَرۡحَمَةِ",
    "numberInSurah": 17,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 532,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "ثم كان من الذين آمنوا وتواصوا بالصبر وتواصوا بالمرحمة"
  },
  {
    "number": 6041,
    "text": "أُوْلَـٰٓئِكَ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ",
    "numberInSurah": 18,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 532,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "أولئك أصحاب الميمنة"
  },
  {
    "number": 6042,
    "text": "وَٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمۡ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ",
    "numberInSurah": 19,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 532,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "والذين كفروا بآياتنا هم أصحاب المشأمة"
  },
  {
    "number": 6043,
    "text": "عَلَيۡهِمۡ نَارٞ مُّؤۡصَدَةُۢ",
    "numberInSurah": 20,
    "juz": 30,
    "manzil": 7,
    "page": 594,
    "ruku": 532,
    "hizbQuarter": 238,
    "sajda": false,
    "no_Tashkeel_text": "عليهم نار مؤصدة"
  }
]