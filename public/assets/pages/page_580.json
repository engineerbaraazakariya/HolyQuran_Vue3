[
  {
    "number": 5617,
    "text": "وَمِنَ ٱلَّيۡلِ فَٱسۡجُدۡ لَهُۥ وَسَبِّحۡهُ لَيۡلٗا طَوِيلًا",
    "numberInSurah": 26,
    "juz": 29,
    "manzil": 7,
    "page": 580,
    "ruku": 515,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "ومن الليل فاسجد له وسبحه ليلا طويلا"
  },
  {
    "number": 5618,
    "text": "إِنَّ هَـٰٓؤُلَآءِ يُحِبُّونَ ٱلۡعَاجِلَةَ وَيَذَرُونَ وَرَآءَهُمۡ يَوۡمٗا ثَقِيلٗا",
    "numberInSurah": 27,
    "juz": 29,
    "manzil": 7,
    "page": 580,
    "ruku": 515,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "إن هؤلاء يحبون العاجلة ويذرون وراءهم يوما ثقيلا"
  },
  {
    "number": 5619,
    "text": "نَّحۡنُ خَلَقۡنَٰهُمۡ وَشَدَدۡنَآ أَسۡرَهُمۡۖ وَإِذَا شِئۡنَا بَدَّلۡنَآ أَمۡثَٰلَهُمۡ تَبۡدِيلًا",
    "numberInSurah": 28,
    "juz": 29,
    "manzil": 7,
    "page": 580,
    "ruku": 515,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "نحن خلقناهم وشددنا أسرهم وإذا شئنا بدلنا أمثالهم تبديلا"
  },
  {
    "number": 5620,
    "text": "إِنَّ هَٰذِهِۦ تَذۡكِرَةٞۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلٗا",
    "numberInSurah": 29,
    "juz": 29,
    "manzil": 7,
    "page": 580,
    "ruku": 515,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "إن هذه تذكرة فمن شاء اتخذ إلى ربه سبيلا"
  },
  {
    "number": 5621,
    "text": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمٗا",
    "numberInSurah": 30,
    "juz": 29,
    "manzil": 7,
    "page": 580,
    "ruku": 515,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "وما تشاءون إلا أن يشاء الله إن الله كان عليما حكيما"
  },
  {
    "number": 5622,
    "text": "يُدۡخِلُ مَن يَشَآءُ فِي رَحۡمَتِهِۦۚ وَٱلظَّـٰلِمِينَ أَعَدَّ لَهُمۡ عَذَابًا أَلِيمَۢا",
    "numberInSurah": 31,
    "juz": 29,
    "manzil": 7,
    "page": 580,
    "ruku": 515,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "يدخل من يشاء في رحمته والظالمين أعد لهم عذابا أليما"
  },
  {
    "number": 5623,
    "text": "وَٱلۡمُرۡسَلَٰتِ عُرۡفٗا",
    "numberInSurah": 1,
    "juz": 29,
    "manzil": 7,
    "page": 580,
    "ruku": 516,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "بسم الله الرحمن الرحيم والمرسلات عرفا"
  },
  {
    "number": 5624,
    "text": "فَٱلۡعَٰصِفَٰتِ عَصۡفٗا",
    "numberInSurah": 2,
    "juz": 29,
    "manzil": 7,
    "page": 580,
    "ruku": 516,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "فالعاصفات عصفا"
  },
  {
    "number": 5625,
    "text": "وَٱلنَّـٰشِرَٰتِ نَشۡرٗا",
    "numberInSurah": 3,
    "juz": 29,
    "manzil": 7,
    "page": 580,
    "ruku": 516,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "والناشرات نشرا"
  },
  {
    "number": 5626,
    "text": "فَٱلۡفَٰرِقَٰتِ فَرۡقٗا",
    "numberInSurah": 4,
    "juz": 29,
    "manzil": 7,
    "page": 580,
    "ruku": 516,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "فالفارقات فرقا"
  },
  {
    "number": 5627,
    "text": "فَٱلۡمُلۡقِيَٰتِ ذِكۡرًا",
    "numberInSurah": 5,
    "juz": 29,
    "manzil": 7,
    "page": 580,
    "ruku": 516,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "فالملقيات ذكرا"
  },
  {
    "number": 5628,
    "text": "عُذۡرًا أَوۡ نُذۡرًا",
    "numberInSurah": 6,
    "juz": 29,
    "manzil": 7,
    "page": 580,
    "ruku": 516,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "عذرا أو نذرا"
  },
  {
    "number": 5629,
    "text": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٞ",
    "numberInSurah": 7,
    "juz": 29,
    "manzil": 7,
    "page": 580,
    "ruku": 516,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "إنما توعدون لواقع"
  },
  {
    "number": 5630,
    "text": "فَإِذَا ٱلنُّجُومُ طُمِسَتۡ",
    "numberInSurah": 8,
    "juz": 29,
    "manzil": 7,
    "page": 580,
    "ruku": 516,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "فإذا النجوم طمست"
  },
  {
    "number": 5631,
    "text": "وَإِذَا ٱلسَّمَآءُ فُرِجَتۡ",
    "numberInSurah": 9,
    "juz": 29,
    "manzil": 7,
    "page": 580,
    "ruku": 516,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "وإذا السماء فرجت"
  },
  {
    "number": 5632,
    "text": "وَإِذَا ٱلۡجِبَالُ نُسِفَتۡ",
    "numberInSurah": 10,
    "juz": 29,
    "manzil": 7,
    "page": 580,
    "ruku": 516,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "وإذا الجبال نسفت"
  },
  {
    "number": 5633,
    "text": "وَإِذَا ٱلرُّسُلُ أُقِّتَتۡ",
    "numberInSurah": 11,
    "juz": 29,
    "manzil": 7,
    "page": 580,
    "ruku": 516,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "وإذا الرسل أقتت"
  },
  {
