  },
  {
    "number": 5636,
    "text": "وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلۡفَصۡلِ",
    "numberInSurah": 14,
    "juz": 29,
    "manzil": 7,
    "page": 580,
    "ruku": 516,
    "hizbQuarter": 232,
    "sajda": false,
