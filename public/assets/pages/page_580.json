    "text": "لِأَيِّ يَوۡمٍ أُجِّلَتۡ",
    "numberInSurah": 12,
    "juz": 29,
    "manzil": 7,
    "page": 580,
    "ruku": 516,
    "hizbQuarter": 232,
    "sajda": false,
    "no_Tashkeel_text": "لأي يوم أجلت"
  },
  {
