[
  {
    "number": 5728,
    "text": "إِذۡ نَادَىٰهُ رَبُّهُۥ بِٱلۡوَادِ ٱلۡمُقَدَّسِ طُوًى",
    "numberInSurah": 16,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "إذ ناداه ربه بالواد المقدس طوى"
  },
  {
    "number": 5729,
    "text": "ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ",
    "numberInSurah": 17,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "اذهب إلى فرعون إنه طغى"
  },
  {
    "number": 5730,
    "text": "فَقُلۡ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ",
    "numberInSurah": 18,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "فقل هل لك إلى أن تزكى"
  },
  {
    "number": 5731,
    "text": "وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡشَىٰ",
    "numberInSurah": 19,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "وأهديك إلى ربك فتخشى"
  },
  {
    "number": 5732,
    "text": "فَأَرَىٰهُ ٱلۡأٓيَةَ ٱلۡكُبۡرَىٰ",
    "numberInSurah": 20,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "فأراه الآية الكبرى"
  },
  {
    "number": 5733,
    "text": "فَكَذَّبَ وَعَصَىٰ",
    "numberInSurah": 21,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "فكذب وعصى"
  },
  {
    "number": 5734,
    "text": "ثُمَّ أَدۡبَرَ يَسۡعَىٰ",
    "numberInSurah": 22,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "ثم أدبر يسعى"
  },
  {
    "number": 5735,
    "text": "فَحَشَرَ فَنَادَىٰ",
    "numberInSurah": 23,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "فحشر فنادى"
  },
  {
    "number": 5736,
    "text": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىٰ",
    "numberInSurah": 24,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "فقال أنا ربكم الأعلى"
  },
  {
    "number": 5737,
    "text": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡأٓخِرَةِ وَٱلۡأُولَىٰٓ",
    "numberInSurah": 25,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "فأخذه الله نكال الآخرة والأولى"
  },
  {
    "number": 5738,
    "text": "إِنَّ فِي ذَٰلِكَ لَعِبۡرَةٗ لِّمَن يَخۡشَىٰٓ",
    "numberInSurah": 26,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 520,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "إن في ذلك لعبرة لمن يخشى"
  },
  {
    "number": 5739,
    "text": "ءَأَنتُمۡ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَآءُۚ بَنَىٰهَا",
    "numberInSurah": 27,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 521,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "أأنتم أشد خلقا أم السماء بناها"
  },
  {
    "number": 5740,
    "text": "رَفَعَ سَمۡكَهَا فَسَوَّىٰهَا",
    "numberInSurah": 28,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 521,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "رفع سمكها فسواها"
  },
  {
    "number": 5741,
    "text": "وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُحَىٰهَا",
    "numberInSurah": 29,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 521,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "وأغطش ليلها وأخرج ضحاها"
  },
  {
    "number": 5742,
    "text": "وَٱلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَحَىٰهَآ",
    "numberInSurah": 30,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 521,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "والأرض بعد ذلك دحاها"
  },
  {
    "number": 5743,
    "text": "أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعَىٰهَا",
    "numberInSurah": 31,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 521,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "أخرج منها ماءها ومرعاها"
  },
  {
    "number": 5744,
    "text": "وَٱلۡجِبَالَ أَرۡسَىٰهَا",
    "numberInSurah": 32,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 521,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "والجبال أرساها"
  },
  {
    "number": 5745,
    "text": "مَتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ",
    "numberInSurah": 33,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 521,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "متاعا لكم ولأنعامكم"
  },
  {
    "number": 5746,
    "text": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلۡكُبۡرَىٰ",
    "numberInSurah": 34,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 521,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "فإذا جاءت الطامة الكبرى"
  },
  {
    "number": 5747,
    "text": "يَوۡمَ يَتَذَكَّرُ ٱلۡإِنسَٰنُ مَا سَعَىٰ",
    "numberInSurah": 35,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 521,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "يوم يتذكر الإنسان ما سعى"
  },
  {
    "number": 5748,
    "text": "وَبُرِّزَتِ ٱلۡجَحِيمُ لِمَن يَرَىٰ",
    "numberInSurah": 36,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 521,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "وبرزت الجحيم لمن يرى"
  },
  {
    "number": 5749,
    "text": "فَأَمَّا مَن طَغَىٰ",
    "numberInSurah": 37,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 521,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "فأما من طغى"
  },
  {
    "number": 5750,
    "text": "وَءَاثَرَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا",
    "numberInSurah": 38,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 521,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "وآثر الحياة الدنيا"
  },
  {
    "number": 5751,
    "text": "فَإِنَّ ٱلۡجَحِيمَ هِيَ ٱلۡمَأۡوَىٰ",
    "numberInSurah": 39,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 521,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "فإن الجحيم هي المأوى"
  },
  {
    "number": 5752,
    "text": "وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفۡسَ عَنِ ٱلۡهَوَىٰ",
    "numberInSurah": 40,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 521,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "وأما من خاف مقام ربه ونهى النفس عن الهوى"
  },
  {
    "number": 5753,
    "text": "فَإِنَّ ٱلۡجَنَّةَ هِيَ ٱلۡمَأۡوَىٰ",
    "numberInSurah": 41,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 521,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "فإن الجنة هي المأوى"
  },
  {
    "number": 5754,
    "text": "يَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرۡسَىٰهَا",
    "numberInSurah": 42,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 521,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "يسألونك عن الساعة أيان مرساها"
  },
  {
    "number": 5755,
    "text": "فِيمَ أَنتَ مِن ذِكۡرَىٰهَآ",
    "numberInSurah": 43,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 521,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "فيم أنت من ذكراها"
  },
  {
    "number": 5756,
    "text": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ",
    "numberInSurah": 44,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 521,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "إلى ربك منتهاها"
  },
  {
    "number": 5757,
    "text": "إِنَّمَآ أَنتَ مُنذِرُ مَن يَخۡشَىٰهَا",
    "numberInSurah": 45,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 521,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "إنما أنت منذر من يخشاها"
  },
  {
    "number": 5758,
    "text": "كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُوٓاْ إِلَّا عَشِيَّةً أَوۡ ضُحَىٰهَا",
    "numberInSurah": 46,
    "juz": 30,
    "manzil": 7,
    "page": 584,
    "ruku": 521,
    "hizbQuarter": 233,
    "sajda": false,
    "no_Tashkeel_text": "كأنهم يوم يرونها لم يلبثوا إلا عشية أو ضحاها"
  }
]