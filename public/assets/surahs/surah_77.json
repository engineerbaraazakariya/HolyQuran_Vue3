{
    "number": 77,
    "name": "سُورَةُ المُرۡسَلَاتِ",
    "englishName": "Al-Mursalaat",
    "englishNameTranslation": "The Emissaries",
    "revelationType": "Meccan",
    "ayahs": [
        {
            "number": 5623,
            "text": "وَٱلۡمُرۡسَلَٰتِ عُرۡفٗا",
            "numberInSurah": 1,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "بسم الله الرحمن الرحيم والمرسلات عرفا"
        },
        {
            "number": 5624,
            "text": "فَٱلۡعَٰصِفَٰتِ عَصۡفٗا",
            "numberInSurah": 2,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "فالعاصفات عصفا"
        },
        {
            "number": 5625,
            "text": "وَٱلنَّـٰشِرَٰتِ نَشۡرٗا",
            "numberInSurah": 3,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "والناشرات نشرا"
        },
        {
            "number": 5626,
            "text": "فَٱلۡفَٰرِقَٰتِ فَرۡقٗا",
            "numberInSurah": 4,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "فالفارقات فرقا"
        },
        {
            "number": 5627,
            "text": "فَٱلۡمُلۡقِيَٰتِ ذِكۡرًا",
            "numberInSurah": 5,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "فالملقيات ذكرا"
        },
        {
            "number": 5628,
            "text": "عُذۡرًا أَوۡ نُذۡرًا",
            "numberInSurah": 6,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "عذرا أو نذرا"
        },
        {
            "number": 5629,
            "text": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٞ",
            "numberInSurah": 7,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "إنما توعدون لواقع"
        },
        {
            "number": 5630,
            "text": "فَإِذَا ٱلنُّجُومُ طُمِسَتۡ",
            "numberInSurah": 8,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "فإذا النجوم طمست"
        },
        {
            "number": 5631,
            "text": "وَإِذَا ٱلسَّمَآءُ فُرِجَتۡ",
            "numberInSurah": 9,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "وإذا السماء فرجت"
        },
        {
            "number": 5632,
            "text": "وَإِذَا ٱلۡجِبَالُ نُسِفَتۡ",
            "numberInSurah": 10,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "وإذا الجبال نسفت"
        },
        {
            "number": 5633,
            "text": "وَإِذَا ٱلرُّسُلُ أُقِّتَتۡ",
            "numberInSurah": 11,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "وإذا الرسل أقتت"
        },
        {
            "number": 5634,
            "text": "لِأَيِّ يَوۡمٍ أُجِّلَتۡ",
            "numberInSurah": 12,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "لأي يوم أجلت"
        },
        {
            "number": 5635,
            "text": "لِيَوۡمِ ٱلۡفَصۡلِ",
            "numberInSurah": 13,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ليوم الفصل"
        },
        {
            "number": 5636,
            "text": "وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلۡفَصۡلِ",
            "numberInSurah": 14,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "وما أدراك ما يوم الفصل"
        },
        {
            "number": 5637,
            "text": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
            "numberInSurah": 15,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ويل يومئذ للمكذبين"
        },
        {
            "number": 5638,
            "text": "أَلَمۡ نُهۡلِكِ ٱلۡأَوَّلِينَ",
            "numberInSurah": 16,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ألم نهلك الأولين"
        },
        {
            "number": 5639,
            "text": "ثُمَّ نُتۡبِعُهُمُ ٱلۡأٓخِرِينَ",
            "numberInSurah": 17,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ثم نتبعهم الآخرين"
        },
        {
            "number": 5640,
            "text": "كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ",
            "numberInSurah": 18,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "كذلك نفعل بالمجرمين"
        },
        {
            "number": 5641,
            "text": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
            "numberInSurah": 19,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ويل يومئذ للمكذبين"
        },
        {
            "number": 5642,
            "text": "أَلَمۡ نَخۡلُقكُّم مِّن مَّآءٖ مَّهِينٖ",
            "numberInSurah": 20,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ألم نخلقكم من ماء مهين"
        },
        {
            "number": 5643,
            "text": "فَجَعَلۡنَٰهُ فِي قَرَارٖ مَّكِينٍ",
            "numberInSurah": 21,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "فجعلناه في قرار مكين"
        },
        {
            "number": 5644,
            "text": "إِلَىٰ قَدَرٖ مَّعۡلُومٖ",
            "numberInSurah": 22,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "إلى قدر معلوم"
        },
        {
            "number": 5645,
            "text": "فَقَدَرۡنَا فَنِعۡمَ ٱلۡقَٰدِرُونَ",
            "numberInSurah": 23,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "فقدرنا فنعم القادرون"
        },
        {
            "number": 5646,
            "text": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
            "numberInSurah": 24,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ويل يومئذ للمكذبين"
        },
        {
            "number": 5647,
            "text": "أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ كِفَاتًا",
            "numberInSurah": 25,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ألم نجعل الأرض كفاتا"
        },
        {
            "number": 5648,
            "text": "أَحۡيَآءٗ وَأَمۡوَٰتٗا",
            "numberInSurah": 26,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "أحياء وأمواتا"
        },
        {
            "number": 5649,
            "text": "وَجَعَلۡنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتٖ وَأَسۡقَيۡنَٰكُم مَّآءٗ فُرَاتٗا",
            "numberInSurah": 27,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "وجعلنا فيها رواسي شامخات وأسقيناكم ماء فراتا"
        },
        {
            "number": 5650,
            "text": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
            "numberInSurah": 28,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ويل يومئذ للمكذبين"
        },
        {
            "number": 5651,
            "text": "ٱنطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ",
            "numberInSurah": 29,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "انطلقوا إلى ما كنتم به تكذبون"
        },
        {
            "number": 5652,
            "text": "ٱنطَلِقُوٓاْ إِلَىٰ ظِلّٖ ذِي ثَلَٰثِ شُعَبٖ",
            "numberInSurah": 30,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "انطلقوا إلى ظل ذي ثلاث شعب"
        },
        {
            "number": 5653,
            "text": "لَّا ظَلِيلٖ وَلَا يُغۡنِي مِنَ ٱللَّهَبِ",
            "numberInSurah": 31,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "لا ظليل ولا يغني من اللهب"
        },
        {
            "number": 5654,
            "text": "إِنَّهَا تَرۡمِي بِشَرَرٖ كَٱلۡقَصۡرِ",
            "numberInSurah": 32,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "إنها ترمي بشرر كالقصر"
        },
        {
            "number": 5655,
            "text": "كَأَنَّهُۥ جِمَٰلَتٞ صُفۡرٞ",
            "numberInSurah": 33,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "كأنه جمالت صفر"
        },
        {
            "number": 5656,
            "text": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
            "numberInSurah": 34,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ويل يومئذ للمكذبين"
        },
        {
            "number": 5657,
            "text": "هَٰذَا يَوۡمُ لَا يَنطِقُونَ",
            "numberInSurah": 35,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "هذا يوم لا ينطقون"
        },
        {
            "number": 5658,
            "text": "وَلَا يُؤۡذَنُ لَهُمۡ فَيَعۡتَذِرُونَ",
            "numberInSurah": 36,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ولا يؤذن لهم فيعتذرون"
        },
        {
            "number": 5659,
            "text": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
            "numberInSurah": 37,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ويل يومئذ للمكذبين"
        },
        {
            "number": 5660,
            "text": "هَٰذَا يَوۡمُ ٱلۡفَصۡلِۖ جَمَعۡنَٰكُمۡ وَٱلۡأَوَّلِينَ",
            "numberInSurah": 38,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "هذا يوم الفصل جمعناكم والأولين"
        },
        {
            "number": 5661,
            "text": "فَإِن كَانَ لَكُمۡ كَيۡدٞ فَكِيدُونِ",
            "numberInSurah": 39,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "فإن كان لكم كيد فكيدون"
        },
        {
            "number": 5662,
            "text": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
            "numberInSurah": 40,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ويل يومئذ للمكذبين"
        },
        {
            "number": 5663,
            "text": "إِنَّ ٱلۡمُتَّقِينَ فِي ظِلَٰلٖ وَعُيُونٖ",
            "numberInSurah": 41,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 517,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "إن المتقين في ظلال وعيون"
        },
        {
            "number": 5664,
            "text": "وَفَوَٰكِهَ مِمَّا يَشۡتَهُونَ",
            "numberInSurah": 42,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 517,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "وفواكه مما يشتهون"
        },
        {
            "number": 5665,
            "text": "كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَا كُنتُمۡ تَعۡمَلُونَ",
            "numberInSurah": 43,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 517,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "كلوا واشربوا هنيئا بما كنتم تعملون"
        },
        {
            "number": 5666,
            "text": "إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ",
            "numberInSurah": 44,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 517,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "إنا كذلك نجزي المحسنين"
        },
        {
            "number": 5667,
            "text": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
            "numberInSurah": 45,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 517,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ويل يومئذ للمكذبين"
        },
        {
            "number": 5668,
            "text": "كُلُواْ وَتَمَتَّعُواْ قَلِيلًا إِنَّكُم مُّجۡرِمُونَ",
            "numberInSurah": 46,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 517,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "كلوا وتمتعوا قليلا إنكم مجرمون"
        },
        {
            "number": 5669,
            "text": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
            "numberInSurah": 47,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 517,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ويل يومئذ للمكذبين"
        },
        {
            "number": 5670,
            "text": "وَإِذَا قِيلَ لَهُمُ ٱرۡكَعُواْ لَا يَرۡكَعُونَ",
            "numberInSurah": 48,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 517,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "وإذا قيل لهم اركعوا لا يركعون"
        },
