{
    "number": 77,
    "name": "سُورَةُ المُرۡسَلَاتِ",
    "englishName": "Al-Mursalaat",
    "englishNameTranslation": "The Emissaries",
    "revelationType": "Meccan",
    "ayahs": [
        {
            "number": 5623,
            "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
            "numberInSurah": 1,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "بسم الله الرحمن الرحيم والمرسلات عرفا"
        },
        {
            "number": 5624,
            "text": "ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ",
            "numberInSurah": 2,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "فالعاصفات عصفا"
        },
        {
            "number": 5625,
            "text": "ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
            "numberInSurah": 3,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "والناشرات نشرا"
        },
        {
            "number": 5626,
            "text": "مَٰلِكِ يَوۡمِ ٱلدِّينِ",
            "numberInSurah": 4,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "فالفارقات فرقا"
        },
        {
            "number": 5627,
            "text": "إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ",
            "numberInSurah": 5,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "فالملقيات ذكرا"
        },
        {
            "number": 5628,
            "text": "ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ",
            "numberInSurah": 6,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "عذرا أو نذرا"
        },
        {
            "number": 5629,
            "text": "صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ",
            "numberInSurah": 7,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "إنما توعدون لواقع"
        },
        {
            "number": 5630,
            "text": "فَإِذَا النُّجومُ طُمِسَت",
            "numberInSurah": 8,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "فإذا النجوم طمست"
        },
        {
            "number": 5631,
            "text": "وَإِذَا السَّماءُ فُرِجَت",
            "numberInSurah": 9,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "وإذا السماء فرجت"
        },
        {
            "number": 5632,
            "text": "وَإِذَا الجِبالُ نُسِفَت",
            "numberInSurah": 10,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "وإذا الجبال نسفت"
        },
        {
            "number": 5633,
            "text": "وَإِذَا الرُّسُلُ أُقِّتَت",
            "numberInSurah": 11,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "وإذا الرسل أقتت"
        },
        {
            "number": 5634,
            "text": "لِأَىِّ يَومٍ أُجِّلَت",
            "numberInSurah": 12,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "لأي يوم أجلت"
        },
        {
            "number": 5635,
            "text": "لِيَومِ الفَصلِ",
            "numberInSurah": 13,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ليوم الفصل"
        },
        {
            "number": 5636,
            "text": "وَما أَدرىٰكَ ما يَومُ الفَصلِ",
            "numberInSurah": 14,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "وما أدراك ما يوم الفصل"
        },
        {
            "number": 5637,
            "text": "وَيلٌ يَومَئِذٍ لِلمُكَذِّبينَ",
            "numberInSurah": 15,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ويل يومئذ للمكذبين"
        },
        {
            "number": 5638,
            "text": "أَلَم نُهلِكِ الأَوَّلينَ",
            "numberInSurah": 16,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ألم نهلك الأولين"
        },
        {
            "number": 5639,
            "text": "ثُمَّ نُتبِعُهُمُ الـٔاخِرينَ",
            "numberInSurah": 17,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ثم نتبعهم الآخرين"
        },
        {
            "number": 5640,
            "text": "كَذٰلِكَ نَفعَلُ بِالمُجرِمينَ",
            "numberInSurah": 18,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "كذلك نفعل بالمجرمين"
        },
        {
            "number": 5641,
            "text": "وَيلٌ يَومَئِذٍ لِلمُكَذِّبينَ",
            "numberInSurah": 19,
            "juz": 29,
            "manzil": 7,
            "page": 580,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ويل يومئذ للمكذبين"
        },
        {
            "number": 5642,
            "text": "أَلَم نَخلُقكُم مِن ماءٍ مَهينٍ",
            "numberInSurah": 20,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ألم نخلقكم من ماء مهين"
        },
        {
            "number": 5643,
            "text": "فَجَعَلنـٰهُ فى قَرارٍ مَكينٍ",
            "numberInSurah": 21,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "فجعلناه في قرار مكين"
        },
        {
            "number": 5644,
            "text": "إِلىٰ قَدَرٍ مَعلومٍ",
            "numberInSurah": 22,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "إلى قدر معلوم"
        },
        {
            "number": 5645,
            "text": "فَقَدَرنا فَنِعمَ القـٰدِرونَ",
            "numberInSurah": 23,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "فقدرنا فنعم القادرون"
        },
        {
            "number": 5646,
            "text": "وَيلٌ يَومَئِذٍ لِلمُكَذِّبينَ",
            "numberInSurah": 24,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ويل يومئذ للمكذبين"
        },
        {
            "number": 5647,
            "text": "أَلَم نَجعَلِ الأَرضَ كِفاتًا",
            "numberInSurah": 25,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ألم نجعل الأرض كفاتا"
        },
        {
            "number": 5648,
            "text": "أَحياءً وَأَموٰتًا",
            "numberInSurah": 26,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "أحياء وأمواتا"
        },
        {
            "number": 5649,
            "text": "وَجَعَلنا فيها رَوٰسِىَ شـٰمِخـٰتٍ وَأَسقَينـٰكُم ماءً فُراتًا",
            "numberInSurah": 27,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "وجعلنا فيها رواسي شامخات وأسقيناكم ماء فراتا"
        },
        {
            "number": 5650,
            "text": "وَيلٌ يَومَئِذٍ لِلمُكَذِّبينَ",
            "numberInSurah": 28,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ويل يومئذ للمكذبين"
        },
        {
            "number": 5651,
            "text": "انطَلِقوا إِلىٰ ما كُنتُم بِهِ تُكَذِّبونَ",
            "numberInSurah": 29,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "انطلقوا إلى ما كنتم به تكذبون"
        },
        {
            "number": 5652,
            "text": "انطَلِقوا إِلىٰ ظِلٍّ ذى ثَلـٰثِ شُعَبٍ",
            "numberInSurah": 30,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "انطلقوا إلى ظل ذي ثلاث شعب"
        },
        {
            "number": 5653,
            "text": "لا ظَليلٍ وَلا يُغنى مِنَ اللَّهَبِ",
            "numberInSurah": 31,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "لا ظليل ولا يغني من اللهب"
        },
        {
            "number": 5654,
            "text": "إِنَّها تَرمى بِشَرَرٍ كَالقَصرِ",
            "numberInSurah": 32,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "إنها ترمي بشرر كالقصر"
        },
        {
            "number": 5655,
            "text": "كَأَنَّهُ جِمـٰلَتٌ صُفرٌ",
            "numberInSurah": 33,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "كأنه جمالت صفر"
        },
        {
            "number": 5656,
            "text": "وَيلٌ يَومَئِذٍ لِلمُكَذِّبينَ",
            "numberInSurah": 34,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ويل يومئذ للمكذبين"
        },
        {
            "number": 5657,
            "text": "هـٰذا يَومُ لا يَنطِقونَ",
            "numberInSurah": 35,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "هذا يوم لا ينطقون"
        },
        {
            "number": 5658,
            "text": "وَلا يُؤذَنُ لَهُم فَيَعتَذِرونَ",
            "numberInSurah": 36,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ولا يؤذن لهم فيعتذرون"
        },
        {
            "number": 5659,
            "text": "وَيلٌ يَومَئِذٍ لِلمُكَذِّبينَ",
            "numberInSurah": 37,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ويل يومئذ للمكذبين"
        },
        {
            "number": 5660,
            "text": "هـٰذا يَومُ الفَصلِ ۖ جَمَعنـٰكُم وَالأَوَّلينَ",
            "numberInSurah": 38,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "هذا يوم الفصل جمعناكم والأولين"
        },
        {
            "number": 5661,
            "text": "فَإِن كانَ لَكُم كَيدٌ فَكيدونِ",
            "numberInSurah": 39,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "فإن كان لكم كيد فكيدون"
        },
        {
            "number": 5662,
            "text": "وَيلٌ يَومَئِذٍ لِلمُكَذِّبينَ",
            "numberInSurah": 40,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 516,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ويل يومئذ للمكذبين"
        },
        {
            "number": 5663,
            "text": "إِنَّ المُتَّقينَ فى ظِلـٰلٍ وَعُيونٍ",
            "numberInSurah": 41,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 517,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "إن المتقين في ظلال وعيون"
        },
        {
            "number": 5664,
            "text": "وَفَوٰكِهَ مِمّا يَشتَهونَ",
            "numberInSurah": 42,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 517,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "وفواكه مما يشتهون"
        },
        {
            "number": 5665,
            "text": "كُلوا وَاشرَبوا هَنيـًٔا بِما كُنتُم تَعمَلونَ",
            "numberInSurah": 43,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 517,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "كلوا واشربوا هنيئا بما كنتم تعملون"
        },
        {
            "number": 5666,
            "text": "إِنّا كَذٰلِكَ نَجزِى المُحسِنينَ",
            "numberInSurah": 44,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 517,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "إنا كذلك نجزي المحسنين"
        },
        {
            "number": 5667,
            "text": "وَيلٌ يَومَئِذٍ لِلمُكَذِّبينَ",
            "numberInSurah": 45,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 517,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ويل يومئذ للمكذبين"
        },
        {
            "number": 5668,
            "text": "كُلوا وَتَمَتَّعوا قَليلًا إِنَّكُم مُجرِمونَ",
            "numberInSurah": 46,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 517,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "كلوا وتمتعوا قليلا إنكم مجرمون"
        },
        {
            "number": 5669,
            "text": "وَيلٌ يَومَئِذٍ لِلمُكَذِّبينَ",
            "numberInSurah": 47,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 517,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ويل يومئذ للمكذبين"
        },
        {
            "number": 5670,
            "text": "وَإِذا قيلَ لَهُمُ اركَعوا لا يَركَعونَ",
            "numberInSurah": 48,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 517,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "وإذا قيل لهم اركعوا لا يركعون"
        },
        {
            "number": 5671,
            "text": "وَيلٌ يَومَئِذٍ لِلمُكَذِّبينَ",
            "numberInSurah": 49,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 517,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "ويل يومئذ للمكذبين"
        },
        {
            "number": 5672,
            "text": "فَبِأَىِّ حَديثٍ بَعدَهُ يُؤمِنونَ",
            "numberInSurah": 50,
            "juz": 29,
            "manzil": 7,
            "page": 581,
            "ruku": 517,
            "hizbQuarter": 232,
            "sajda": false,
            "no_Tashkeel_text": "فبأي حديث بعده يؤمنون"
        }
    ]
}