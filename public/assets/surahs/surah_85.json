{
    "number": 85,
    "name": "سُورَةُ البُرُوجِ",
    "englishName": "Al-Burooj",
    "englishNameTranslation": "The Constellations",
    "revelationType": "Meccan",
    "ayahs": [
        {
            "number": 5910,
            "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
            "numberInSurah": 1,
            "juz": 30,
            "manzil": 7,
            "page": 590,
            "ruku": 527,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "بسم الله الرحمن الرحيم والسماء ذات البروج"
        },
        {
            "number": 5911,
            "text": "ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ",
            "numberInSurah": 2,
            "juz": 30,
            "manzil": 7,
            "page": 590,
            "ruku": 527,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "واليوم الموعود"
        },
        {
            "number": 5912,
            "text": "ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
            "numberInSurah": 3,
            "juz": 30,
            "manzil": 7,
            "page": 590,
            "ruku": 527,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "وشاهد ومشهود"
        },
        {
            "number": 5913,
            "text": "مَٰلِكِ يَوۡمِ ٱلدِّينِ",
            "numberInSurah": 4,
            "juz": 30,
            "manzil": 7,
            "page": 590,
            "ruku": 527,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "قتل أصحاب الأخدود"
        },
        {
            "number": 5914,
            "text": "إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ",
            "numberInSurah": 5,
            "juz": 30,
            "manzil": 7,
            "page": 590,
            "ruku": 527,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "النار ذات الوقود"
        },
        {
            "number": 5915,
            "text": "ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ",
            "numberInSurah": 6,
            "juz": 30,
            "manzil": 7,
            "page": 590,
            "ruku": 527,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "إذ هم عليها قعود"
        },
        {
            "number": 5916,
            "text": "صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ",
            "numberInSurah": 7,
            "juz": 30,
            "manzil": 7,
            "page": 590,
            "ruku": 527,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "وهم على ما يفعلون بالمؤمنين شهود"
        },
        {
            "number": 5917,
            "text": "وَما نَقَموا مِنهُم إِلّا أَن يُؤمِنوا بِاللَّهِ العَزيزِ الحَميدِ",
            "numberInSurah": 8,
            "juz": 30,
            "manzil": 7,
            "page": 590,
            "ruku": 527,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "وما نقموا منهم إلا أن يؤمنوا بالله العزيز الحميد"
        },
        {
            "number": 5918,
            "text": "الَّذى لَهُ مُلكُ السَّمـٰوٰتِ وَالأَرضِ ۚ وَاللَّهُ عَلىٰ كُلِّ شَىءٍ شَهيدٌ",
            "numberInSurah": 9,
            "juz": 30,
            "manzil": 7,
            "page": 590,
            "ruku": 527,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "الذي له ملك السماوات والأرض والله على كل شيء شهيد"
        },
        {
            "number": 5919,
            "text": "إِنَّ الَّذينَ فَتَنُوا المُؤمِنينَ وَالمُؤمِنـٰتِ ثُمَّ لَم يَتوبوا فَلَهُم عَذابُ جَهَنَّمَ وَلَهُم عَذابُ الحَريقِ",
            "numberInSurah": 10,
            "juz": 30,
            "manzil": 7,
            "page": 590,
            "ruku": 527,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "إن الذين فتنوا المؤمنين والمؤمنات ثم لم يتوبوا فلهم عذاب جهنم ولهم عذاب الحريق"
        },
        {
            "number": 5920,
            "text": "إِنَّ الَّذينَ ءامَنوا وَعَمِلُوا الصّـٰلِحـٰتِ لَهُم جَنّـٰتٌ تَجرى مِن تَحتِهَا الأَنهـٰرُ ۚ ذٰلِكَ الفَوزُ الكَبيرُ",
            "numberInSurah": 11,
            "juz": 30,
            "manzil": 7,
            "page": 590,
            "ruku": 527,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "إن الذين آمنوا وعملوا الصالحات لهم جنات تجري من تحتها الأنهار ذلك الفوز الكبير"
        },
        {
            "number": 5921,
            "text": "إِنَّ بَطشَ رَبِّكَ لَشَديدٌ",
            "numberInSurah": 12,
            "juz": 30,
            "manzil": 7,
            "page": 590,
            "ruku": 527,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "إن بطش ربك لشديد"
        },
        {
            "number": 5922,
            "text": "إِنَّهُ هُوَ يُبدِئُ وَيُعيدُ",
            "numberInSurah": 13,
            "juz": 30,
            "manzil": 7,
            "page": 590,
            "ruku": 527,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "إنه هو يبدئ ويعيد"
        },
        {
            "number": 5923,
            "text": "وَهُوَ الغَفورُ الوَدودُ",
            "numberInSurah": 14,
            "juz": 30,
            "manzil": 7,
            "page": 590,
            "ruku": 527,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "وهو الغفور الودود"
        },
        {
            "number": 5924,
            "text": "ذُو العَرشِ المَجيدُ",
            "numberInSurah": 15,
            "juz": 30,
            "manzil": 7,
            "page": 590,
            "ruku": 527,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "ذو العرش المجيد"
        },
        {
            "number": 5925,
            "text": "فَعّالٌ لِما يُريدُ",
            "numberInSurah": 16,
            "juz": 30,
            "manzil": 7,
            "page": 590,
            "ruku": 527,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "فعال لما يريد"
        },
        {
            "number": 5926,
            "text": "هَل أَتىٰكَ حَديثُ الجُنودِ",
            "numberInSurah": 17,
            "juz": 30,
            "manzil": 7,
            "page": 590,
            "ruku": 527,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "هل أتاك حديث الجنود"
        },
        {
            "number": 5927,
            "text": "فِرعَونَ وَثَمودَ",
            "numberInSurah": 18,
            "juz": 30,
            "manzil": 7,
            "page": 590,
            "ruku": 527,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "فرعون وثمود"
        },
        {
            "number": 5928,
            "text": "بَلِ الَّذينَ كَفَروا فى تَكذيبٍ",
            "numberInSurah": 19,
            "juz": 30,
            "manzil": 7,
            "page": 590,
            "ruku": 527,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "بل الذين كفروا في تكذيب"
        },
        {
            "number": 5929,
            "text": "وَاللَّهُ مِن وَرائِهِم مُحيطٌ",
            "numberInSurah": 20,
            "juz": 30,
            "manzil": 7,
            "page": 590,
            "ruku": 527,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "والله من ورائهم محيط"
        },
        {
            "number": 5930,
            "text": "بَل هُوَ قُرءانٌ مَجيدٌ",
            "numberInSurah": 21,
            "juz": 30,
            "manzil": 7,
            "page": 590,
            "ruku": 527,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "بل هو قرآن مجيد"
        },
        {
            "number": 5931,
            "text": "فى لَوحٍ مَحفوظٍ",
            "numberInSurah": 22,
            "juz": 30,
            "manzil": 7,
            "page": 590,
            "ruku": 527,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "في لوح محفوظ"
        }
    ]
}