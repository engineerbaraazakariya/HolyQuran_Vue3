{
    "number": 44,
    "name": "سُورَةُ الدُّخَانِ",
    "englishName": "Ad-Dukhaan",
    "englishNameTranslation": "The Smoke",
    "revelationType": "Meccan",
    "ayahs": [
        {
            "number": 4415,
            "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
            "numberInSurah": 1,
            "juz": 25,
            "manzil": 6,
            "page": 496,
            "ruku": 431,
            "hizbQuarter": 198,
            "sajda": false,
            "no_Tashkeel_text": "بسم الله الرحمن الرحيم حم"
        },
        {
            "number": 4416,
            "text": "ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ",
            "numberInSurah": 2,
            "juz": 25,
            "manzil": 6,
            "page": 496,
            "ruku": 431,
            "hizbQuarter": 198,
            "sajda": false,
            "no_Tashkeel_text": "والكتاب المبين"
        },
        {
            "number": 4417,
            "text": "ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
            "numberInSurah": 3,
            "juz": 25,
            "manzil": 6,
            "page": 496,
            "ruku": 431,
            "hizbQuarter": 198,
            "sajda": false,
            "no_Tashkeel_text": "إنا أنزلناه في ليلة مباركة إنا كنا منذرين"
        },
        {
            "number": 4418,
            "text": "مَٰلِكِ يَوۡمِ ٱلدِّينِ",
            "numberInSurah": 4,
            "juz": 25,
            "manzil": 6,
            "page": 496,
            "ruku": 431,
            "hizbQuarter": 198,
            "sajda": false,
            "no_Tashkeel_text": "فيها يفرق كل أمر حكيم"
        },
        {
            "number": 4419,
            "text": "إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ",
            "numberInSurah": 5,
            "juz": 25,
            "manzil": 6,
            "page": 496,
            "ruku": 431,
            "hizbQuarter": 198,
            "sajda": false,
            "no_Tashkeel_text": "أمرا من عندنا إنا كنا مرسلين"
        },
        {
            "number": 4420,
            "text": "ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ",
            "numberInSurah": 6,
            "juz": 25,
            "manzil": 6,
            "page": 496,
            "ruku": 431,
            "hizbQuarter": 198,
            "sajda": false,
            "no_Tashkeel_text": "رحمة من ربك إنه هو السميع العليم"
        },
        {
            "number": 4421,
            "text": "صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ",
            "numberInSurah": 7,
            "juz": 25,
            "manzil": 6,
            "page": 496,
            "ruku": 431,
            "hizbQuarter": 198,
            "sajda": false,
            "no_Tashkeel_text": "رب السماوات والأرض وما بينهما إن كنتم موقنين"
        },
        {
            "number": 4422,
            "text": "لا إِلـٰهَ إِلّا هُوَ يُحيۦ وَيُميتُ ۖ رَبُّكُم وَرَبُّ ءابائِكُمُ الأَوَّلينَ",
            "numberInSurah": 8,
            "juz": 25,
            "manzil": 6,
            "page": 496,
            "ruku": 431,
            "hizbQuarter": 198,
            "sajda": false,
            "no_Tashkeel_text": "لا إله إلا هو يحيي ويميت ربكم ورب آبائكم الأولين"
        },
        {
            "number": 4423,
            "text": "بَل هُم فى شَكٍّ يَلعَبونَ",
            "numberInSurah": 9,
            "juz": 25,
            "manzil": 6,
            "page": 496,
            "ruku": 431,
            "hizbQuarter": 198,
            "sajda": false,
            "no_Tashkeel_text": "بل هم في شك يلعبون"
        },
        {
            "number": 4424,
            "text": "فَارتَقِب يَومَ تَأتِى السَّماءُ بِدُخانٍ مُبينٍ",
            "numberInSurah": 10,
            "juz": 25,
            "manzil": 6,
            "page": 496,
            "ruku": 431,
            "hizbQuarter": 198,
            "sajda": false,
            "no_Tashkeel_text": "فارتقب يوم تأتي السماء بدخان مبين"
        },
        {
            "number": 4425,
            "text": "يَغشَى النّاسَ ۖ هـٰذا عَذابٌ أَليمٌ",
            "numberInSurah": 11,
            "juz": 25,
            "manzil": 6,
            "page": 496,
            "ruku": 431,
            "hizbQuarter": 198,
            "sajda": false,
            "no_Tashkeel_text": "يغشى الناس هذا عذاب أليم"
        },
        {
            "number": 4426,
            "text": "رَبَّنَا اكشِف عَنَّا العَذابَ إِنّا مُؤمِنونَ",
            "numberInSurah": 12,
            "juz": 25,
            "manzil": 6,
            "page": 496,
            "ruku": 431,
            "hizbQuarter": 198,
            "sajda": false,
            "no_Tashkeel_text": "ربنا اكشف عنا العذاب إنا مؤمنون"
        },
        {
            "number": 4427,
            "text": "أَنّىٰ لَهُمُ الذِّكرىٰ وَقَد جاءَهُم رَسولٌ مُبينٌ",
            "numberInSurah": 13,
            "juz": 25,
            "manzil": 6,
            "page": 496,
            "ruku": 431,
            "hizbQuarter": 198,
            "sajda": false,
            "no_Tashkeel_text": "أنى لهم الذكرى وقد جاءهم رسول مبين"
        },
        {
            "number": 4428,
            "text": "ثُمَّ تَوَلَّوا عَنهُ وَقالوا مُعَلَّمٌ مَجنونٌ",
            "numberInSurah": 14,
            "juz": 25,
            "manzil": 6,
            "page": 496,
            "ruku": 431,
            "hizbQuarter": 198,
            "sajda": false,
            "no_Tashkeel_text": "ثم تولوا عنه وقالوا معلم مجنون"
        },
        {
            "number": 4429,
            "text": "إِنّا كاشِفُوا العَذابِ قَليلًا ۚ إِنَّكُم عائِدونَ",
            "numberInSurah": 15,
            "juz": 25,
            "manzil": 6,
            "page": 496,
            "ruku": 431,
            "hizbQuarter": 198,
            "sajda": false,
            "no_Tashkeel_text": "إنا كاشفو العذاب قليلا إنكم عائدون"
        },
        {
            "number": 4430,
            "text": "يَومَ نَبطِشُ البَطشَةَ الكُبرىٰ إِنّا مُنتَقِمونَ",
            "numberInSurah": 16,
            "juz": 25,
            "manzil": 6,
            "page": 496,
            "ruku": 431,
            "hizbQuarter": 198,
            "sajda": false,
            "no_Tashkeel_text": "يوم نبطش البطشة الكبرى إنا منتقمون"
        },
        {
            "number": 4431,
            "text": "۞ وَلَقَد فَتَنّا قَبلَهُم قَومَ فِرعَونَ وَجاءَهُم رَسولٌ كَريمٌ",
            "numberInSurah": 17,
            "juz": 25,
            "manzil": 6,
            "page": 496,
            "ruku": 431,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "ولقد فتنا قبلهم قوم فرعون وجاءهم رسول كريم"
        },
        {
            "number": 4432,
            "text": "أَن أَدّوا إِلَىَّ عِبادَ اللَّهِ ۖ إِنّى لَكُم رَسولٌ أَمينٌ",
            "numberInSurah": 18,
            "juz": 25,
            "manzil": 6,
            "page": 496,
            "ruku": 431,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "أن أدوا إلي عباد الله إني لكم رسول أمين"
        },
        {
            "number": 4433,
            "text": "وَأَن لا تَعلوا عَلَى اللَّهِ ۖ إِنّى ءاتيكُم بِسُلطـٰنٍ مُبينٍ",
            "numberInSurah": 19,
            "juz": 25,
            "manzil": 6,
            "page": 497,
            "ruku": 431,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "وأن لا تعلوا على الله إني آتيكم بسلطان مبين"
        },
        {
            "number": 4434,
            "text": "وَإِنّى عُذتُ بِرَبّى وَرَبِّكُم أَن تَرجُمونِ",
            "numberInSurah": 20,
            "juz": 25,
            "manzil": 6,
            "page": 497,
            "ruku": 431,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "وإني عذت بربي وربكم أن ترجمون"
        },
        {
            "number": 4435,
            "text": "وَإِن لَم تُؤمِنوا لى فَاعتَزِلونِ",
            "numberInSurah": 21,
            "juz": 25,
            "manzil": 6,
            "page": 497,
            "ruku": 431,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "وإن لم تؤمنوا لي فاعتزلون"
        },
        {
            "number": 4436,
            "text": "فَدَعا رَبَّهُ أَنَّ هـٰؤُلاءِ قَومٌ مُجرِمونَ",
            "numberInSurah": 22,
            "juz": 25,
            "manzil": 6,
            "page": 497,
            "ruku": 431,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "فدعا ربه أن هؤلاء قوم مجرمون"
        },
        {
            "number": 4437,
            "text": "فَأَسرِ بِعِبادى لَيلًا إِنَّكُم مُتَّبَعونَ",
            "numberInSurah": 23,
            "juz": 25,
            "manzil": 6,
            "page": 497,
            "ruku": 431,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "فأسر بعبادي ليلا إنكم متبعون"
        },
        {
            "number": 4438,
            "text": "وَاترُكِ البَحرَ رَهوًا ۖ إِنَّهُم جُندٌ مُغرَقونَ",
            "numberInSurah": 24,
            "juz": 25,
            "manzil": 6,
            "page": 497,
            "ruku": 431,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "واترك البحر رهوا إنهم جند مغرقون"
        },
        {
            "number": 4439,
            "text": "كَم تَرَكوا مِن جَنّـٰتٍ وَعُيونٍ",
            "numberInSurah": 25,
            "juz": 25,
            "manzil": 6,
            "page": 497,
            "ruku": 431,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "كم تركوا من جنات وعيون"
        },
        {
            "number": 4440,
            "text": "وَزُروعٍ وَمَقامٍ كَريمٍ",
            "numberInSurah": 26,
            "juz": 25,
            "manzil": 6,
            "page": 497,
            "ruku": 431,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "وزروع ومقام كريم"
        },
        {
            "number": 4441,
            "text": "وَنَعمَةٍ كانوا فيها فـٰكِهينَ",
            "numberInSurah": 27,
            "juz": 25,
            "manzil": 6,
            "page": 497,
            "ruku": 431,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "ونعمة كانوا فيها فاكهين"
        },
        {
            "number": 4442,
            "text": "كَذٰلِكَ ۖ وَأَورَثنـٰها قَومًا ءاخَرينَ",
            "numberInSurah": 28,
            "juz": 25,
            "manzil": 6,
            "page": 497,
            "ruku": 431,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "كذلك وأورثناها قوما آخرين"
        },
        {
            "number": 4443,
            "text": "فَما بَكَت عَلَيهِمُ السَّماءُ وَالأَرضُ وَما كانوا مُنظَرينَ",
            "numberInSurah": 29,
            "juz": 25,
            "manzil": 6,
            "page": 497,
            "ruku": 431,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "فما بكت عليهم السماء والأرض وما كانوا منظرين"
        },
        {
            "number": 4444,
            "text": "وَلَقَد نَجَّينا بَنى إِسرٰءيلَ مِنَ العَذابِ المُهينِ",
            "numberInSurah": 30,
            "juz": 25,
            "manzil": 6,
            "page": 497,
            "ruku": 432,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "ولقد نجينا بني إسرائيل من العذاب المهين"
        },
        {
            "number": 4445,
            "text": "مِن فِرعَونَ ۚ إِنَّهُ كانَ عالِيًا مِنَ المُسرِفينَ",
            "numberInSurah": 31,
            "juz": 25,
            "manzil": 6,
            "page": 497,
            "ruku": 432,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "من فرعون إنه كان عاليا من المسرفين"
        },
        {
            "number": 4446,
            "text": "وَلَقَدِ اختَرنـٰهُم عَلىٰ عِلمٍ عَلَى العـٰلَمينَ",
            "numberInSurah": 32,
            "juz": 25,
            "manzil": 6,
            "page": 497,
            "ruku": 432,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "ولقد اخترناهم على علم على العالمين"
        },
        {
            "number": 4447,
            "text": "وَءاتَينـٰهُم مِنَ الـٔايـٰتِ ما فيهِ بَلـٰؤٌا۟ مُبينٌ",
            "numberInSurah": 33,
            "juz": 25,
            "manzil": 6,
            "page": 497,
            "ruku": 432,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "وآتيناهم من الآيات ما فيه بلاء مبين"
        },
        {
            "number": 4448,
            "text": "إِنَّ هـٰؤُلاءِ لَيَقولونَ",
            "numberInSurah": 34,
            "juz": 25,
            "manzil": 6,
            "page": 497,
            "ruku": 432,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "إن هؤلاء ليقولون"
        },
        {
            "number": 4449,
            "text": "إِن هِىَ إِلّا مَوتَتُنَا الأولىٰ وَما نَحنُ بِمُنشَرينَ",
            "numberInSurah": 35,
            "juz": 25,
            "manzil": 6,
            "page": 497,
            "ruku": 432,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "إن هي إلا موتتنا الأولى وما نحن بمنشرين"
        },
        {
            "number": 4450,
            "text": "فَأتوا بِـٔابائِنا إِن كُنتُم صـٰدِقينَ",
            "numberInSurah": 36,
            "juz": 25,
            "manzil": 6,
            "page": 497,
            "ruku": 432,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "فأتوا بآبائنا إن كنتم صادقين"
        },
        {
            "number": 4451,
            "text": "أَهُم خَيرٌ أَم قَومُ تُبَّعٍ وَالَّذينَ مِن قَبلِهِم ۚ أَهلَكنـٰهُم ۖ إِنَّهُم كانوا مُجرِمينَ",
            "numberInSurah": 37,
            "juz": 25,
            "manzil": 6,
            "page": 497,
            "ruku": 432,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "أهم خير أم قوم تبع والذين من قبلهم أهلكناهم إنهم كانوا مجرمين"
        },
        {
            "number": 4452,
            "text": "وَما خَلَقنَا السَّمـٰوٰتِ وَالأَرضَ وَما بَينَهُما لـٰعِبينَ",
            "numberInSurah": 38,
            "juz": 25,
            "manzil": 6,
            "page": 497,
            "ruku": 432,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "وما خلقنا السماوات والأرض وما بينهما لاعبين"
        },
        {
            "number": 4453,
            "text": "ما خَلَقنـٰهُما إِلّا بِالحَقِّ وَلـٰكِنَّ أَكثَرَهُم لا يَعلَمونَ",
            "numberInSurah": 39,
            "juz": 25,
            "manzil": 6,
            "page": 497,
            "ruku": 432,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "ما خلقناهما إلا بالحق ولكن أكثرهم لا يعلمون"
        },
        {
            "number": 4454,
            "text": "إِنَّ يَومَ الفَصلِ ميقـٰتُهُم أَجمَعينَ",
            "numberInSurah": 40,
            "juz": 25,
            "manzil": 6,
            "page": 498,
            "ruku": 432,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "إن يوم الفصل ميقاتهم أجمعين"
        },
        {
            "number": 4455,
            "text": "يَومَ لا يُغنى مَولًى عَن مَولًى شَيـًٔا وَلا هُم يُنصَرونَ",
            "numberInSurah": 41,
            "juz": 25,
            "manzil": 6,
            "page": 498,
            "ruku": 432,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "يوم لا يغني مولى عن مولى شيئا ولا هم ينصرون"
        },
        {
            "number": 4456,
            "text": "إِلّا مَن رَحِمَ اللَّهُ ۚ إِنَّهُ هُوَ العَزيزُ الرَّحيمُ",
            "numberInSurah": 42,
            "juz": 25,
            "manzil": 6,
            "page": 498,
            "ruku": 432,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "إلا من رحم الله إنه هو العزيز الرحيم"
        },
        {
            "number": 4457,
            "text": "إِنَّ شَجَرَتَ الزَّقّومِ",
            "numberInSurah": 43,
            "juz": 25,
            "manzil": 6,
            "page": 498,
            "ruku": 433,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "إن شجرت الزقوم"
        },
        {
            "number": 4458,
            "text": "طَعامُ الأَثيمِ",
            "numberInSurah": 44,
            "juz": 25,
            "manzil": 6,
            "page": 498,
            "ruku": 433,
            "hizbQuarter": 199,
            "sajda": false,
            "no_Tashkeel_text": "طعام الأثيم"
        },
        {
            "number": 4459,
            "text": "كَالمُهلِ يَغلى فِى البُطونِ",
            "numberInSurah": 45,
            "juz": 25,
            "manzil": 6,
            "page": 498,
            "ruku": 433,
            "hizbQuarter": 199,
