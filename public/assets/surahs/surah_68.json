{
  "number": 68,
  "name": "سُورَةُ القَلَمِ",
  "englishName": "Al-Qalam",
  "englishNameTranslation": "The Pen",
  "revelationType": "Meccan",
  "ayahs": [
    {
      "number": 5272,
      "text": "ن ۚ وَالقَلَمِ وَما يَسطُرونَ",
      "numberInSurah": 1,
      "juz": 29,
      "manzil": 7,
      "page": 564,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "بسم الله الرحمن الرحيم ن والقلم وما يسطرون"
    },
    {
      "number": 5273,
      "text": "ما أَنتَ بِنِعمَةِ رَبِّكَ بِمَجنونٍ",
      "numberInSurah": 2,
      "juz": 29,
      "manzil": 7,
      "page": 564,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "ما أنت بنعمة ربك بمجنون"
    },
    {
      "number": 5274,
      "text": "وَإِنَّ لَكَ لَأَجرًا غَيرَ مَمنونٍ",
      "numberInSurah": 3,
      "juz": 29,
      "manzil": 7,
      "page": 564,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "وإن لك لأجرا غير ممنون"
    },
    {
      "number": 5275,
      "text": "وَإِنَّكَ لَعَلىٰ خُلُقٍ عَظيمٍ",
      "numberInSurah": 4,
      "juz": 29,
      "manzil": 7,
      "page": 564,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "وإنك لعلى خلق عظيم"
    },
    {
      "number": 5276,
      "text": "فَسَتُبصِرُ وَيُبصِرونَ",
      "numberInSurah": 5,
      "juz": 29,
      "manzil": 7,
      "page": 564,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "فستبصر ويبصرون"
    },
    {
      "number": 5277,
      "text": "بِأَييِكُمُ المَفتونُ",
      "numberInSurah": 6,
      "juz": 29,
      "manzil": 7,
      "page": 564,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "بأييكم المفتون"
    },
    {
      "number": 5278,
      "text": "إِنَّ رَبَّكَ هُوَ أَعلَمُ بِمَن ضَلَّ عَن سَبيلِهِ وَهُوَ أَعلَمُ بِالمُهتَدينَ",
      "numberInSurah": 7,
      "juz": 29,
      "manzil": 7,
      "page": 564,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "إن ربك هو أعلم بمن ضل عن سبيله وهو أعلم بالمهتدين"
    },
    {
      "number": 5279,
      "text": "فَلا تُطِعِ المُكَذِّبينَ",
      "numberInSurah": 8,
      "juz": 29,
      "manzil": 7,
      "page": 564,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "فلا تطع المكذبين"
    },
    {
      "number": 5280,
      "text": "وَدّوا لَو تُدهِنُ فَيُدهِنونَ",
      "numberInSurah": 9,
      "juz": 29,
      "manzil": 7,
      "page": 564,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "ودوا لو تدهن فيدهنون"
    },
    {
      "number": 5281,
      "text": "وَلا تُطِع كُلَّ حَلّافٍ مَهينٍ",
      "numberInSurah": 10,
      "juz": 29,
      "manzil": 7,
      "page": 564,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "ولا تطع كل حلاف مهين"
    },
    {
      "number": 5282,
      "text": "هَمّازٍ مَشّاءٍ بِنَميمٍ",
      "numberInSurah": 11,
      "juz": 29,
      "manzil": 7,
      "page": 564,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "هماز مشاء بنميم"
    },
    {
      "number": 5283,
      "text": "مَنّاعٍ لِلخَيرِ مُعتَدٍ أَثيمٍ",
      "numberInSurah": 12,
      "juz": 29,
      "manzil": 7,
      "page": 564,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "مناع للخير معتد أثيم"
    },
    {
      "number": 5284,
      "text": "عُتُلٍّ بَعدَ ذٰلِكَ زَنيمٍ",
      "numberInSurah": 13,
      "juz": 29,
      "manzil": 7,
      "page": 564,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "عتل بعد ذلك زنيم"
    },
    {
      "number": 5285,
      "text": "أَن كانَ ذا مالٍ وَبَنينَ",
      "numberInSurah": 14,
      "juz": 29,
      "manzil": 7,
      "page": 564,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "أن كان ذا مال وبنين"
    },
    {
      "number": 5286,
      "text": "إِذا تُتلىٰ عَلَيهِ ءايـٰتُنا قالَ أَسـٰطيرُ الأَوَّلينَ",
      "numberInSurah": 15,
      "juz": 29,
      "manzil": 7,
      "page": 564,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "إذا تتلى عليه آياتنا قال أساطير الأولين"
    },
    {
      "number": 5287,
      "text": "سَنَسِمُهُ عَلَى الخُرطومِ",
      "numberInSurah": 16,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "سنسمه على الخرطوم"
    },
    {
      "number": 5288,
      "text": "إِنّا بَلَونـٰهُم كَما بَلَونا أَصحـٰبَ الجَنَّةِ إِذ أَقسَموا لَيَصرِمُنَّها مُصبِحينَ",
      "numberInSurah": 17,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "إنا بلوناهم كما بلونا أصحاب الجنة إذ أقسموا ليصرمنها مصبحين"
    },
    {
      "number": 5289,
      "text": "وَلا يَستَثنونَ",
      "numberInSurah": 18,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "ولا يستثنون"
    },
    {
      "number": 5290,
      "text": "فَطافَ عَلَيها طائِفٌ مِن رَبِّكَ وَهُم نائِمونَ",
      "numberInSurah": 19,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "فطاف عليها طائف من ربك وهم نائمون"
    },
    {
      "number": 5291,
      "text": "فَأَصبَحَت كَالصَّريمِ",
      "numberInSurah": 20,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "فأصبحت كالصريم"
    },
    {
      "number": 5292,
      "text": "فَتَنادَوا مُصبِحينَ",
      "numberInSurah": 21,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "فتنادوا مصبحين"
    },
    {
      "number": 5293,
      "text": "أَنِ اغدوا عَلىٰ حَرثِكُم إِن كُنتُم صـٰرِمينَ",
      "numberInSurah": 22,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "أن اغدوا على حرثكم إن كنتم صارمين"
    },
    {
      "number": 5294,
      "text": "فَانطَلَقوا وَهُم يَتَخـٰفَتونَ",
      "numberInSurah": 23,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "فانطلقوا وهم يتخافتون"
    },
    {
      "number": 5295,
      "text": "أَن لا يَدخُلَنَّهَا اليَومَ عَلَيكُم مِسكينٌ",
      "numberInSurah": 24,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "أن لا يدخلنها اليوم عليكم مسكين"
    },
    {
      "number": 5296,
      "text": "وَغَدَوا عَلىٰ حَردٍ قـٰدِرينَ",
      "numberInSurah": 25,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "وغدوا على حرد قادرين"
    },
    {
      "number": 5297,
      "text": "فَلَمّا رَأَوها قالوا إِنّا لَضالّونَ",
      "numberInSurah": 26,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "فلما رأوها قالوا إنا لضالون"
    },
    {
      "number": 5298,
      "text": "بَل نَحنُ مَحرومونَ",
      "numberInSurah": 27,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "بل نحن محرومون"
    },
    {
      "number": 5299,
      "text": "قالَ أَوسَطُهُم أَلَم أَقُل لَكُم لَولا تُسَبِّحونَ",
      "numberInSurah": 28,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "قال أوسطهم ألم أقل لكم لولا تسبحون"
    },
    {
      "number": 5300,
      "text": "قالوا سُبحـٰنَ رَبِّنا إِنّا كُنّا ظـٰلِمينَ",
      "numberInSurah": 29,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "قالوا سبحان ربنا إنا كنا ظالمين"
    },
    {
      "number": 5301,
      "text": "فَأَقبَلَ بَعضُهُم عَلىٰ بَعضٍ يَتَلـٰوَمونَ",
      "numberInSurah": 30,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "فأقبل بعضهم على بعض يتلاومون"
    },
    {
      "number": 5302,
      "text": "قالوا يـٰوَيلَنا إِنّا كُنّا طـٰغينَ",
      "numberInSurah": 31,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "قالوا يا ويلنا إنا كنا طاغين"
    },
    {
      "number": 5303,
      "text": "عَسىٰ رَبُّنا أَن يُبدِلَنا خَيرًا مِنها إِنّا إِلىٰ رَبِّنا رٰغِبونَ",
      "numberInSurah": 32,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "عسى ربنا أن يبدلنا خيرا منها إنا إلى ربنا راغبون"
    },
    {
      "number": 5304,
      "text": "كَذٰلِكَ العَذابُ ۖ وَلَعَذابُ الـٔاخِرَةِ أَكبَرُ ۚ لَو كانوا يَعلَمونَ",
      "numberInSurah": 33,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "كذلك العذاب ولعذاب الآخرة أكبر لو كانوا يعلمون"
    },
    {
      "number": 5305,
      "text": "إِنَّ لِلمُتَّقينَ عِندَ رَبِّهِم جَنّـٰتِ النَّعيمِ",
      "numberInSurah": 34,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 499,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "إن للمتقين عند ربهم جنات النعيم"
    },
    {
      "number": 5306,
      "text": "أَفَنَجعَلُ المُسلِمينَ كَالمُجرِمينَ",
      "numberInSurah": 35,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 499,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "أفنجعل المسلمين كالمجرمين"
    },
    {
      "number": 5307,
      "text": "ما لَكُم كَيفَ تَحكُمونَ",
      "numberInSurah": 36,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 499,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "ما لكم كيف تحكمون"
    },
    {
      "number": 5308,
      "text": "أَم لَكُم كِتـٰبٌ فيهِ تَدرُسونَ",
      "numberInSurah": 37,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 499,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "أم لكم كتاب فيه تدرسون"
    },
    {
      "number": 5309,
      "text": "إِنَّ لَكُم فيهِ لَما تَخَيَّرونَ",
      "numberInSurah": 38,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 499,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "إن لكم فيه لما تخيرون"
    },
    {
      "number": 5310,
      "text": "أَم لَكُم أَيمـٰنٌ عَلَينا بـٰلِغَةٌ إِلىٰ يَومِ القِيـٰمَةِ ۙ إِنَّ لَكُم لَما تَحكُمونَ",
      "numberInSurah": 39,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 499,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "أم لكم أيمان علينا بالغة إلى يوم القيامة إن لكم لما تحكمون"
    },
    {
      "number": 5311,
      "text": "سَلهُم أَيُّهُم بِذٰلِكَ زَعيمٌ",
      "numberInSurah": 40,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 499,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "سلهم أيهم بذلك زعيم"
    },
    {
      "number": 5312,
      "text": "أَم لَهُم شُرَكاءُ فَليَأتوا بِشُرَكائِهِم إِن كانوا صـٰدِقينَ",
      "numberInSurah": 41,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 499,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "أم لهم شركاء فليأتوا بشركائهم إن كانوا صادقين"
    },
    {
      "number": 5313,
      "text": "يَومَ يُكشَفُ عَن ساقٍ وَيُدعَونَ إِلَى السُّجودِ فَلا يَستَطيعونَ",
      "numberInSurah": 42,
      "juz": 29,
      "manzil": 7,
      "page": 565,
      "ruku": 499,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "يوم يكشف عن ساق ويدعون إلى السجود فلا يستطيعون"
    },
    {
      "number": 5314,
      "text": "خـٰشِعَةً أَبصـٰرُهُم تَرهَقُهُم ذِلَّةٌ ۖ وَقَد كانوا يُدعَونَ إِلَى السُّجودِ وَهُم سـٰلِمونَ",
      "numberInSurah": 43,
      "juz": 29,
      "manzil": 7,
      "page": 566,
      "ruku": 499,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "خاشعة أبصارهم ترهقهم ذلة وقد كانوا يدعون إلى السجود وهم سالمون"
    },
    {
      "number": 5315,
      "text": "فَذَرنى وَمَن يُكَذِّبُ بِهـٰذَا الحَديثِ ۖ سَنَستَدرِجُهُم مِن حَيثُ لا يَعلَمونَ",
      "numberInSurah": 44,
      "juz": 29,
      "manzil": 7,
      "page": 566,
      "ruku": 499,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "فذرني ومن يكذب بهذا الحديث سنستدرجهم من حيث لا يعلمون"
    },
    {
      "number": 5316,
      "text": "وَأُملى لَهُم ۚ إِنَّ كَيدى مَتينٌ",
      "numberInSurah": 45,
      "juz": 29,
      "manzil": 7,
      "page": 566,
      "ruku": 499,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "وأملي لهم إن كيدي متين"
    },
    {
      "number": 5317,
      "text": "أَم تَسـَٔلُهُم أَجرًا فَهُم مِن مَغرَمٍ مُثقَلونَ",
      "numberInSurah": 46,
      "juz": 29,
      "manzil": 7,
      "page": 566,
      "ruku": 499,
      "hizbQuarter": 226,
      "sajda": false,
      "no_Tashkeel_text": "أم تسألهم أجرا فهم من مغرم مثقلون"
    },
    {
      "number": 5318,
      "text": "أَم عِندَهُمُ الغَيبُ فَهُم يَكتُبونَ",
      "numberInSurah": 47,
      "juz": 29,
      "manzil": 7,
      "page": 566,
      "ruku": 499,
      "hizbQuarter": 226,
      "sajda": false,
