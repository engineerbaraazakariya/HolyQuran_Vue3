{
    "number": 89,
    "name": "سُورَةُ الفَجۡرِ",
    "englishName": "Al-Fajr",
    "englishNameTranslation": "The Dawn",
    "revelationType": "Meccan",
    "ayahs": [
        {
            "number": 5994,
            "text": "وَٱلۡفَجۡرِ",
            "numberInSurah": 1,
            "juz": 30,
            "manzil": 7,
            "page": 593,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "بسم الله الرحمن الرحيم والفجر"
        },
        {
            "number": 5995,
            "text": "وَلَيَالٍ عَشۡرٖ",
            "numberInSurah": 2,
            "juz": 30,
            "manzil": 7,
            "page": 593,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "وليال عشر"
        },
        {
            "number": 5996,
            "text": "وَٱلشَّفۡعِ وَٱلۡوَتۡرِ",
            "numberInSurah": 3,
            "juz": 30,
            "manzil": 7,
            "page": 593,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "والشفع والوتر"
        },
        {
            "number": 5997,
            "text": "وَٱلَّيۡلِ إِذَا يَسۡرِ",
            "numberInSurah": 4,
            "juz": 30,
            "manzil": 7,
            "page": 593,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "والليل إذا يسر"
        },
        {
            "number": 5998,
            "text": "هَلۡ فِي ذَٰلِكَ قَسَمٞ لِّذِي حِجۡرٍ",
            "numberInSurah": 5,
            "juz": 30,
            "manzil": 7,
            "page": 593,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "هل في ذلك قسم لذي حجر"
        },
        {
            "number": 5999,
            "text": "أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ",
            "numberInSurah": 6,
            "juz": 30,
            "manzil": 7,
            "page": 593,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "ألم تر كيف فعل ربك بعاد"
        },
        {
            "number": 6000,
            "text": "إِرَمَ ذَاتِ ٱلۡعِمَادِ",
            "numberInSurah": 7,
            "juz": 30,
            "manzil": 7,
            "page": 593,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "إرم ذات العماد"
        },
        {
            "number": 6001,
            "text": "ٱلَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ٱلۡبِلَٰدِ",
            "numberInSurah": 8,
            "juz": 30,
            "manzil": 7,
            "page": 593,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "التي لم يخلق مثلها في البلاد"
        },
        {
            "number": 6002,
            "text": "وَثَمُودَ ٱلَّذِينَ جَابُواْ ٱلصَّخۡرَ بِٱلۡوَادِ",
            "numberInSurah": 9,
            "juz": 30,
            "manzil": 7,
            "page": 593,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "وثمود الذين جابوا الصخر بالواد"
        },
        {
            "number": 6003,
            "text": "وَفِرۡعَوۡنَ ذِي ٱلۡأَوۡتَادِ",
            "numberInSurah": 10,
            "juz": 30,
            "manzil": 7,
            "page": 593,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "وفرعون ذي الأوتاد"
        },
        {
            "number": 6004,
            "text": "ٱلَّذِينَ طَغَوۡاْ فِي ٱلۡبِلَٰدِ",
            "numberInSurah": 11,
            "juz": 30,
            "manzil": 7,
            "page": 593,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "الذين طغوا في البلاد"
        },
        {
            "number": 6005,
            "text": "فَأَكۡثَرُواْ فِيهَا ٱلۡفَسَادَ",
            "numberInSurah": 12,
            "juz": 30,
            "manzil": 7,
            "page": 593,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "فأكثروا فيها الفساد"
        },
        {
            "number": 6006,
            "text": "فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ",
            "numberInSurah": 13,
            "juz": 30,
            "manzil": 7,
            "page": 593,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "فصب عليهم ربك سوط عذاب"
        },
        {
            "number": 6007,
            "text": "إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ",
            "numberInSurah": 14,
            "juz": 30,
            "manzil": 7,
            "page": 593,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "إن ربك لبالمرصاد"
        },
        {
            "number": 6008,
            "text": "فَأَمَّا ٱلۡإِنسَٰنُ إِذَا مَا ٱبۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّيٓ أَكۡرَمَنِ",
            "numberInSurah": 15,
            "juz": 30,
            "manzil": 7,
            "page": 593,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "فأما الإنسان إذا ما ابتلاه ربه فأكرمه ونعمه فيقول ربي أكرمن"
        },
        {
            "number": 6009,
            "text": "وَأَمَّآ إِذَا مَا ٱبۡتَلَىٰهُ فَقَدَرَ عَلَيۡهِ رِزۡقَهُۥ فَيَقُولُ رَبِّيٓ أَهَٰنَنِ",
            "numberInSurah": 16,
            "juz": 30,
            "manzil": 7,
            "page": 593,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "وأما إذا ما ابتلاه فقدر عليه رزقه فيقول ربي أهانن"
        },
        {
            "number": 6010,
            "text": "كَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡيَتِيمَ",
            "numberInSurah": 17,
            "juz": 30,
            "manzil": 7,
            "page": 593,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "كلا بل لا تكرمون اليتيم"
        },
        {
            "number": 6011,
            "text": "وَلَا تَحَـٰٓضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ",
            "numberInSurah": 18,
            "juz": 30,
            "manzil": 7,
            "page": 593,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "ولا تحاضون على طعام المسكين"
        },
        {
            "number": 6012,
            "text": "وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلٗا لَّمّٗا",
            "numberInSurah": 19,
            "juz": 30,
            "manzil": 7,
            "page": 593,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "وتأكلون التراث أكلا لما"
        },
        {
            "number": 6013,
            "text": "وَتُحِبُّونَ ٱلۡمَالَ حُبّٗا جَمّٗا",
            "numberInSurah": 20,
            "juz": 30,
            "manzil": 7,
            "page": 593,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "وتحبون المال حبا جما"
        },
        {
            "number": 6014,
            "text": "كَلَّآۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكّٗا دَكّٗا",
            "numberInSurah": 21,
            "juz": 30,
            "manzil": 7,
            "page": 593,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "كلا إذا دكت الأرض دكا دكا"
        },
        {
            "number": 6015,
            "text": "وَجَآءَ رَبُّكَ وَٱلۡمَلَكُ صَفّٗا صَفّٗا",
            "numberInSurah": 22,
            "juz": 30,
            "manzil": 7,
            "page": 593,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "وجاء ربك والملك صفا صفا"
        },
        {
            "number": 6016,
            "text": "وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَۚ يَوۡمَئِذٖ يَتَذَكَّرُ ٱلۡإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ",
            "numberInSurah": 23,
            "juz": 30,
            "manzil": 7,
            "page": 593,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "وجيء يومئذ بجهنم يومئذ يتذكر الإنسان وأنى له الذكرى"
        },
        {
            "number": 6017,
            "text": "يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي",
            "numberInSurah": 24,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "يقول يا ليتني قدمت لحياتي"
        },
        {
            "number": 6018,
            "text": "فَيَوۡمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ",
            "numberInSurah": 25,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "فيومئذ لا يعذب عذابه أحد"
        },
        {
            "number": 6019,
            "text": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞ",
            "numberInSurah": 26,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "ولا يوثق وثاقه أحد"
        },
        {
            "number": 6020,
            "text": "يَـٰٓأَيَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ",
            "numberInSurah": 27,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "يا أيتها النفس المطمئنة"
        },
        {
            "number": 6021,
            "text": "ٱرۡجِعِيٓ إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرۡضِيَّةٗ",
            "numberInSurah": 28,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "ارجعي إلى ربك راضية مرضية"
        },
        {
            "number": 6022,
            "text": "فَٱدۡخُلِي فِي عِبَٰدِي",
            "numberInSurah": 29,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "فادخلي في عبادي"
        },
        {
            "number": 6023,
            "text": "وَٱدۡخُلِي جَنَّتِي",
            "numberInSurah": 30,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 531,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "وادخلي جنتي"
        }
    ]
}