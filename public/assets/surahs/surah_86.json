{
    "number": 86,
    "name": "سُورَةُ الطَّارِقِ",
    "englishName": "At-Taariq",
    "englishNameTranslation": "The Morning Star",
    "revelationType": "Meccan",
    "ayahs": [
        {
            "number": 5932,
            "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
            "numberInSurah": 1,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 528,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "بسم الله الرحمن الرحيم والسماء والطارق"
        },
        {
            "number": 5933,
            "text": "ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ",
            "numberInSurah": 2,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 528,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "وما أدراك ما الطارق"
        },
        {
            "number": 5934,
            "text": "ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
            "numberInSurah": 3,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 528,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "النجم الثاقب"
        },
        {
            "number": 5935,
            "text": "مَٰلِكِ يَوۡمِ ٱلدِّينِ",
            "numberInSurah": 4,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 528,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "إن كل نفس لما عليها حافظ"
        },
        {
            "number": 5936,
            "text": "إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ",
            "numberInSurah": 5,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 528,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "فلينظر الإنسان مم خلق"
        },
        {
            "number": 5937,
            "text": "ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ",
            "numberInSurah": 6,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 528,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "خلق من ماء دافق"
        },
        {
            "number": 5938,
            "text": "صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ",
            "numberInSurah": 7,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 528,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "يخرج من بين الصلب والترائب"
        },
        {
            "number": 5939,
            "text": "إِنَّهُ عَلىٰ رَجعِهِ لَقادِرٌ",
            "numberInSurah": 8,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 528,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "إنه على رجعه لقادر"
        },
        {
            "number": 5940,
            "text": "يَومَ تُبلَى السَّرائِرُ",
            "numberInSurah": 9,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 528,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "يوم تبلى السرائر"
        },
        {
            "number": 5941,
            "text": "فَما لَهُ مِن قُوَّةٍ وَلا ناصِرٍ",
            "numberInSurah": 10,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 528,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "فما له من قوة ولا ناصر"
        },
        {
            "number": 5942,
            "text": "وَالسَّماءِ ذاتِ الرَّجعِ",
            "numberInSurah": 11,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 528,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "والسماء ذات الرجع"
        },
        {
            "number": 5943,
            "text": "وَالأَرضِ ذاتِ الصَّدعِ",
            "numberInSurah": 12,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 528,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "والأرض ذات الصدع"
        },
        {
            "number": 5944,
            "text": "إِنَّهُ لَقَولٌ فَصلٌ",
            "numberInSurah": 13,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 528,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "إنه لقول فصل"
        },
        {
            "number": 5945,
            "text": "وَما هُوَ بِالهَزلِ",
            "numberInSurah": 14,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 528,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "وما هو بالهزل"
        },
        {
            "number": 5946,
            "text": "إِنَّهُم يَكيدونَ كَيدًا",
            "numberInSurah": 15,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 528,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "إنهم يكيدون كيدا"
        },
        {
            "number": 5947,
            "text": "وَأَكيدُ كَيدًا",
            "numberInSurah": 16,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 528,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "وأكيد كيدا"
        },
        {
            "number": 5948,
            "text": "فَمَهِّلِ الكـٰفِرينَ أَمهِلهُم رُوَيدًا",
            "numberInSurah": 17,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 528,
            "hizbQuarter": 236,
            "sajda": false,
            "no_Tashkeel_text": "فمهل الكافرين أمهلهم رويدا"
        }
    ]
}