            "ruku": 537,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "فما يكذبك بعد بالدين"
        },
        {
            "number": 6106,
            "text": "أَلَيسَ اللَّهُ بِأَحكَمِ الحـٰكِمينَ",
            "numberInSurah": 8,
            "juz": 30,
            "manzil": 7,
