            "manzil": 7,
            "page": 597,
            "ruku": 537,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "بسم الله الرحمن الرحيم والتين والزيتون"
        },
        {
            "number": 6100,
            "text": "ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ",
            "numberInSurah": 2,
            "juz": 30,
            "manzil": 7,
            "page": 597,
            "ruku": 537,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "وطور سينين"
        },
        {
            "number": 6101,
            "text": "ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
            "numberInSurah": 3,
            "juz": 30,
            "manzil": 7,
            "page": 597,
            "ruku": 537,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "وهذا البلد الأمين"
        },
        {
            "number": 6102,
            "text": "مَٰلِكِ يَوۡمِ ٱلدِّينِ",
            "numberInSurah": 4,
            "juz": 30,
            "manzil": 7,
            "page": 597,
            "ruku": 537,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "لقد خلقنا الإنسان في أحسن تقويم"
        },
        {
            "number": 6103,
            "text": "إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ",
