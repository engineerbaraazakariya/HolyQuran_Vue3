            "juz": 30,
            "manzil": 7,
            "page": 597,
            "ruku": 537,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "ثم رددناه أسفل سافلين"
        },
        {
            "number": 6104,
            "text": "ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ",
            "numberInSurah": 6,
            "juz": 30,
            "manzil": 7,
            "page": 597,
            "ruku": 537,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "إلا الذين آمنوا وعملوا الصالحات فلهم أجر غير ممنون"
        },
        {
            "number": 6105,
            "text": "صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ",
            "numberInSurah": 7,
