{
  "number": 80,
  "name": "سُورَةُ عَبَسَ",
  "englishName": "Abasa",
  "englishNameTranslation": "He frowned",
  "revelationType": "Meccan",
  "ayahs": [
    {
      "number": 5759,
      "text": "عَبَسَ وَتَوَلّىٰ",
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "بسم الله الرحمن الرحيم عبس وتولى"
    },
    {
      "number": 5760,
      "text": "أَن جاءَهُ الأَعمىٰ",
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "أن جاءه الأعمى"
    },
    {
      "number": 5761,
      "text": "وَما يُدريكَ لَعَلَّهُ يَزَّكّىٰ",
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "وما يدريك لعله يزكى"
    },
    {
      "number": 5762,
      "text": "أَو يَذَّكَّرُ فَتَنفَعَهُ الذِّكرىٰ",
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "أو يذكر فتنفعه الذكرى"
    },
    {
      "number": 5763,
      "text": "أَمّا مَنِ استَغنىٰ",
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "أما من استغنى"
    },
    {
      "number": 5764,
      "text": "فَأَنتَ لَهُ تَصَدّىٰ",
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "فأنت له تصدى"
    },
    {
      "number": 5765,
      "text": "وَما عَلَيكَ أَلّا يَزَّكّىٰ",
      "numberInSurah": 7,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "وما عليك ألا يزكى"
    },
    {
      "number": 5766,
      "text": "وَأَمّا مَن جاءَكَ يَسعىٰ",
      "numberInSurah": 8,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "وأما من جاءك يسعى"
    },
    {
      "number": 5767,
      "text": "وَهُوَ يَخشىٰ",
      "numberInSurah": 9,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "وهو يخشى"
    },
    {
      "number": 5768,
      "text": "فَأَنتَ عَنهُ تَلَهّىٰ",
      "numberInSurah": 10,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "فأنت عنه تلهى"
    },
    {
      "number": 5769,
      "text": "كَلّا إِنَّها تَذكِرَةٌ",
      "numberInSurah": 11,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "كلا إنها تذكرة"
    },
    {
      "number": 5770,
      "text": "فَمَن شاءَ ذَكَرَهُ",
      "numberInSurah": 12,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "فمن شاء ذكره"
    },
    {
      "number": 5771,
      "text": "فى صُحُفٍ مُكَرَّمَةٍ",
      "numberInSurah": 13,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "في صحف مكرمة"
    },
    {
      "number": 5772,
      "text": "مَرفوعَةٍ مُطَهَّرَةٍ",
      "numberInSurah": 14,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "مرفوعة مطهرة"
    },
    {
      "number": 5773,
      "text": "بِأَيدى سَفَرَةٍ",
      "numberInSurah": 15,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "بأيدي سفرة"
    },
    {
      "number": 5774,
      "text": "كِرامٍ بَرَرَةٍ",
      "numberInSurah": 16,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "كرام بررة"
    },
    {
      "number": 5775,
      "text": "قُتِلَ الإِنسـٰنُ ما أَكفَرَهُ",
      "numberInSurah": 17,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "قتل الإنسان ما أكفره"
    },
    {
      "number": 5776,
      "text": "مِن أَىِّ شَىءٍ خَلَقَهُ",
      "numberInSurah": 18,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "من أي شيء خلقه"
    },
    {
      "number": 5777,
      "text": "مِن نُطفَةٍ خَلَقَهُ فَقَدَّرَهُ",
      "numberInSurah": 19,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "من نطفة خلقه فقدره"
    },
    {
      "number": 5778,
      "text": "ثُمَّ السَّبيلَ يَسَّرَهُ",
      "numberInSurah": 20,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "ثم السبيل يسره"
    },
    {
      "number": 5779,
      "text": "ثُمَّ أَماتَهُ فَأَقبَرَهُ",
      "numberInSurah": 21,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "ثم أماته فأقبره"
    },
    {
      "number": 5780,
      "text": "ثُمَّ إِذا شاءَ أَنشَرَهُ",
      "numberInSurah": 22,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "ثم إذا شاء أنشره"
    },
    {
      "number": 5781,
      "text": "كَلّا لَمّا يَقضِ ما أَمَرَهُ",
      "numberInSurah": 23,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "كلا لما يقض ما أمره"
    },
    {
      "number": 5782,
      "text": "فَليَنظُرِ الإِنسـٰنُ إِلىٰ طَعامِهِ",
      "numberInSurah": 24,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "فلينظر الإنسان إلى طعامه"
    },
    {
      "number": 5783,
      "text": "أَنّا صَبَبنَا الماءَ صَبًّا",
      "numberInSurah": 25,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "أنا صببنا الماء صبا"
    },
    {
      "number": 5784,
      "text": "ثُمَّ شَقَقنَا الأَرضَ شَقًّا",
      "numberInSurah": 26,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "ثم شققنا الأرض شقا"
    },
    {
      "number": 5785,
      "text": "فَأَنبَتنا فيها حَبًّا",
      "numberInSurah": 27,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "فأنبتنا فيها حبا"
    },
    {
      "number": 5786,
      "text": "وَعِنَبًا وَقَضبًا",
      "numberInSurah": 28,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "وعنبا وقضبا"
    },
    {
      "number": 5787,
      "text": "وَزَيتونًا وَنَخلًا",
      "numberInSurah": 29,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "وزيتونا ونخلا"
    },
    {
      "number": 5788,
      "text": "وَحَدائِقَ غُلبًا",
      "numberInSurah": 30,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "وحدائق غلبا"
    },
    {
      "number": 5789,
      "text": "وَفـٰكِهَةً وَأَبًّا",
      "numberInSurah": 31,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "وفاكهة وأبا"
    },
    {
      "number": 5790,
      "text": "مَتـٰعًا لَكُم وَلِأَنعـٰمِكُم",
      "numberInSurah": 32,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "متاعا لكم ولأنعامكم"
    },
    {
      "number": 5791,
      "text": "فَإِذا جاءَتِ الصّاخَّةُ",
      "numberInSurah": 33,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "فإذا جاءت الصاخة"
    },
    {
      "number": 5792,
      "text": "يَومَ يَفِرُّ المَرءُ مِن أَخيهِ",
      "numberInSurah": 34,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "يوم يفر المرء من أخيه"
    },
    {
      "number": 5793,
      "text": "وَأُمِّهِ وَأَبيهِ",
      "numberInSurah": 35,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "وأمه وأبيه"
    },
    {
      "number": 5794,
      "text": "وَصـٰحِبَتِهِ وَبَنيهِ",
      "numberInSurah": 36,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "وصاحبته وبنيه"
    },
    {
      "number": 5795,
      "text": "لِكُلِّ امرِئٍ مِنهُم يَومَئِذٍ شَأنٌ يُغنيهِ",
      "numberInSurah": 37,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "لكل امرئ منهم يومئذ شأن يغنيه"
    },
    {
      "number": 5796,
      "text": "وُجوهٌ يَومَئِذٍ مُسفِرَةٌ",
      "numberInSurah": 38,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "وجوه يومئذ مسفرة"
    },
    {
      "number": 5797,
      "text": "ضاحِكَةٌ مُستَبشِرَةٌ",
      "numberInSurah": 39,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "ضاحكة مستبشرة"
    },
    {
      "number": 5798,
      "text": "وَوُجوهٌ يَومَئِذٍ عَلَيها غَبَرَةٌ",
      "numberInSurah": 40,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "ووجوه يومئذ عليها غبرة"
    },
    {
      "number": 5799,
      "text": "تَرهَقُها قَتَرَةٌ",
      "numberInSurah": 41,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "ترهقها قترة"
    },
    {
      "number": 5800,
      "text": "أُولـٰئِكَ هُمُ الكَفَرَةُ الفَجَرَةُ",
      "numberInSurah": 42,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false,
      "no_Tashkeel_text": "أولئك هم الكفرة الفجرة"
    }
  ]
}