      "ruku": 542,
      "hizbQuarter": 239,
      "sajda": false,
      "no_Tashkeel_text": "وإنه على ذلك لشهيد"
    },
    {
      "number": 6154,
      "text": "وَإِنَّهُ لِحُبِّ الخَيرِ لَشَديدٌ",
