      "page": 599,
      "ruku": 542,
      "hizbQuarter": 239,
      "sajda": false,
      "no_Tashkeel_text": "فأثرن به نقعا"
    },
    {
      "number": 6151,
      "text": "فَوَسَطنَ بِهِ جَمعًا",
