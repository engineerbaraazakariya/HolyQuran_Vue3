      "manzil": 7,
      "page": 600,
      "ruku": 542,
      "hizbQuarter": 240,
      "sajda": false,
      "no_Tashkeel_text": "وحصل ما في الصدور"
    },
    {
      "number": 6157,
      "text": "إِنَّ رَبَّهُم بِهِم يَومَئِذٍ لَخَبيرٌ",
