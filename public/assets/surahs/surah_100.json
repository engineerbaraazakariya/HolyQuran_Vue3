      "juz": 30,
      "manzil": 7,
      "page": 599,
      "ruku": 542,
      "hizbQuarter": 239,
      "sajda": false,
      "no_Tashkeel_text": "وإنه لحب الخير لشديد"
    },
    {
      "number": 6155,
      "text": "۞ أَفَلا يَعلَمُ إِذا بُعثِرَ ما فِى القُبورِ",
