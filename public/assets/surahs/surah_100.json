      "page": 599,
      "ruku": 542,
      "hizbQuarter": 239,
      "sajda": false,
      "no_Tashkeel_text": "فوسطن به جمعا"
    },
    {
      "number": 6152,
      "text": "إِنَّ الإِنسـٰنَ لِرَبِّهِ لَكَنودٌ",
