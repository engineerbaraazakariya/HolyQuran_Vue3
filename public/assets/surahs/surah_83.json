{
  "number": 83,
  "name": "سُورَةُ المُطَفِّفِينَ",
  "englishName": "Al-Mutaffifin",
  "englishNameTranslation": "Defrauding",
  "revelationType": "Meccan",
  "ayahs": [
    {
      "number": 5849,
      "text": "وَيلٌ لِلمُطَفِّفينَ",
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "بسم الله الرحمن الرحيم ويل للمطففين"
    },
    {
      "number": 5850,
      "text": "الَّذينَ إِذَا اكتالوا عَلَى النّاسِ يَستَوفونَ",
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "الذين إذا اكتالوا على الناس يستوفون"
    },
    {
      "number": 5851,
      "text": "وَإِذا كالوهُم أَو وَزَنوهُم يُخسِرونَ",
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "وإذا كالوهم أو وزنوهم يخسرون"
    },
    {
      "number": 5852,
      "text": "أَلا يَظُنُّ أُولـٰئِكَ أَنَّهُم مَبعوثونَ",
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "ألا يظن أولئك أنهم مبعوثون"
    },
    {
      "number": 5853,
      "text": "لِيَومٍ عَظيمٍ",
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "ليوم عظيم"
    },
    {
      "number": 5854,
      "text": "يَومَ يَقومُ النّاسُ لِرَبِّ العـٰلَمينَ",
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "يوم يقوم الناس لرب العالمين"
    },
    {
      "number": 5855,
      "text": "كَلّا إِنَّ كِتـٰبَ الفُجّارِ لَفى سِجّينٍ",
      "numberInSurah": 7,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "كلا إن كتاب الفجار لفي سجين"
    },
    {
      "number": 5856,
      "text": "وَما أَدرىٰكَ ما سِجّينٌ",
      "numberInSurah": 8,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "وما أدراك ما سجين"
    },
    {
      "number": 5857,
      "text": "كِتـٰبٌ مَرقومٌ",
      "numberInSurah": 9,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "كتاب مرقوم"
    },
    {
      "number": 5858,
      "text": "وَيلٌ يَومَئِذٍ لِلمُكَذِّبينَ",
      "numberInSurah": 10,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "ويل يومئذ للمكذبين"
    },
    {
      "number": 5859,
      "text": "الَّذينَ يُكَذِّبونَ بِيَومِ الدّينِ",
      "numberInSurah": 11,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "الذين يكذبون بيوم الدين"
    },
    {
      "number": 5860,
      "text": "وَما يُكَذِّبُ بِهِ إِلّا كُلُّ مُعتَدٍ أَثيمٍ",
      "numberInSurah": 12,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "وما يكذب به إلا كل معتد أثيم"
    },
    {
      "number": 5861,
      "text": "إِذا تُتلىٰ عَلَيهِ ءايـٰتُنا قالَ أَسـٰطيرُ الأَوَّلينَ",
      "numberInSurah": 13,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "إذا تتلى عليه آياتنا قال أساطير الأولين"
    },
    {
      "number": 5862,
      "text": "كَلّا ۖ بَل ۜ رانَ عَلىٰ قُلوبِهِم ما كانوا يَكسِبونَ",
      "numberInSurah": 14,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "كلا بل ران على قلوبهم ما كانوا يكسبون"
    },
    {
      "number": 5863,
      "text": "كَلّا إِنَّهُم عَن رَبِّهِم يَومَئِذٍ لَمَحجوبونَ",
      "numberInSurah": 15,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "كلا إنهم عن ربهم يومئذ لمحجوبون"
    },
    {
      "number": 5864,
      "text": "ثُمَّ إِنَّهُم لَصالُوا الجَحيمِ",
      "numberInSurah": 16,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "ثم إنهم لصالو الجحيم"
    },
    {
      "number": 5865,
      "text": "ثُمَّ يُقالُ هـٰذَا الَّذى كُنتُم بِهِ تُكَذِّبونَ",
      "numberInSurah": 17,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "ثم يقال هذا الذي كنتم به تكذبون"
    },
    {
      "number": 5866,
      "text": "كَلّا إِنَّ كِتـٰبَ الأَبرارِ لَفى عِلِّيّينَ",
      "numberInSurah": 18,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "كلا إن كتاب الأبرار لفي عليين"
    },
    {
      "number": 5867,
      "text": "وَما أَدرىٰكَ ما عِلِّيّونَ",
      "numberInSurah": 19,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "وما أدراك ما عليون"
    },
    {
      "number": 5868,
      "text": "كِتـٰبٌ مَرقومٌ",
      "numberInSurah": 20,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "كتاب مرقوم"
    },
    {
      "number": 5869,
      "text": "يَشهَدُهُ المُقَرَّبونَ",
      "numberInSurah": 21,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "يشهده المقربون"
    },
    {
      "number": 5870,
      "text": "إِنَّ الأَبرارَ لَفى نَعيمٍ",
      "numberInSurah": 22,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "إن الأبرار لفي نعيم"
    },
    {
      "number": 5871,
      "text": "عَلَى الأَرائِكِ يَنظُرونَ",
      "numberInSurah": 23,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "على الأرائك ينظرون"
    },
    {
      "number": 5872,
      "text": "تَعرِفُ فى وُجوهِهِم نَضرَةَ النَّعيمِ",
      "numberInSurah": 24,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "تعرف في وجوههم نضرة النعيم"
    },
    {
      "number": 5873,
      "text": "يُسقَونَ مِن رَحيقٍ مَختومٍ",
      "numberInSurah": 25,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "يسقون من رحيق مختوم"
    },
    {
      "number": 5874,
      "text": "خِتـٰمُهُ مِسكٌ ۚ وَفى ذٰلِكَ فَليَتَنافَسِ المُتَنـٰفِسونَ",
      "numberInSurah": 26,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "ختامه مسك وفي ذلك فليتنافس المتنافسون"
    },
    {
      "number": 5875,
      "text": "وَمِزاجُهُ مِن تَسنيمٍ",
      "numberInSurah": 27,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "ومزاجه من تسنيم"
    },
    {
      "number": 5876,
      "text": "عَينًا يَشرَبُ بِهَا المُقَرَّبونَ",
      "numberInSurah": 28,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "عينا يشرب بها المقربون"
    },
    {
      "number": 5877,
      "text": "إِنَّ الَّذينَ أَجرَموا كانوا مِنَ الَّذينَ ءامَنوا يَضحَكونَ",
      "numberInSurah": 29,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "إن الذين أجرموا كانوا من الذين آمنوا يضحكون"
    },
    {
      "number": 5878,
      "text": "وَإِذا مَرّوا بِهِم يَتَغامَزونَ",
      "numberInSurah": 30,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "وإذا مروا بهم يتغامزون"
    },
    {
      "number": 5879,
      "text": "وَإِذَا انقَلَبوا إِلىٰ أَهلِهِمُ انقَلَبوا فَكِهينَ",
      "numberInSurah": 31,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "وإذا انقلبوا إلى أهلهم انقلبوا فكهين"
    },
    {
      "number": 5880,
      "text": "وَإِذا رَأَوهُم قالوا إِنَّ هـٰؤُلاءِ لَضالّونَ",
      "numberInSurah": 32,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "وإذا رأوهم قالوا إن هؤلاء لضالون"
    },
    {
      "number": 5881,
      "text": "وَما أُرسِلوا عَلَيهِم حـٰفِظينَ",
      "numberInSurah": 33,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "وما أرسلوا عليهم حافظين"
    },
    {
      "number": 5882,
      "text": "فَاليَومَ الَّذينَ ءامَنوا مِنَ الكُفّارِ يَضحَكونَ",
      "numberInSurah": 34,
      "juz": 30,
      "manzil": 7,
      "page": 588,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "فاليوم الذين آمنوا من الكفار يضحكون"
    },
    {
      "number": 5883,
      "text": "عَلَى الأَرائِكِ يَنظُرونَ",
      "numberInSurah": 35,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "على الأرائك ينظرون"
    },
    {
      "number": 5884,
      "text": "هَل ثُوِّبَ الكُفّارُ ما كانوا يَفعَلونَ",
      "numberInSurah": 36,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "هل ثوب الكفار ما كانوا يفعلون"
    }
  ]
}