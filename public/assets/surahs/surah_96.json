{
    "number": 96,
    "name": "سُورَةُ العَلَقِ",
    "englishName": "Al-Alaq",
    "englishNameTranslation": "The Clot",
    "revelationType": "Meccan",
    "ayahs": [
        {
            "number": 6107,
            "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
            "numberInSurah": 1,
            "juz": 30,
            "manzil": 7,
            "page": 597,
            "ruku": 538,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "بسم الله الرحمن الرحيم اقرأ باسم ربك الذي خلق"
        },
        {
            "number": 6108,
            "text": "ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ",
            "numberInSurah": 2,
            "juz": 30,
            "manzil": 7,
            "page": 597,
            "ruku": 538,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "خلق الإنسان من علق"
        },
        {
            "number": 6109,
            "text": "ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
            "numberInSurah": 3,
            "juz": 30,
            "manzil": 7,
            "page": 597,
            "ruku": 538,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "اقرأ وربك الأكرم"
        },
        {
            "number": 6110,
            "text": "مَٰلِكِ يَوۡمِ ٱلدِّينِ",
            "numberInSurah": 4,
            "juz": 30,
            "manzil": 7,
            "page": 597,
            "ruku": 538,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "الذي علم بالقلم"
        },
        {
            "number": 6111,
            "text": "إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ",
            "numberInSurah": 5,
            "juz": 30,
            "manzil": 7,
            "page": 597,
            "ruku": 538,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "علم الإنسان ما لم يعلم"
        },
        {
            "number": 6112,
            "text": "ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ",
            "numberInSurah": 6,
            "juz": 30,
            "manzil": 7,
            "page": 597,
            "ruku": 538,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "كلا إن الإنسان ليطغى"
        },
        {
            "number": 6113,
            "text": "صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ",
            "numberInSurah": 7,
            "juz": 30,
            "manzil": 7,
            "page": 597,
            "ruku": 538,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "أن رآه استغنى"
        },
        {
            "number": 6114,
            "text": "إِنَّ إِلىٰ رَبِّكَ الرُّجعىٰ",
            "numberInSurah": 8,
            "juz": 30,
            "manzil": 7,
            "page": 597,
            "ruku": 538,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "إن إلى ربك الرجعى"
        },
        {
            "number": 6115,
            "text": "أَرَءَيتَ الَّذى يَنهىٰ",
            "numberInSurah": 9,
            "juz": 30,
            "manzil": 7,
            "page": 597,
            "ruku": 538,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "أرأيت الذي ينهى"
        },
        {
            "number": 6116,
            "text": "عَبدًا إِذا صَلّىٰ",
            "numberInSurah": 10,
            "juz": 30,
            "manzil": 7,
            "page": 597,
            "ruku": 538,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "عبدا إذا صلى"
        },
        {
            "number": 6117,
            "text": "أَرَءَيتَ إِن كانَ عَلَى الهُدىٰ",
            "numberInSurah": 11,
            "juz": 30,
            "manzil": 7,
            "page": 597,
            "ruku": 538,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "أرأيت إن كان على الهدى"
        },
        {
            "number": 6118,
            "text": "أَو أَمَرَ بِالتَّقوىٰ",
            "numberInSurah": 12,
            "juz": 30,
            "manzil": 7,
            "page": 597,
            "ruku": 538,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "أو أمر بالتقوى"
        },
        {
            "number": 6119,
            "text": "أَرَءَيتَ إِن كَذَّبَ وَتَوَلّىٰ",
            "numberInSurah": 13,
            "juz": 30,
            "manzil": 7,
            "page": 597,
            "ruku": 538,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "أرأيت إن كذب وتولى"
        },
        {
            "number": 6120,
            "text": "أَلَم يَعلَم بِأَنَّ اللَّهَ يَرىٰ",
            "numberInSurah": 14,
            "juz": 30,
            "manzil": 7,
            "page": 597,
            "ruku": 538,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "ألم يعلم بأن الله يرى"
        },
        {
            "number": 6121,
            "text": "كَلّا لَئِن لَم يَنتَهِ لَنَسفَعًا بِالنّاصِيَةِ",
            "numberInSurah": 15,
            "juz": 30,
            "manzil": 7,
            "page": 597,
            "ruku": 538,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "كلا لئن لم ينته لنسفعا بالناصية"
        },
        {
            "number": 6122,
            "text": "ناصِيَةٍ كـٰذِبَةٍ خاطِئَةٍ",
            "numberInSurah": 16,
            "juz": 30,
            "manzil": 7,
            "page": 597,
            "ruku": 538,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "ناصية كاذبة خاطئة"
        },
        {
            "number": 6123,
            "text": "فَليَدعُ نادِيَهُ",
            "numberInSurah": 17,
            "juz": 30,
            "manzil": 7,
            "page": 597,
            "ruku": 538,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "فليدع ناديه"
        },
        {
            "number": 6124,
            "text": "سَنَدعُ الزَّبانِيَةَ",
            "numberInSurah": 18,
            "juz": 30,
            "manzil": 7,
            "page": 597,
            "ruku": 538,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "سندع الزبانية"
        },
        {
            "number": 6125,
            "text": "كَلّا لا تُطِعهُ وَاسجُد وَاقتَرِب ۩",
            "numberInSurah": 19,
            "juz": 30,
            "manzil": 7,
            "page": 597,
            "ruku": 538,
            "hizbQuarter": 239,
            "sajda": {
                "id": 15,
                "recommended": false,
                "obligatory": true
            },
            "no_Tashkeel_text": "كلا لا تطعه واسجد واقترب"
        }
    ]
}