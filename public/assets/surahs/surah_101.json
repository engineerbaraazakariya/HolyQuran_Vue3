{
    "number": 101,
    "name": "سُورَةُ القَارِعَةِ",
    "englishName": "Al-Qaari'a",
    "englishNameTranslation": "The Calamity",
    "revelationType": "Meccan",
    "ayahs": [
        {
            "number": 6158,
            "text": "ٱلۡقَارِعَةُ",
            "numberInSurah": 1,
            "juz": 30,
            "manzil": 7,
            "page": 600,
            "ruku": 543,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "بسم الله الرحمن الرحيم القارعة"
        },
        {
            "number": 6159,
            "text": "مَا ٱلۡقَارِعَةُ",
            "numberInSurah": 2,
            "juz": 30,
            "manzil": 7,
            "page": 600,
            "ruku": 543,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "ما القارعة"
        },
        {
            "number": 6160,
            "text": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ",
            "numberInSurah": 3,
            "juz": 30,
            "manzil": 7,
            "page": 600,
            "ruku": 543,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "وما أدراك ما القارعة"
        },
        {
            "number": 6161,
            "text": "يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ",
            "numberInSurah": 4,
            "juz": 30,
            "manzil": 7,
            "page": 600,
            "ruku": 543,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "يوم يكون الناس كالفراش المبثوث"
        },
        {
            "number": 6162,
            "text": "وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ",
            "numberInSurah": 5,
            "juz": 30,
            "manzil": 7,
            "page": 600,
            "ruku": 543,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "وتكون الجبال كالعهن المنفوش"
        },
        {
            "number": 6163,
            "text": "فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ",
            "numberInSurah": 6,
            "juz": 30,
            "manzil": 7,
            "page": 600,
            "ruku": 543,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "فأما من ثقلت موازينه"
        },
        {
            "number": 6164,
            "text": "فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ",
            "numberInSurah": 7,
            "juz": 30,
            "manzil": 7,
            "page": 600,
            "ruku": 543,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "فهو في عيشة راضية"
        },
        {
            "number": 6165,
            "text": "وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ",
            "numberInSurah": 8,
            "juz": 30,
            "manzil": 7,
            "page": 600,
            "ruku": 543,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "وأما من خفت موازينه"
        },
        {
            "number": 6166,
            "text": "فَأُمُّهُۥ هَاوِيَةٞ",
            "numberInSurah": 9,
            "juz": 30,
            "manzil": 7,
            "page": 600,
            "ruku": 543,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "فأمه هاوية"
        },
        {
            "number": 6167,
            "text": "وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ",
            "numberInSurah": 10,
            "juz": 30,
            "manzil": 7,
            "page": 600,
            "ruku": 543,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "وما أدراك ما هيه"
        },
        {
            "number": 6168,
            "text": "نَارٌ حَامِيَةُۢ",
            "numberInSurah": 11,
            "juz": 30,
            "manzil": 7,
            "page": 600,
            "ruku": 543,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "نار حامية"
        }
    ]
}