{
    "number": 92,
    "name": "سُورَةُ اللَّيۡلِ",
    "englishName": "Al-Lail",
    "englishNameTranslation": "The Night",
    "revelationType": "Meccan",
    "ayahs": [
        {
            "number": 6059,
            "text": "وَٱلَّيۡلِ إِذَا يَغۡشَىٰ",
            "numberInSurah": 1,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 534,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "بسم الله الرحمن الرحيم والليل إذا يغشى"
        },
        {
            "number": 6060,
            "text": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",
            "numberInSurah": 2,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 534,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "والنهار إذا تجلى"
        },
        {
            "number": 6061,
            "text": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ",
            "numberInSurah": 3,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 534,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "وما خلق الذكر والأنثى"
        },
        {
            "number": 6062,
            "text": "إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ",
            "numberInSurah": 4,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 534,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "إن سعيكم لشتى"
        },
        {
            "number": 6063,
            "text": "فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ",
            "numberInSurah": 5,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 534,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "فأما من أعطى واتقى"
        },
        {
            "number": 6064,
            "text": "وَصَدَّقَ بِٱلۡحُسۡنَىٰ",
            "numberInSurah": 6,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 534,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "وصدق بالحسنى"
        },
        {
            "number": 6065,
            "text": "فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ",
            "numberInSurah": 7,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 534,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "فسنيسره لليسرى"
        },
        {
            "number": 6066,
            "text": "وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ",
            "numberInSurah": 8,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 534,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "وأما من بخل واستغنى"
        },
        {
            "number": 6067,
            "text": "وَكَذَّبَ بِٱلۡحُسۡنَىٰ",
            "numberInSurah": 9,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 534,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "وكذب بالحسنى"
        },
        {
            "number": 6068,
            "text": "فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ",
            "numberInSurah": 10,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 534,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "فسنيسره للعسرى"
        },
        {
            "number": 6069,
            "text": "وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",
            "numberInSurah": 11,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 534,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "وما يغني عنه ماله إذا تردى"
        },
        {
            "number": 6070,
            "text": "إِنَّ عَلَيۡنَا لَلۡهُدَىٰ",
            "numberInSurah": 12,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 534,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "إن علينا للهدى"
        },
        {
            "number": 6071,
            "text": "وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ",
            "numberInSurah": 13,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 534,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "وإن لنا للآخرة والأولى"
        },
        {
            "number": 6072,
            "text": "فَأَنذَرۡتُكُمۡ نَارٗا تَلَظَّىٰ",
            "numberInSurah": 14,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 534,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "فأنذرتكم نارا تلظى"
        },
        {
            "number": 6073,
            "text": "لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى",
            "numberInSurah": 15,
            "juz": 30,
            "manzil": 7,
            "page": 596,
            "ruku": 534,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "لا يصلاها إلا الأشقى"
        },
        {
            "number": 6074,
            "text": "ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ",
            "numberInSurah": 16,
            "juz": 30,
            "manzil": 7,
            "page": 596,
            "ruku": 534,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "الذي كذب وتولى"
        },
        {
            "number": 6075,
            "text": "وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى",
            "numberInSurah": 17,
            "juz": 30,
            "manzil": 7,
            "page": 596,
            "ruku": 534,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "وسيجنبها الأتقى"
        },
        {
            "number": 6076,
            "text": "ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ",
            "numberInSurah": 18,
            "juz": 30,
            "manzil": 7,
            "page": 596,
            "ruku": 534,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "الذي يؤتي ماله يتزكى"
        },
        {
            "number": 6077,
            "text": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزَىٰٓ",
            "numberInSurah": 19,
            "juz": 30,
            "manzil": 7,
            "page": 596,
            "ruku": 534,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "وما لأحد عنده من نعمة تجزى"
        },
        {
            "number": 6078,
            "text": "إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ",
            "numberInSurah": 20,
            "juz": 30,
            "manzil": 7,
            "page": 596,
            "ruku": 534,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "إلا ابتغاء وجه ربه الأعلى"
        },
        {
            "number": 6079,
            "text": "وَلَسَوۡفَ يَرۡضَىٰ",
            "numberInSurah": 21,
            "juz": 30,
            "manzil": 7,
            "page": 596,
            "ruku": 534,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "ولسوف يرضى"
        }
    ]
}