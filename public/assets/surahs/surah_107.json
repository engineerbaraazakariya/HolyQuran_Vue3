{
  "number": 107,
  "name": "سُورَةُ المَاعُونِ",
  "englishName": "Al-Maa'un",
  "englishNameTranslation": "Almsgiving",
  "revelationType": "Meccan",
  "ayahs": [
    {
      "number": 6198,
      "text": "أَرَءَيتَ الَّذى يُكَذِّبُ بِالدّينِ",
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 602,
      "ruku": 549,
      "hizbQuarter": 240,
      "sajda": false,
      "no_Tashkeel_text": "بسم الله الرحمن الرحيم أرأيت الذي يكذب بالدين"
    },
    {
      "number": 6199,
      "text": "فَذٰلِكَ الَّذى يَدُعُّ اليَتيمَ",
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 602,
      "ruku": 549,
      "hizbQuarter": 240,
      "sajda": false,
      "no_Tashkeel_text": "فذلك الذي يدع اليتيم"
    },
    {
      "number": 6200,
      "text": "وَلا يَحُضُّ عَلىٰ طَعامِ المِسكينِ",
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 602,
      "ruku": 549,
      "hizbQuarter": 240,
      "sajda": false,
      "no_Tashkeel_text": "ولا يحض على طعام المسكين"
    },
    {
      "number": 6201,
      "text": "فَوَيلٌ لِلمُصَلّينَ",
