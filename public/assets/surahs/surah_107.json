{
    "number": 107,
    "name": "سُورَةُ المَاعُونِ",
    "englishName": "Al-Maa'un",
    "englishNameTranslation": "Almsgiving",
    "revelationType": "Meccan",
    "ayahs": [
        {
            "number": 6198,
            "text": "أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ",
            "numberInSurah": 1,
            "juz": 30,
            "manzil": 7,
            "page": 602,
            "ruku": 549,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "بسم الله الرحمن الرحيم أرأيت الذي يكذب بالدين"
        },
        {
            "number": 6199,
            "text": "فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ",
            "numberInSurah": 2,
            "juz": 30,
            "manzil": 7,
            "page": 602,
            "ruku": 549,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "فذلك الذي يدع اليتيم"
        },
        {
            "number": 6200,
            "text": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ",
            "numberInSurah": 3,
            "juz": 30,
            "manzil": 7,
            "page": 602,
            "ruku": 549,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "ولا يحض على طعام المسكين"
        },
        {
            "number": 6201,
            "text": "فَوَيۡلٞ لِّلۡمُصَلِّينَ",
            "numberInSurah": 4,
            "juz": 30,
            "manzil": 7,
            "page": 602,
            "ruku": 549,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "فويل للمصلين"
        },
        {
            "number": 6202,
            "text": "ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ",
            "numberInSurah": 5,
            "juz": 30,
            "manzil": 7,
            "page": 602,
            "ruku": 549,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "الذين هم عن صلاتهم ساهون"
        },
        {
            "number": 6203,
            "text": "ٱلَّذِينَ هُمۡ يُرَآءُونَ",
            "numberInSurah": 6,
            "juz": 30,
            "manzil": 7,
            "page": 602,
            "ruku": 549,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "الذين هم يراءون"
        },
        {
            "number": 6204,
            "text": "وَيَمۡنَعُونَ ٱلۡمَاعُونَ",
            "numberInSurah": 7,
            "juz": 30,
            "manzil": 7,
            "page": 602,
            "ruku": 549,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "ويمنعون الماعون"
        }
    ]
