      "juz": 30,
      "manzil": 7,
      "page": 602,
      "ruku": 549,
      "hizbQuarter": 240,
      "sajda": false,
      "no_Tashkeel_text": "فويل للمصلين"
    },
    {
      "number": 6202,
      "text": "الَّذينَ هُم عَن صَلاتِهِم ساهونَ",
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 602,
      "ruku": 549,
      "hizbQuarter": 240,
      "sajda": false,
      "no_Tashkeel_text": "الذين هم عن صلاتهم ساهون"
    },
    {
      "number": 6203,
      "text": "الَّذينَ هُم يُراءونَ",
