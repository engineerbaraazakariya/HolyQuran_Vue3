{
  "number": 74,
  "name": "سُورَةُ المُدَّثِّرِ",
  "englishName": "Al-Muddaththir",
  "englishNameTranslation": "The Cloaked One",
  "revelationType": "Meccan",
  "ayahs": [
    {
      "number": 5496,
      "text": "يـٰأَيُّهَا المُدَّثِّرُ",
      "numberInSurah": 1,
      "juz": 29,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "بسم الله الرحمن الرحيم يا أيها المدثر"
    },
    {
      "number": 5497,
      "text": "قُم فَأَنذِر",
      "numberInSurah": 2,
      "juz": 29,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "قم فأنذر"
    },
    {
      "number": 5498,
      "text": "وَرَبَّكَ فَكَبِّر",
      "numberInSurah": 3,
      "juz": 29,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "وربك فكبر"
    },
    {
      "number": 5499,
      "text": "وَثِيابَكَ فَطَهِّر",
      "numberInSurah": 4,
      "juz": 29,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "وثيابك فطهر"
    },
    {
      "number": 5500,
      "text": "وَالرُّجزَ فَاهجُر",
      "numberInSurah": 5,
      "juz": 29,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "والرجز فاهجر"
    },
    {
      "number": 5501,
      "text": "وَلا تَمنُن تَستَكثِرُ",
      "numberInSurah": 6,
      "juz": 29,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "ولا تمنن تستكثر"
    },
    {
      "number": 5502,
      "text": "وَلِرَبِّكَ فَاصبِر",
      "numberInSurah": 7,
      "juz": 29,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "ولربك فاصبر"
    },
    {
      "number": 5503,
      "text": "فَإِذا نُقِرَ فِى النّاقورِ",
      "numberInSurah": 8,
      "juz": 29,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "فإذا نقر في الناقور"
    },
    {
      "number": 5504,
      "text": "فَذٰلِكَ يَومَئِذٍ يَومٌ عَسيرٌ",
      "numberInSurah": 9,
      "juz": 29,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "فذلك يومئذ يوم عسير"
    },
    {
      "number": 5505,
      "text": "عَلَى الكـٰفِرينَ غَيرُ يَسيرٍ",
      "numberInSurah": 10,
      "juz": 29,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "على الكافرين غير يسير"
    },
    {
      "number": 5506,
      "text": "ذَرنى وَمَن خَلَقتُ وَحيدًا",
      "numberInSurah": 11,
      "juz": 29,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "ذرني ومن خلقت وحيدا"
    },
    {
      "number": 5507,
      "text": "وَجَعَلتُ لَهُ مالًا مَمدودًا",
      "numberInSurah": 12,
      "juz": 29,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "وجعلت له مالا ممدودا"
    },
    {
      "number": 5508,
      "text": "وَبَنينَ شُهودًا",
      "numberInSurah": 13,
      "juz": 29,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "وبنين شهودا"
    },
    {
      "number": 5509,
      "text": "وَمَهَّدتُ لَهُ تَمهيدًا",
      "numberInSurah": 14,
      "juz": 29,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "ومهدت له تمهيدا"
    },
    {
      "number": 5510,
      "text": "ثُمَّ يَطمَعُ أَن أَزيدَ",
      "numberInSurah": 15,
      "juz": 29,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "ثم يطمع أن أزيد"
    },
    {
      "number": 5511,
      "text": "كَلّا ۖ إِنَّهُ كانَ لِـٔايـٰتِنا عَنيدًا",
      "numberInSurah": 16,
      "juz": 29,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "كلا إنه كان لآياتنا عنيدا"
    },
    {
      "number": 5512,
      "text": "سَأُرهِقُهُ صَعودًا",
      "numberInSurah": 17,
      "juz": 29,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "سأرهقه صعودا"
    },
    {
      "number": 5513,
      "text": "إِنَّهُ فَكَّرَ وَقَدَّرَ",
      "numberInSurah": 18,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "إنه فكر وقدر"
    },
    {
      "number": 5514,
      "text": "فَقُتِلَ كَيفَ قَدَّرَ",
      "numberInSurah": 19,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "فقتل كيف قدر"
    },
    {
      "number": 5515,
      "text": "ثُمَّ قُتِلَ كَيفَ قَدَّرَ",
      "numberInSurah": 20,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "ثم قتل كيف قدر"
    },
    {
      "number": 5516,
      "text": "ثُمَّ نَظَرَ",
      "numberInSurah": 21,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "ثم نظر"
    },
    {
      "number": 5517,
      "text": "ثُمَّ عَبَسَ وَبَسَرَ",
      "numberInSurah": 22,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "ثم عبس وبسر"
    },
    {
      "number": 5518,
      "text": "ثُمَّ أَدبَرَ وَاستَكبَرَ",
      "numberInSurah": 23,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "ثم أدبر واستكبر"
    },
    {
      "number": 5519,
      "text": "فَقالَ إِن هـٰذا إِلّا سِحرٌ يُؤثَرُ",
      "numberInSurah": 24,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "فقال إن هذا إلا سحر يؤثر"
    },
    {
      "number": 5520,
      "text": "إِن هـٰذا إِلّا قَولُ البَشَرِ",
      "numberInSurah": 25,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "إن هذا إلا قول البشر"
    },
    {
      "number": 5521,
      "text": "سَأُصليهِ سَقَرَ",
      "numberInSurah": 26,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "سأصليه سقر"
    },
    {
      "number": 5522,
      "text": "وَما أَدرىٰكَ ما سَقَرُ",
      "numberInSurah": 27,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "وما أدراك ما سقر"
    },
    {
      "number": 5523,
      "text": "لا تُبقى وَلا تَذَرُ",
      "numberInSurah": 28,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "لا تبقي ولا تذر"
    },
    {
      "number": 5524,
      "text": "لَوّاحَةٌ لِلبَشَرِ",
      "numberInSurah": 29,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "لواحة للبشر"
    },
    {
      "number": 5525,
      "text": "عَلَيها تِسعَةَ عَشَرَ",
      "numberInSurah": 30,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "عليها تسعة عشر"
    },
    {
      "number": 5526,
      "text": "وَما جَعَلنا أَصحـٰبَ النّارِ إِلّا مَلـٰئِكَةً ۙ وَما جَعَلنا عِدَّتَهُم إِلّا فِتنَةً لِلَّذينَ كَفَروا لِيَستَيقِنَ الَّذينَ أوتُوا الكِتـٰبَ وَيَزدادَ الَّذينَ ءامَنوا إيمـٰنًا ۙ وَلا يَرتابَ الَّذينَ أوتُوا الكِتـٰبَ وَالمُؤمِنونَ ۙ وَلِيَقولَ الَّذينَ فى قُلوبِهِم مَرَضٌ وَالكـٰفِرونَ ماذا أَرادَ اللَّهُ بِهـٰذا مَثَلًا ۚ كَذٰلِكَ يُضِلُّ اللَّهُ مَن يَشاءُ وَيَهدى مَن يَشاءُ ۚ وَما يَعلَمُ جُنودَ رَبِّكَ إِلّا هُوَ ۚ وَما هِىَ إِلّا ذِكرىٰ لِلبَشَرِ",
      "numberInSurah": 31,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "وما جعلنا أصحاب النار إلا ملائكة وما جعلنا عدتهم إلا فتنة للذين كفروا ليستيقن الذين أوتوا الكتاب ويزداد الذين آمنوا إيمانا ولا يرتاب الذين أوتوا الكتاب والمؤمنون وليقول الذين في قلوبهم مرض والكافرون ماذا أراد الله بهذا مثلا كذلك يضل الله من يشاء ويهدي من يشاء وما يعلم جنود ربك إلا هو وما هي إلا ذكرى للبشر"
    },
    {
      "number": 5527,
      "text": "كَلّا وَالقَمَرِ",
      "numberInSurah": 32,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "كلا والقمر"
    },
    {
      "number": 5528,
      "text": "وَالَّيلِ إِذ أَدبَرَ",
      "numberInSurah": 33,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "والليل إذ أدبر"
    },
    {
      "number": 5529,
      "text": "وَالصُّبحِ إِذا أَسفَرَ",
      "numberInSurah": 34,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "والصبح إذا أسفر"
    },
    {
      "number": 5530,
      "text": "إِنَّها لَإِحدَى الكُبَرِ",
      "numberInSurah": 35,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "إنها لإحدى الكبر"
    },
    {
      "number": 5531,
      "text": "نَذيرًا لِلبَشَرِ",
      "numberInSurah": 36,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "نذيرا للبشر"
    },
    {
      "number": 5532,
      "text": "لِمَن شاءَ مِنكُم أَن يَتَقَدَّمَ أَو يَتَأَخَّرَ",
      "numberInSurah": 37,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "لمن شاء منكم أن يتقدم أو يتأخر"
    },
    {
      "number": 5533,
      "text": "كُلُّ نَفسٍ بِما كَسَبَت رَهينَةٌ",
      "numberInSurah": 38,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "كل نفس بما كسبت رهينة"
    },
    {
      "number": 5534,
      "text": "إِلّا أَصحـٰبَ اليَمينِ",
      "numberInSurah": 39,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "إلا أصحاب اليمين"
    },
    {
      "number": 5535,
      "text": "فى جَنّـٰتٍ يَتَساءَلونَ",
      "numberInSurah": 40,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "في جنات يتساءلون"
    },
    {
      "number": 5536,
      "text": "عَنِ المُجرِمينَ",
      "numberInSurah": 41,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "عن المجرمين"
    },
    {
      "number": 5537,
      "text": "ما سَلَكَكُم فى سَقَرَ",
      "numberInSurah": 42,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "ما سلككم في سقر"
    },
    {
      "number": 5538,
      "text": "قالوا لَم نَكُ مِنَ المُصَلّينَ",
      "numberInSurah": 43,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "قالوا لم نك من المصلين"
    },
    {
      "number": 5539,
      "text": "وَلَم نَكُ نُطعِمُ المِسكينَ",
      "numberInSurah": 44,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "ولم نك نطعم المسكين"
    },
    {
      "number": 5540,
      "text": "وَكُنّا نَخوضُ مَعَ الخائِضينَ",
      "numberInSurah": 45,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "وكنا نخوض مع الخائضين"
    },
    {
      "number": 5541,
      "text": "وَكُنّا نُكَذِّبُ بِيَومِ الدّينِ",
      "numberInSurah": 46,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "وكنا نكذب بيوم الدين"
    },
    {
      "number": 5542,
      "text": "حَتّىٰ أَتىٰنَا اليَقينُ",
      "numberInSurah": 47,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "حتى أتانا اليقين"
    },
    {
      "number": 5543,
      "text": "فَما تَنفَعُهُم شَفـٰعَةُ الشّـٰفِعينَ",
      "numberInSurah": 48,
      "juz": 29,
      "manzil": 7,
      "page": 577,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "فما تنفعهم شفاعة الشافعين"
    },
    {
      "number": 5544,
      "text": "فَما لَهُم عَنِ التَّذكِرَةِ مُعرِضينَ",
      "numberInSurah": 49,
      "juz": 29,
      "manzil": 7,
      "page": 577,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "فما لهم عن التذكرة معرضين"
    },
    {
      "number": 5545,
      "text": "كَأَنَّهُم حُمُرٌ مُستَنفِرَةٌ",
      "numberInSurah": 50,
      "juz": 29,
      "manzil": 7,
      "page": 577,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false,
      "no_Tashkeel_text": "كأنهم حمر مستنفرة"
    },
    {
      "number": 5546,
      "text": "فَرَّت مِن قَسوَرَةٍ",
      "numberInSurah": 51,
      "juz": 29,
      "manzil": 7,
      "page": 577,
      "ruku": 511,
