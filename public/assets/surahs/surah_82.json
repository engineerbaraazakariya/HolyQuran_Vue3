{
  "number": 82,
  "name": "سُورَةُ الانفِطَارِ",
  "englishName": "Al-Infitaar",
  "englishNameTranslation": "The Cleaving",
  "revelationType": "Meccan",
  "ayahs": [
    {
      "number": 5830,
      "text": "إِذَا السَّماءُ انفَطَرَت",
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "بسم الله الرحمن الرحيم إذا السماء انفطرت"
    },
    {
      "number": 5831,
      "text": "وَإِذَا الكَواكِبُ انتَثَرَت",
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "وإذا الكواكب انتثرت"
    },
    {
      "number": 5832,
      "text": "وَإِذَا البِحارُ فُجِّرَت",
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "وإذا البحار فجرت"
    },
    {
      "number": 5833,
      "text": "وَإِذَا القُبورُ بُعثِرَت",
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "وإذا القبور بعثرت"
    },
    {
      "number": 5834,
      "text": "عَلِمَت نَفسٌ ما قَدَّمَت وَأَخَّرَت",
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "علمت نفس ما قدمت وأخرت"
    },
    {
      "number": 5835,
      "text": "يـٰأَيُّهَا الإِنسـٰنُ ما غَرَّكَ بِرَبِّكَ الكَريمِ",
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "يا أيها الإنسان ما غرك بربك الكريم"
    },
    {
      "number": 5836,
      "text": "الَّذى خَلَقَكَ فَسَوّىٰكَ فَعَدَلَكَ",
      "numberInSurah": 7,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "الذي خلقك فسواك فعدلك"
    },
    {
      "number": 5837,
      "text": "فى أَىِّ صورَةٍ ما شاءَ رَكَّبَكَ",
      "numberInSurah": 8,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "في أي صورة ما شاء ركبك"
    },
    {
      "number": 5838,
      "text": "كَلّا بَل تُكَذِّبونَ بِالدّينِ",
      "numberInSurah": 9,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "كلا بل تكذبون بالدين"
    },
    {
      "number": 5839,
      "text": "وَإِنَّ عَلَيكُم لَحـٰفِظينَ",
      "numberInSurah": 10,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "وإن عليكم لحافظين"
    },
    {
      "number": 5840,
      "text": "كِرامًا كـٰتِبينَ",
      "numberInSurah": 11,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "كراما كاتبين"
    },
    {
      "number": 5841,
      "text": "يَعلَمونَ ما تَفعَلونَ",
      "numberInSurah": 12,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "يعلمون ما تفعلون"
    },
    {
      "number": 5842,
      "text": "إِنَّ الأَبرارَ لَفى نَعيمٍ",
      "numberInSurah": 13,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "إن الأبرار لفي نعيم"
    },
    {
      "number": 5843,
      "text": "وَإِنَّ الفُجّارَ لَفى جَحيمٍ",
      "numberInSurah": 14,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "وإن الفجار لفي جحيم"
    },
    {
      "number": 5844,
      "text": "يَصلَونَها يَومَ الدّينِ",
      "numberInSurah": 15,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "يصلونها يوم الدين"
    },
    {
      "number": 5845,
      "text": "وَما هُم عَنها بِغائِبينَ",
      "numberInSurah": 16,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "وما هم عنها بغائبين"
    },
    {
      "number": 5846,
      "text": "وَما أَدرىٰكَ ما يَومُ الدّينِ",
      "numberInSurah": 17,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "وما أدراك ما يوم الدين"
    },
    {
      "number": 5847,
      "text": "ثُمَّ ما أَدرىٰكَ ما يَومُ الدّينِ",
      "numberInSurah": 18,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "ثم ما أدراك ما يوم الدين"
    },
    {
      "number": 5848,
      "text": "يَومَ لا تَملِكُ نَفسٌ لِنَفسٍ شَيـًٔا ۖ وَالأَمرُ يَومَئِذٍ لِلَّهِ",
      "numberInSurah": 19,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false,
      "no_Tashkeel_text": "يوم لا تملك نفس لنفس شيئا والأمر يومئذ لله"
    }
  ]
}