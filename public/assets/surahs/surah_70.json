{
    "number": 70,
    "name": "سُورَةُ المَعَارِجِ",
    "englishName": "Al-Ma'aarij",
    "englishNameTranslation": "The Ascending Stairways",
    "revelationType": "Meccan",
    "ayahs": [
        {
            "number": 5376,
            "text": "سَأَلَ سَآئِلُۢ بِعَذَابٖ وَاقِعٖ",
            "numberInSurah": 1,
            "juz": 29,
            "manzil": 7,
            "page": 568,
            "ruku": 502,
            "hizbQuarter": 227,
            "sajda": false,
            "no_Tashkeel_text": "بسم الله الرحمن الرحيم سأل سائل بعذاب واقع"
        },
        {
            "number": 5377,
            "text": "لِّلۡكَٰفِرِينَ لَيۡسَ لَهُۥ دَافِعٞ",
            "numberInSurah": 2,
            "juz": 29,
            "manzil": 7,
            "page": 568,
            "ruku": 502,
            "hizbQuarter": 227,
            "sajda": false,
            "no_Tashkeel_text": "للكافرين ليس له دافع"
        },
        {
            "number": 5378,
            "text": "مِّنَ ٱللَّهِ ذِي ٱلۡمَعَارِجِ",
            "numberInSurah": 3,
            "juz": 29,
            "manzil": 7,
            "page": 568,
            "ruku": 502,
            "hizbQuarter": 227,
            "sajda": false,
            "no_Tashkeel_text": "من الله ذي المعارج"
        },
        {
            "number": 5379,
            "text": "تَعۡرُجُ ٱلۡمَلَـٰٓئِكَةُ وَٱلرُّوحُ إِلَيۡهِ فِي يَوۡمٖ كَانَ مِقۡدَارُهُۥ خَمۡسِينَ أَلۡفَ سَنَةٖ",
            "numberInSurah": 4,
            "juz": 29,
            "manzil": 7,
            "page": 568,
            "ruku": 502,
            "hizbQuarter": 227,
            "sajda": false,
            "no_Tashkeel_text": "تعرج الملائكة والروح إليه في يوم كان مقداره خمسين ألف سنة"
        },
        {
            "number": 5380,
            "text": "فَٱصۡبِرۡ صَبۡرٗا جَمِيلًا",
            "numberInSurah": 5,
            "juz": 29,
            "manzil": 7,
            "page": 568,
            "ruku": 502,
            "hizbQuarter": 227,
            "sajda": false,
            "no_Tashkeel_text": "فاصبر صبرا جميلا"
        },
        {
            "number": 5381,
            "text": "إِنَّهُمۡ يَرَوۡنَهُۥ بَعِيدٗا",
            "numberInSurah": 6,
            "juz": 29,
            "manzil": 7,
            "page": 568,
            "ruku": 502,
            "hizbQuarter": 227,
            "sajda": false,
            "no_Tashkeel_text": "إنهم يرونه بعيدا"
        },
        {
            "number": 5382,
            "text": "وَنَرَىٰهُ قَرِيبٗا",
            "numberInSurah": 7,
            "juz": 29,
            "manzil": 7,
            "page": 568,
            "ruku": 502,
            "hizbQuarter": 227,
            "sajda": false,
            "no_Tashkeel_text": "ونراه قريبا"
        },
        {
            "number": 5383,
            "text": "يَوۡمَ تَكُونُ ٱلسَّمَآءُ كَٱلۡمُهۡلِ",
            "numberInSurah": 8,
            "juz": 29,
            "manzil": 7,
            "page": 568,
            "ruku": 502,
            "hizbQuarter": 227,
            "sajda": false,
            "no_Tashkeel_text": "يوم تكون السماء كالمهل"
        },
        {
            "number": 5384,
            "text": "وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ",
            "numberInSurah": 9,
            "juz": 29,
            "manzil": 7,
            "page": 568,
            "ruku": 502,
            "hizbQuarter": 227,
            "sajda": false,
            "no_Tashkeel_text": "وتكون الجبال كالعهن"
        },
        {
            "number": 5385,
            "text": "وَلَا يَسۡـَٔلُ حَمِيمٌ حَمِيمٗا",
            "numberInSurah": 10,
            "juz": 29,
            "manzil": 7,
            "page": 568,
            "ruku": 502,
            "hizbQuarter": 227,
            "sajda": false,
            "no_Tashkeel_text": "ولا يسأل حميم حميما"
        },
        {
            "number": 5386,
            "text": "يُبَصَّرُونَهُمۡۚ يَوَدُّ ٱلۡمُجۡرِمُ لَوۡ يَفۡتَدِي مِنۡ عَذَابِ يَوۡمِئِذِۭ بِبَنِيهِ",
            "numberInSurah": 11,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 227,
            "sajda": false,
            "no_Tashkeel_text": "يبصرونهم يود المجرم لو يفتدي من عذاب يومئذ ببنيه"
        },
        {
            "number": 5387,
            "text": "وَصَٰحِبَتِهِۦ وَأَخِيهِ",
            "numberInSurah": 12,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 227,
            "sajda": false,
            "no_Tashkeel_text": "وصاحبته وأخيه"
        },
        {
            "number": 5388,
            "text": "وَفَصِيلَتِهِ ٱلَّتِي تُـٔۡوِيهِ",
            "numberInSurah": 13,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 227,
            "sajda": false,
            "no_Tashkeel_text": "وفصيلته التي تؤويه"
        },
        {
            "number": 5389,
            "text": "وَمَن فِي ٱلۡأَرۡضِ جَمِيعٗا ثُمَّ يُنجِيهِ",
            "numberInSurah": 14,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 227,
            "sajda": false,
            "no_Tashkeel_text": "ومن في الأرض جميعا ثم ينجيه"
        },
        {
            "number": 5390,
            "text": "كَلَّآۖ إِنَّهَا لَظَىٰ",
            "numberInSurah": 15,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 227,
            "sajda": false,
            "no_Tashkeel_text": "كلا إنها لظى"
        },
        {
            "number": 5391,
            "text": "نَزَّاعَةٗ لِّلشَّوَىٰ",
            "numberInSurah": 16,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 227,
            "sajda": false,
            "no_Tashkeel_text": "نزاعة للشوى"
        },
        {
            "number": 5392,
            "text": "تَدۡعُواْ مَنۡ أَدۡبَرَ وَتَوَلَّىٰ",
            "numberInSurah": 17,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 227,
            "sajda": false,
            "no_Tashkeel_text": "تدعو من أدبر وتولى"
        },
        {
            "number": 5393,
            "text": "وَجَمَعَ فَأَوۡعَىٰٓ",
            "numberInSurah": 18,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 227,
            "sajda": false,
            "no_Tashkeel_text": "وجمع فأوعى"
        },
        {
            "number": 5394,
            "text": "۞إِنَّ ٱلۡإِنسَٰنَ خُلِقَ هَلُوعًا",
            "numberInSurah": 19,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "إن الإنسان خلق هلوعا"
        },
        {
            "number": 5395,
            "text": "إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعٗا",
            "numberInSurah": 20,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "إذا مسه الشر جزوعا"
        },
        {
            "number": 5396,
            "text": "وَإِذَا مَسَّهُ ٱلۡخَيۡرُ مَنُوعًا",
            "numberInSurah": 21,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "وإذا مسه الخير منوعا"
        },
        {
            "number": 5397,
            "text": "إِلَّا ٱلۡمُصَلِّينَ",
            "numberInSurah": 22,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "إلا المصلين"
        },
        {
            "number": 5398,
            "text": "ٱلَّذِينَ هُمۡ عَلَىٰ صَلَاتِهِمۡ دَآئِمُونَ",
            "numberInSurah": 23,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "الذين هم على صلاتهم دائمون"
        },
        {
            "number": 5399,
            "text": "وَٱلَّذِينَ فِيٓ أَمۡوَٰلِهِمۡ حَقّٞ مَّعۡلُومٞ",
            "numberInSurah": 24,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "والذين في أموالهم حق معلوم"
        },
        {
            "number": 5400,
            "text": "لِّلسَّآئِلِ وَٱلۡمَحۡرُومِ",
            "numberInSurah": 25,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "للسائل والمحروم"
        },
        {
            "number": 5401,
            "text": "وَٱلَّذِينَ يُصَدِّقُونَ بِيَوۡمِ ٱلدِّينِ",
            "numberInSurah": 26,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "والذين يصدقون بيوم الدين"
        },
        {
            "number": 5402,
            "text": "وَٱلَّذِينَ هُم مِّنۡ عَذَابِ رَبِّهِم مُّشۡفِقُونَ",
            "numberInSurah": 27,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "والذين هم من عذاب ربهم مشفقون"
        },
        {
            "number": 5403,
            "text": "إِنَّ عَذَابَ رَبِّهِمۡ غَيۡرُ مَأۡمُونٖ",
            "numberInSurah": 28,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "إن عذاب ربهم غير مأمون"
        },
        {
            "number": 5404,
            "text": "وَٱلَّذِينَ هُمۡ لِفُرُوجِهِمۡ حَٰفِظُونَ",
            "numberInSurah": 29,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "والذين هم لفروجهم حافظون"
        },
        {
            "number": 5405,
            "text": "إِلَّا عَلَىٰٓ أَزۡوَٰجِهِمۡ أَوۡ مَا مَلَكَتۡ أَيۡمَٰنُهُمۡ فَإِنَّهُمۡ غَيۡرُ مَلُومِينَ",
            "numberInSurah": 30,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "إلا على أزواجهم أو ما ملكت أيمانهم فإنهم غير ملومين"
        },
        {
            "number": 5406,
            "text": "فَمَنِ ٱبۡتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُوْلَـٰٓئِكَ هُمُ ٱلۡعَادُونَ",
            "numberInSurah": 31,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "فمن ابتغى وراء ذلك فأولئك هم العادون"
        },
        {
            "number": 5407,
            "text": "وَٱلَّذِينَ هُمۡ لِأَمَٰنَٰتِهِمۡ وَعَهۡدِهِمۡ رَٰعُونَ",
            "numberInSurah": 32,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "والذين هم لأماناتهم وعهدهم راعون"
        },
        {
            "number": 5408,
            "text": "وَٱلَّذِينَ هُم بِشَهَٰدَٰتِهِمۡ قَآئِمُونَ",
            "numberInSurah": 33,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "والذين هم بشهاداتهم قائمون"
        },
        {
            "number": 5409,
            "text": "وَٱلَّذِينَ هُمۡ عَلَىٰ صَلَاتِهِمۡ يُحَافِظُونَ",
            "numberInSurah": 34,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "والذين هم على صلاتهم يحافظون"
        },
        {
            "number": 5410,
            "text": "أُوْلَـٰٓئِكَ فِي جَنَّـٰتٖ مُّكۡرَمُونَ",
            "numberInSurah": 35,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 502,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "أولئك في جنات مكرمون"
        },
        {
            "number": 5411,
            "text": "فَمَالِ ٱلَّذِينَ كَفَرُواْ قِبَلَكَ مُهۡطِعِينَ",
            "numberInSurah": 36,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 503,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "فمال الذين كفروا قبلك مهطعين"
        },
        {
            "number": 5412,
            "text": "عَنِ ٱلۡيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ",
            "numberInSurah": 37,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 503,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "عن اليمين وعن الشمال عزين"
        },
        {
            "number": 5413,
            "text": "أَيَطۡمَعُ كُلُّ ٱمۡرِيٕٖ مِّنۡهُمۡ أَن يُدۡخَلَ جَنَّةَ نَعِيمٖ",
            "numberInSurah": 38,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 503,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "أيطمع كل امرئ منهم أن يدخل جنة نعيم"
        },
        {
            "number": 5414,
            "text": "كَلَّآۖ إِنَّا خَلَقۡنَٰهُم مِّمَّا يَعۡلَمُونَ",
            "numberInSurah": 39,
            "juz": 29,
            "manzil": 7,
            "page": 569,
            "ruku": 503,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "كلا إنا خلقناهم مما يعلمون"
        },
        {
            "number": 5415,
            "text": "فَلَآ أُقۡسِمُ بِرَبِّ ٱلۡمَشَٰرِقِ وَٱلۡمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ",
            "numberInSurah": 40,
            "juz": 29,
            "manzil": 7,
            "page": 570,
            "ruku": 503,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "فلا أقسم برب المشارق والمغارب إنا لقادرون"
        },
        {
            "number": 5416,
            "text": "عَلَىٰٓ أَن نُّبَدِّلَ خَيۡرٗا مِّنۡهُمۡ وَمَا نَحۡنُ بِمَسۡبُوقِينَ",
            "numberInSurah": 41,
            "juz": 29,
            "manzil": 7,
            "page": 570,
            "ruku": 503,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "على أن نبدل خيرا منهم وما نحن بمسبوقين"
        },
        {
            "number": 5417,
            "text": "فَذَرۡهُمۡ يَخُوضُواْ وَيَلۡعَبُواْ حَتَّىٰ يُلَٰقُواْ يَوۡمَهُمُ ٱلَّذِي يُوعَدُونَ",
            "numberInSurah": 42,
            "juz": 29,
            "manzil": 7,
            "page": 570,
            "ruku": 503,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "فذرهم يخوضوا ويلعبوا حتى يلاقوا يومهم الذي يوعدون"
        },
        {
            "number": 5418,
            "text": "يَوۡمَ يَخۡرُجُونَ مِنَ ٱلۡأَجۡدَاثِ سِرَاعٗا كَأَنَّهُمۡ إِلَىٰ نُصُبٖ يُوفِضُونَ",
            "numberInSurah": 43,
            "juz": 29,
            "manzil": 7,
            "page": 570,
            "ruku": 503,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "يوم يخرجون من الأجداث سراعا كأنهم إلى نصب يوفضون"
        },
        {
            "number": 5419,
            "text": "خَٰشِعَةً أَبۡصَٰرُهُمۡ تَرۡهَقُهُمۡ ذِلَّةٞۚ ذَٰلِكَ ٱلۡيَوۡمُ ٱلَّذِي كَانُواْ يُوعَدُونَ",
            "numberInSurah": 44,
            "juz": 29,
            "manzil": 7,
            "page": 570,
            "ruku": 503,
            "hizbQuarter": 228,
            "sajda": false,
            "no_Tashkeel_text": "خاشعة أبصارهم ترهقهم ذلة ذلك اليوم الذي كانوا يوعدون"
        }
    ]
}