{
    "number": 87,
    "name": "سُورَةُ الأَعۡلَىٰ",
    "englishName": "Al-A'laa",
    "englishNameTranslation": "The Most High",
    "revelationType": "Meccan",
    "ayahs": [
        {
            "number": 5949,
            "text": "سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى",
            "numberInSurah": 1,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 529,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "بسم الله الرحمن الرحيم سبح اسم ربك الأعلى"
        },
        {
            "number": 5950,
            "text": "ٱلَّذِي خَلَقَ فَسَوَّىٰ",
            "numberInSurah": 2,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 529,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "الذي خلق فسوى"
        },
        {
            "number": 5951,
            "text": "وَٱلَّذِي قَدَّرَ فَهَدَىٰ",
            "numberInSurah": 3,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 529,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "والذي قدر فهدى"
        },
        {
            "number": 5952,
            "text": "وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ",
            "numberInSurah": 4,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 529,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "والذي أخرج المرعى"
        },
        {
            "number": 5953,
            "text": "فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ",
            "numberInSurah": 5,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 529,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "فجعله غثاء أحوى"
        },
        {
            "number": 5954,
            "text": "سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ",
            "numberInSurah": 6,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 529,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "سنقرئك فلا تنسى"
        },
        {
            "number": 5955,
            "text": "إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ",
            "numberInSurah": 7,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 529,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "إلا ما شاء الله إنه يعلم الجهر وما يخفى"
        },
        {
            "number": 5956,
            "text": "وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ",
            "numberInSurah": 8,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 529,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "ونيسرك لليسرى"
        },
        {
            "number": 5957,
            "text": "فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ",
            "numberInSurah": 9,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 529,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "فذكر إن نفعت الذكرى"
        },
        {
            "number": 5958,
            "text": "سَيَذَّكَّرُ مَن يَخۡشَىٰ",
            "numberInSurah": 10,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 529,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "سيذكر من يخشى"
        },
        {
            "number": 5959,
            "text": "وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى",
            "numberInSurah": 11,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 529,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "ويتجنبها الأشقى"
        },
        {
            "number": 5960,
            "text": "ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ",
            "numberInSurah": 12,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 529,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "الذي يصلى النار الكبرى"
        },
        {
            "number": 5961,
            "text": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ",
            "numberInSurah": 13,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 529,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "ثم لا يموت فيها ولا يحيى"
        },
        {
            "number": 5962,
            "text": "قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ",
            "numberInSurah": 14,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 529,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "قد أفلح من تزكى"
        },
        {
            "number": 5963,
            "text": "وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ",
            "numberInSurah": 15,
            "juz": 30,
            "manzil": 7,
            "page": 591,
            "ruku": 529,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "وذكر اسم ربه فصلى"
        },
        {
            "number": 5964,
            "text": "بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا",
            "numberInSurah": 16,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 529,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "بل تؤثرون الحياة الدنيا"
        },
        {
            "number": 5965,
            "text": "وَٱلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقَىٰٓ",
            "numberInSurah": 17,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 529,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "والآخرة خير وأبقى"
        },
        {
            "number": 5966,
            "text": "إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ",
            "numberInSurah": 18,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 529,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "إن هذا لفي الصحف الأولى"
        },
        {
            "number": 5967,
            "text": "صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ",
            "numberInSurah": 19,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 529,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "صحف إبراهيم وموسى"
        }
    ]
}