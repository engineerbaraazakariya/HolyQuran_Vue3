{
    "number": 97,
    "name": "سُورَةُ القَدۡرِ",
    "englishName": "Al-Qadr",
    "englishNameTranslation": "The Power, Fate",
    "revelationType": "Meccan",
    "ayahs": [
        {
            "number": 6126,
            "text": "إِنَّآ أَنزَلۡنَٰهُ فِي لَيۡلَةِ ٱلۡقَدۡرِ",
            "numberInSurah": 1,
            "juz": 30,
            "manzil": 7,
            "page": 598,
            "ruku": 539,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "بسم الله الرحمن الرحيم إنا أنزلناه في ليلة القدر"
        },
        {
            "number": 6127,
            "text": "وَمَآ أَدۡرَىٰكَ مَا لَيۡلَةُ ٱلۡقَدۡرِ",
            "numberInSurah": 2,
            "juz": 30,
            "manzil": 7,
            "page": 598,
            "ruku": 539,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "وما أدراك ما ليلة القدر"
        },
        {
            "number": 6128,
            "text": "لَيۡلَةُ ٱلۡقَدۡرِ خَيۡرٞ مِّنۡ أَلۡفِ شَهۡرٖ",
            "numberInSurah": 3,
            "juz": 30,
            "manzil": 7,
            "page": 598,
            "ruku": 539,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "ليلة القدر خير من ألف شهر"
        },
        {
            "number": 6129,
            "text": "تَنَزَّلُ ٱلۡمَلَـٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذۡنِ رَبِّهِم مِّن كُلِّ أَمۡرٖ",
            "numberInSurah": 4,
            "juz": 30,
            "manzil": 7,
            "page": 598,
            "ruku": 539,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "تنزل الملائكة والروح فيها بإذن ربهم من كل أمر"
        },
        {
            "number": 6130,
            "text": "سَلَٰمٌ هِيَ حَتَّىٰ مَطۡلَعِ ٱلۡفَجۡرِ",
            "numberInSurah": 5,
            "juz": 30,
