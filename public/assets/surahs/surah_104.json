{
    "number": 104,
    "name": "سُورَةُ الهُمَزَةِ",
    "englishName": "Al-Humaza",
    "englishNameTranslation": "The Traducer",
    "revelationType": "Meccan",
    "ayahs": [
        {
            "number": 6180,
            "text": "وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ",
            "numberInSurah": 1,
            "juz": 30,
            "manzil": 7,
            "page": 601,
            "ruku": 546,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "بسم الله الرحمن الرحيم ويل لكل همزة لمزة"
        },
        {
            "number": 6181,
            "text": "ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ",
            "numberInSurah": 2,
            "juz": 30,
            "manzil": 7,
            "page": 601,
            "ruku": 546,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "الذي جمع مالا وعدده"
        },
        {
            "number": 6182,
            "text": "يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ",
            "numberInSurah": 3,
            "juz": 30,
            "manzil": 7,
            "page": 601,
            "ruku": 546,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "يحسب أن ماله أخلده"
        },
        {
            "number": 6183,
            "text": "كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ",
            "numberInSurah": 4,
            "juz": 30,
            "manzil": 7,
            "page": 601,
            "ruku": 546,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "كلا لينبذن في الحطمة"
        },
        {
            "number": 6184,
            "text": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ",
            "numberInSurah": 5,
            "juz": 30,
            "manzil": 7,
            "page": 601,
            "ruku": 546,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "وما أدراك ما الحطمة"
        },
        {
            "number": 6185,
            "text": "نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ",
            "numberInSurah": 6,
            "juz": 30,
            "manzil": 7,
            "page": 601,
            "ruku": 546,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "نار الله الموقدة"
        },
        {
            "number": 6186,
            "text": "ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ",
            "numberInSurah": 7,
            "juz": 30,
            "manzil": 7,
            "page": 601,
            "ruku": 546,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "التي تطلع على الأفئدة"
        },
        {
            "number": 6187,
            "text": "إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ",
            "numberInSurah": 8,
            "juz": 30,
            "manzil": 7,
            "page": 601,
            "ruku": 546,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "إنها عليهم مؤصدة"
        },
        {
            "number": 6188,
            "text": "فِي عَمَدٖ مُّمَدَّدَةِۭ",
            "numberInSurah": 9,
            "juz": 30,
            "manzil": 7,
            "page": 601,
            "ruku": 546,
            "hizbQuarter": 240,
            "sajda": false,
            "no_Tashkeel_text": "في عمد ممددة"
        }
    ]
}