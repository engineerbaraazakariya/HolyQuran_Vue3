{
    "number": 55,
    "name": "سُورَةُ الرَّحۡمَٰن",
    "englishName": "Ar-Rahmaan",
    "englishNameTranslation": "The Beneficent",
    "revelationType": "Medinan",
    "ayahs": [
        {
            "number": 4902,
            "text": "ٱلرَّحۡمَٰنُ",
            "numberInSurah": 1,
            "juz": 27,
            "manzil": 7,
            "page": 531,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "بسم الله الرحمن الرحيم الرحمن"
        },
        {
            "number": 4903,
            "text": "عَلَّمَ ٱلۡقُرۡءَانَ",
            "numberInSurah": 2,
            "juz": 27,
            "manzil": 7,
            "page": 531,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "علم القرآن"
        },
        {
            "number": 4904,
            "text": "خَلَقَ ٱلۡإِنسَٰنَ",
            "numberInSurah": 3,
            "juz": 27,
            "manzil": 7,
            "page": 531,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "خلق الإنسان"
        },
        {
            "number": 4905,
            "text": "عَلَّمَهُ ٱلۡبَيَانَ",
            "numberInSurah": 4,
            "juz": 27,
            "manzil": 7,
            "page": 531,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "علمه البيان"
        },
        {
            "number": 4906,
            "text": "ٱلشَّمۡسُ وَٱلۡقَمَرُ بِحُسۡبَانٖ",
            "numberInSurah": 5,
            "juz": 27,
            "manzil": 7,
            "page": 531,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "الشمس والقمر بحسبان"
        },
        {
            "number": 4907,
            "text": "وَٱلنَّجۡمُ وَٱلشَّجَرُ يَسۡجُدَانِ",
            "numberInSurah": 6,
            "juz": 27,
            "manzil": 7,
            "page": 531,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "والنجم والشجر يسجدان"
        },
        {
            "number": 4908,
            "text": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلۡمِيزَانَ",
            "numberInSurah": 7,
            "juz": 27,
            "manzil": 7,
            "page": 531,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "والسماء رفعها ووضع الميزان"
        },
        {
            "number": 4909,
            "text": "أَلَّا تَطۡغَوۡاْ فِي ٱلۡمِيزَانِ",
            "numberInSurah": 8,
            "juz": 27,
            "manzil": 7,
            "page": 531,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "ألا تطغوا في الميزان"
        },
        {
            "number": 4910,
            "text": "وَأَقِيمُواْ ٱلۡوَزۡنَ بِٱلۡقِسۡطِ وَلَا تُخۡسِرُواْ ٱلۡمِيزَانَ",
            "numberInSurah": 9,
            "juz": 27,
            "manzil": 7,
            "page": 531,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "وأقيموا الوزن بالقسط ولا تخسروا الميزان"
        },
        {
            "number": 4911,
            "text": "وَٱلۡأَرۡضَ وَضَعَهَا لِلۡأَنَامِ",
            "numberInSurah": 10,
            "juz": 27,
            "manzil": 7,
            "page": 531,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "والأرض وضعها للأنام"
        },
        {
            "number": 4912,
            "text": "فِيهَا فَٰكِهَةٞ وَٱلنَّخۡلُ ذَاتُ ٱلۡأَكۡمَامِ",
            "numberInSurah": 11,
            "juz": 27,
            "manzil": 7,
            "page": 531,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "فيها فاكهة والنخل ذات الأكمام"
        },
        {
            "number": 4913,
            "text": "وَٱلۡحَبُّ ذُو ٱلۡعَصۡفِ وَٱلرَّيۡحَانُ",
            "numberInSurah": 12,
            "juz": 27,
            "manzil": 7,
            "page": 531,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "والحب ذو العصف والريحان"
        },
        {
            "number": 4914,
            "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
            "numberInSurah": 13,
            "juz": 27,
            "manzil": 7,
            "page": 531,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "فبأي آلاء ربكما تكذبان"
        },
        {
            "number": 4915,
            "text": "خَلَقَ ٱلۡإِنسَٰنَ مِن صَلۡصَٰلٖ كَٱلۡفَخَّارِ",
            "numberInSurah": 14,
            "juz": 27,
            "manzil": 7,
            "page": 531,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "خلق الإنسان من صلصال كالفخار"
        },
        {
            "number": 4916,
            "text": "وَخَلَقَ ٱلۡجَآنَّ مِن مَّارِجٖ مِّن نَّارٖ",
            "numberInSurah": 15,
            "juz": 27,
            "manzil": 7,
            "page": 531,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "وخلق الجان من مارج من نار"
        },
        {
            "number": 4917,
            "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
            "numberInSurah": 16,
            "juz": 27,
            "manzil": 7,
            "page": 531,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "فبأي آلاء ربكما تكذبان"
        },
        {
            "number": 4918,
            "text": "رَبُّ ٱلۡمَشۡرِقَيۡنِ وَرَبُّ ٱلۡمَغۡرِبَيۡنِ",
            "numberInSurah": 17,
            "juz": 27,
            "manzil": 7,
            "page": 532,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "رب المشرقين ورب المغربين"
        },
        {
            "number": 4919,
            "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
            "numberInSurah": 18,
            "juz": 27,
            "manzil": 7,
            "page": 532,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "فبأي آلاء ربكما تكذبان"
        },
        {
            "number": 4920,
            "text": "مَرَجَ ٱلۡبَحۡرَيۡنِ يَلۡتَقِيَانِ",
            "numberInSurah": 19,
            "juz": 27,
            "manzil": 7,
            "page": 532,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "مرج البحرين يلتقيان"
        },
        {
            "number": 4921,
            "text": "بَيۡنَهُمَا بَرۡزَخٞ لَّا يَبۡغِيَانِ",
            "numberInSurah": 20,
            "juz": 27,
            "manzil": 7,
            "page": 532,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "بينهما برزخ لا يبغيان"
        },
        {
            "number": 4922,
            "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
            "numberInSurah": 21,
            "juz": 27,
            "manzil": 7,
            "page": 532,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "فبأي آلاء ربكما تكذبان"
        },
        {
            "number": 4923,
            "text": "يَخۡرُجُ مِنۡهُمَا ٱللُّؤۡلُؤُ وَٱلۡمَرۡجَانُ",
            "numberInSurah": 22,
            "juz": 27,
            "manzil": 7,
            "page": 532,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "يخرج منهما اللؤلؤ والمرجان"
        },
        {
            "number": 4924,
            "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
            "numberInSurah": 23,
            "juz": 27,
            "manzil": 7,
            "page": 532,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "فبأي آلاء ربكما تكذبان"
        },
        {
            "number": 4925,
            "text": "وَلَهُ ٱلۡجَوَارِ ٱلۡمُنشَـَٔاتُ فِي ٱلۡبَحۡرِ كَٱلۡأَعۡلَٰمِ",
            "numberInSurah": 24,
            "juz": 27,
            "manzil": 7,
            "page": 532,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "وله الجوار المنشآت في البحر كالأعلام"
        },
        {
            "number": 4926,
            "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
            "numberInSurah": 25,
            "juz": 27,
            "manzil": 7,
            "page": 532,
            "ruku": 466,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "فبأي آلاء ربكما تكذبان"
        },
        {
            "number": 4927,
            "text": "كُلُّ مَنۡ عَلَيۡهَا فَانٖ",
            "numberInSurah": 26,
            "juz": 27,
            "manzil": 7,
            "page": 532,
            "ruku": 467,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "كل من عليها فان"
        },
        {
            "number": 4928,
            "text": "وَيَبۡقَىٰ وَجۡهُ رَبِّكَ ذُو ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ",
            "numberInSurah": 27,
            "juz": 27,
            "manzil": 7,
            "page": 532,
            "ruku": 467,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "ويبقى وجه ربك ذو الجلال والإكرام"
        },
        {
            "number": 4929,
            "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
            "numberInSurah": 28,
            "juz": 27,
            "manzil": 7,
            "page": 532,
            "ruku": 467,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "فبأي آلاء ربكما تكذبان"
        },
        {
            "number": 4930,
            "text": "يَسۡـَٔلُهُۥ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ كُلَّ يَوۡمٍ هُوَ فِي شَأۡنٖ",
            "numberInSurah": 29,
            "juz": 27,
            "manzil": 7,
            "page": 532,
            "ruku": 467,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "يسأله من في السماوات والأرض كل يوم هو في شأن"
        },
        {
            "number": 4931,
            "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
            "numberInSurah": 30,
            "juz": 27,
            "manzil": 7,
            "page": 532,
            "ruku": 467,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "فبأي آلاء ربكما تكذبان"
        },
        {
            "number": 4932,
            "text": "سَنَفۡرُغُ لَكُمۡ أَيُّهَ ٱلثَّقَلَانِ",
            "numberInSurah": 31,
            "juz": 27,
            "manzil": 7,
            "page": 532,
            "ruku": 467,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "سنفرغ لكم أيه الثقلان"
        },
        {
            "number": 4933,
            "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
            "numberInSurah": 32,
            "juz": 27,
            "manzil": 7,
            "page": 532,
            "ruku": 467,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "فبأي آلاء ربكما تكذبان"
        },
        {
            "number": 4934,
            "text": "يَٰمَعۡشَرَ ٱلۡجِنِّ وَٱلۡإِنسِ إِنِ ٱسۡتَطَعۡتُمۡ أَن تَنفُذُواْ مِنۡ أَقۡطَارِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ فَٱنفُذُواْۚ لَا تَنفُذُونَ إِلَّا بِسُلۡطَٰنٖ",
            "numberInSurah": 33,
            "juz": 27,
            "manzil": 7,
            "page": 532,
            "ruku": 467,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "يا معشر الجن والإنس إن استطعتم أن تنفذوا من أقطار السماوات والأرض فانفذوا لا تنفذون إلا بسلطان"
        },
        {
            "number": 4935,
            "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
            "numberInSurah": 34,
            "juz": 27,
            "manzil": 7,
            "page": 532,
            "ruku": 467,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "فبأي آلاء ربكما تكذبان"
        },
        {
            "number": 4936,
            "text": "يُرۡسَلُ عَلَيۡكُمَا شُوَاظٞ مِّن نَّارٖ وَنُحَاسٞ فَلَا تَنتَصِرَانِ",
            "numberInSurah": 35,
            "juz": 27,
            "manzil": 7,
            "page": 532,
            "ruku": 467,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "يرسل عليكما شواظ من نار ونحاس فلا تنتصران"
        },
        {
            "number": 4937,
            "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
            "numberInSurah": 36,
            "juz": 27,
            "manzil": 7,
            "page": 532,
            "ruku": 467,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "فبأي آلاء ربكما تكذبان"
        },
        {
            "number": 4938,
            "text": "فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتۡ وَرۡدَةٗ كَٱلدِّهَانِ",
            "numberInSurah": 37,
            "juz": 27,
            "manzil": 7,
            "page": 532,
            "ruku": 467,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "فإذا انشقت السماء فكانت وردة كالدهان"
        },
        {
            "number": 4939,
            "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
            "numberInSurah": 38,
            "juz": 27,
            "manzil": 7,
            "page": 532,
            "ruku": 467,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "فبأي آلاء ربكما تكذبان"
        },
        {
            "number": 4940,
            "text": "فَيَوۡمَئِذٖ لَّا يُسۡـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٞ وَلَا جَآنّٞ",
            "numberInSurah": 39,
            "juz": 27,
            "manzil": 7,
            "page": 532,
            "ruku": 467,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "فيومئذ لا يسأل عن ذنبه إنس ولا جان"
        },
        {
            "number": 4941,
            "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
            "numberInSurah": 40,
            "juz": 27,
            "manzil": 7,
            "page": 532,
            "ruku": 467,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "فبأي آلاء ربكما تكذبان"
        },
        {
            "number": 4942,
            "text": "يُعۡرَفُ ٱلۡمُجۡرِمُونَ بِسِيمَٰهُمۡ فَيُؤۡخَذُ بِٱلنَّوَٰصِي وَٱلۡأَقۡدَامِ",
            "numberInSurah": 41,
            "juz": 27,
            "manzil": 7,
            "page": 533,
            "ruku": 467,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "يعرف المجرمون بسيماهم فيؤخذ بالنواصي والأقدام"
        },
        {
            "number": 4943,
            "text": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
            "numberInSurah": 42,
            "juz": 27,
            "manzil": 7,
            "page": 533,
            "ruku": 467,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "فبأي آلاء ربكما تكذبان"
        },
        {
            "number": 4944,
            "text": "هَٰذِهِۦ جَهَنَّمُ ٱلَّتِي يُكَذِّبُ بِهَا ٱلۡمُجۡرِمُونَ",
            "numberInSurah": 43,
            "juz": 27,
            "manzil": 7,
            "page": 533,
            "ruku": 467,
            "hizbQuarter": 213,
            "sajda": false,
            "no_Tashkeel_text": "هذه جهنم التي يكذب بها المجرمون"
        },
        {
            "number": 4945,
            "text": "يَطُوفُونَ بَيۡنَهَا وَبَيۡنَ حَمِيمٍ ءَانٖ",
            "numberInSurah": 44,
            "juz": 27,
            "manzil": 7,
            "page": 533,
            "ruku": 467,
