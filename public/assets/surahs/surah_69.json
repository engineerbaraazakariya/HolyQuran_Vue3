{
  "number": 69,
  "name": "سُورَةُ الحَاقَّةِ",
  "englishName": "Al-Haaqqa",
  "englishNameTranslation": "The Reality",
  "revelationType": "Meccan",
  "ayahs": [
    {
      "number": 5324,
      "text": "الحاقَّةُ",
      "numberInSurah": 1,
      "juz": 29,
      "manzil": 7,
      "page": 566,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "بسم الله الرحمن الرحيم الحاقة"
    },
    {
      "number": 5325,
      "text": "مَا الحاقَّةُ",
      "numberInSurah": 2,
      "juz": 29,
      "manzil": 7,
      "page": 566,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "ما الحاقة"
    },
    {
      "number": 5326,
      "text": "وَما أَدرىٰكَ مَا الحاقَّةُ",
      "numberInSurah": 3,
      "juz": 29,
      "manzil": 7,
      "page": 566,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "وما أدراك ما الحاقة"
    },
    {
      "number": 5327,
      "text": "كَذَّبَت ثَمودُ وَعادٌ بِالقارِعَةِ",
      "numberInSurah": 4,
      "juz": 29,
      "manzil": 7,
      "page": 566,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "كذبت ثمود وعاد بالقارعة"
    },
    {
      "number": 5328,
      "text": "فَأَمّا ثَمودُ فَأُهلِكوا بِالطّاغِيَةِ",
      "numberInSurah": 5,
      "juz": 29,
      "manzil": 7,
      "page": 566,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "فأما ثمود فأهلكوا بالطاغية"
    },
    {
      "number": 5329,
      "text": "وَأَمّا عادٌ فَأُهلِكوا بِريحٍ صَرصَرٍ عاتِيَةٍ",
      "numberInSurah": 6,
      "juz": 29,
      "manzil": 7,
      "page": 566,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "وأما عاد فأهلكوا بريح صرصر عاتية"
    },
    {
      "number": 5330,
      "text": "سَخَّرَها عَلَيهِم سَبعَ لَيالٍ وَثَمـٰنِيَةَ أَيّامٍ حُسومًا فَتَرَى القَومَ فيها صَرعىٰ كَأَنَّهُم أَعجازُ نَخلٍ خاوِيَةٍ",
      "numberInSurah": 7,
      "juz": 29,
      "manzil": 7,
      "page": 566,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "سخرها عليهم سبع ليال وثمانية أيام حسوما فترى القوم فيها صرعى كأنهم أعجاز نخل خاوية"
    },
    {
      "number": 5331,
      "text": "فَهَل تَرىٰ لَهُم مِن باقِيَةٍ",
      "numberInSurah": 8,
      "juz": 29,
      "manzil": 7,
      "page": 566,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "فهل ترى لهم من باقية"
    },
    {
      "number": 5332,
      "text": "وَجاءَ فِرعَونُ وَمَن قَبلَهُ وَالمُؤتَفِكـٰتُ بِالخاطِئَةِ",
      "numberInSurah": 9,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "وجاء فرعون ومن قبله والمؤتفكات بالخاطئة"
    },
    {
      "number": 5333,
      "text": "فَعَصَوا رَسولَ رَبِّهِم فَأَخَذَهُم أَخذَةً رابِيَةً",
      "numberInSurah": 10,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "فعصوا رسول ربهم فأخذهم أخذة رابية"
    },
    {
      "number": 5334,
      "text": "إِنّا لَمّا طَغَا الماءُ حَمَلنـٰكُم فِى الجارِيَةِ",
      "numberInSurah": 11,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "إنا لما طغى الماء حملناكم في الجارية"
    },
    {
      "number": 5335,
      "text": "لِنَجعَلَها لَكُم تَذكِرَةً وَتَعِيَها أُذُنٌ وٰعِيَةٌ",
      "numberInSurah": 12,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "لنجعلها لكم تذكرة وتعيها أذن واعية"
    },
    {
      "number": 5336,
      "text": "فَإِذا نُفِخَ فِى الصّورِ نَفخَةٌ وٰحِدَةٌ",
      "numberInSurah": 13,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "فإذا نفخ في الصور نفخة واحدة"
    },
    {
      "number": 5337,
      "text": "وَحُمِلَتِ الأَرضُ وَالجِبالُ فَدُكَّتا دَكَّةً وٰحِدَةً",
      "numberInSurah": 14,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "وحملت الأرض والجبال فدكتا دكة واحدة"
    },
    {
      "number": 5338,
      "text": "فَيَومَئِذٍ وَقَعَتِ الواقِعَةُ",
      "numberInSurah": 15,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "فيومئذ وقعت الواقعة"
    },
    {
      "number": 5339,
      "text": "وَانشَقَّتِ السَّماءُ فَهِىَ يَومَئِذٍ واهِيَةٌ",
      "numberInSurah": 16,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "وانشقت السماء فهي يومئذ واهية"
    },
    {
      "number": 5340,
      "text": "وَالمَلَكُ عَلىٰ أَرجائِها ۚ وَيَحمِلُ عَرشَ رَبِّكَ فَوقَهُم يَومَئِذٍ ثَمـٰنِيَةٌ",
      "numberInSurah": 17,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "والملك على أرجائها ويحمل عرش ربك فوقهم يومئذ ثمانية"
    },
    {
      "number": 5341,
      "text": "يَومَئِذٍ تُعرَضونَ لا تَخفىٰ مِنكُم خافِيَةٌ",
      "numberInSurah": 18,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "يومئذ تعرضون لا تخفى منكم خافية"
    },
    {
      "number": 5342,
      "text": "فَأَمّا مَن أوتِىَ كِتـٰبَهُ بِيَمينِهِ فَيَقولُ هاؤُمُ اقرَءوا كِتـٰبِيَه",
      "numberInSurah": 19,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "فأما من أوتي كتابه بيمينه فيقول هاؤم اقرءوا كتابيه"
    },
    {
      "number": 5343,
      "text": "إِنّى ظَنَنتُ أَنّى مُلـٰقٍ حِسابِيَه",
      "numberInSurah": 20,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "إني ظننت أني ملاق حسابيه"
    },
    {
      "number": 5344,
      "text": "فَهُوَ فى عيشَةٍ راضِيَةٍ",
      "numberInSurah": 21,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "فهو في عيشة راضية"
    },
    {
      "number": 5345,
      "text": "فى جَنَّةٍ عالِيَةٍ",
      "numberInSurah": 22,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "في جنة عالية"
    },
    {
      "number": 5346,
      "text": "قُطوفُها دانِيَةٌ",
      "numberInSurah": 23,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "قطوفها دانية"
    },
    {
      "number": 5347,
      "text": "كُلوا وَاشرَبوا هَنيـًٔا بِما أَسلَفتُم فِى الأَيّامِ الخالِيَةِ",
      "numberInSurah": 24,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "كلوا واشربوا هنيئا بما أسلفتم في الأيام الخالية"
    },
    {
      "number": 5348,
      "text": "وَأَمّا مَن أوتِىَ كِتـٰبَهُ بِشِمالِهِ فَيَقولُ يـٰلَيتَنى لَم أوتَ كِتـٰبِيَه",
      "numberInSurah": 25,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "وأما من أوتي كتابه بشماله فيقول يا ليتني لم أوت كتابيه"
    },
    {
      "number": 5349,
      "text": "وَلَم أَدرِ ما حِسابِيَه",
      "numberInSurah": 26,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "ولم أدر ما حسابيه"
    },
    {
      "number": 5350,
      "text": "يـٰلَيتَها كانَتِ القاضِيَةَ",
      "numberInSurah": 27,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "يا ليتها كانت القاضية"
    },
    {
      "number": 5351,
      "text": "ما أَغنىٰ عَنّى مالِيَه ۜ",
      "numberInSurah": 28,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "ما أغنى عني ماليه"
    },
    {
      "number": 5352,
      "text": "هَلَكَ عَنّى سُلطـٰنِيَه",
      "numberInSurah": 29,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "هلك عني سلطانيه"
    },
    {
      "number": 5353,
      "text": "خُذوهُ فَغُلّوهُ",
      "numberInSurah": 30,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "خذوه فغلوه"
    },
    {
      "number": 5354,
      "text": "ثُمَّ الجَحيمَ صَلّوهُ",
      "numberInSurah": 31,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "ثم الجحيم صلوه"
    },
    {
      "number": 5355,
      "text": "ثُمَّ فى سِلسِلَةٍ ذَرعُها سَبعونَ ذِراعًا فَاسلُكوهُ",
      "numberInSurah": 32,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "ثم في سلسلة ذرعها سبعون ذراعا فاسلكوه"
    },
    {
      "number": 5356,
      "text": "إِنَّهُ كانَ لا يُؤمِنُ بِاللَّهِ العَظيمِ",
      "numberInSurah": 33,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "إنه كان لا يؤمن بالله العظيم"
    },
    {
      "number": 5357,
      "text": "وَلا يَحُضُّ عَلىٰ طَعامِ المِسكينِ",
      "numberInSurah": 34,
      "juz": 29,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "ولا يحض على طعام المسكين"
    },
    {
      "number": 5358,
      "text": "فَلَيسَ لَهُ اليَومَ هـٰهُنا حَميمٌ",
      "numberInSurah": 35,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "فليس له اليوم هاهنا حميم"
    },
    {
      "number": 5359,
      "text": "وَلا طَعامٌ إِلّا مِن غِسلينٍ",
      "numberInSurah": 36,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "ولا طعام إلا من غسلين"
    },
    {
      "number": 5360,
      "text": "لا يَأكُلُهُ إِلَّا الخـٰطِـٔونَ",
      "numberInSurah": 37,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "لا يأكله إلا الخاطئون"
    },
    {
      "number": 5361,
      "text": "فَلا أُقسِمُ بِما تُبصِرونَ",
      "numberInSurah": 38,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "فلا أقسم بما تبصرون"
    },
    {
      "number": 5362,
      "text": "وَما لا تُبصِرونَ",
      "numberInSurah": 39,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "وما لا تبصرون"
    },
    {
      "number": 5363,
      "text": "إِنَّهُ لَقَولُ رَسولٍ كَريمٍ",
      "numberInSurah": 40,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "إنه لقول رسول كريم"
    },
    {
      "number": 5364,
      "text": "وَما هُوَ بِقَولِ شاعِرٍ ۚ قَليلًا ما تُؤمِنونَ",
      "numberInSurah": 41,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "وما هو بقول شاعر قليلا ما تؤمنون"
    },
    {
      "number": 5365,
      "text": "وَلا بِقَولِ كاهِنٍ ۚ قَليلًا ما تَذَكَّرونَ",
      "numberInSurah": 42,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "ولا بقول كاهن قليلا ما تذكرون"
    },
    {
      "number": 5366,
      "text": "تَنزيلٌ مِن رَبِّ العـٰلَمينَ",
      "numberInSurah": 43,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "تنزيل من رب العالمين"
    },
    {
      "number": 5367,
      "text": "وَلَو تَقَوَّلَ عَلَينا بَعضَ الأَقاويلِ",
      "numberInSurah": 44,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "ولو تقول علينا بعض الأقاويل"
    },
    {
      "number": 5368,
      "text": "لَأَخَذنا مِنهُ بِاليَمينِ",
      "numberInSurah": 45,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "لأخذنا منه باليمين"
    },
    {
      "number": 5369,
      "text": "ثُمَّ لَقَطَعنا مِنهُ الوَتينَ",
      "numberInSurah": 46,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "ثم لقطعنا منه الوتين"
    },
    {
      "number": 5370,
      "text": "فَما مِنكُم مِن أَحَدٍ عَنهُ حـٰجِزينَ",
      "numberInSurah": 47,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false,
      "no_Tashkeel_text": "فما منكم من أحد عنه حاجزين"
    },
    {
      "number": 5371,
      "text": "وَإِنَّهُ لَتَذكِرَةٌ لِلمُتَّقينَ",
      "numberInSurah": 48,
      "juz": 29,
      "manzil": 7,
      "page": 568,
