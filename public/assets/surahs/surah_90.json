{
    "number": 90,
    "name": "سُورَةُ البَلَدِ",
    "englishName": "Al-Balad",
    "englishNameTranslation": "The City",
    "revelationType": "Meccan",
    "ayahs": [
        {
            "number": 6024,
            "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
            "numberInSurah": 1,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 532,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "بسم الله الرحمن الرحيم لا أقسم بهذا البلد"
        },
        {
            "number": 6025,
            "text": "ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ",
            "numberInSurah": 2,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 532,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "وأنت حل بهذا البلد"
        },
        {
            "number": 6026,
            "text": "ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
            "numberInSurah": 3,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 532,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "ووالد وما ولد"
        },
        {
            "number": 6027,
            "text": "مَٰلِكِ يَوۡمِ ٱلدِّينِ",
            "numberInSurah": 4,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 532,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "لقد خلقنا الإنسان في كبد"
        },
        {
            "number": 6028,
            "text": "إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ",
            "numberInSurah": 5,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 532,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "أيحسب أن لن يقدر عليه أحد"
        },
        {
            "number": 6029,
            "text": "ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ",
            "numberInSurah": 6,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 532,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "يقول أهلكت مالا لبدا"
        },
        {
            "number": 6030,
            "text": "صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ",
            "numberInSurah": 7,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 532,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "أيحسب أن لم يره أحد"
        },
        {
            "number": 6031,
            "text": "أَلَم نَجعَل لَهُ عَينَينِ",
            "numberInSurah": 8,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 532,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "ألم نجعل له عينين"
        },
        {
            "number": 6032,
            "text": "وَلِسانًا وَشَفَتَينِ",
            "numberInSurah": 9,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 532,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "ولسانا وشفتين"
        },
        {
            "number": 6033,
            "text": "وَهَدَينـٰهُ النَّجدَينِ",
            "numberInSurah": 10,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 532,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "وهديناه النجدين"
        },
        {
            "number": 6034,
            "text": "فَلَا اقتَحَمَ العَقَبَةَ",
            "numberInSurah": 11,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 532,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "فلا اقتحم العقبة"
        },
        {
            "number": 6035,
            "text": "وَما أَدرىٰكَ مَا العَقَبَةُ",
            "numberInSurah": 12,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 532,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "وما أدراك ما العقبة"
        },
        {
            "number": 6036,
            "text": "فَكُّ رَقَبَةٍ",
            "numberInSurah": 13,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 532,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "فك رقبة"
        },
        {
            "number": 6037,
            "text": "أَو إِطعـٰمٌ فى يَومٍ ذى مَسغَبَةٍ",
            "numberInSurah": 14,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 532,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "أو إطعام في يوم ذي مسغبة"
        },
        {
            "number": 6038,
            "text": "يَتيمًا ذا مَقرَبَةٍ",
            "numberInSurah": 15,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 532,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "يتيما ذا مقربة"
        },
        {
            "number": 6039,
            "text": "أَو مِسكينًا ذا مَترَبَةٍ",
            "numberInSurah": 16,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 532,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "أو مسكينا ذا متربة"
        },
        {
            "number": 6040,
            "text": "ثُمَّ كانَ مِنَ الَّذينَ ءامَنوا وَتَواصَوا بِالصَّبرِ وَتَواصَوا بِالمَرحَمَةِ",
            "numberInSurah": 17,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 532,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "ثم كان من الذين آمنوا وتواصوا بالصبر وتواصوا بالمرحمة"
        },
        {
            "number": 6041,
            "text": "أُولـٰئِكَ أَصحـٰبُ المَيمَنَةِ",
            "numberInSurah": 18,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 532,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "أولئك أصحاب الميمنة"
        },
        {
            "number": 6042,
            "text": "وَالَّذينَ كَفَروا بِـٔايـٰتِنا هُم أَصحـٰبُ المَشـَٔمَةِ",
            "numberInSurah": 19,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 532,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "والذين كفروا بآياتنا هم أصحاب المشأمة"
        },
        {
            "number": 6043,
            "text": "عَلَيهِم نارٌ مُؤصَدَةٌ",
            "numberInSurah": 20,
            "juz": 30,
            "manzil": 7,
            "page": 594,
            "ruku": 532,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "عليهم نار مؤصدة"
        }
    ]
}