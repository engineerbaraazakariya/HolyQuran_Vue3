{
    "number": 98,
    "name": "سُورَةُ البَيِّنَةِ",
    "englishName": "Al-Bayyina",
    "englishNameTranslation": "The Evidence",
    "revelationType": "Medinan",
    "ayahs": [
        {
            "number": 6131,
            "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
            "numberInSurah": 1,
            "juz": 30,
            "manzil": 7,
            "page": 598,
            "ruku": 540,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "بسم الله الرحمن الرحيم لم يكن الذين كفروا من أهل الكتاب والمشركين منفكين حتى تأتيهم البينة"
        },
        {
            "number": 6132,
            "text": "ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ",
            "numberInSurah": 2,
            "juz": 30,
            "manzil": 7,
            "page": 598,
            "ruku": 540,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "رسول من الله يتلو صحفا مطهرة"
        },
        {
            "number": 6133,
            "text": "ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
            "numberInSurah": 3,
            "juz": 30,
            "manzil": 7,
            "page": 598,
            "ruku": 540,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "فيها كتب قيمة"
        },
        {
            "number": 6134,
            "text": "مَٰلِكِ يَوۡمِ ٱلدِّينِ",
            "numberInSurah": 4,
            "juz": 30,
            "manzil": 7,
            "page": 598,
            "ruku": 540,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "وما تفرق الذين أوتوا الكتاب إلا من بعد ما جاءتهم البينة"
        },
        {
            "number": 6135,
            "text": "إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ",
            "numberInSurah": 5,
            "juz": 30,
            "manzil": 7,
            "page": 598,
            "ruku": 540,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "وما أمروا إلا ليعبدوا الله مخلصين له الدين حنفاء ويقيموا الصلاة ويؤتوا الزكاة وذلك دين القيمة"
        },
        {
            "number": 6136,
            "text": "ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ",
            "numberInSurah": 6,
            "juz": 30,
            "manzil": 7,
            "page": 598,
            "ruku": 540,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "إن الذين كفروا من أهل الكتاب والمشركين في نار جهنم خالدين فيها أولئك هم شر البرية"
        },
        {
            "number": 6137,
            "text": "صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ",
            "numberInSurah": 7,
            "juz": 30,
            "manzil": 7,
            "page": 598,
            "ruku": 540,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "إن الذين آمنوا وعملوا الصالحات أولئك هم خير البرية"
        },
        {
            "number": 6138,
            "text": "جَزاؤُهُم عِندَ رَبِّهِم جَنّـٰتُ عَدنٍ تَجرى مِن تَحتِهَا الأَنهـٰرُ خـٰلِدينَ فيها أَبَدًا ۖ رَضِىَ اللَّهُ عَنهُم وَرَضوا عَنهُ ۚ ذٰلِكَ لِمَن خَشِىَ رَبَّهُ",
            "numberInSurah": 8,
            "juz": 30,
            "manzil": 7,
            "page": 599,
            "ruku": 540,
            "hizbQuarter": 239,
            "sajda": false,
            "no_Tashkeel_text": "جزاؤهم عند ربهم جنات عدن تجري من تحتها الأنهار خالدين فيها أبدا رضي الله عنهم ورضوا عنه ذلك لمن خشي ربه"
        }
    ]
}