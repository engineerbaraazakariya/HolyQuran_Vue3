{
    "number": 88,
    "name": "سُورَةُ الغَاشِيَةِ",
    "englishName": "Al-Ghaashiya",
    "englishNameTranslation": "The Overwhelming",
    "revelationType": "Meccan",
    "ayahs": [
        {
            "number": 5968,
            "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
            "numberInSurah": 1,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "بسم الله الرحمن الرحيم هل أتاك حديث الغاشية"
        },
        {
            "number": 5969,
            "text": "ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ",
            "numberInSurah": 2,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "وجوه يومئذ خاشعة"
        },
        {
            "number": 5970,
            "text": "ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
            "numberInSurah": 3,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "عاملة ناصبة"
        },
        {
            "number": 5971,
            "text": "مَٰلِكِ يَوۡمِ ٱلدِّينِ",
            "numberInSurah": 4,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "تصلى نارا حامية"
        },
        {
            "number": 5972,
            "text": "إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ",
            "numberInSurah": 5,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "تسقى من عين آنية"
        },
        {
            "number": 5973,
            "text": "ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ",
            "numberInSurah": 6,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "ليس لهم طعام إلا من ضريع"
        },
        {
            "number": 5974,
            "text": "صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ",
            "numberInSurah": 7,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "لا يسمن ولا يغني من جوع"
        },
        {
            "number": 5975,
            "text": "وُجوهٌ يَومَئِذٍ ناعِمَةٌ",
            "numberInSurah": 8,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "وجوه يومئذ ناعمة"
        },
        {
            "number": 5976,
            "text": "لِسَعيِها راضِيَةٌ",
            "numberInSurah": 9,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "لسعيها راضية"
        },
        {
            "number": 5977,
            "text": "فى جَنَّةٍ عالِيَةٍ",
            "numberInSurah": 10,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "في جنة عالية"
        },
        {
            "number": 5978,
            "text": "لا تَسمَعُ فيها لـٰغِيَةً",
            "numberInSurah": 11,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "لا تسمع فيها لاغية"
        },
        {
            "number": 5979,
            "text": "فيها عَينٌ جارِيَةٌ",
            "numberInSurah": 12,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "فيها عين جارية"
        },
        {
            "number": 5980,
            "text": "فيها سُرُرٌ مَرفوعَةٌ",
            "numberInSurah": 13,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "فيها سرر مرفوعة"
        },
        {
            "number": 5981,
            "text": "وَأَكوابٌ مَوضوعَةٌ",
            "numberInSurah": 14,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "وأكواب موضوعة"
        },
        {
            "number": 5982,
            "text": "وَنَمارِقُ مَصفوفَةٌ",
            "numberInSurah": 15,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "ونمارق مصفوفة"
        },
        {
            "number": 5983,
            "text": "وَزَرابِىُّ مَبثوثَةٌ",
            "numberInSurah": 16,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "وزرابي مبثوثة"
        },
        {
            "number": 5984,
            "text": "أَفَلا يَنظُرونَ إِلَى الإِبِلِ كَيفَ خُلِقَت",
            "numberInSurah": 17,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "أفلا ينظرون إلى الإبل كيف خلقت"
        },
        {
            "number": 5985,
            "text": "وَإِلَى السَّماءِ كَيفَ رُفِعَت",
            "numberInSurah": 18,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "وإلى السماء كيف رفعت"
        },
        {
            "number": 5986,
            "text": "وَإِلَى الجِبالِ كَيفَ نُصِبَت",
            "numberInSurah": 19,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "وإلى الجبال كيف نصبت"
        },
        {
            "number": 5987,
            "text": "وَإِلَى الأَرضِ كَيفَ سُطِحَت",
            "numberInSurah": 20,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "وإلى الأرض كيف سطحت"
        },
        {
            "number": 5988,
            "text": "فَذَكِّر إِنَّما أَنتَ مُذَكِّرٌ",
            "numberInSurah": 21,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "فذكر إنما أنت مذكر"
        },
        {
            "number": 5989,
            "text": "لَستَ عَلَيهِم بِمُصَيطِرٍ",
            "numberInSurah": 22,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "لست عليهم بمصيطر"
        },
        {
            "number": 5990,
            "text": "إِلّا مَن تَوَلّىٰ وَكَفَرَ",
            "numberInSurah": 23,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "إلا من تولى وكفر"
        },
        {
            "number": 5991,
            "text": "فَيُعَذِّبُهُ اللَّهُ العَذابَ الأَكبَرَ",
            "numberInSurah": 24,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "فيعذبه الله العذاب الأكبر"
        },
        {
            "number": 5992,
            "text": "إِنَّ إِلَينا إِيابَهُم",
            "numberInSurah": 25,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "إن إلينا إيابهم"
        },
        {
            "number": 5993,
            "text": "ثُمَّ إِنَّ عَلَينا حِسابَهُم",
            "numberInSurah": 26,
            "juz": 30,
            "manzil": 7,
            "page": 592,
            "ruku": 530,
            "hizbQuarter": 237,
            "sajda": false,
            "no_Tashkeel_text": "ثم إن علينا حسابهم"
        }
    ]
}