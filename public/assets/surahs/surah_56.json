{
  "number": 56,
  "name": "سُورَةُ الوَاقِعَةِ",
  "englishName": "Al-Waaqia",
  "englishNameTranslation": "The Inevitable",
  "revelationType": "Meccan",
  "ayahs": [
    {
      "number": 4980,
      "text": "إِذا وَقَعَتِ الواقِعَةُ",
      "numberInSurah": 1,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "بسم الله الرحمن الرحيم إذا وقعت الواقعة"
    },
    {
      "number": 4981,
      "text": "لَيسَ لِوَقعَتِها كاذِبَةٌ",
      "numberInSurah": 2,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "ليس لوقعتها كاذبة"
    },
    {
      "number": 4982,
      "text": "خافِضَةٌ رافِعَةٌ",
      "numberInSurah": 3,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "خافضة رافعة"
    },
    {
      "number": 4983,
      "text": "إِذا رُجَّتِ الأَرضُ رَجًّا",
      "numberInSurah": 4,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "إذا رجت الأرض رجا"
    },
    {
      "number": 4984,
      "text": "وَبُسَّتِ الجِبالُ بَسًّا",
      "numberInSurah": 5,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "وبست الجبال بسا"
    },
    {
      "number": 4985,
      "text": "فَكانَت هَباءً مُنبَثًّا",
      "numberInSurah": 6,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "فكانت هباء منبثا"
    },
    {
      "number": 4986,
      "text": "وَكُنتُم أَزوٰجًا ثَلـٰثَةً",
      "numberInSurah": 7,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "وكنتم أزواجا ثلاثة"
    },
    {
      "number": 4987,
      "text": "فَأَصحـٰبُ المَيمَنَةِ ما أَصحـٰبُ المَيمَنَةِ",
      "numberInSurah": 8,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "فأصحاب الميمنة ما أصحاب الميمنة"
    },
    {
      "number": 4988,
      "text": "وَأَصحـٰبُ المَشـَٔمَةِ ما أَصحـٰبُ المَشـَٔمَةِ",
      "numberInSurah": 9,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "وأصحاب المشأمة ما أصحاب المشأمة"
    },
    {
      "number": 4989,
      "text": "وَالسّـٰبِقونَ السّـٰبِقونَ",
      "numberInSurah": 10,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "والسابقون السابقون"
    },
    {
      "number": 4990,
      "text": "أُولـٰئِكَ المُقَرَّبونَ",
      "numberInSurah": 11,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "أولئك المقربون"
    },
    {
      "number": 4991,
      "text": "فى جَنّـٰتِ النَّعيمِ",
      "numberInSurah": 12,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "في جنات النعيم"
    },
    {
      "number": 4992,
      "text": "ثُلَّةٌ مِنَ الأَوَّلينَ",
      "numberInSurah": 13,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "ثلة من الأولين"
    },
    {
      "number": 4993,
      "text": "وَقَليلٌ مِنَ الـٔاخِرينَ",
      "numberInSurah": 14,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "وقليل من الآخرين"
    },
    {
      "number": 4994,
      "text": "عَلىٰ سُرُرٍ مَوضونَةٍ",
      "numberInSurah": 15,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "على سرر موضونة"
    },
    {
      "number": 4995,
      "text": "مُتَّكِـٔينَ عَلَيها مُتَقـٰبِلينَ",
      "numberInSurah": 16,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "متكئين عليها متقابلين"
    },
    {
      "number": 4996,
      "text": "يَطوفُ عَلَيهِم وِلدٰنٌ مُخَلَّدونَ",
      "numberInSurah": 17,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "يطوف عليهم ولدان مخلدون"
    },
    {
      "number": 4997,
      "text": "بِأَكوابٍ وَأَباريقَ وَكَأسٍ مِن مَعينٍ",
      "numberInSurah": 18,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "بأكواب وأباريق وكأس من معين"
    },
    {
      "number": 4998,
      "text": "لا يُصَدَّعونَ عَنها وَلا يُنزِفونَ",
      "numberInSurah": 19,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "لا يصدعون عنها ولا ينزفون"
    },
    {
      "number": 4999,
      "text": "وَفـٰكِهَةٍ مِمّا يَتَخَيَّرونَ",
      "numberInSurah": 20,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "وفاكهة مما يتخيرون"
    },
    {
      "number": 5000,
      "text": "وَلَحمِ طَيرٍ مِمّا يَشتَهونَ",
      "numberInSurah": 21,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "ولحم طير مما يشتهون"
    },
    {
      "number": 5001,
      "text": "وَحورٌ عينٌ",
      "numberInSurah": 22,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "وحور عين"
    },
    {
      "number": 5002,
      "text": "كَأَمثـٰلِ اللُّؤلُؤِ المَكنونِ",
      "numberInSurah": 23,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "كأمثال اللؤلؤ المكنون"
    },
    {
      "number": 5003,
      "text": "جَزاءً بِما كانوا يَعمَلونَ",
      "numberInSurah": 24,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "جزاء بما كانوا يعملون"
    },
    {
      "number": 5004,
      "text": "لا يَسمَعونَ فيها لَغوًا وَلا تَأثيمًا",
      "numberInSurah": 25,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "لا يسمعون فيها لغوا ولا تأثيما"
    },
    {
      "number": 5005,
      "text": "إِلّا قيلًا سَلـٰمًا سَلـٰمًا",
      "numberInSurah": 26,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "إلا قيلا سلاما سلاما"
    },
    {
      "number": 5006,
      "text": "وَأَصحـٰبُ اليَمينِ ما أَصحـٰبُ اليَمينِ",
      "numberInSurah": 27,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "وأصحاب اليمين ما أصحاب اليمين"
    },
    {
      "number": 5007,
      "text": "فى سِدرٍ مَخضودٍ",
      "numberInSurah": 28,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "في سدر مخضود"
    },
    {
      "number": 5008,
      "text": "وَطَلحٍ مَنضودٍ",
      "numberInSurah": 29,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "وطلح منضود"
    },
    {
      "number": 5009,
      "text": "وَظِلٍّ مَمدودٍ",
      "numberInSurah": 30,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "وظل ممدود"
    },
    {
      "number": 5010,
      "text": "وَماءٍ مَسكوبٍ",
      "numberInSurah": 31,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "وماء مسكوب"
    },
    {
      "number": 5011,
      "text": "وَفـٰكِهَةٍ كَثيرَةٍ",
      "numberInSurah": 32,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "وفاكهة كثيرة"
    },
    {
      "number": 5012,
      "text": "لا مَقطوعَةٍ وَلا مَمنوعَةٍ",
      "numberInSurah": 33,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "لا مقطوعة ولا ممنوعة"
    },
    {
      "number": 5013,
      "text": "وَفُرُشٍ مَرفوعَةٍ",
      "numberInSurah": 34,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "وفرش مرفوعة"
    },
    {
      "number": 5014,
      "text": "إِنّا أَنشَأنـٰهُنَّ إِنشاءً",
      "numberInSurah": 35,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "إنا أنشأناهن إنشاء"
    },
    {
      "number": 5015,
      "text": "فَجَعَلنـٰهُنَّ أَبكارًا",
      "numberInSurah": 36,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "فجعلناهن أبكارا"
    },
    {
      "number": 5016,
      "text": "عُرُبًا أَترابًا",
      "numberInSurah": 37,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "عربا أترابا"
    },
    {
      "number": 5017,
      "text": "لِأَصحـٰبِ اليَمينِ",
      "numberInSurah": 38,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "لأصحاب اليمين"
    },
    {
      "number": 5018,
      "text": "ثُلَّةٌ مِنَ الأَوَّلينَ",
      "numberInSurah": 39,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "ثلة من الأولين"
    },
    {
      "number": 5019,
      "text": "وَثُلَّةٌ مِنَ الـٔاخِرينَ",
      "numberInSurah": 40,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "وثلة من الآخرين"
    },
    {
      "number": 5020,
      "text": "وَأَصحـٰبُ الشِّمالِ ما أَصحـٰبُ الشِّمالِ",
      "numberInSurah": 41,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "وأصحاب الشمال ما أصحاب الشمال"
    },
    {
      "number": 5021,
      "text": "فى سَمومٍ وَحَميمٍ",
      "numberInSurah": 42,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "في سموم وحميم"
    },
    {
      "number": 5022,
      "text": "وَظِلٍّ مِن يَحمومٍ",
      "numberInSurah": 43,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "وظل من يحموم"
    },
    {
      "number": 5023,
      "text": "لا بارِدٍ وَلا كَريمٍ",
      "numberInSurah": 44,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "لا بارد ولا كريم"
    },
    {
      "number": 5024,
      "text": "إِنَّهُم كانوا قَبلَ ذٰلِكَ مُترَفينَ",
      "numberInSurah": 45,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "إنهم كانوا قبل ذلك مترفين"
    },
    {
      "number": 5025,
      "text": "وَكانوا يُصِرّونَ عَلَى الحِنثِ العَظيمِ",
      "numberInSurah": 46,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "وكانوا يصرون على الحنث العظيم"
    },
    {
      "number": 5026,
      "text": "وَكانوا يَقولونَ أَئِذا مِتنا وَكُنّا تُرابًا وَعِظـٰمًا أَءِنّا لَمَبعوثونَ",
      "numberInSurah": 47,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "وكانوا يقولون أئذا متنا وكنا ترابا وعظاما أإنا لمبعوثون"
    },
    {
      "number": 5027,
      "text": "أَوَءاباؤُنَا الأَوَّلونَ",
      "numberInSurah": 48,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "أوآباؤنا الأولون"
    },
    {
      "number": 5028,
      "text": "قُل إِنَّ الأَوَّلينَ وَالـٔاخِرينَ",
      "numberInSurah": 49,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "قل إن الأولين والآخرين"
    },
    {
      "number": 5029,
      "text": "لَمَجموعونَ إِلىٰ ميقـٰتِ يَومٍ مَعلومٍ",
      "numberInSurah": 50,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "لمجموعون إلى ميقات يوم معلوم"
    },
    {
      "number": 5030,
      "text": "ثُمَّ إِنَّكُم أَيُّهَا الضّالّونَ المُكَذِّبونَ",
      "numberInSurah": 51,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "ثم إنكم أيها الضالون المكذبون"
    },
    {
      "number": 5031,
      "text": "لَـٔاكِلونَ مِن شَجَرٍ مِن زَقّومٍ",
      "numberInSurah": 52,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "لآكلون من شجر من زقوم"
    },
    {
      "number": 5032,
      "text": "فَمالِـٔونَ مِنهَا البُطونَ",
      "numberInSurah": 53,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "فمالئون منها البطون"
    },
    {
      "number": 5033,
      "text": "فَشـٰرِبونَ عَلَيهِ مِنَ الحَميمِ",
      "numberInSurah": 54,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "فشاربون عليه من الحميم"
    },
    {
      "number": 5034,
      "text": "فَشـٰرِبونَ شُربَ الهيمِ",
      "numberInSurah": 55,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "فشاربون شرب الهيم"
    },
    {
      "number": 5035,
      "text": "هـٰذا نُزُلُهُم يَومَ الدّينِ",
      "numberInSurah": 56,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "هذا نزلهم يوم الدين"
    },
    {
      "number": 5036,
      "text": "نَحنُ خَلَقنـٰكُم فَلَولا تُصَدِّقونَ",
      "numberInSurah": 57,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "نحن خلقناكم فلولا تصدقون"
    },
    {
      "number": 5037,
      "text": "أَفَرَءَيتُم ما تُمنونَ",
      "numberInSurah": 58,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "أفرأيتم ما تمنون"
    },
    {
      "number": 5038,
      "text": "ءَأَنتُم تَخلُقونَهُ أَم نَحنُ الخـٰلِقونَ",
      "numberInSurah": 59,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "أأنتم تخلقونه أم نحن الخالقون"
    },
    {
      "number": 5039,
      "text": "نَحنُ قَدَّرنا بَينَكُمُ المَوتَ وَما نَحنُ بِمَسبوقينَ",
      "numberInSurah": 60,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "نحن قدرنا بينكم الموت وما نحن بمسبوقين"
    },
    {
      "number": 5040,
      "text": "عَلىٰ أَن نُبَدِّلَ أَمثـٰلَكُم وَنُنشِئَكُم فى ما لا تَعلَمونَ",
      "numberInSurah": 61,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "على أن نبدل أمثالكم وننشئكم في ما لا تعلمون"
    },
    {
      "number": 5041,
      "text": "وَلَقَد عَلِمتُمُ النَّشأَةَ الأولىٰ فَلَولا تَذَكَّرونَ",
      "numberInSurah": 62,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "ولقد علمتم النشأة الأولى فلولا تذكرون"
    },
    {
      "number": 5042,
      "text": "أَفَرَءَيتُم ما تَحرُثونَ",
      "numberInSurah": 63,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "أفرأيتم ما تحرثون"
    },
    {
      "number": 5043,
      "text": "ءَأَنتُم تَزرَعونَهُ أَم نَحنُ الزّٰرِعونَ",
      "numberInSurah": 64,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "أأنتم تزرعونه أم نحن الزارعون"
    },
    {
      "number": 5044,
      "text": "لَو نَشاءُ لَجَعَلنـٰهُ حُطـٰمًا فَظَلتُم تَفَكَّهونَ",
      "numberInSurah": 65,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "لو نشاء لجعلناه حطاما فظلتم تفكهون"
    },
    {
      "number": 5045,
      "text": "إِنّا لَمُغرَمونَ",
      "numberInSurah": 66,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "إنا لمغرمون"
    },
    {
      "number": 5046,
      "text": "بَل نَحنُ مَحرومونَ",
      "numberInSurah": 67,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "بل نحن محرومون"
    },
    {
      "number": 5047,
      "text": "أَفَرَءَيتُمُ الماءَ الَّذى تَشرَبونَ",
      "numberInSurah": 68,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "أفرأيتم الماء الذي تشربون"
    },
    {
      "number": 5048,
      "text": "ءَأَنتُم أَنزَلتُموهُ مِنَ المُزنِ أَم نَحنُ المُنزِلونَ",
      "numberInSurah": 69,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "أأنتم أنزلتموه من المزن أم نحن المنزلون"
    },
    {
      "number": 5049,
      "text": "لَو نَشاءُ جَعَلنـٰهُ أُجاجًا فَلَولا تَشكُرونَ",
      "numberInSurah": 70,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "لو نشاء جعلناه أجاجا فلولا تشكرون"
    },
    {
      "number": 5050,
      "text": "أَفَرَءَيتُمُ النّارَ الَّتى تورونَ",
      "numberInSurah": 71,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "أفرأيتم النار التي تورون"
    },
    {
      "number": 5051,
      "text": "ءَأَنتُم أَنشَأتُم شَجَرَتَها أَم نَحنُ المُنشِـٔونَ",
      "numberInSurah": 72,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "أأنتم أنشأتم شجرتها أم نحن المنشئون"
    },
    {
      "number": 5052,
      "text": "نَحنُ جَعَلنـٰها تَذكِرَةً وَمَتـٰعًا لِلمُقوينَ",
      "numberInSurah": 73,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "نحن جعلناها تذكرة ومتاعا للمقوين"
    },
    {
      "number": 5053,
      "text": "فَسَبِّح بِاسمِ رَبِّكَ العَظيمِ",
      "numberInSurah": 74,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false,
      "no_Tashkeel_text": "فسبح باسم ربك العظيم"
    },
    {
      "number": 5054,
      "text": "۞ فَلا أُقسِمُ بِمَوٰقِعِ النُّجومِ",
      "numberInSurah": 75,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false,
      "no_Tashkeel_text": "فلا أقسم بمواقع النجوم"
    },
    {
      "number": 5055,
      "text": "وَإِنَّهُ لَقَسَمٌ لَو تَعلَمونَ عَظيمٌ",
      "numberInSurah": 76,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false,
      "no_Tashkeel_text": "وإنه لقسم لو تعلمون عظيم"
    },
    {
      "number": 5056,
      "text": "إِنَّهُ لَقُرءانٌ كَريمٌ",
      "numberInSurah": 77,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false,
      "no_Tashkeel_text": "إنه لقرآن كريم"
    },
    {
      "number": 5057,
      "text": "فى كِتـٰبٍ مَكنونٍ",
      "numberInSurah": 78,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false,
      "no_Tashkeel_text": "في كتاب مكنون"
    },
    {
      "number": 5058,
      "text": "لا يَمَسُّهُ إِلَّا المُطَهَّرونَ",
      "numberInSurah": 79,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false,
      "no_Tashkeel_text": "لا يمسه إلا المطهرون"
    },
    {
      "number": 5059,
      "text": "تَنزيلٌ مِن رَبِّ العـٰلَمينَ",
      "numberInSurah": 80,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false,
      "no_Tashkeel_text": "تنزيل من رب العالمين"
    },
    {
      "number": 5060,
      "text": "أَفَبِهـٰذَا الحَديثِ أَنتُم مُدهِنونَ",
      "numberInSurah": 81,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false,
      "no_Tashkeel_text": "أفبهذا الحديث أنتم مدهنون"
    },
    {
      "number": 5061,
      "text": "وَتَجعَلونَ رِزقَكُم أَنَّكُم تُكَذِّبونَ",
      "numberInSurah": 82,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false,
      "no_Tashkeel_text": "وتجعلون رزقكم أنكم تكذبون"
    },
    {
      "number": 5062,
      "text": "فَلَولا إِذا بَلَغَتِ الحُلقومَ",
      "numberInSurah": 83,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false,
      "no_Tashkeel_text": "فلولا إذا بلغت الحلقوم"
    },
    {
      "number": 5063,
      "text": "وَأَنتُم حينَئِذٍ تَنظُرونَ",
      "numberInSurah": 84,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false,
      "no_Tashkeel_text": "وأنتم حينئذ تنظرون"
    },
    {
      "number": 5064,
      "text": "وَنَحنُ أَقرَبُ إِلَيهِ مِنكُم وَلـٰكِن لا تُبصِرونَ",
      "numberInSurah": 85,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false,
      "no_Tashkeel_text": "ونحن أقرب إليه منكم ولكن لا تبصرون"
    },
    {
      "number": 5065,
      "text": "فَلَولا إِن كُنتُم غَيرَ مَدينينَ",
      "numberInSurah": 86,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false,
      "no_Tashkeel_text": "فلولا إن كنتم غير مدينين"
    },
    {
      "number": 5066,
      "text": "تَرجِعونَها إِن كُنتُم صـٰدِقينَ",
      "numberInSurah": 87,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false,
      "no_Tashkeel_text": "ترجعونها إن كنتم صادقين"
    },
    {
      "number": 5067,
      "text": "فَأَمّا إِن كانَ مِنَ المُقَرَّبينَ",
      "numberInSurah": 88,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false,
      "no_Tashkeel_text": "فأما إن كان من المقربين"
    },
    {
      "number": 5068,
      "text": "فَرَوحٌ وَرَيحانٌ وَجَنَّتُ نَعيمٍ",
      "numberInSurah": 89,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false,
      "no_Tashkeel_text": "فروح وريحان وجنت نعيم"
    },
    {
      "number": 5069,
      "text": "وَأَمّا إِن كانَ مِن أَصحـٰبِ اليَمينِ",
      "numberInSurah": 90,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false,
      "no_Tashkeel_text": "وأما إن كان من أصحاب اليمين"
    },
    {
      "number": 5070,
      "text": "فَسَلـٰمٌ لَكَ مِن أَصحـٰبِ اليَمينِ",
      "numberInSurah": 91,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false,
      "no_Tashkeel_text": "فسلام لك من أصحاب اليمين"
    },
    {
      "number": 5071,
      "text": "وَأَمّا إِن كانَ مِنَ المُكَذِّبينَ الضّالّينَ",
      "numberInSurah": 92,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false,
      "no_Tashkeel_text": "وأما إن كان من المكذبين الضالين"
    },
    {
      "number": 5072,
      "text": "فَنُزُلٌ مِن حَميمٍ",
      "numberInSurah": 93,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false,
      "no_Tashkeel_text": "فنزل من حميم"
    },
    {
      "number": 5073,
      "text": "وَتَصلِيَةُ جَحيمٍ",
      "numberInSurah": 94,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false,
      "no_Tashkeel_text": "وتصلية جحيم"
    },
    {
      "number": 5074,
      "text": "إِنَّ هـٰذا لَهُوَ حَقُّ اليَقينِ",
      "numberInSurah": 95,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false,
      "no_Tashkeel_text": "إن هذا لهو حق اليقين"
    },
    {
      "number": 5075,
      "text": "فَسَبِّح بِاسمِ رَبِّكَ العَظيمِ",
      "numberInSurah": 96,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false,
      "no_Tashkeel_text": "فسبح باسم ربك العظيم"
    }
  ]
}