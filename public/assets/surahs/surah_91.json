{
    "number": 91,
    "name": "سُورَةُ الشَّمۡسِ",
    "englishName": "Ash-Shams",
    "englishNameTranslation": "The Sun",
    "revelationType": "Meccan",
    "ayahs": [
        {
            "number": 6044,
            "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
            "numberInSurah": 1,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 533,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "بسم الله الرحمن الرحيم والشمس وضحاها"
        },
        {
            "number": 6045,
            "text": "ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ",
            "numberInSurah": 2,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 533,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "والقمر إذا تلاها"
        },
        {
            "number": 6046,
            "text": "ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
            "numberInSurah": 3,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 533,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "والنهار إذا جلاها"
        },
        {
            "number": 6047,
            "text": "مَٰلِكِ يَوۡمِ ٱلدِّينِ",
            "numberInSurah": 4,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 533,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "والليل إذا يغشاها"
        },
        {
            "number": 6048,
            "text": "إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ",
            "numberInSurah": 5,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 533,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "والسماء وما بناها"
        },
        {
            "number": 6049,
            "text": "ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ",
            "numberInSurah": 6,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 533,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "والأرض وما طحاها"
        },
        {
            "number": 6050,
            "text": "صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ",
            "numberInSurah": 7,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 533,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "ونفس وما سواها"
        },
        {
            "number": 6051,
            "text": "فَأَلهَمَها فُجورَها وَتَقوىٰها",
            "numberInSurah": 8,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 533,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "فألهمها فجورها وتقواها"
        },
        {
            "number": 6052,
            "text": "قَد أَفلَحَ مَن زَكّىٰها",
            "numberInSurah": 9,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 533,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "قد أفلح من زكاها"
        },
        {
            "number": 6053,
            "text": "وَقَد خابَ مَن دَسّىٰها",
            "numberInSurah": 10,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 533,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "وقد خاب من دساها"
        },
        {
            "number": 6054,
            "text": "كَذَّبَت ثَمودُ بِطَغوىٰها",
            "numberInSurah": 11,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 533,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "كذبت ثمود بطغواها"
        },
        {
            "number": 6055,
            "text": "إِذِ انبَعَثَ أَشقىٰها",
            "numberInSurah": 12,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 533,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "إذ انبعث أشقاها"
        },
        {
            "number": 6056,
            "text": "فَقالَ لَهُم رَسولُ اللَّهِ ناقَةَ اللَّهِ وَسُقيـٰها",
            "numberInSurah": 13,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 533,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "فقال لهم رسول الله ناقة الله وسقياها"
        },
        {
            "number": 6057,
            "text": "فَكَذَّبوهُ فَعَقَروها فَدَمدَمَ عَلَيهِم رَبُّهُم بِذَنبِهِم فَسَوّىٰها",
            "numberInSurah": 14,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 533,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "فكذبوه فعقروها فدمدم عليهم ربهم بذنبهم فسواها"
        },
        {
            "number": 6058,
            "text": "وَلا يَخافُ عُقبـٰها",
            "numberInSurah": 15,
            "juz": 30,
            "manzil": 7,
            "page": 595,
            "ruku": 533,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "ولا يخاف عقباها"
        }
    ]
}