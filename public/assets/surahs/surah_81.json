{
    "number": 81,
    "name": "سُورَةُ التَّكۡوِيرِ",
    "englishName": "At-Takwir",
    "englishNameTranslation": "The Overthrowing",
    "revelationType": "Meccan",
    "ayahs": [
        {
            "number": 5801,
            "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
            "numberInSurah": 1,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "بسم الله الرحمن الرحيم إذا الشمس كورت"
        },
        {
            "number": 5802,
            "text": "ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ",
            "numberInSurah": 2,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "وإذا النجوم انكدرت"
        },
        {
            "number": 5803,
            "text": "ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
            "numberInSurah": 3,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "وإذا الجبال سيرت"
        },
        {
            "number": 5804,
            "text": "مَٰلِكِ يَوۡمِ ٱلدِّينِ",
            "numberInSurah": 4,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "وإذا العشار عطلت"
        },
        {
            "number": 5805,
            "text": "إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ",
            "numberInSurah": 5,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "وإذا الوحوش حشرت"
        },
        {
            "number": 5806,
            "text": "ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ",
            "numberInSurah": 6,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "وإذا البحار سجرت"
        },
        {
            "number": 5807,
            "text": "صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ",
            "numberInSurah": 7,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "وإذا النفوس زوجت"
        },
        {
            "number": 5808,
            "text": "وَإِذَا المَوءۥدَةُ سُئِلَت",
            "numberInSurah": 8,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "وإذا الموءودة سئلت"
        },
        {
            "number": 5809,
            "text": "بِأَىِّ ذَنبٍ قُتِلَت",
            "numberInSurah": 9,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "بأي ذنب قتلت"
        },
        {
            "number": 5810,
            "text": "وَإِذَا الصُّحُفُ نُشِرَت",
            "numberInSurah": 10,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "وإذا الصحف نشرت"
        },
        {
            "number": 5811,
            "text": "وَإِذَا السَّماءُ كُشِطَت",
            "numberInSurah": 11,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "وإذا السماء كشطت"
        },
        {
            "number": 5812,
            "text": "وَإِذَا الجَحيمُ سُعِّرَت",
            "numberInSurah": 12,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "وإذا الجحيم سعرت"
        },
        {
            "number": 5813,
            "text": "وَإِذَا الجَنَّةُ أُزلِفَت",
            "numberInSurah": 13,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "وإذا الجنة أزلفت"
        },
        {
            "number": 5814,
            "text": "عَلِمَت نَفسٌ ما أَحضَرَت",
            "numberInSurah": 14,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "علمت نفس ما أحضرت"
        },
        {
            "number": 5815,
            "text": "فَلا أُقسِمُ بِالخُنَّسِ",
            "numberInSurah": 15,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "فلا أقسم بالخنس"
        },
        {
            "number": 5816,
            "text": "الجَوارِ الكُنَّسِ",
            "numberInSurah": 16,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "الجوار الكنس"
        },
        {
            "number": 5817,
            "text": "وَالَّيلِ إِذا عَسعَسَ",
            "numberInSurah": 17,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "والليل إذا عسعس"
        },
        {
            "number": 5818,
            "text": "وَالصُّبحِ إِذا تَنَفَّسَ",
            "numberInSurah": 18,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "والصبح إذا تنفس"
        },
        {
            "number": 5819,
            "text": "إِنَّهُ لَقَولُ رَسولٍ كَريمٍ",
            "numberInSurah": 19,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "إنه لقول رسول كريم"
        },
        {
            "number": 5820,
            "text": "ذى قُوَّةٍ عِندَ ذِى العَرشِ مَكينٍ",
            "numberInSurah": 20,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "ذي قوة عند ذي العرش مكين"
        },
        {
            "number": 5821,
            "text": "مُطاعٍ ثَمَّ أَمينٍ",
            "numberInSurah": 21,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "مطاع ثم أمين"
        },
        {
            "number": 5822,
            "text": "وَما صاحِبُكُم بِمَجنونٍ",
            "numberInSurah": 22,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "وما صاحبكم بمجنون"
        },
        {
            "number": 5823,
            "text": "وَلَقَد رَءاهُ بِالأُفُقِ المُبينِ",
            "numberInSurah": 23,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "ولقد رآه بالأفق المبين"
        },
        {
            "number": 5824,
            "text": "وَما هُوَ عَلَى الغَيبِ بِضَنينٍ",
            "numberInSurah": 24,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "وما هو على الغيب بضنين"
        },
        {
            "number": 5825,
            "text": "وَما هُوَ بِقَولِ شَيطـٰنٍ رَجيمٍ",
            "numberInSurah": 25,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "وما هو بقول شيطان رجيم"
        },
        {
            "number": 5826,
            "text": "فَأَينَ تَذهَبونَ",
            "numberInSurah": 26,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "فأين تذهبون"
        },
        {
            "number": 5827,
            "text": "إِن هُوَ إِلّا ذِكرٌ لِلعـٰلَمينَ",
            "numberInSurah": 27,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "إن هو إلا ذكر للعالمين"
        },
        {
            "number": 5828,
            "text": "لِمَن شاءَ مِنكُم أَن يَستَقيمَ",
            "numberInSurah": 28,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "لمن شاء منكم أن يستقيم"
        },
        {
            "number": 5829,
            "text": "وَما تَشاءونَ إِلّا أَن يَشاءَ اللَّهُ رَبُّ العـٰلَمينَ",
            "numberInSurah": 29,
            "juz": 30,
            "manzil": 7,
            "page": 586,
            "ruku": 523,
            "hizbQuarter": 234,
            "sajda": false,
            "no_Tashkeel_text": "وما تشاءون إلا أن يشاء الله رب العالمين"
        }
    ]
}