            "manzil": 7,
            "page": 596,
            "ruku": 535,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "بسم الله الرحمن الرحيم والضحى"
        },
        {
            "number": 6081,
            "text": "وَٱلَّيۡلِ إِذَا سَجَىٰ",
            "numberInSurah": 2,
            "juz": 30,
            "manzil": 7,
            "page": 596,
            "ruku": 535,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "والليل إذا سجى"
        },
        {
            "number": 6082,
            "text": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ",
            "numberInSurah": 3,
            "juz": 30,
            "manzil": 7,
            "page": 596,
            "ruku": 535,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "ما ودعك ربك وما قلى"
        },
        {
            "number": 6083,
            "text": "وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ ٱلۡأُولَىٰ",
            "numberInSurah": 4,
            "juz": 30,
            "manzil": 7,
            "page": 596,
            "ruku": 535,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "وللآخرة خير لك من الأولى"
        },
        {
            "number": 6084,
            "text": "وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ",
            "numberInSurah": 5,
            "juz": 30,
            "manzil": 7,
            "page": 596,
            "ruku": 535,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "ولسوف يعطيك ربك فترضى"
        },
        {
            "number": 6085,
            "text": "أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوَىٰ",
            "numberInSurah": 6,
            "juz": 30,
            "manzil": 7,
            "page": 596,
            "ruku": 535,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "ألم يجدك يتيما فآوى"
        },
        {
            "number": 6086,
            "text": "وَوَجَدَكَ ضَآلّٗا فَهَدَىٰ",
            "numberInSurah": 7,
            "juz": 30,
            "manzil": 7,
            "page": 596,
            "ruku": 535,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "ووجدك ضالا فهدى"
        },
        {
            "number": 6087,
            "text": "وَوَجَدَكَ عَآئِلٗا فَأَغۡنَىٰ",
            "numberInSurah": 8,
            "juz": 30,
            "manzil": 7,
            "page": 596,
            "ruku": 535,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "ووجدك عائلا فأغنى"
        },
        {
            "number": 6088,
            "text": "فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ",
            "numberInSurah": 9,
            "juz": 30,
            "manzil": 7,
            "page": 596,
            "ruku": 535,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "فأما اليتيم فلا تقهر"
        },
        {
            "number": 6089,
            "text": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ",
            "numberInSurah": 10,
            "juz": 30,
            "manzil": 7,
            "page": 596,
            "ruku": 535,
            "hizbQuarter": 238,
            "sajda": false,
            "no_Tashkeel_text": "وأما السائل فلا تنهر"
        },
        {
            "number": 6090,
            "text": "وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ",
